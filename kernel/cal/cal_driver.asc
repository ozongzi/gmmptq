// Calibration driver: one gmmbench case, three cache regimes, msprof-timed.
//
// Why this exists separately from harness/driver.asc: that driver has exactly
// one knob (--iters) and therefore exactly one regime -- "fresh process, N
// back-to-back launches". shape.md §4 was measured that way, and the judge is
// not that regime. This driver can place a launch in any of the three regimes
// we can actually distinguish locally:
//
//   fresh : --prime-ms 0  --warmup 0  --samples 35 --cache-mode hot
//           (reproduces harness/profile.sh <dir> <driver> 35)
//   hot   : --prime-ms 600 --warmup 30 --samples 20 --cache-mode hot
//           (the regime search/*_fast used; caches and clocks settled)
//   cold  : --prime-ms 600 --warmup 30 --samples 20 --cache-mode evict
//           (same, but a >L2 stream runs to completion before every launch)
//
// Timing is NOT taken here. msprof reports each launch's own device Task
// Duration; tools/cal.py picks the kept samples out of the op_summary CSV by
// chronological position, which is why the driver prints the exact launch
// counts it used.
//
// The eviction kernel is byte-identical to the one the earlier cold/warm
// matrix used (experiments/oj_known_config -> safe_driver -> gmmbenchcache
// ::Evict, 40 blocks, aclrtMemset 0x3d source, synchronize to completion
// before the target launch). Default size is 512 MiB, which is what
// experiments/oj_known_config/run.py's --evict meant; L2 on this part is
// 176160768 B = 168 MiB (hw.md), so 512 MiB is ~3x L2.
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
#include <stdexcept>

#include "acl/acl.h"
#include "judge_shim.h"
#include "kernel_operator.h"
#include "tiling/platform/platform_ascendc.h"

#include "kernel.asc"   // the submission, verbatim

// Benchmark-only cache-pressure workload; never part of a submission.
// Streaming over >L2 bytes is an eviction experiment, not a guaranteed flush.
namespace gmmbenchcache {
__global__ __vector__ void Evict(GM_ADDR source, GM_ADDR sink,
                                 uint64_t bytes, uint32_t cores) {
    using namespace AscendC;
    constexpr uint32_t CHUNK = 32768;
    TPipe pipe; TBuf<TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, CHUNK);
    auto local = buffer.Get<uint32_t>();
    GlobalTensor<uint32_t> src, dst;
    src.SetGlobalBuffer((__gm__ uint32_t*)source);
    dst.SetGlobalBuffer((__gm__ uint32_t*)sink);
    uint32_t checksum = 0;
    for (uint64_t offset = uint64_t(GetBlockIdx()) * CHUNK; offset < bytes;
         offset += uint64_t(cores) * CHUNK) {
        DataCopy(local, src[offset / 4], CHUNK / 4);
        SetFlag<HardEvent::MTE2_S>(0); WaitFlag<HardEvent::MTE2_S>(0);
        checksum += local.GetValue(0);
        SetFlag<HardEvent::S_MTE2>(0); WaitFlag<HardEvent::S_MTE2>(0);
    }
    dst.SetValue(GetBlockIdx(), checksum);
}
}

// A kernel that does nothing, to read the msprof per-task floor in each of the
// three regimes. One block, AIV, no UB, no DMA: whatever Task Duration it
// reports is pure launch-and-retire.
namespace gmmcal {
__global__ __vector__ void Nop() {}
}

namespace {

void must(aclError status, const char* what) {
    if (status != ACL_SUCCESS) {
        throw std::runtime_error(std::string(what) + " failed: " + std::to_string(status));
    }
}

std::vector<uint8_t> slurp(const std::string& path, size_t expect) {
    FILE* file = fopen(path.c_str(), "rb");
    if (!file) throw std::runtime_error("cannot open " + path);
    fseek(file, 0, SEEK_END);
    long size = ftell(file);
    fseek(file, 0, SEEK_SET);
    if (expect && size_t(size) != expect) {
        fclose(file);
        throw std::runtime_error(path + ": " + std::to_string(size) + " bytes, expected " +
                                 std::to_string(expect));
    }
    const size_t count = static_cast<size_t>(size);
    std::vector<uint8_t> bytes(count);
    if (fread(bytes.data(), 1, bytes.size(), file) != bytes.size()) {
        fclose(file);
        throw std::runtime_error("short read on " + path);
    }
    fclose(file);
    return bytes;
}

void* to_device(const std::vector<uint8_t>& host) {
    void* device = nullptr;
    must(aclrtMalloc(&device, host.size() ? host.size() : 32, ACL_MEM_MALLOC_HUGE_FIRST),
         "aclrtMalloc");
    if (host.size()) {
        must(aclrtMemcpy(device, host.size(), host.data(), host.size(),
                         ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy H2D");
    }
    return device;
}

} // namespace

int main(int argc, char** argv) {
    std::string dir, out_path, cache_mode = "hot", which = "prod";
    int device_id = 0, cores = 0, prime_ms = 600, warmup = 30, samples = 20;
    long long evict_mib = 512;
    for (int i = 1; i < argc; i++) {
        std::string arg = argv[i];
        auto next = [&]() -> const char* {
            if (i + 1 >= argc) { fprintf(stderr, "%s needs a value\n", arg.c_str()); exit(2); }
            return argv[++i];
        };
        if (arg == "--dir") dir = next();
        else if (arg == "--out") out_path = next();
        else if (arg == "--device") device_id = atoi(next());
        else if (arg == "--cores") cores = atoi(next());
        else if (arg == "--prime-ms") prime_ms = atoi(next());
        else if (arg == "--warmup") warmup = atoi(next());
        else if (arg == "--samples") samples = atoi(next());
        else if (arg == "--evict-mib") evict_mib = atoll(next());
        else if (arg == "--kernel") which = next();
        else if (arg == "--cache-mode") cache_mode = next();
        else { fprintf(stderr, "unknown argument %s\n", arg.c_str()); return 2; }
    }
    if (dir.empty()) {
        fprintf(stderr, "usage: cal_driver --dir <case dir> [--out y.bin] [--device 0]\n"
                        "       [--cores N] [--prime-ms 600] [--warmup 30] [--samples 20]\n"
                        "       [--cache-mode hot|evict] [--evict-mib 512] [--kernel prod|nop]\n");
        return 2;
    }
    if (cache_mode != "hot" && cache_mode != "evict") {
        fprintf(stderr, "--cache-mode must be hot or evict\n"); return 2;
    }
    if (which != "prod" && which != "nop") {
        fprintf(stderr, "--kernel must be prod or nop\n"); return 2;
    }
    if (samples < 1) { fprintf(stderr, "--samples must be >= 1\n"); return 2; }
    if (out_path.empty()) out_path = dir + "/out.bin";

    long long e = 0, m = 0, k = 0, n = 0, gt = 0;
    char dtype[32] = {0};
    {
        FILE* file = fopen((dir + "/shape.txt").c_str(), "r");
        if (!file) { fprintf(stderr, "cannot read %s/shape.txt\n", dir.c_str()); return 1; }
        if (fscanf(file, "%lld %lld %lld %lld %lld %31s", &e, &m, &k, &n, &gt, dtype) != 6) {
            fclose(file);
            fprintf(stderr, "%s/shape.txt is malformed\n", dir.c_str());
            return 1;
        }
        fclose(file);
    }
    const bool bf = strcmp(dtype, "bfloat16") == 0;
    const size_t wscale_bytes = bf ? 2 : 4;

    try {
        must(aclInit(nullptr), "aclInit");
        must(aclrtSetDevice(device_id), "aclrtSetDevice");
        aclrtStream stream = nullptr;
        must(aclrtCreateStream(&stream), "aclrtCreateStream");

        auto x_host = slurp(dir + "/x.bin", size_t(m) * k);
        auto w_host = slurp(dir + "/weight.bin", size_t(e) * k * n);
        auto xs_host = slurp(dir + "/xscale.bin", size_t(m) * 4);
        auto ws_host = slurp(dir + "/wscale.bin", size_t(e) * n * wscale_bytes);
        auto gl_host = slurp(dir + "/grouplist.bin", size_t(e) * 8);

        void* x = to_device(x_host);
        void* weight = to_device(w_host);
        void* xscale = to_device(xs_host);
        void* wscale = to_device(ws_host);
        void* grouplist = to_device(gl_host);
        const size_t y_bytes = size_t(m) * n * 2;
        void* y = nullptr;
        must(aclrtMalloc(&y, y_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc y");
        {
            std::vector<uint8_t> poison(y_bytes, 0xAB);
            must(aclrtMemcpy(y, y_bytes, poison.data(), y_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
                 "poison y");
        }

        // Cache pressure buffers, allocated only when asked for, so the hot arm
        // has exactly the same device memory footprint as harness/driver.asc.
        const uint64_t evict_bytes = uint64_t(evict_mib) * 1024ull * 1024ull;
        const uint32_t evict_cores = 40;
        void* ev_src = nullptr; void* ev_sink = nullptr;
        if (cache_mode == "evict") {
            must(aclrtMalloc(&ev_src, evict_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc evict");
            must(aclrtMalloc(&ev_sink, evict_cores * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST),
                 "aclrtMalloc evict sink");
            must(aclrtMemset(ev_src, evict_bytes, 0x3d, evict_bytes), "evict source fill");
            must(aclrtMemset(ev_sink, evict_cores * sizeof(uint32_t), 0,
                             evict_cores * sizeof(uint32_t)), "evict sink init");
        }

        const int64_t x_shape[2] = {m, k};
        const int64_t w_shape[3] = {e, k, n};
        const int64_t xs_shape[1] = {m};
        const int64_t ws_shape[2] = {e, n};
        const int64_t gl_shape[1] = {e};
        const int64_t y_shape[2] = {m, n};
        const TensorInfo x_info{2, x_shape, JUDGE_INT8};
        const TensorInfo w_info{3, w_shape, JUDGE_INT8};
        const TensorInfo xs_info{1, xs_shape, JUDGE_FLOAT32};
        const TensorInfo ws_info{2, ws_shape, bf ? JUDGE_BFLOAT16 : JUDGE_FLOAT32};
        const TensorInfo gl_info{1, gl_shape, JUDGE_INT64};
        const TensorInfo y_info{2, y_shape, bf ? JUDGE_BFLOAT16 : JUDGE_FLOAT16};
        const TensorGroupInfo gx{1, &x_info}, gw{1, &w_info}, gxs{1, &xs_info},
            gws{1, &ws_info}, ggl{1, &gl_info}, gy{1, &y_info};

        int64_t available = cores;
        if (available <= 0) {
            auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
            available = int64_t(platform->GetCoreNumAic());
        }

        // One launch, in whatever regime was asked for. Every launch in the
        // process goes through here, so prime, warmup and kept samples are
        // byte-for-byte the same sequence of device work.
        auto one = [&]() {
            if (ev_src) {
                gmmbenchcache::Evict<<<evict_cores, nullptr, stream>>>(
                    (GM_ADDR)ev_src, (GM_ADDR)ev_sink, evict_bytes, evict_cores);
                must(aclrtSynchronizeStream(stream), "evict synchronize");
            }
            if (which == "nop") {
                gmmcal::Nop<<<1, nullptr, stream>>>();
            } else {
                run_kernel((GM_ADDR)x, gx, (GM_ADDR)weight, gw, (GM_ADDR)xscale, gxs,
                           (GM_ADDR)wscale, gws, (GM_ADDR)grouplist, ggl, (GM_ADDR)y, gy,
                           available, stream, gt, dtype);
            }
            must(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        };

        long long primed = 0;
        if (prime_ms > 0) {
            auto start = std::chrono::steady_clock::now();
            double elapsed = 0;
            do {
                one();
                primed++;
                elapsed = std::chrono::duration<double, std::milli>(
                    std::chrono::steady_clock::now() - start).count();
            } while (elapsed < prime_ms);
        }
        for (int i = 0; i < warmup; i++) one();
        for (int i = 0; i < samples; i++) one();

        std::vector<uint8_t> y_host(y_bytes);
        must(aclrtMemcpy(y_host.data(), y_bytes, y, y_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
             "aclrtMemcpy D2H");
        FILE* out = fopen(out_path.c_str(), "wb");
        if (!out) throw std::runtime_error("cannot write " + out_path);
        fwrite(y_host.data(), 1, y_host.size(), out);
        fclose(out);

        // The parser needs these three numbers to find the kept samples by
        // position, and the eviction count to check every target had one.
        printf("CAL kernel=%s mode=%s evict_mib=%lld cores=%lld "
               "prime=%lld warmup=%d samples=%d launches=%lld\n",
               which.c_str(), cache_mode.c_str(), ev_src ? evict_mib : 0LL,
               (long long)available, primed, warmup, samples,
               primed + warmup + samples);
        printf("CAL shape E=%lld M=%lld K=%lld N=%lld gt=%lld %s -> %s\n",
               e, m, k, n, gt, dtype, out_path.c_str());

        if (ev_src) { aclrtFree(ev_src); aclrtFree(ev_sink); }
        aclrtFree(x); aclrtFree(weight); aclrtFree(xscale);
        aclrtFree(wscale); aclrtFree(grouplist); aclrtFree(y);
        aclrtDestroyStream(stream);
        aclrtResetDevice(device_id);
        aclFinalize();
    } catch (const std::exception& error) {
        fprintf(stderr, "cal_driver: %s\n", error.what());
        return 1;
    }
    return 0;
}
