namespace gmmptq {

// Full-K cube body: one AIC tile-walks (expert, m-block, n-tile), accumulating
// the whole K in L0C in one pass, and stages int32 partials to GM; the paired
// AIVs read a staged tile back and apply the per-channel and per-token scales.
//
// Every cube variant we ship is this body under a different set of policy
// knobs, so the knobs are template parameters rather than four copies:
//
//   BM/BN/BK  tile shape; RV is the AIV row batch inside a BM block.
//   NMajor    walk n-tiles outermost, so B stays resident instead of A.
//   Prefetch  double-buffer B in L1 and issue tile t+1's load with tile t.
//   SingleL0  one L0A/L0B buffer instead of two (frees room for a larger BK).
//   PreXS     hoist the per-token scale load out of the RV loop.
//   Parts     how many AIVs split one BM block (1 or 2).
//   StaticNoPipe  skip TPipe and address L1/L0/UB at fixed offsets.
//   StreamB   load B one BK slab at a time instead of all of K up front.
//   P2TwoStripe   two-bank UB stripe with flattened scale multiplies.
//   Panel     stage `Panel` consecutive n-tiles of B together and reuse them
//             across those tiles (0 keeps the per-tile B policy above).
//   UnitFlagChain  hand MMAD results to FIXPIPE with unit flags instead of
//             explicit FIX_M/M_FIX barriers; needs the row-major MM config.
//   TilePipe  alternate the L0A/L0B half across tiles rather than restarting
//             each tile at half 0, so a tile stages its operands while the
//             previous tile is still multiplying, and skip the end-of-tile
//             MTE1-MTE2 barrier when no new L1 staging DMA follows.
template <typename ScaleT, typename OutT, uint32_t BM, uint32_t BN, uint32_t BK,
          uint32_t RV, bool NMajor = false, bool Prefetch = false,
          bool SingleL0 = false, bool PreXS = false, uint32_t Parts = 2u,
          bool StaticNoPipe = false, bool StreamB = false, bool P2TwoStripe = false,
          uint32_t Panel = 0u, bool UnitFlagChain = false, bool TilePipe = false>
__aicore__ inline void CubeFullKBody(GM_ADDR xGm, GM_ADDR wGm, GM_ADDR xsGm,
                                     GM_ADDR wsGm, GM_ADDR glGm, GM_ADDR yGm,
                                     GM_ADDR stGm, Plan p) {
  using namespace AscendC;
  static_assert(BM > 0 && BM % 16 == 0, "BM must align to the M fractile");
  static_assert(BN > 0 && BN % 32 == 0, "BN must align to int8 transpose pairs");
  static_assert(BK > 0 && BK % 32 == 0, "BK must align to int8 K fractiles");
  static_assert(RV > 0 && RV <= BM && RV % 8 == 0, "RV must align Brcb rows");
  static_assert(sizeof(OutT) == 2, "The output must be fp16 or bf16");
  static_assert(!(NMajor && Prefetch), "B prefetch is for M-major traversal");
  static_assert(!PreXS || (!NMajor && BM > 32u && BM != 208u && RV >= (BM + 1u) / 2u),
                "PreXS requires M-major early-scale placement and one AIV batch");
  static_assert(BM * BK * (SingleL0 ? 1u : 2u) <= L0A_BYTES, "L0A overflow");
  static_assert(BN * BK * (SingleL0 ? 1u : 2u) <= L0B_BYTES, "L0B overflow");
  static_assert(BM * BN * sizeof(int32_t) <= L0C_BYTES, "L0C overflow");
  static_assert(
      !P2TwoStripe || (BM == 96u && BN == 128u && BK == 256u && RV == 96u && !NMajor &&
                       !Prefetch && SingleL0 && PreXS && Parts == 1u && StreamB),
      "P2TwoStripe requires the original P2 resource policy");
  static_assert(!Panel || (!Prefetch && !StreamB),
                "panel residency replaces the per-tile B load policies");
  constexpr uint32_t PITCH = BN;
  constexpr uint32_t UB_USED = RV * PITCH * 10u + PITCH * 8u + RV * 36u;
  static_assert(UB_USED <= 192u * 1024u - 8192u - 256u, "UB overflow");
  const uint32_t nTiles = (p.n + BN - 1u) / BN;
  GlobalTensor<int64_t> list;
  list.SetGlobalBuffer((__gm__ int64_t*)glGm);
  Schedule sched{list, p.listType, p.e, BM, nTiles};
  const uint32_t total = sched.Total();
  typename FullKPipeType<StaticNoPipe>::Type pipe;
  if ASCEND_IS_AIC {
    const uint32_t physicalAic = GetBlockIdx();
    const uint32_t aic = (P2TwoStripe && p.cores % 7u != 0u)
                             ? (physicalAic * 7u) % p.cores
                             : physicalAic;
    const uint32_t first = uint32_t(uint64_t(total) * aic / p.cores);
    const uint32_t last = uint32_t(uint64_t(total) * (aic + 1u) / p.cores);
    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<int32_t> stg;
    xg.SetGlobalBuffer((__gm__ int8_t*)xGm);
    wg.SetGlobalBuffer((__gm__ int8_t*)wGm);
    stg.SetGlobalBuffer((__gm__ int32_t*)stGm);
    typename FullKBufferType<StaticNoPipe, TPosition::A1>::Type l1Buf;
    typename FullKBufferType<StaticNoPipe, TPosition::A2>::Type l0aBuf;
    typename FullKBufferType<StaticNoPipe, TPosition::B2>::Type l0bBuf;
    typename FullKBufferType<StaticNoPipe, TPosition::CO1>::Type l0cBuf;
    InitCubeBuffers<StaticNoPipe>(l1Buf, l0aBuf, l0bBuf, l0cBuf);
    pipe.Destroy();
    LocalTensor<int8_t> l1 = l1Buf.template Get<int8_t>();
    LocalTensor<int8_t> l0a = l0aBuf.template Get<int8_t>();
    LocalTensor<int8_t> l0b = l0bBuf.template Get<int8_t>();
    LocalTensor<int32_t> l0c = l0cBuf.template Get<int32_t>();
    if constexpr (UnitFlagChain) {
      SetFixPipeConfig<uint64_t>(l0c.ReinterpretCast<uint64_t>(), true);
      Barrier<HardEvent::FIX_M>();
      SetMMRowMajor();
    }
    const uint32_t aBytes = BM * p.kl;
    const uint32_t bBytes = p.kl * BN;
    LocalTensor<int8_t> l1a = l1;
    LocalTensor<int8_t> l1b0 = l1[aBytes];
    LocalTensor<int8_t> l1b1 = l1[aBytes + (Prefetch ? bBytes : 0u)];
    if constexpr (!SingleL0) {
      SetFlag<HardEvent::M_MTE1>(1);
      SetFlag<HardEvent::M_MTE1>(2);
    }
    uint32_t heldAExpert = 0xffffffffu, heldM = 0xffffffffu;
    uint32_t heldBExpert = 0xffffffffu, heldN = 0xffffffffu;
    // Counts K slabs across the whole tile walk, not within one tile, so the
    // L0A/L0B half keeps alternating from one tile to the next.
    uint32_t kctr = 0;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      const uint32_t value = uint32_t(list.GetValue(e));
      const uint32_t end = p.listType == 0 ? value : start + value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t mBlocks = (rows + BM - 1u) / BM;
      const uint32_t count = mBlocks * nTiles;
      if (acc + count > first) {
        const uint32_t lo = first > acc ? first - acc : 0u;
        const uint32_t hi = Min(count, last - acc);
        for (uint32_t t = lo; t < hi; ++t) {
          const uint16_t tileId = uint16_t((acc + t - first) & 3u);
          if (acc + t - first >= 4u) CrossCoreWaitFlag(uint16_t(4u + tileId));
          const CubeTile tile =
              CubeTile::Of<BM, BN, NMajor>(t, mBlocks, nTiles, start, rows, p.n);
          const uint32_t gRow = tile.gRow, mt = tile.mt;
          const uint32_t nOff = tile.nOff, nt = tile.nt;
          const bool reuseA = e == heldAExpert && tile.mIdx == heldM;
          const bool reuseB =
              e == heldBExpert &&
              (Panel ? tile.nIdx / Panel == heldN / Panel : tile.nIdx == heldN);
          // A fresh L1 staging DMA may not overtake the previous tile's L0 loads;
          // when both panels are reused there is no DMA, so no barrier either.
          if constexpr (TilePipe && !Prefetch) {
            if (!reuseA || !reuseB) Barrier<HardEvent::MTE1_MTE2>();
          }
          // A is loaded before B unless StreamB wants the first B slab first.
          if constexpr (!StreamB) {
            if (!reuseA) LoadAPanel(l1a, xg, gRow, mt, p.k, BM);
          }
          LocalTensor<int8_t> l1b = l1b0;
          Nd2NzParams bp;
          bp.ndNum = 1;
          bp.dstNzNStride = 1;
          bp.srcNdMatrixStride = 0;
          bp.dstNzMatrixStride = 0;
          bp.srcDValue = uint16_t(p.wstride);
          bp.dstNzC0Stride = uint16_t(p.kl);
          if constexpr (Panel) {
            // One DataCopy brings in `Panel` n-tiles; the tile picks its slice.
            const uint32_t panelOff = (tile.nIdx / Panel) * BN * Panel;
            l1b = l1b0[(tile.nIdx % Panel) * BN * p.kl];
            bp.nValue = uint16_t(p.k);
            bp.dValue = uint16_t(Min(BN * Panel, p.n - panelOff));
            if (!reuseB)
              DataCopy(l1b0, wg[uint64_t(e) * p.k * p.wstride + panelOff], bp);
          } else {
            if constexpr (Prefetch) l1b = ((t - lo) & 1u) ? l1b1 : l1b0;
            bp.nValue = uint16_t(StreamB ? Min(BK, p.k) : p.k);
            bp.dValue = uint16_t(nt);
            const bool wantB = Prefetch ? t == lo : !reuseB;
            if (wantB) DataCopy(l1b, wg[uint64_t(e) * p.k * p.wstride + nOff], bp);
          }
          if constexpr (StreamB) {
            if (!reuseA) LoadAPanel(l1a, xg, gRow, mt, p.k, BM);
          }
          Barrier<HardEvent::MTE2_MTE1>();
          if constexpr (Prefetch) {
            if (t + 1u < hi) {
              LocalTensor<int8_t> nextB = ((t - lo) & 1u) ? l1b0 : l1b1;
              const uint32_t nextNOff = ((t + 1u) % nTiles) * BN;
              Nd2NzParams nextBp = bp;
              nextBp.dValue = uint16_t(Min(BN, p.n - nextNOff));
              DataCopy(nextB, wg[uint64_t(e) * p.k * p.wstride + nextNOff], nextBp);
            }
          }
          bool firstK = true;
          for (uint32_t ks = 0; ks < p.k; ks += BK) {
            if constexpr (StreamB) {
              if (ks > 0u) Barrier<HardEvent::MTE2_MTE1>();
              if (!reuseB && ks + BK < p.k) {
                Nd2NzParams nextBp = bp;
                nextBp.nValue = uint16_t(Min(BK, p.k - ks - BK));
                DataCopy(l1b[(ks + BK) * C0_I8],
                         wg[uint64_t(e) * p.k * p.wstride +
                            uint64_t(ks + BK) * p.wstride + nOff],
                         nextBp);
              }
            }
            const uint32_t kstep = Min(BK, p.k - ks);
            const uint32_t half =
                SingleL0 ? 0u : ((TilePipe ? kctr : (ks / BK)) & 1u);
            if constexpr (!SingleL0) WaitFlag<HardEvent::M_MTE1>(half + 1u);
            LocalTensor<int8_t> a = l0a[half * BM * BK];
            LocalTensor<int8_t> b = l0b[half * BK * BN];
            const uint32_t kFrac = Up(kstep, C0_I8) / C0_I8;
            LoadTileToL0<BM>(a, b, l1a, l1b, ks, mt, nt, kFrac, p.kl);
            Barrier<HardEvent::MTE1_M>();
            MmadParams mp;
            mp.m = uint16_t(Up(mt, ROW_FRAC));
            mp.n = uint16_t(Up(nt, C0_I8));
            mp.k = uint16_t(kstep);
            mp.cmatrixInitVal = firstK;
            if constexpr (UnitFlagChain) {
              mp.unitFlag = (ks + BK >= p.k) ? 3u : 2u;
            } else {
              mp.unitFlag = 0;
              if (firstK) Barrier<HardEvent::FIX_M>();
            }
            Mmad(l0c, a, b, mp);
            if ((uint32_t(mp.m) / 16u) * (uint32_t(mp.n) / 16u) < 10u)
              PipeBarrier<PIPE_M>();
            if constexpr (SingleL0)
              Barrier<HardEvent::M_MTE1>();
            else
              SetFlag<HardEvent::M_MTE1>(half + 1u);
            firstK = false;
            ++kctr;
          }
          if constexpr (!TilePipe || Prefetch) Barrier<HardEvent::MTE1_MTE2>();
          heldAExpert = e;
          heldM = tile.mIdx;
          heldBExpert = e;
          heldN = tile.nIdx;
          if constexpr (!UnitFlagChain) Barrier<HardEvent::M_FIX>();
          FixpipeParamsV220 fp;
          fp.nSize = uint16_t(UnitFlagChain ? Up(nt, C0_I8) : nt);
          fp.mSize = uint16_t(UnitFlagChain ? Up(mt, ROW_FRAC) : mt);
          fp.srcStride = uint16_t(Up(mt, ROW_FRAC));
          fp.dstStride = BN;
          fp.quantPre = QuantMode_t::NoQuant;
          fp.reluEn = false;
          fp.unitFlag = UnitFlagChain ? 3u : 0u;
          const uint64_t base = uint64_t(acc + t) * BM * BN;
          Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(stg[base], l0c, fp);
          CrossCoreSetFlag<2, PIPE_FIX>(tileId);
        }
      }
      acc += count;
      start = end;
    }
    const uint32_t owned = last - first;
    for (uint32_t q = owned > 4u ? owned - 4u : owned; q < owned; ++q)
      CrossCoreWaitFlag(uint16_t(4u + (q & 3u)));
    if constexpr (!SingleL0) {
      WaitFlag<HardEvent::M_MTE1>(1);
      WaitFlag<HardEvent::M_MTE1>(2);
    }
    if constexpr (UnitFlagChain) {
      Barrier<HardEvent::FIX_M>();
      SetMMColumnMajor();
    }
  } else {
    const uint32_t physicalAic = GetBlockIdx() / GetTaskRation();
    const uint32_t aic = (P2TwoStripe && p.cores % 7u != 0u)
                             ? (physicalAic * 7u) % p.cores
                             : physicalAic;
    const uint32_t sub = GetSubBlockIdx();
    const uint32_t first = uint32_t(uint64_t(total) * aic / p.cores);
    const uint32_t last = uint32_t(uint64_t(total) * (aic + 1u) / p.cores);
    GlobalTensor<int32_t> stg;
    GlobalTensor<float> xsg;
    GlobalTensor<ScaleT> wsg;
    GlobalTensor<OutT> yg;
    stg.SetGlobalBuffer((__gm__ int32_t*)stGm);
    xsg.SetGlobalBuffer((__gm__ float*)xsGm);
    wsg.SetGlobalBuffer((__gm__ ScaleT*)wsGm);
    yg.SetGlobalBuffer((__gm__ OutT*)yGm);
    typename FullKBufferType<StaticNoPipe, TPosition::VECCALC>::Type ub;
    if constexpr (StaticNoPipe)
      ub.bytes = UB_USED;
    else
      GetTPipePtr()->InitBuffer(ub, UB_USED);
    pipe.Destroy();
    LocalTensor<uint8_t> raw = ub.template Get<uint8_t>();
    uint32_t off = 0;
    LocalTensor<int32_t> accI = raw[off].ReinterpretCast<int32_t>();
    off += RV * PITCH * 4u;
    LocalTensor<float> accF = raw[off].ReinterpretCast<float>();
    off += RV * PITCH * 4u;
    LocalTensor<OutT> out = raw[off].ReinterpretCast<OutT>();
    off += RV * PITCH * 2u;
    LocalTensor<ScaleT> wsl = raw[off].ReinterpretCast<ScaleT>();
    off += PITCH * 4u;
    LocalTensor<float> wsf = raw[off].ReinterpretCast<float>();
    off += PITCH * 4u;
    LocalTensor<float> xsl = raw[off].ReinterpretCast<float>();
    off += RV * 4u;
    LocalTensor<float> xsb = raw[off].ReinterpretCast<float>();
    if constexpr (P2TwoStripe) {
      SetFlag<HardEvent::MTE3_MTE2>(1);
      SetFlag<HardEvent::MTE3_MTE2>(2);
    }
    uint32_t heldScaleExpert = 0xffffffffu, heldScaleN = 0xffffffffu;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      const uint32_t value = uint32_t(list.GetValue(e));
      const uint32_t end = p.listType == 0 ? value : start + value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t mBlocks = (rows + BM - 1u) / BM;
      const uint32_t count = mBlocks * nTiles;
      if (acc + count > first) {
        const uint32_t lo = first > acc ? first - acc : 0u;
        const uint32_t hi = Min(count, last - acc);
        for (uint32_t t = lo; t < hi; ++t) {
          const uint16_t tileId = uint16_t((acc + t - first) & 3u);
          const CubeTile tile =
              CubeTile::Of<BM, BN, NMajor>(t, mBlocks, nTiles, start, rows, p.n);
          const uint32_t gRow = tile.gRow, mt = tile.mt;
          const uint32_t nOff = tile.nOff, nt = tile.nt;
          const uint64_t base = uint64_t(acc + t) * BM * BN;
          // Narrow BM blocks claim the staged tile before touching the scales;
          // wide ones overlap the scale load with the cube still working.
          if constexpr (BM <= 32 || BM == 208) {
            CrossCoreWaitFlag(tileId);
            if (last - first > 4u)
              CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
          }
          const uint32_t half = (mt + Parts - 1u) / Parts;
          const uint32_t r0 = Min(sub * half, mt);
          const uint32_t r1 = Min((sub + 1u) * half, mt);
          if (r0 < r1 && (!NMajor || heldScaleExpert != e || heldScaleN != tile.nIdx)) {
            heldScaleExpert = e;
            heldScaleN = tile.nIdx;
            DataCopyPad(wsl, wsg[uint64_t(e) * p.n + nOff],
                        DataCopyExtParams{1, uint32_t(nt * sizeof(ScaleT)), 0, 0, 0},
                        DataCopyPadExtParams<ScaleT>{false, 0, 0, 0});
            if constexpr (PreXS) {
              DataCopyPad(xsl, xsg[gRow + r0],
                          DataCopyExtParams{1, (r1 - r0) * 4u, 0, 0, 0},
                          DataCopyPadExtParams<float>{false, 0, 0, 0});
            }
            Barrier<HardEvent::MTE2_V>();
            ToFloat<ScaleT>(wsf, wsl, nt);
            if constexpr (PreXS) {
              BrcbRepeatParams br;
              br.dstBlkStride = 1;
              br.dstRepStride = 8;
              Brcb(xsb, xsl, uint8_t((r1 - r0 + 7u) / 8u), br);
            }
            PipeBarrier<PIPE_V>();
            if constexpr (P2TwoStripe) {
              // Splat the channel scales across the stripe rows once, so the
              // per-row multiply below can run flat over 64-element repeats.
              LocalTensor<uint16_t> wmU16 = out.template ReinterpretCast<uint16_t>();
              LocalTensor<uint16_t> wsU16 = wsf.template ReinterpretCast<uint16_t>();
              BinaryRepeatParams copyScale;
              copyScale.dstBlkStride = 1;
              copyScale.src0BlkStride = 1;
              copyScale.src1BlkStride = 1;
              copyScale.dstRepStride = 16;
              copyScale.src0RepStride = 0;
              copyScale.src1RepStride = 0;
              for (uint32_t c = 0; c < nt; c += 64u)
                Or(wmU16[c * 2u], wsU16[c * 2u], wsU16[c * 2u],
                   uint64_t(Min(128u, 2u * (nt - c))), uint8_t((mt + 1u) / 2u),
                   copyScale);
            }
          }
          if constexpr (BM > 32 && BM != 208) {
            CrossCoreWaitFlag(tileId);
            if (last - first > 4u)
              CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
          }
          if constexpr (P2TwoStripe) {
            constexpr uint32_t BANK_ROWS = 48u;
            LocalTensor<int32_t> accIBase = accI;
            LocalTensor<float> accFBase = accF;
            LocalTensor<float> wm = out.template ReinterpretCast<float>();
            LocalTensor<OutT> outBase = accI.template ReinterpretCast<OutT>();
            const uint32_t ntr = Up(nt, F32_PER_BLK);
            const uint32_t stripeRows = (mt + 1u) / 2u;
            const uint32_t activeBanks = mt > stripeRows ? 2u : 1u;
            for (uint32_t bank = 0; bank < activeBanks; ++bank) {
              const uint32_t row = bank * stripeRows;
              const uint32_t nr = Min(stripeRows, mt - row);
              const uint16_t event = uint16_t(bank + 1u);
              WaitFlag<HardEvent::MTE3_MTE2>(event);
              DataCopyPad(accIBase[bank * BANK_ROWS * PITCH],
                          stg[base + uint64_t(row) * BN],
                          DataCopyExtParams{uint16_t(nr), nt * 4u, (BN - nt) * 4u,
                                            (PITCH - ntr) / F32_PER_BLK, 0},
                          DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
              SetFlag<HardEvent::MTE2_V>(event);
            }
            for (uint32_t bank = 0; bank < activeBanks; ++bank) {
              const uint32_t row = bank * stripeRows;
              const uint32_t nr = Min(stripeRows, mt - row);
              const uint16_t event = uint16_t(bank + 1u);
              LocalTensor<int32_t> accI = accIBase[bank * BANK_ROWS * PITCH];
              LocalTensor<float> accF = accFBase[bank * BANK_ROWS * PITCH];
              LocalTensor<OutT> out = outBase[bank * BANK_ROWS * PITCH * 2u];
              WaitFlag<HardEvent::MTE2_V>(event);
              Cast(accF, accI, RoundMode::CAST_RINT, nr * PITCH);
              PipeBarrier<PIPE_V>();
              BinaryRepeatParams flatScale;
              flatScale.dstBlkStride = 1;
              flatScale.src0BlkStride = 1;
              flatScale.src1BlkStride = 1;
              flatScale.dstRepStride = 8;
              flatScale.src0RepStride = 8;
              flatScale.src1RepStride = 8;
              Mul(accF, accF, wm, uint64_t(64), uint8_t(nr * 2u), flatScale);
              PipeBarrier<PIPE_V>();
              MulByTokenScale(accF, xsb[row * 8u], nr, nt, PITCH);
              PipeBarrier<PIPE_V>();
              Cast(out, accF, RoundMode::CAST_RINT, nr * PITCH);
              SetFlag<HardEvent::V_MTE3>(event);
              WaitFlag<HardEvent::V_MTE3>(event);
              StoreRows(yg[uint64_t(gRow + row) * p.n + nOff], out, nr, nt, PITCH, p.n);
              SetFlag<HardEvent::MTE3_MTE2>(event);
            }
            Barrier<HardEvent::V_MTE2>();
          } else {
            const uint32_t ntr = Up(nt, F32_PER_BLK);
            for (uint32_t r = r0; r < r1; r += RV) {
              const uint32_t nr = Min(RV, r1 - r);
              DataCopyPad(accI, stg[base + uint64_t(r) * BN],
                          DataCopyExtParams{uint16_t(nr), nt * 4u, (BN - nt) * 4u,
                                            (PITCH - ntr) / F32_PER_BLK, 0},
                          DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
              if constexpr (!PreXS) {
                DataCopyPad(xsl, xsg[gRow + r], DataCopyExtParams{1, nr * 4u, 0, 0, 0},
                            DataCopyPadExtParams<float>{false, 0, 0, 0});
              }
              Barrier<HardEvent::MTE2_V>();
              Cast(accF, accI, RoundMode::CAST_RINT, nr * PITCH);
              if constexpr (!PreXS) {
                BrcbRepeatParams br;
                br.dstBlkStride = 1;
                br.dstRepStride = 8;
                Brcb(xsb, xsl, uint8_t((nr + 7u) / 8u), br);
              }
              PipeBarrier<PIPE_V>();
              MulByRow(accF, accF, wsf, nr, nt, PITCH);
              PipeBarrier<PIPE_V>();
              MulByTokenScale(accF, xsb, nr, nt, PITCH);
              PipeBarrier<PIPE_V>();
              Barrier<HardEvent::MTE3_V>();
              Cast(out, accF, RoundMode::CAST_RINT, nr * PITCH);
              Barrier<HardEvent::V_MTE3>();
              StoreRows(yg[uint64_t(gRow + r) * p.n + nOff], out, nr, nt, PITCH, p.n);
              Barrier<HardEvent::V_MTE2>();
            }
          }
        }
      }
      acc += count;
      start = end;
    }
    if constexpr (P2TwoStripe) {
      WaitFlag<HardEvent::MTE3_MTE2>(1);
      WaitFlag<HardEvent::MTE3_MTE2>(2);
    }
    Barrier<HardEvent::MTE3_S>();
  }
}

}  // namespace gmmptq
