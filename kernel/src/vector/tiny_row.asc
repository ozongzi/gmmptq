namespace gmmptq {

// Row-parallel tiny kernels: M <= 4, N <= 32, K <= 8, one AIV block per token.
//
// The whole row's work is a handful of int8 multiplies, so the block reads the
// operands with GetValue, accumulates in scalar registers, and writes its row.
//
//   SingleExpert  E == 1, so there is no group list to scan.
//   Direct        pack the row's 16-bit results into a register and store them
//                 with WriteGmByPassDCache, instead of staging through UB and
//                 issuing a DataCopyPad. Worth it only when the whole row fits
//                 one aligned 32-bit (or 16-bit) store, which the dispatcher
//                 checks before picking this variant.
template <typename ScaleT, typename OutT, bool SingleExpert, bool Direct>
__global__ __aicore__ void TinyRowKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                         GM_ADDR groups, GM_ADDR y, uint32_t packed) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const GeneralVectorDims s = UnpackTinyDims(packed);
  using namespace AscendC;
  PreloadOperands<!SingleExpert>(x, w, xs, ws, groups);
  const uint32_t m = GetBlockIdx();
  uint32_t owner = 0;
  if constexpr (!SingleExpert) {
    GlobalTensor<int64_t> gg;
    gg.SetGlobalBuffer((__gm__ int64_t*)groups);
    owner = OwnerOfRow(gg, s.e, s.listType, m);
  }
  TinyOperands<ScaleT, OutT> t;
  t.Bind(x, w, xs, ws, groups, y);
  if constexpr (!Direct) InitSocState();
  LocalTensor<float> f(TPosition::VECCALC, 0, 32);
  LocalTensor<OutT> out(TPosition::VECCALC, 128, 32);
  uint32_t encodedRow = 0;
  const float row = t.xsg.GetValue(m);
  for (uint32_t n = 0; n < s.n; ++n) {
    const int32_t sum = TinyDot(t.xg, t.wg, m, owner, n, s.k, s.n);
    const float scale = WeightScaleAt<ScaleT>(ws, uint64_t(owner) * s.n + n);
    const float value = float(sum) * scale * row;
    if constexpr (Direct)
      encodedRow |= uint32_t(GvEncode<sizeof(ScaleT) == 2>(value)) << (16 * n);
    else
      f.SetValue(n, value);
  }
  if constexpr (Direct) {
    if (s.n == 1)
      WriteGmByPassDCache(reinterpret_cast<__gm__ uint16_t*>(y) + m,
                          uint16_t(encodedRow));
    else
      WriteGmByPassDCache(reinterpret_cast<__gm__ uint32_t*>(y) + m, encodedRow);
    DataSyncBarrier<MemDsbT::DDR>();
  } else {
    GvBarrier<HardEvent::S_V>();
    Cast(out, f, RoundMode::CAST_RINT, s.n);
    GvBarrier<HardEvent::V_MTE3>();
    DataCopyPad(t.yg[uint64_t(m) * s.n], out,
                DataCopyExtParams{1, s.n * sizeof(OutT), 0, 0, 0});
    PipeBarrier<PIPE_ALL>();
  }
}

// Same arithmetic when there are more tokens than the core budget allows: each
// block strides through its share of the rows. Each in-flight row owns its own
// UB slot and event id, so the stores of one row overlap the next row's work.
template <typename ScaleT, typename OutT>
__global__ __aicore__ void TinyRowStrided(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                          GM_ADDR groups, GM_ADDR y, uint32_t packed) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const GeneralVectorDims s = UnpackTinyDims(packed);
  using namespace AscendC;
  PreloadOperands<true>(x, w, xs, ws, groups);
  InitSocState();
  const uint32_t first = GetBlockIdx(), blocks = GetBlockNum();
  for (uint32_t m = first, slot = 0; m < s.m; m += blocks, ++slot) {
    GlobalTensor<int64_t> gg;
    gg.SetGlobalBuffer((__gm__ int64_t*)groups);
    const uint32_t owner = OwnerOfRow(gg, s.e, s.listType, m);
    TinyOperands<ScaleT, OutT> t;
    t.Bind(x, w, xs, ws, groups, y);
    LocalTensor<float> f(TPosition::VECCALC, slot * 192, 32);
    LocalTensor<OutT> out(TPosition::VECCALC, slot * 192 + 128, 32);
    const float row = t.xsg.GetValue(m);
    for (uint32_t n = 0; n < s.n; ++n) {
      const int32_t sum = TinyDot(t.xg, t.wg, m, owner, n, s.k, s.n);
      const float scale = WeightScaleAt<ScaleT>(ws, uint64_t(owner) * s.n + n);
      f.SetValue(n, float(sum) * scale * row);
    }
    SetFlag<HardEvent::S_V>(static_cast<event_t>(slot));
    WaitFlag<HardEvent::S_V>(static_cast<event_t>(slot));
    Cast(out, f, RoundMode::CAST_RINT, s.n);
    SetFlag<HardEvent::V_MTE3>(static_cast<event_t>(slot));
    WaitFlag<HardEvent::V_MTE3>(static_cast<event_t>(slot));
    DataCopyPad(t.yg[uint64_t(m) * s.n], out,
                DataCopyExtParams{1, s.n * sizeof(OutT), 0, 0, 0});
  }
  PipeBarrier<PIPE_ALL>();
}

// N == 1 with many experts: the row's own scale is read before the owner scan
// so that load is in flight during the scan, and the scan starts from whichever
// end of the group list is closer to this row.
template <typename ScaleT, typename OutT>
__global__ __aicore__ void TinyRowBisectDirect(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                               GM_ADDR ws, GM_ADDR groups, GM_ADDR y,
                                               uint32_t packed) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  GeneralVectorDims s = UnpackTinyDims(packed);
  s.n = 1u;
  using namespace AscendC;
  PreloadOperands<true>(x, w, xs, ws, groups);
  const uint32_t m = GetBlockIdx();
  uint32_t owner = 0, start = 0;
  GlobalTensor<float> earlyXs;
  earlyXs.SetGlobalBuffer((__gm__ float*)xs);
  const float row = earlyXs.GetValue(m);
  GlobalTensor<int64_t> gg;
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  if (m * 2u >= s.m) {
    uint32_t end = s.m;
    owner = 0u;
    for (uint32_t e = s.e - 1u; e > 0u; --e) {
      const uint32_t begin = s.listType == 0 ? uint32_t(gg.GetValue(e - 1u))
                                             : end - uint32_t(gg.GetValue(e));
      if (m >= begin) {
        owner = e;
        break;
      }
      end = begin;
    }
  } else {
    owner = s.e - 1u;
    for (uint32_t e = 0; e + 1u < s.e; ++e) {
      const uint32_t v = uint32_t(gg.GetValue(e));
      const uint32_t end = s.listType == 0 ? v : start + v;
      if (m < end) {
        owner = e;
        break;
      }
      start = end;
    }
  }
  TinyOperands<ScaleT, OutT> t;
  t.Bind(x, w, xs, ws, groups, y);
  uint32_t encodedRow = 0;
  for (uint32_t n = 0; n < s.n; ++n) {
    const float scale = WeightScaleAt<ScaleT>(ws, uint64_t(owner) * s.n + n);
    const int32_t sum = TinyDot(t.xg, t.wg, m, owner, n, s.k, s.n);
    encodedRow |= uint32_t(GvEncode<sizeof(ScaleT) == 2>(float(sum) * scale * row))
                  << (16 * n);
  }
  if (s.n == 1)
    WriteGmByPassDCache(reinterpret_cast<__gm__ uint16_t*>(y) + m,
                        uint16_t(encodedRow));
  else
    WriteGmByPassDCache(reinterpret_cast<__gm__ uint32_t*>(y) + m, encodedRow);
  DataSyncBarrier<MemDsbT::DDR>();
}

}  // namespace gmmptq
