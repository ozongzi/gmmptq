namespace tiny_capacity_unrolled {
using namespace gmmptq;
using namespace AscendC;

// Capacity-bounded tiny kernels: the entire problem is a handful of bytes.
//
// At M*K <= 8 and K*N <= 8 even a DataCopyPad is too much machinery, so these
// load each operand as one scalar word of a compile-time width, do the
// arithmetic with shifts and multiplies, and store the output as one word. The
// Select functions below turn the runtime shape into the matching
// instantiation; every combination the dispatcher can reach has one.
template <uint32_t Cap>
__aicore__ inline uint64_t Load(GM_ADDR p, uint32_t bytes) {
  if (bytes == 0u) return 0u;
  if constexpr (Cap == 1u)
    return uint64_t(*(__gm__ uint8_t*)p);
  else {
    if (bytes == Cap && (reinterpret_cast<uintptr_t>(p) & (Cap - 1u)) == 0u) {
      if constexpr (Cap == 8u)
        return *(__gm__ uint64_t*)p;
      else if constexpr (Cap == 4u)
        return *(__gm__ uint32_t*)p;
      else
        return *(__gm__ uint16_t*)p;
    }
    constexpr uint32_t Half = Cap / 2u;
    uint64_t lo = Load<Half>(p, Min(bytes, Half));
    if (bytes > Half) lo |= Load<Half>(p + Half, bytes - Half) << (Half * 8u);
    return lo;
  }
}
template <uint32_t Cap>
__aicore__ inline void Store(GM_ADDR p, uint64_t bits, uint32_t bytes) {
  if (bytes == 0u) return;
  if constexpr (Cap == 2u)
    WriteGmByPassDCache((__gm__ uint16_t*)p, uint16_t(bits));
  else {
    if (bytes == Cap && (reinterpret_cast<uintptr_t>(p) & (Cap - 1u)) == 0u) {
      if constexpr (Cap == 8u)
        WriteGmByPassDCache((__gm__ uint64_t*)p, bits);
      else
        WriteGmByPassDCache((__gm__ uint32_t*)p, uint32_t(bits));
    } else {
      constexpr uint32_t Half = Cap / 2u;
      Store<Half>(p, bits, Min(bytes, Half));
      if (bytes > Half) Store<Half>(p + Half, bits >> (Half * 8u), bytes - Half);
    }
  }
}
__aicore__ inline float F(uint32_t u) {
  union {
    uint32_t u;
    float f;
  } v;
  v.u = u;
  return v.f;
}
__aicore__ inline int32_t S(uint64_t u, uint32_t i) {
  return int32_t(int8_t((u >> (i * 8u)) & 255u));
}
template <bool BF, uint32_t KC, uint32_t NC, bool Full, bool Single>
__aicore__ inline void Rows(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR y,
                            uint32_t m, uint32_t actualK, uint32_t actualN,
                            uint32_t owners) {
  constexpr uint32_t MC =
      (4u < 8u / KC ? 4u : 8u / KC) < 8u / NC ? (4u < 8u / KC ? 4u : 8u / KC) : 8u / NC;
  constexpr uint32_t XCap = MC * KC, WCap = KC * NC, SCap = NC * (BF ? 2u : 4u);
  static_assert(XCap <= 8u && WCap <= 8u && SCap <= 8u && MC * NC <= 8u,
                "capacity family");
  const uint32_t k = Full ? KC : actualK, n = Full ? NC : actualN;
  const uint64_t xx = Load<XCap>(x, m * k), sx0 = Load<8>(xs, Min(8u, m * 4u));
  const uint64_t sx1 = m > 2u ? Load<8>(xs + 8u, m * 4u - 8u) : 0u;
  uint64_t ww = 0, sw = 0, out0 = 0, out1 = 0;
  uint32_t held = 0xffffffffu;
  if constexpr (Single) {
    ww = Load<WCap>(w, k * n);
    sw = Load<SCap>(ws, n * (BF ? 2u : 4u));
  }
#pragma unroll
  for (uint32_t row = 0; row < MC; ++row)
    if (row < m) {
      if constexpr (!Single) {
        const uint32_t owner = (owners >> (8u * row)) & 255u;
        if (owner != held) {
          ww = Load<WCap>(w + uint64_t(owner) * k * n, k * n);
          sw =
              Load<SCap>(ws + uint64_t(owner) * n * (BF ? 2u : 4u), n * (BF ? 2u : 4u));
          held = owner;
        }
      }
      const float scale = F(uint32_t((row < 2u ? sx0 : sx1) >> (32u * (row & 1u))));
#pragma unroll
      for (uint32_t col = 0; col < NC; ++col)
        if (Full || col < n) {
          int32_t dot = 0;
#pragma unroll
          for (uint32_t t = 0; t < KC; ++t)
            if (Full || t < k) dot += S(xx, row * k + t) * S(ww, t * n + col);
          const uint32_t sb = BF ? uint32_t(uint16_t(sw >> (16u * col))) << 16u
                                 : uint32_t(sw >> (32u * col));
          const float weighted = float(dot) * F(sb);
          const uint16_t v = GvEncode<BF>(weighted * scale);
          const uint32_t q = row * n + col;
          if (q < 4u)
            out0 |= uint64_t(v) << (q * 16u);
          else
            out1 |= uint64_t(v) << ((q - 4u) * 16u);
        }
    }
  const uint32_t bytes = m * n * 2u;
  Store<8>(y, out0, Min(bytes, 8u));
  if (bytes > 8u) Store<8>(y + 8u, out1, bytes - 8u);
}
template <bool BF, uint32_t KC, uint32_t NC>
__global__ __aicore__ void SearchTinyCapacityUnrolled11850012(GM_ADDR x, GM_ADDR w,
                                                              GM_ADDR xs, GM_ADDR ws,
                                                              GM_ADDR gl, GM_ADDR y,
                                                              uint32_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const uint32_t m = (dims & 3u) + 1u, k = ((dims >> 2u) & 7u) + 1u,
                 n = ((dims >> 5u) & 3u) + 1u, e = ((dims >> 7u) & 127u) + 1u,
                 gt = (dims >> 14u) & 1u;
  GlobalTensor<uint64_t> preload;
  if (e > 1u) {
    preload.SetGlobalBuffer((__gm__ uint64_t*)gl);
    DataCachePreload(preload, int16_t(0));
  }
  preload.SetGlobalBuffer((__gm__ uint64_t*)x);
  DataCachePreload(preload, int16_t(0));
  preload.SetGlobalBuffer((__gm__ uint64_t*)xs);
  DataCachePreload(preload, int16_t(0));
  preload.SetGlobalBuffer((__gm__ uint64_t*)w);
  DataCachePreload(preload, int16_t(0));
  preload.SetGlobalBuffer((__gm__ uint64_t*)ws);
  DataCachePreload(preload, int16_t(0));
  uint32_t owners = 0;
  if (e > 1u) {
    uint32_t done = 0;
    uint64_t end = 0;
    for (uint32_t expert = 0; expert + 1u < e && done < m; ++expert) {
      const uint64_t v = Load<8>(gl + uint64_t(expert) * 8u, 8u);
      end = gt ? end + v : v;
      while (done < m && uint64_t(done) < end) {
        owners |= expert << (8u * done);
        ++done;
      }
    }
    while (done < m) {
      owners |= (e - 1u) << (8u * done);
      ++done;
    }
  }
  if (e == 1u) {
    if (k == KC && n == NC)
      Rows<BF, KC, NC, true, true>(x, w, xs, ws, y, m, k, n, 0u);
    else
      Rows<BF, KC, NC, false, true>(x, w, xs, ws, y, m, k, n, 0u);
  } else {
    if (k == KC && n == NC)
      Rows<BF, KC, NC, true, false>(x, w, xs, ws, y, m, k, n, owners);
    else
      Rows<BF, KC, NC, false, false>(x, w, xs, ws, y, m, k, n, owners);
  }
  DataSyncBarrier<MemDsbT::DDR>();
}
}  // namespace tiny_capacity_unrolled
namespace tiny_capacity_unrolled {

// One run of the kernel instantiated for a capacity cell. TINY_CAPACITY_CPU
// selects the CPU-simulator build, where the same kernel is called rather than
// launched.
#ifdef TINY_CAPACITY_CPU
#define TINY_CAPACITY_RUN(Kernel, ...) Kernel<__VA_ARGS__>(x, w, xs, ws, gl, y, dims)
#else
#define TINY_CAPACITY_RUN(Kernel, ...) \
  Kernel<__VA_ARGS__><<<1, nullptr, stream>>>(x, w, xs, ws, gl, y, dims)
#endif

// Tries the (KC, NC) cell, and reports whether it covered (k, n).
//
// BFOnly marks the cells that exist only for a bf16 output: its scales are two
// bytes instead of four, which leaves room in the output word for a wider N.
template <bool BF, uint32_t KC, uint32_t NC, bool BFOnly = false>
inline bool TryCell(uint32_t k, uint32_t n, GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                    GM_ADDR ws, GM_ADDR gl, GM_ADDR y, uint32_t dims,
                    aclrtStream stream) {
  if constexpr (BFOnly && !BF) {
    return false;
  } else {
    if (k > KC || n > NC) return false;
    TINY_CAPACITY_RUN(SearchTinyCapacityUnrolled11850012, BF, KC, NC);
    return true;
  }
}

// Registered cells, in the order they are tried: K capacity outermost, and
// within it the narrowest N that still covers the shape.
template <bool BF>
inline void Select(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                   uint32_t dims, aclrtStream stream) {
  const uint32_t k = ((dims >> 2u) & 7u) + 1u, n = ((dims >> 5u) & 3u) + 1u;
#define TINY_CAPACITY_TRY(KC, NC, BFOnly) \
  if (TryCell<BF, KC, NC, BFOnly>(k, n, x, w, xs, ws, gl, y, dims, stream)) return
  TINY_CAPACITY_TRY(1u, 1u, false);
  TINY_CAPACITY_TRY(1u, 2u, false);
  TINY_CAPACITY_TRY(1u, 4u, true);
  TINY_CAPACITY_TRY(2u, 1u, false);
  TINY_CAPACITY_TRY(2u, 2u, false);
  TINY_CAPACITY_TRY(2u, 4u, true);
  TINY_CAPACITY_TRY(4u, 1u, false);
  TINY_CAPACITY_TRY(4u, 2u, false);
  TINY_CAPACITY_TRY(8u, 1u, false);
#undef TINY_CAPACITY_TRY
  throw std::invalid_argument("outside registered power-of-two capacity family");
}

}  // namespace tiny_capacity_unrolled
namespace tiny_capacity_contract {
using namespace gmmptq;
using namespace AscendC;
template <uint32_t Cap>
__aicore__ inline uint64_t Load(GM_ADDR p, uint32_t bytes) {
  if (bytes == 0u) return 0u;
  if constexpr (Cap == 1u)
    return uint64_t(*(__gm__ uint8_t*)p);
  else {
    if (bytes == Cap && (reinterpret_cast<uintptr_t>(p) & (Cap - 1u)) == 0u) {
      if constexpr (Cap == 8u)
        return *(__gm__ uint64_t*)p;
      else if constexpr (Cap == 4u)
        return *(__gm__ uint32_t*)p;
      else
        return *(__gm__ uint16_t*)p;
    }
    constexpr uint32_t Half = Cap / 2u;
    uint64_t lo = Load<Half>(p, Min(bytes, Half));
    if (bytes > Half) lo |= Load<Half>(p + Half, bytes - Half) << (Half * 8u);
    return lo;
  }
}
template <uint32_t Cap>
__aicore__ inline void Store(GM_ADDR p, uint64_t bits, uint32_t bytes) {
  if (bytes == 0u) return;
  if constexpr (Cap == 2u)
    WriteGmByPassDCache((__gm__ uint16_t*)p, uint16_t(bits));
  else {
    if (bytes == Cap && (reinterpret_cast<uintptr_t>(p) & (Cap - 1u)) == 0u) {
      if constexpr (Cap == 8u)
        WriteGmByPassDCache((__gm__ uint64_t*)p, bits);
      else
        WriteGmByPassDCache((__gm__ uint32_t*)p, uint32_t(bits));
    } else {
      constexpr uint32_t Half = Cap / 2u;
      Store<Half>(p, bits, Min(bytes, Half));
      if (bytes > Half) Store<Half>(p + Half, bits >> (Half * 8u), bytes - Half);
    }
  }
}
__aicore__ inline float F(uint32_t u) {
  union {
    uint32_t u;
    float f;
  } v;
  v.u = u;
  return v.f;
}
__aicore__ inline int32_t S(uint64_t u, uint32_t i) {
  return int32_t(int8_t((u >> (i * 8u)) & 255u));
}
template <uint32_t RC>
struct RowScales {
  uint64_t low;
  __aicore__ inline RowScales(GM_ADDR p, uint32_t rows)
      : low(Load<RC * 4u>(p, rows * 4u)) {}
  __aicore__ inline float Get(uint32_t row) const {
    return F(uint32_t(low >> (32u * row)));
  }
};
template <>
struct RowScales<4u> {
  uint64_t low, high;
  __aicore__ inline RowScales(GM_ADDR p, uint32_t rows)
      : low(Load<8>(p, 8u)), high(Load<8>(p + 8u, rows * 4u - 8u)) {}
  __aicore__ inline float Get(uint32_t row) const {
    return F(uint32_t((row < 2u ? low : high) >> (32u * (row & 1u))));
  }
};
template <uint32_t Cells>
struct Output {
  uint64_t low = 0;
  __aicore__ inline void Put(uint32_t q, uint16_t v) {
    low |= uint64_t(v) << (16u * q);
  }
  __aicore__ inline void Write(GM_ADDR p, uint32_t bytes) {
    Store<Cells * 2u>(p, low, bytes);
  }
};
template <>
struct Output<8u> {
  uint64_t low = 0, high = 0;
  __aicore__ inline void Put(uint32_t q, uint16_t v) {
    if (q < 4u)
      low |= uint64_t(v) << (16u * q);
    else
      high |= uint64_t(v) << (16u * (q - 4u));
  }
  __aicore__ inline void Write(GM_ADDR p, uint32_t bytes) {
    Store<8>(p, low, 8u);
    if (bytes > 8u) Store<8>(p + 8u, high, bytes - 8u);
  }
};
template <bool BF, uint32_t RC, uint32_t KC, uint32_t NC, bool Full>
__aicore__ inline void Rows(GM_ADDR w, GM_ADDR ws, GM_ADDR y, uint32_t m,
                            uint32_t actualK, uint32_t actualN, uint32_t owners,
                            uint64_t xx, const RowScales<RC>& rowScales) {
  constexpr uint32_t MC = RC;
  constexpr uint32_t XCap = MC * KC, WCap = KC * NC, SCap = NC * (BF ? 2u : 4u);
  static_assert(XCap <= 8u && WCap <= 8u && SCap <= 8u && MC * NC <= 8u,
                "capacity family");
  const uint32_t k = Full ? KC : actualK, n = Full ? NC : actualN;
  Output<RC * NC> output;
  uint64_t ww = 0, sw = 0;
  uint32_t held = 0xffffffffu;
#pragma unroll
  for (uint32_t row = 0; row < MC; ++row)
    if (row < m) {
      const uint32_t owner = (owners >> (8u * row)) & 255u;
      if (owner != held) {
        ww = Load<WCap>(w + uint64_t(owner) * k * n, k * n);
        sw = Load<SCap>(ws + uint64_t(owner) * n * (BF ? 2u : 4u), n * (BF ? 2u : 4u));
        held = owner;
      }
      const float scale = rowScales.Get(row);
#pragma unroll
      for (uint32_t col = 0; col < NC; ++col)
        if (Full || col < n) {
          int32_t dot = 0;
#pragma unroll
          for (uint32_t t = 0; t < KC; ++t)
            if (Full || t < k) dot += S(xx, row * k + t) * S(ww, t * n + col);
          const uint32_t sb = BF ? uint32_t(uint16_t(sw >> (16u * col))) << 16u
                                 : uint32_t(sw >> (32u * col));
          const float weighted = float(dot) * F(sb);
          const uint16_t v = GvEncode<BF>(weighted * scale);
          const uint32_t q = row * n + col;
          output.Put(q, v);
        }
    }
  output.Write(y, m * n * 2u);
}
template <uint32_t RC>
__aicore__ inline uint32_t BatchOwners(GM_ADDR gl, uint32_t e, uint32_t m,
                                       uint32_t gt) {
  uint32_t v0 = 0u, v1 = 0u, v2 = 0u, v3 = 0u, v4 = 0u, v5 = 0u, v6 = 0u;
  if (e > 1u) v0 = uint32_t(Load<4>(gl + 0u, 4u));
  if (e > 2u) v1 = uint32_t(Load<4>(gl + 8u, 4u));
  if (e > 3u) v2 = uint32_t(Load<4>(gl + 16u, 4u));
  if (e > 4u) v3 = uint32_t(Load<4>(gl + 24u, 4u));
  if (e > 5u) v4 = uint32_t(Load<4>(gl + 32u, 4u));
  if (e > 6u) v5 = uint32_t(Load<4>(gl + 40u, 4u));
  if (e > 7u) v6 = uint32_t(Load<4>(gl + 48u, 4u));
  if (gt) {
    v1 += v0;
    v2 += v1;
    v3 += v2;
    v4 += v3;
    v5 += v4;
    v6 += v5;
  }
  uint32_t owners = 0u;
#pragma unroll
  for (uint32_t row = 0u; row < RC; ++row)
    if (row < m) {
      uint32_t owner = 0u;
      owner += uint32_t(e > 1u && v0 <= row);
      owner += uint32_t(e > 2u && v1 <= row);
      owner += uint32_t(e > 3u && v2 <= row);
      owner += uint32_t(e > 4u && v3 <= row);
      owner += uint32_t(e > 5u && v4 <= row);
      owner += uint32_t(e > 6u && v5 <= row);
      owner += uint32_t(e > 7u && v6 <= row);
      owners |= owner << (8u * row);
    }
  return owners;
}
template <uint32_t C>
__aicore__ inline uint32_t DecodeCapacity(uint32_t encodedMinus1) {
  static_assert(C == 1u || C == 2u || C == 4u || C == 8u,
                "power-of-two dimension capacity");
  if constexpr (C <= 2u)
    return C;
  else
    return C / 2u + 1u + (encodedMinus1 & (C / 2u - 1u));
}
template <bool BF, uint32_t RC, uint32_t KC, uint32_t NC>
__global__ __aicore__ void SearchTinyCapacityContract11850017(GM_ADDR x, GM_ADDR w,
                                                              GM_ADDR xs, GM_ADDR ws,
                                                              GM_ADDR gl, GM_ADDR y,
                                                              uint32_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const uint32_t m = DecodeCapacity<RC>(dims & 3u),
                 k = DecodeCapacity<KC>((dims >> 2u) & 7u),
                 n = DecodeCapacity<NC>((dims >> 5u) & 3u),
                 e = ((dims >> 7u) & 127u) + 1u, gt = (dims >> 14u) & 1u;
  GlobalTensor<uint64_t> preload;
  preload.SetGlobalBuffer((__gm__ uint64_t*)gl);
  DataCachePreload(preload, int16_t(0));
  preload.SetGlobalBuffer((__gm__ uint64_t*)x);
  DataCachePreload(preload, int16_t(0));
  preload.SetGlobalBuffer((__gm__ uint64_t*)xs);
  DataCachePreload(preload, int16_t(0));
  preload.SetGlobalBuffer((__gm__ uint64_t*)w);
  DataCachePreload(preload, int16_t(0));
  preload.SetGlobalBuffer((__gm__ uint64_t*)ws);
  DataCachePreload(preload, int16_t(0));
  const uint64_t xx = Load<RC * KC>(x, m * k);
  const RowScales<RC> rowScales(xs, m);
  const uint32_t owners = BatchOwners<RC>(gl, e, m, gt);
  if (k == KC && n == NC)
    Rows<BF, RC, KC, NC, true>(w, ws, y, m, k, n, owners, xx, rowScales);
  else
    Rows<BF, RC, KC, NC, false>(w, ws, y, m, k, n, owners, xx, rowScales);
  DataSyncBarrier<MemDsbT::DDR>();
}
}  // namespace tiny_capacity_contract
namespace tiny_capacity_contract {

// As in tiny_capacity_unrolled, but the row count is a capacity too: this
// variant reads all RC rows of x as one word.
template <bool BF, uint32_t RC, uint32_t KC, uint32_t NC, bool BFOnly = false>
inline bool TryCell(uint32_t m, uint32_t k, uint32_t n, GM_ADDR x, GM_ADDR w,
                    GM_ADDR xs, GM_ADDR ws, GM_ADDR gl, GM_ADDR y, uint32_t dims,
                    aclrtStream stream) {
  if constexpr (BFOnly && !BF) {
    return false;
  } else {
    if (m > RC || k > KC || n > NC) return false;
    TINY_CAPACITY_RUN(SearchTinyCapacityContract11850017, BF, RC, KC, NC);
    return true;
  }
}

template <bool BF>
inline void Select(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                   uint32_t dims, aclrtStream stream) {
  const uint32_t m = (dims & 3u) + 1u, k = ((dims >> 2u) & 7u) + 1u,
                 n = ((dims >> 5u) & 3u) + 1u;
#define TINY_CAPACITY_TRY(RC, KC, NC, BFOnly)                                      \
  if (TryCell<BF, RC, KC, NC, BFOnly>(m, k, n, x, w, xs, ws, gl, y, dims, stream)) \
  return
  TINY_CAPACITY_TRY(1u, 1u, 1u, false);
  TINY_CAPACITY_TRY(1u, 1u, 2u, false);
  TINY_CAPACITY_TRY(1u, 1u, 4u, true);
  TINY_CAPACITY_TRY(1u, 2u, 1u, false);
  TINY_CAPACITY_TRY(1u, 2u, 2u, false);
  TINY_CAPACITY_TRY(1u, 2u, 4u, true);
  TINY_CAPACITY_TRY(1u, 4u, 1u, false);
  TINY_CAPACITY_TRY(1u, 4u, 2u, false);
  TINY_CAPACITY_TRY(1u, 8u, 1u, false);
  TINY_CAPACITY_TRY(2u, 1u, 1u, false);
  TINY_CAPACITY_TRY(2u, 1u, 2u, false);
  TINY_CAPACITY_TRY(2u, 1u, 4u, true);
  TINY_CAPACITY_TRY(2u, 2u, 1u, false);
  TINY_CAPACITY_TRY(2u, 2u, 2u, false);
  TINY_CAPACITY_TRY(2u, 2u, 4u, true);
  TINY_CAPACITY_TRY(2u, 4u, 1u, false);
  TINY_CAPACITY_TRY(2u, 4u, 2u, false);
  TINY_CAPACITY_TRY(4u, 1u, 1u, false);
  TINY_CAPACITY_TRY(4u, 1u, 2u, false);
  TINY_CAPACITY_TRY(4u, 2u, 1u, false);
  TINY_CAPACITY_TRY(4u, 2u, 2u, false);
#undef TINY_CAPACITY_TRY
  throw std::invalid_argument("outside registered M/K/N capacity family");
}

#undef TINY_CAPACITY_RUN

}  // namespace tiny_capacity_contract
