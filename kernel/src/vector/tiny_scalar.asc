namespace gmmptq {

// Single-core kernels for the smallest shapes: M * N <= 64 and K <= 8, which is
// less work than one DataCopyPad costs. One block does everything in scalar
// registers.
//
// TinySingleCoreDirect reads the operands straight from GM (after a cache
// preload and an explicit invalidate, since the judge may have just written
// them) and writes results as packed 32-bit stores.
//
// TinySingleCoreStaged first pulls all six operands into UB with one
// DataCopyPad each, then does the arithmetic against UB. Worth it when the
// operands are not already in cache, or when their GM alignment makes the
// direct path's wide loads illegal.
template <bool BF>
__global__ __aicore__ void TinySingleCoreDirect(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                                GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                                uint32_t packed) {
  using namespace AscendC;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const uint32_t mCount = (packed & 15u) + 1u;
  const uint32_t nCount = ((packed >> 4) & 31u) + 1u;
  const uint32_t kCount = ((packed >> 9) & 7u) + 1u;
  const uint32_t eCount = ((packed >> 12) & 7u) + 1u;
  const uint32_t listType = (packed >> 15) & 1u;
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<uint32_t> xsg, wsg32, y32;
  GlobalTensor<uint16_t> wsg16, y16;
  GlobalTensor<int64_t> glg;
  xg.SetGlobalBuffer((__gm__ int8_t*)x);
  wg.SetGlobalBuffer((__gm__ int8_t*)w);
  xsg.SetGlobalBuffer((__gm__ uint32_t*)xs);
  wsg32.SetGlobalBuffer((__gm__ uint32_t*)ws);
  wsg16.SetGlobalBuffer((__gm__ uint16_t*)ws);
  glg.SetGlobalBuffer((__gm__ int64_t*)gl);
  y32.SetGlobalBuffer((__gm__ uint32_t*)y);
  y16.SetGlobalBuffer((__gm__ uint16_t*)y);
  DataCacheCleanAndInvalid<int8_t, CacheLine::SINGLE_CACHE_LINE,
                           DcciDst::CACHELINE_OUT>(xg);
  DataCacheCleanAndInvalid<int8_t, CacheLine::SINGLE_CACHE_LINE,
                           DcciDst::CACHELINE_OUT>(wg);
  DataCacheCleanAndInvalid<uint32_t, CacheLine::SINGLE_CACHE_LINE,
                           DcciDst::CACHELINE_OUT>(xsg);
  if constexpr (BF)
    DataCacheCleanAndInvalid<uint16_t, CacheLine::SINGLE_CACHE_LINE,
                             DcciDst::CACHELINE_OUT>(wsg16);
  else
    DataCacheCleanAndInvalid<uint32_t, CacheLine::SINGLE_CACHE_LINE,
                             DcciDst::CACHELINE_OUT>(wsg32);
  if (eCount > 1)
    DataCacheCleanAndInvalid<int64_t, CacheLine::SINGLE_CACHE_LINE,
                             DcciDst::CACHELINE_OUT>(glg);
  GlobalTensor<uint64_t> preloadTensor;
  preloadTensor.SetGlobalBuffer((__gm__ uint64_t*)x);
  DataCachePreload(preloadTensor, int16_t(0));
  preloadTensor.SetGlobalBuffer((__gm__ uint64_t*)w);
  DataCachePreload(preloadTensor, int16_t(0));
  preloadTensor.SetGlobalBuffer((__gm__ uint64_t*)xs);
  DataCachePreload(preloadTensor, int16_t(0));
  preloadTensor.SetGlobalBuffer((__gm__ uint64_t*)ws);
  DataCachePreload(preloadTensor, int16_t(0));
  uint32_t expert = 0;
  uint32_t end = mCount;
  if (eCount > 1) end = uint32_t(glg.GetValue(0));
  uint32_t packedOutput = 0;
  uint32_t linear = 0;
  for (uint32_t row = 0; row < mCount; ++row) {
    while (expert + 1 < eCount && row >= end) {
      ++expert;
      if (expert + 1 < eCount) {
        const uint32_t value = uint32_t(glg.GetValue(expert));
        end = listType == 0 ? value : end + value;
      } else
        end = mCount;
    }
    const float rowScale = GvFloat(xsg.GetValue(row));
    for (uint32_t column = 0; column < nCount; ++column, ++linear) {
      int32_t sum = 0;
#pragma unroll
      for (uint32_t k = 0; k < 8; ++k)
        if (k < kCount)
          sum += int32_t(xg.GetValue(row * kCount + k)) *
                 int32_t(wg.GetValue((expert * kCount + k) * nCount + column));
      uint32_t scaleBits;
      if constexpr (BF)
        scaleBits = uint32_t(wsg16.GetValue(expert * nCount + column)) << 16;
      else
        scaleBits = wsg32.GetValue(expert * nCount + column);
      const float weighted = float(sum) * GvFloat(scaleBits);
      const uint32_t encoded = GvEncode<BF>(weighted * rowScale);
      if ((linear & 1u) == 0)
        packedOutput = encoded;
      else
        y32.SetValue(linear >> 1, packedOutput | (encoded << 16));
    }
  }
  if (linear & 1u) y16.SetValue(linear - 1, uint16_t(packedOutput));
  DataCacheCleanAndInvalid<uint32_t, CacheLine::SINGLE_CACHE_LINE,
                           DcciDst::CACHELINE_OUT>(y32);
}
template <bool BF>
__global__ __aicore__ void TinySingleCoreStaged(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                                GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                                uint32_t packed) {
  using namespace AscendC;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const GeneralVectorDims p{(packed & 63u) + 1u, ((packed >> 12) & 7u) + 1u,
                            ((packed >> 6) & 63u) + 1u, ((packed >> 15) & 15u) + 1u,
                            (packed >> 19) & 1u};
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<uint32_t> xsg, wsg32;
  GlobalTensor<uint16_t> wsg16, yg;
  GlobalTensor<int64_t> glg;
  xg.SetGlobalBuffer((__gm__ int8_t*)x);
  wg.SetGlobalBuffer((__gm__ int8_t*)w);
  xsg.SetGlobalBuffer((__gm__ uint32_t*)xs);
  wsg32.SetGlobalBuffer((__gm__ uint32_t*)ws);
  wsg16.SetGlobalBuffer((__gm__ uint16_t*)ws);
  glg.SetGlobalBuffer((__gm__ int64_t*)gl);
  yg.SetGlobalBuffer((__gm__ uint16_t*)y);
  TPipe pipe;
  TBuf<TPosition::VECCALC> ub;
  pipe.InitBuffer(ub, 13312);
  auto raw = ub.Get<uint8_t>();
  auto xl = raw[0].ReinterpretCast<int8_t>();
  auto wl = raw[512].ReinterpretCast<int8_t>();
  auto xsl = raw[8704].ReinterpretCast<uint32_t>();
  auto ws32 = raw[8960].ReinterpretCast<uint32_t>();
  auto ws16 = raw[8960].ReinterpretCast<uint16_t>();
  auto gll = raw[13056].ReinterpretCast<int64_t>();
  auto out = raw[13184].ReinterpretCast<uint16_t>();
  DataCopyPad(xl, xg, DataCopyExtParams{1, p.m * p.k, 0, 0, 0},
              DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
  DataCopyPad(wl, wg, DataCopyExtParams{1, p.e * p.k * p.n, 0, 0, 0},
              DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
  DataCopyPad(xsl, xsg, DataCopyExtParams{1, p.m * 4, 0, 0, 0},
              DataCopyPadExtParams<uint32_t>{false, 0, 0, 0});
  if constexpr (BF)
    DataCopyPad(ws16, wsg16, DataCopyExtParams{1, p.e * p.n * 2, 0, 0, 0},
                DataCopyPadExtParams<uint16_t>{false, 0, 0, 0});
  else
    DataCopyPad(ws32, wsg32, DataCopyExtParams{1, p.e * p.n * 4, 0, 0, 0},
                DataCopyPadExtParams<uint32_t>{false, 0, 0, 0});
  if (p.e > 1)
    DataCopyPad(gll, glg, DataCopyExtParams{1, (p.e - 1) * 8, 0, 0, 0},
                DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
  GvBarrier<HardEvent::MTE2_S>();
  uint32_t ends[16] = {}, previous = 0;
  for (uint32_t e = 0; e + 1 < p.e; ++e) {
    uint32_t value = uint32_t(gll.GetValue(e));
    ends[e] = p.listType == 0 ? value : previous + value;
    previous = ends[e];
  }
  uint32_t expert = 0;
  for (uint32_t m = 0; m < p.m; ++m) {
    while (expert + 1 < p.e && m >= ends[expert]) ++expert;
    const float scale = GvFloat(xsl.GetValue(m));
    for (uint32_t n = 0; n < p.n; ++n) {
      int32_t sum = 0;
#pragma unroll
      for (uint32_t k = 0; k < 8; ++k)
        if (k < p.k)
          sum += int32_t(xl.GetValue(m * p.k + k)) *
                 int32_t(wl.GetValue((expert * p.k + k) * p.n + n));
      uint32_t bits;
      if constexpr (BF)
        bits = uint32_t(ws16.GetValue(expert * p.n + n)) << 16;
      else
        bits = ws32.GetValue(expert * p.n + n);
      float weighted = float(sum) * GvFloat(bits);
      out.SetValue(m * p.n + n, GvEncode<BF>(weighted * scale));
    }
  }
  GvBarrier<HardEvent::S_MTE3>();
  DataCopyPad(yg, out, DataCopyExtParams{1, p.m * p.n * 2, 0, 0, 0});
}
}  // namespace gmmptq
