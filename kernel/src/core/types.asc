namespace gmmptq {

// On-chip budgets for dav-2201. L1 holds the staged A and B panels, L0A/L0B the
// fractile operands, L0C the int32 accumulator and UB the vector workspace.
constexpr uint32_t L1_BYTES = 512 * 1024;
constexpr uint32_t L0A_BYTES = 64 * 1024;
constexpr uint32_t L0B_BYTES = 64 * 1024;
constexpr uint32_t L0C_BYTES = 128 * 1024;
constexpr uint32_t UB_BYTES = 192 * 1024;

// Fractile geometry: int8 Mmad consumes 16x32 A fractiles and 32x32 B pairs.
constexpr uint32_t C0_I8 = 32;     // int8 reduction lanes per fractile
constexpr uint32_t FRAC_I8 = 512;  // bytes in one 16x32 int8 fractile
constexpr uint32_t ROW_FRAC = 16;  // rows per M fractile
constexpr uint32_t BLK = 32;       // bytes in one UB/GM access block
constexpr uint32_t F32_PER_BLK = 8;
constexpr uint32_t F32_PER_REP = 64;  // fp32 lanes in one vector repeat
constexpr uint32_t AIV_PER_AIC = 2;

// The shape and tiling decision the host hands to a cube kernel. The host fills
// m/k/n/e/listType/cores from the judge's tensors and a planner fills the rest;
// see host/plan_cube.asc.
struct Plan {
  uint32_t m, k, n, e;
  uint32_t wstride;   // row pitch of the weight the kernel actually reads
  uint32_t listType;  // 0: cumulative group list, 1: per-expert counts
  uint32_t kp;        // k rounded up to C0_I8
  uint32_t m0, n0;    // tile shape
  uint32_t k0;        // K step per Mmad
  uint32_t kl;        // K staged into L1 at once
  uint32_t m0r;       // m0 rounded up to ROW_FRAC
  uint32_t n0r;       // n0 rounded up to ROW_FRAC
  uint32_t n0c;       // n0 rounded up to C0_I8
  uint32_t nTiles;
  uint32_t cores;   // AIC count
  uint32_t vcores;  // AIV count
  uint32_t rv;      // rows an AIV dequantizes per pass
};

__aicore__ inline uint32_t Up(uint32_t v, uint32_t q) { return (v + q - 1) / q * q; }

__aicore__ inline uint32_t Min(uint32_t a, uint32_t b) { return a < b ? a : b; }

// Set-then-wait on one hard event, the fence this code uses everywhere a
// producer pipe hands a buffer to a consumer pipe within the same core.
template <AscendC::HardEvent E>
__aicore__ inline void Barrier() {
  AscendC::SetFlag<E>(0);
  AscendC::WaitFlag<E>(0);
}

}  // namespace gmmptq
