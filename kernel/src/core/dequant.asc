namespace gmmptq {

// Per-token/per-channel dequantization primitives shared by the cube families.
//
// A staged int32 tile holds `rows` tokens of `cols` channels at a row pitch of
// `pitch` fp32 lanes. Turning it into the output takes three steps, in order:
//   1. multiply each row by the per-channel weight scale  (MulByRow)
//   2. multiply each column by the per-token scale        (MulByTokenScale)
//   3. round to fp16/bf16 and store the live columns      (StoreRows)

// Widens a weight-scale vector to fp32. bf16 needs a real cast; fp32 only needs
// a copy, and Adds is the cheapest copy the vector unit has.
template <typename ScaleT>
__aicore__ inline void ToFloat(AscendC::LocalTensor<float> dst,
                               AscendC::LocalTensor<ScaleT> src, uint32_t count) {
  AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
}

template <>
__aicore__ inline void ToFloat<float>(AscendC::LocalTensor<float> dst,
                                      AscendC::LocalTensor<float> src, uint32_t count) {
  AscendC::Adds(dst, src, 0.0f, count);
}

// dst[r][c] = src[r][c] * col[c]: one repeat per row, src1 held at the same
// column vector for every repeat.
__aicore__ inline void MulByRow(AscendC::LocalTensor<float> dst,
                                AscendC::LocalTensor<float> src,
                                AscendC::LocalTensor<float> col, uint32_t rows,
                                uint32_t cols, uint32_t pitch) {
  AscendC::BinaryRepeatParams rp;
  rp.dstBlkStride = 1;
  rp.src0BlkStride = 1;
  rp.src1BlkStride = 1;
  rp.dstRepStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src0RepStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src1RepStride = 0;
  for (uint32_t r = 0; r < rows; r += 255) {
    uint8_t rep = static_cast<uint8_t>(Min(255, rows - r));
    for (uint32_t c = 0; c < cols; c += F32_PER_REP) {
      uint64_t mask = Min(F32_PER_REP, cols - c);
      AscendC::Mul(dst[r * pitch + c], src[r * pitch + c], col[c], mask, rep, rp);
    }
  }
}

// value[r][c] *= brcb[r]: `brcb` is a Brcb'd per-token scale, one 8-lane block
// per row, so src1 walks blocks while dst/src0 walk columns.
__aicore__ inline void MulByCol(AscendC::LocalTensor<float> value,
                                AscendC::LocalTensor<float> brcb, uint32_t rows,
                                uint32_t cols, uint32_t pitch) {
  AscendC::BinaryRepeatParams rp;
  rp.dstBlkStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src0BlkStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src1BlkStride = 1;
  rp.dstRepStride = 1;
  rp.src0RepStride = 1;
  rp.src1RepStride = 0;
  for (uint32_t r = 0; r < rows; r += F32_PER_BLK) {
    uint64_t mask = Min(F32_PER_BLK, rows - r) * F32_PER_BLK;
    for (uint32_t c = 0; c < cols; c += F32_PER_BLK * 255) {
      uint8_t rep =
          static_cast<uint8_t>(Min(F32_PER_BLK * 255, cols - c) / F32_PER_BLK);
      AscendC::Mul(value[r * pitch + c], value[r * pitch + c], brcb[r * F32_PER_BLK],
                   mask, rep, rp);
    }
  }
}

// value[r][c] *= brcb[r], with one repeat per row instead of MulByCol's one
// repeat per 8 rows. The cube bodies prefer this shape because their tiles are
// row-major in UB and `cols` is the live width, not the padded pitch.
__aicore__ inline void MulByTokenScale(AscendC::LocalTensor<float> value,
                                       AscendC::LocalTensor<float> brcb, uint32_t rows,
                                       uint32_t cols, uint32_t pitch) {
  AscendC::BinaryRepeatParams rp;
  rp.dstBlkStride = 1;
  rp.src0BlkStride = 1;
  rp.src1BlkStride = 0;
  rp.dstRepStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src0RepStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src1RepStride = 1;
  for (uint32_t c = 0; c < cols; c += F32_PER_REP)
    AscendC::Mul(value[c], value[c], brcb, uint64_t(Min(F32_PER_REP, cols - c)),
                 uint8_t(rows), rp);
}

// Writes `rows` x `cols` 16-bit results from a `pitch`-wide UB tile into a
// row-major output of row length `n`.
template <typename OutT>
__aicore__ inline void StoreRows(AscendC::GlobalTensor<OutT> dst,
                                 AscendC::LocalTensor<OutT> src, uint32_t rows,
                                 uint32_t cols, uint32_t pitch, uint32_t n) {
  AscendC::DataCopyPad(
      dst, src,
      AscendC::DataCopyExtParams{uint16_t(rows), cols * 2u,
                                 (pitch * 2u - Up(cols * 2u, BLK)) / BLK,
                                 (n - cols) * 2u, 0});
}

}  // namespace gmmptq
