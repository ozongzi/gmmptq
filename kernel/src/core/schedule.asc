namespace gmmptq {

using AscendC::GlobalTensor;
using AscendC::LocalTensor;
using AscendC::TPosition;

__aicore__ inline uint32_t Ceil(uint32_t a, uint32_t b) {
  return b ? (a + b - 1) / b : 0;
}

__aicore__ inline uint32_t MinU(uint32_t a, uint32_t b) { return a < b ? a : b; }

// Tiling for the AIV-only families. `kc` and `nb` are reused per family: a row
// batch and a column pitch for the outer-product kernels, a K chunk and an N
// block for the short-group matmul.
struct VTiling {
  uint32_t m;
  uint32_t k;
  uint32_t n;
  uint32_t e;
  uint32_t listType;
  uint32_t coreNum;
  uint32_t kc;
  uint32_t nb;
};

// The group list gives each expert's token count (listType 1) or its
// cumulative end row (listType 0). Both forms turn into [rowStart, rowStart +
// rows) by scanning, which is what every family needs.

// Counts the (m-block, n-tile) tiles across all experts, i.e. the work items a
// cube kernel distributes over its cores.
struct Schedule {
  AscendC::GlobalTensor<int64_t> list;
  uint32_t listType;
  uint32_t experts;
  uint32_t m0;
  uint32_t nTiles;
  __aicore__ inline uint32_t Total() const {
    uint32_t total = 0, start = 0;
    for (uint32_t e = 0; e < experts; ++e) {
      uint32_t v = static_cast<uint32_t>(list.GetValue(e));
      uint32_t end = listType == 0 ? v : start + v;
      total += (end > start ? (end - start + m0 - 1) / m0 : 0u) * nTiles;
      start = end;
    }
    return total;
  }
};

// A forward cursor over the same tile space, for the vector families that take
// tiles round-robin rather than as a contiguous range. Skips empty experts.
struct Walk {
  GlobalTensor<int64_t> list;
  uint32_t listType;
  uint32_t experts;
  uint32_t baseM;
  uint32_t nTiles;
  uint32_t expert;
  uint32_t rowStart;
  uint32_t rows;
  uint32_t mIdx;
  uint32_t nIdx;
  uint32_t mTiles;
  uint32_t cursor;
  bool done;
  __aicore__ inline void Init(const GlobalTensor<int64_t>& glist, uint32_t type,
                              uint32_t experts_, uint32_t baseM_, uint32_t nTiles_) {
    list = glist;
    listType = type;
    experts = experts_;
    baseM = baseM_;
    nTiles = nTiles_;
    expert = 0;
    rowStart = 0;
    cursor = 0;
    mIdx = 0;
    nIdx = 0;
    rows = 0;
    mTiles = 0;
    done = false;
    Seek();
  }
  __aicore__ inline void Seek() {
    while (expert < experts) {
      uint32_t v = static_cast<uint32_t>(list.GetValue(expert));
      uint32_t end = (listType == 0) ? v : cursor + v;
      rows = (end > cursor) ? (end - cursor) : 0u;
      rowStart = cursor;
      cursor = end;
      if (rows > 0) {
        mTiles = Ceil(rows, baseM);
        mIdx = 0;
        nIdx = 0;
        return;
      }
      ++expert;
    }
    done = true;
  }
  __aicore__ inline void Next() {
    if (++nIdx < nTiles) return;
    nIdx = 0;
    if (++mIdx < mTiles) return;
    ++expert;
    Seek();
  }
};

namespace vec {
constexpr uint32_t GRAIN = 32;
}  // namespace vec

namespace outer {
constexpr uint32_t MAX_ROWS = 32;
}  // namespace outer

}  // namespace gmmptq
