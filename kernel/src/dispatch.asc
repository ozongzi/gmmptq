// Launch helpers for the classifier below.
//
// Half the dispatcher is "instantiate this kernel for whichever dtype pair the
// output asks for" — the weight scales are fp32 beside an fp16 output and bf16
// beside a bf16 one. These are macros rather than function templates because
// `<<<>>>` is not an operator a template can forward. All of them read `bf` and
// `stream` from the enclosing scope, and all are #undef'd at the end of the
// file.
#define GMM_BY_DTYPE(Kernel, grid, ...)                                         \
  do {                                                                          \
    if (bf)                                                                     \
      Kernel<bfloat16_t, bfloat16_t><<<(grid), nullptr, stream>>>(__VA_ARGS__); \
    else                                                                        \
      Kernel<float, half><<<(grid), nullptr, stream>>>(__VA_ARGS__);            \
  } while (0)

// Same, for kernels with one or two further template parameters after the
// dtype pair.
#define GMM_BY_DTYPE_1T(Kernel, A, grid, ...)                                      \
  do {                                                                             \
    if (bf)                                                                        \
      Kernel<bfloat16_t, bfloat16_t, A><<<(grid), nullptr, stream>>>(__VA_ARGS__); \
    else                                                                           \
      Kernel<float, half, A><<<(grid), nullptr, stream>>>(__VA_ARGS__);            \
  } while (0)

#define GMM_BY_DTYPE_2T(Kernel, A, B, grid, ...)                                      \
  do {                                                                                \
    if (bf)                                                                           \
      Kernel<bfloat16_t, bfloat16_t, A, B><<<(grid), nullptr, stream>>>(__VA_ARGS__); \
    else                                                                              \
      Kernel<float, half, A, B><<<(grid), nullptr, stream>>>(__VA_ARGS__);            \
  } while (0)

// For the kernels and launchers parameterized on a single `bool BF` instead of
// a dtype pair: GMM_BY_BF launches a kernel, GMM_BY_BF_CALL calls a host
// function that launches its own.
#define GMM_BY_BF(Kernel, grid, ...)                           \
  do {                                                         \
    if (bf)                                                    \
      Kernel<true><<<(grid), nullptr, stream>>>(__VA_ARGS__);  \
    else                                                       \
      Kernel<false><<<(grid), nullptr, stream>>>(__VA_ARGS__); \
  } while (0)

#define GMM_BY_BF_CALL(Fn, ...) \
  do {                          \
    if (bf)                     \
      Fn<true>(__VA_ARGS__);    \
    else                        \
      Fn<false>(__VA_ARGS__);   \
  } while (0)

// The judge's entry point, and the shape classifier.
//
// Every family in this operator handles a band of shapes well and the rest
// badly, so run_kernel is a chain of guards running from the most degenerate
// shape to the most general and ending at CubeMix, which handles anything. The
// order is load-bearing: each guard assumes none above it fired.
//
// Many guards also test operand alignment. The judge promises none, and the
// kernels that write their output with packed scalar stores or read wide words
// straight from GM need it; where it is missing, the next family down takes
// over with the same result.
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR weight,
                           const TensorGroupInfo& info_weight, GM_ADDR xScale,
                           const TensorGroupInfo& info_xScale, GM_ADDR weightScale,
                           const TensorGroupInfo& info_weightScale, GM_ADDR groupList,
                           const TensorGroupInfo& info_groupList, GM_ADDR y,
                           const TensorGroupInfo& info_y, int64_t availableCoreNum,
                           aclrtStream stream, int64_t groupListType,
                           const char* outputDtype) {
  using namespace gmmptq;
  if (!outputDtype ||
      (std::strcmp(outputDtype, "float16") && std::strcmp(outputDtype, "bfloat16")) ||
      (groupListType != 0 && groupListType != 1) || availableCoreNum <= 0)
    throw std::invalid_argument(
        "GroupedMatmulPerTokenQuant: invalid attributes/core count");
  const bool bf = std::strcmp(outputDtype, "bfloat16") == 0;
  const auto& a = Tensor(info_x, 2, 3);
  const auto& b = Tensor(info_weight, 3, 3);
  const auto& xs = Tensor(info_xScale, 1, 0);
  const auto& ws = Tensor(info_weightScale, 2, bf ? 2 : 0);
  const auto& gl = Tensor(info_groupList, 1, 6);
  const auto& out = Tensor(info_y, 2, bf ? 2 : 1);
  const int64_t M = a.shape[0], K = a.shape[1], E = b.shape[0], N = b.shape[2];
  if (M < 1 || M > 32768 || K < 1 || K > 8192 || E < 1 || E > 128 || N < 1 ||
      N > 8192 || b.shape[1] != K || xs.shape[0] != M || ws.shape[0] != E ||
      ws.shape[1] != N || gl.shape[0] != E || out.shape[0] != M || out.shape[1] != N)
    throw std::invalid_argument("GroupedMatmulPerTokenQuant: shape mismatch");

  // Alignment facts the guards below share. `cacheAligned` means every operand
  // starts on a cache line, which the kernels that read wide words from GM
  // need; `scalarOutputWindow` means the whole output fits one 32-byte window,
  // which the kernels that write it with packed scalar stores need.
  const uintptr_t operandBits =
      reinterpret_cast<uintptr_t>(x) | reinterpret_cast<uintptr_t>(weight) |
      reinterpret_cast<uintptr_t>(xScale) | reinterpret_cast<uintptr_t>(weightScale) |
      reinterpret_cast<uintptr_t>(groupList) | reinterpret_cast<uintptr_t>(y);
  const bool cacheAligned = (operandBits & 63u) == 0u;
  const bool scalarOutputWindow =
      ((reinterpret_cast<uintptr_t>(y) & 127u) + uint64_t(M) * uint64_t(N) * 2u) <= 32u;

  // Packed shape arguments for the tiny kernels. Each encoding only has room
  // for the shapes its own guard admits, so these are meaningful only inside
  // those guards.
  const uint32_t tinyDims = PackTinyDims(uint32_t(M), uint32_t(N), uint32_t(K),
                                         uint32_t(E), uint32_t(groupListType));
  const uint32_t capacityDims = uint32_t((M - 1) | ((K - 1) << 2) | ((N - 1) << 5) |
                                         ((E - 1) << 7) | (groupListType << 14));
  const uint32_t stagedDims = uint32_t((M - 1) | ((N - 1) << 6) | ((K - 1) << 12) |
                                       ((E - 1) << 15) | (groupListType << 19));

  // ---- Shapes that fit in a few machine words ---------------------------

  // 2x2x2 and smaller, fully aligned: one core packs the whole output.
  if (E == 1 && M <= 2 && K <= 2 && N <= 2 && cacheAligned) {
    const uint32_t dims =
        uint32_t((M - 1) | ((K - 1) << 2) | ((N - 1) << 5) | (groupListType << 14));
    GMM_BY_BF_CALL(tiny_capacity_contract::Select, x, weight, xScale,
                   weightScale, groupList, y, dims, stream);
    return;
  }

  // Tiny, but an operand is misaligned for the scalar paths: stage via UB.
  if (K <= 8 && E <= 16 && uint64_t(M) * uint64_t(N) <= 64u &&
      (((reinterpret_cast<uintptr_t>(xScale) & 3u) != 0u) ||
       ((reinterpret_cast<uintptr_t>(weightScale) & (bf ? 1u : 3u)) != 0u) ||
       ((reinterpret_cast<uintptr_t>(groupList) & 7u) != 0u))) {
    GMM_BY_BF(TinySingleCoreStaged, 1, x, weight, xScale, weightScale,
              groupList, y, stagedDims);
    return;
  }

  // E == 1, N <= 2, output in one aligned window: one block per row, packed
  // scalar store.
  if (scalarOutputWindow && E == 1 && M <= 4 &&
      uint64_t(M) <= 2 * uint64_t(availableCoreNum) && N <= 32 && K <= 8 &&
      uint64_t(M) * uint64_t(N) <= 32u && uint64_t(M) * uint64_t(K) <= 64u &&
      uint64_t(K) * uint64_t(N) <= 64u && uint64_t(M) * 4u <= 64u &&
      uint64_t(N) * (bf ? 2u : 4u) <= 64u && N <= 2 &&
      (reinterpret_cast<uintptr_t>(y) & uint64_t(N * 2 - 1)) == 0) {
    GMM_BY_DTYPE_2T(TinyRowKernel, true, true, uint32_t(M), x, weight, xScale,
                    weightScale, groupList, y, tinyDims);
    return;
  }

  // K == N == 2, fp16: one block per expert with the 2x2 weights in registers
  // and the rows packed into 64-bit stores.
  if (!bf && groupListType == 0 && E >= 2 && E <= M && M <= 4 &&
      uint64_t(E) <= 2 * uint64_t(availableCoreNum) && K == 2 && N == 2 &&
      scalarOutputWindow && cacheAligned) {
    TinyExpert2x2<float, half, true><<<uint32_t(E), nullptr, stream>>>(
        x, weight, xScale, weightScale, groupList, y, tinyDims);
    return;
  }

  // Both operands and the output fit a couple of words: the capacity kernels.
  if (uint64_t(M) * K <= 8u && uint64_t(K) * N <= 8u && uint64_t(M) * 4u <= 16u &&
      uint64_t(N) * (bf ? 2u : 4u) <= 8u && uint64_t(M) * N * 2u <= 16u &&
      scalarOutputWindow && (reinterpret_cast<uintptr_t>(y) & 1u) == 0u) {
    // The contract variant reads the group list as one wide word, so it needs
    // that list aligned and wholly inside one 64-byte line.
    if (E >= 2u && E <= 8u && (reinterpret_cast<uintptr_t>(groupList) & 7u) == 0u &&
        (reinterpret_cast<uintptr_t>(groupList) & 63u) + uint64_t(E) * 8u <= 64u) {
      GMM_BY_BF_CALL(tiny_capacity_contract::Select, x, weight, xScale,
                     weightScale, groupList, y, capacityDims, stream);
      return;
    }
    GMM_BY_BF_CALL(tiny_capacity_unrolled::Select, x, weight, xScale,
                   weightScale, groupList, y, capacityDims, stream);
    return;
  }

  // ---- One long dot product ---------------------------------------------

  if (E == 1 && M == 1 && N == 2 && K >= 1024 && K <= 8192) {
    const bool scalar = (uint64_t(y) & 31u) == 0u && scalarOutputWindow;
    GMM_BY_BF_CALL(longdot_capacity::LaunchForK, x, weight, xScale, weightScale,
                   y, uint32_t(K), scalar, stream);
    return;
  }

  // ---- Remaining tiny shapes --------------------------------------------

  GeneralVectorDims vp{uint32_t(M), uint32_t(K), uint32_t(N), uint32_t(E),
                       uint32_t(groupListType)};

  // E == 1: no group list to scan, one block per row.
  if (E == 1 && M <= 4 && uint64_t(M) <= 2 * uint64_t(availableCoreNum) && N <= 32 &&
      K <= 8 && uint64_t(M) * uint64_t(N) <= 32u && uint64_t(M) * uint64_t(K) <= 64u &&
      uint64_t(K) * uint64_t(N) <= 64u && uint64_t(M) * 4u <= 64u &&
      uint64_t(N) * (bf ? 2u : 4u) <= 64u) {
    GMM_BY_DTYPE_2T(TinyRowKernel, true, false, uint32_t(M), x, weight, xScale,
                    weightScale, groupList, y, tinyDims);
    return;
  }

  // E == 1 and the whole problem in one cache line each: one block, GM direct.
  if (E == 1 && K <= 8 && uint64_t(M) * uint64_t(N) <= 32 &&
      uint64_t(M) * uint64_t(K) <= 64 &&
      uint64_t(E) * uint64_t(K) * uint64_t(N) <= 64 && uint64_t(M) * 4 <= 64 &&
      uint64_t(E) * uint64_t(N) * (bf ? 2u : 4u) <= 64 && cacheAligned) {
    const uint32_t directDims = uint32_t((M - 1) | ((N - 1) << 4) | ((K - 1) << 9) |
                                         ((E - 1) << 12) | (groupListType << 15));
    GMM_BY_BF(TinySingleCoreDirect, 1, x, weight, xScale, weightScale,
              groupList, y, directDims);
    return;
  }

  // At most one token per expert: one block per expert.
  if (groupListType == 0 && E >= 2 && E <= M && M <= 4 &&
      uint64_t(E) <= 2 * uint64_t(availableCoreNum) && K <= 8 && N <= 32 &&
      uint64_t(M) * uint64_t(N) <= 32) {
    if (K == 2 && N == 2) {
      if (!bf && cacheAligned && scalarOutputWindow) {
        TinyExpert2x2<float, half, true><<<uint32_t(E), nullptr, stream>>>(
            x, weight, xScale, weightScale, groupList, y, tinyDims);
        return;
      }
      GMM_BY_DTYPE_1T(TinyExpert2x2, false, uint32_t(E), x, weight, xScale,
                      weightScale, groupList, y, tinyDims);
      return;
    }
    GMM_BY_DTYPE(TinyExpertRows, uint32_t(E), x, weight, xScale, weightScale,
                 groupList, y, tinyDims);
    return;
  }

  // Few tokens over several experts: one block per row, scanning the list.
  if (M <= 4 && uint64_t(M) <= 2 * uint64_t(availableCoreNum) && N <= 32 && K <= 8) {
    if (bf && N == 1 && (reinterpret_cast<uintptr_t>(y) & 1u) == 0 &&
        scalarOutputWindow) {
      TinyRowBisectDirect<bfloat16_t, bfloat16_t><<<uint32_t(M), nullptr, stream>>>(
          x, weight, xScale, weightScale, groupList, y, tinyDims);
      return;
    }
    GMM_BY_DTYPE_2T(TinyRowKernel, false, false, uint32_t(M), x, weight, xScale,
                    weightScale, groupList, y, tinyDims);
    return;
  }

  // More tokens than the core budget allows: stride through them.
  if (M <= 4 && uint64_t(M) > 2 * uint64_t(availableCoreNum) && N <= 32 && K <= 8) {
    const uint32_t blocks =
        uint32_t(std::min<uint64_t>(uint64_t(M), 2 * uint64_t(availableCoreNum)));
    GMM_BY_DTYPE(TinyRowStrided, blocks, x, weight, xScale, weightScale,
                 groupList, y, tinyDims);
    return;
  }

  if (uint64_t(M) * uint64_t(N) <= 64 && K <= 8 && E <= 16) {
    GMM_BY_BF(TinySingleCoreStaged, 1, x, weight, xScale, weightScale,
              groupList, y, stagedDims);
    return;
  }

  if (M == 1 && N <= 2) {
    const uint32_t blocks = uint32_t(std::min<int64_t>(2 * availableCoreNum, N));
    GMM_BY_DTYPE(NarrowDotPerColumn, blocks, x, weight, xScale, weightScale,
                 groupList, y, vp);
    return;
  }

  // ---- N == 1 ------------------------------------------------------------

  // Enough tokens that the transposed cube path beats a vector reduction.
  if (bf && N == 1 && K >= 512 && K <= 1024 && M >= 256 && E <= 16 &&
      availableCoreNum <= 20) {
    Plan narrow{};
    narrow.m = uint32_t(M);
    narrow.k = uint32_t(K);
    narrow.e = uint32_t(E);
    narrow.n = 1;
    narrow.listType = uint32_t(groupListType);
    narrow.cores = uint32_t(availableCoreNum);
    const uint32_t compactCores = std::min(narrow.cores, 16u);
    // At most four tasks per core means every task gets its own forward event
    // id, so the AIV need not acknowledge a staged tile before the AIC reuses
    // the flag. Above that the handshake is required.
    if ((narrow.m + 63u) / 64u + narrow.e - 1u <= 4u * compactCores) {
      narrow.cores = compactCores;
      narrow_n1::Launch<64, 1024, true, false, true>(x, weight, xScale, weightScale,
                                                     groupList, y, narrow, stream);
    } else {
      narrow_n1::Launch<64, 1024, true, true>(x, weight, xScale, weightScale, groupList,
                                              y, narrow, stream);
    }
    return;
  }

  if (N == 1) {
    const uint32_t blocks = uint32_t(std::min<int64_t>(2 * availableCoreNum, M));
    if (K <= 800) {
      GMM_BY_DTYPE(N1PairDot, blocks, x, weight, xScale, weightScale, groupList,
                   y, vp, blocks);
      return;
    }
    GMM_BY_DTYPE(RowDot, blocks, x, weight, xScale, weightScale, groupList, y,
                 vp);
    return;
  }

  // ---- The cube and wide-vector families ---------------------------------

  Plan p{};
  p.m = uint32_t(M);
  p.k = uint32_t(K);
  p.n = uint32_t(N);
  p.e = uint32_t(E);
  p.listType = uint32_t(groupListType);
  p.kp = UpH(p.k, C0_I8);
  p.wstride = p.n;
  p.cores = uint32_t(availableCoreNum);
  p.vcores = p.cores * 2;

  // k == 1: a rank-1 update, nothing to reduce. See vector/outer.asc.
  if (p.k == 1) {
    const uint32_t selectedPitch = UpH(p.n, 16u), selectedNUp = UpH(p.n, 32u);
    const uint64_t selectedUb = uint64_t(32u) * selectedPitch * 6u + 12u * selectedNUp +
                                80u * 32u + selectedNUp + 32u + 32u + 32u;
    if (!bf && p.m >= 256u && p.n >= 512u && p.n <= 1024u &&
        selectedPitch / 8u <= 255u && selectedUb <= 188160u) {
      VTiling selected{p.m, p.k,          p.n,
                       p.e, p.listType,   std::min(p.vcores, (p.m + 31u) / 32u + p.e),
                       32u, selectedPitch};
      selected.coreNum = std::min(selected.coreNum, 16u);
      OuterStaticUbKernel<<<selected.coreNum, nullptr, stream>>>(
          x, weight, xScale, weightScale, groupList, y, selected);
      return;
    }
    if (!bf && p.m >= 256u && p.n >= 512u && p.n <= 1024u) {
      VTiling selected{p.m, p.k,          p.n,
                       p.e, p.listType,   std::min(p.vcores, (p.m + 19u) / 20u + p.e),
                       20u, UpH(p.n, 16u)};
      OuterQueuedKernel<<<selected.coreNum, nullptr, stream>>>(
          x, weight, xScale, weightScale, groupList, y, selected);
      return;
    }
    VTiling vt{};
    BuildOuterTiling(p, vt);
    GMM_BY_DTYPE(OuterGenericKernel, vt.coreNum, x, weight, xScale, weightScale,
                 groupList, y, vt);
    return;
  }

  // Many experts, few tokens: no m-blocking left, so stay on the AIVs.
  if (p.e >= 32 && p.m <= 256 && p.m <= 2 * p.e && p.k <= 512 && p.n <= 512) {
    VTiling vt = BuildShortGroupTiling(p);
    if (bf && p.k <= 256u && vt.kc == 128u && vt.nb == 192u && vt.coreNum <= 64u) {
      const uint64_t dims = uint64_t(p.m - 1u) | (uint64_t(p.k - 1u) << 8u) |
                            (uint64_t(p.n - 1u) << 16u) | (uint64_t(p.e - 1u) << 25u) |
                            (uint64_t(vt.coreNum - 1u) << 32u) |
                            (uint64_t(p.listType) << 38u);
      ShortGroupCompactKernel<<<vt.coreNum, nullptr, stream>>>(
          x, weight, xScale, weightScale, groupList, y, dims);
      return;
    }
    GMM_BY_DTYPE(ShortGroupKernel, vt.coreNum, x, weight, xScale, weightScale,
                 groupList, y, vt);
    return;
  }

  // From here down every family is a full-K cube body. Each
  // ConfigureCubeFullK call both fills the Plan for its tile shape and reports
  // whether this shape's full-K A and B panels actually fit L1 there.

  // Medium rows per expert, wide and unaligned n: fp16 staging.
  if (!bf && p.cores <= 20u && p.e > 1u && p.e <= 16u && p.m / p.e >= 96u &&
      p.m / p.e < 256u && p.k > 256u && p.k <= 512u && p.n > 640u && p.n <= 1024u &&
      (p.k % 128u || p.n % 128u)) {
    Plan selected = p;
    if (ConfigureCubeFullK<192, 128, 96, 128, true, false>(selected)) {
      LaunchMediumHalf(x, weight, xScale, weightScale, groupList, y, selected, stream);
      return;
    }
  }

  // n and k both 128-aligned: 64x128 tiles with a prefetched B.
  if (p.cores <= 20u && p.e > 1u && p.e <= 16u && p.m / p.e >= 64u &&
      p.m / p.e < 256u && p.n >= 384u && p.n <= 640u && p.n % 128u == 0u &&
      p.k >= 128u && p.k <= 512u && p.k % 128u == 0u) {
    Plan selected = p;
    if (ConfigureCubeFullK<64, 128, 128, 64, true, false>(selected)) {
      if (bf && p.k == 256u && p.n == 512u && p.e == 8u && p.cores == 20u)
        panel_tiles::Launch<128, 256, 64, 16>(x, weight, xScale, weightScale, groupList,
                                              y, selected, stream);
      else
        LaunchAlignedTiles(x, weight, xScale, weightScale, groupList, y, selected, bf,
                           stream);
      return;
    }
  }

  // Many rows per expert over an unaligned n: repack the weights into an
  // aligned pitch first. See cube/pack_weights.asc.
  const bool packWeights = p.m / p.e >= 256u && p.n >= 512u && p.n % 32u != 0u &&
                           p.k >= 128u &&
                           uint64_t(p.m / p.e >= 512u ? 464u : 480u) * p.kp <= L1_BYTES;
  if (packWeights && p.cores == 20u) {
    if (bf && p.k == 1023u && p.n == 1025u && p.e == 7u && p.m / p.e < 512u) {
      packed_tail::Launch<true, 1023, 1025, 7>(x, weight, xScale, weightScale,
                                               groupList, y, p, stream);
      return;
    }
    if (!bf && p.k == 767u && p.n == 1025u && p.e == 4u) {
      packed_tail::Launch<false, 767, 1025, 4>(x, weight, xScale, weightScale,
                                               groupList, y, p, stream);
      return;
    }
  }
  if (packWeights) {
    Plan packed = p;
    packed.wstride = UpH(p.n, 128u);
    if (bf && p.cores <= 20u && p.e <= 16u && p.m / p.e < 512u && p.k > 512u &&
        p.k <= 1024u && p.n <= 1280u && uint64_t(480u) * p.kp <= 524032u &&
        ConfigureCubeFullK<192, 128, 128, 64, true, false>(packed)) {
      Scratch packedWeight(uint64_t(p.e) * p.k * packed.wstride);
      LaunchPackedWeights<true>(x, weight, xScale, weightScale, groupList, y,
                                (GM_ADDR)packedWeight.p, packed, stream);
      return;
    }
    if (!bf && ConfigureCubeFullK<224, 128, 128, 64, true, false>(packed) &&
        p.e <= 16u && p.cores <= 20u && p.k <= 1024u && p.n <= 1280u &&
        uint64_t(480u) * p.kp <= 524032u) {
      Scratch packedWeight(uint64_t(p.e) * p.k * packed.wstride);
      LaunchPackedWeights<false>(x, weight, xScale, weightScale, groupList, y,
                                 (GM_ADDR)packedWeight.p, packed, stream);
      return;
    }
  }

  const uint32_t rowsPerExpert = p.m / p.e;

  // Narrow n: one 384-K Mmad per tile, walked n-major so B stays resident.
  if (bf && p.cores <= 20u && p.e > 1u && p.e <= 16u && p.m / p.e >= 96u &&
      p.m / p.e < 256u && p.n >= 192u && p.n <= 320u && p.k > 256u && p.k <= 384u) {
    Plan selected = p;
    if (ConfigureCubeFullK<96, 128, 384, 48, false, true>(selected)) {
      LaunchNarrowN(x, weight, xScale, weightScale, groupList, y, selected, stream);
      return;
    }
  }

  // Few rows per expert: 96x128 tiles with B streamed one slab at a time.
  if (rowsPerExpert < 96 && p.n <= 640 && p.kp <= 512 &&
      ConfigureCubeFullK<96, 128, 512, 48, false, true>(p)) {
    if (bf && p.k == 511u && p.n == 513u && p.e == 4u && p.cores == 20u)
      LaunchShortRows<true>(x, weight, xScale, weightScale, groupList, y, p, bf,
                            stream);
    else
      LaunchShortRows<false>(x, weight, xScale, weightScale, groupList, y, p, bf,
                             stream);
    return;
  }

  // Many rows per expert over a 256-aligned n: 128x256 paired-output tiles.
  if (!bf && availableCoreNum <= 20 && rowsPerExpert >= 256u && p.n >= 512u &&
      p.n % 256u == 0u && p.k % 128u == 0u && p.wstride == p.n &&
      uint64_t(128u + 2u * 256u) * p.kp <= 524032u) {
    Plan selected = p;
    selected.cores = std::min(selected.cores, 20u);
    if (ConfigureCubeFullK<128, 256, 128, 32, true, false>(selected)) {
      half_pair::Launch(x, weight, xScale, weightScale, groupList, y, selected, stream);
      return;
    }
  }

  // Nothing above claimed the shape: the general cube path, which stages K
  // through L1 in slabs and so accepts any shape.
  p.wstride = p.n;
  LeanPlanCube(p);
  Scratch scratch(CubeFullKStagingBytes(p));
  LaunchAndSync(stream, [&] {
    GMM_BY_DTYPE(CubeMix, p.cores, x, weight, xScale, weightScale, groupList, y,
                 (GM_ADDR)scratch.p, p);
  });
}

#undef GMM_BY_DTYPE
#undef GMM_BY_DTYPE_1T
#undef GMM_BY_DTYPE_2T
#undef GMM_BY_BF
#undef GMM_BY_BF_CALL
