namespace gmmptq {

// Medium bf16-scale family (rows/expert in [96, 256), n in (640, 1024]) in fp16
// staging, with the weighted tile ownership that evens out the short tail
// strips of a 192-row block.
template <typename ScaleT, typename OutT>
__global__ __aicore__ void MediumHalfKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                            GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                            GM_ADDR staging, uint32_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  Plan p = PackedPlan<9, 10, 4, 5>::Decode(dims);
  CubeFullKBodyScalarHalf<ScaleT, OutT, 192, 128, 96, 128, false, true, false, true,
                          true, true, true, true, true>(x, w, xs, ws, gl, y, staging,
                                                        p);
}

inline void LaunchMediumHalf(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl,
                             GM_ADDR y, const Plan& p, aclrtStream stream) {
  const uint32_t dims = PackedPlan<9, 10, 4, 5>::Encode(p);
  Scratch scratch(CubeFullKStagingBytes(p) / 2u);
  LaunchAndSync(stream, [&] {
    MediumHalfKernel<float, half>
        <<<p.cores, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)scratch.p, dims);
  });
}

}  // namespace gmmptq

// Paired-output variant for the 256-wide fp16 shape: tiles are 128x256, so one
// AIV pass covers two output blocks and the staged tile is read back flat.
namespace half_pair {
using namespace gmmptq;

template <typename ScaleT, typename OutT>
__global__ __aicore__ void Kernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                  GM_ADDR gl, GM_ADDR y, GM_ADDR staging,
                                  uint32_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  Plan p = PackedPlan<3, 6, 7, 5, 7, 7>::Decode(dims);
  CubeFullKUnitBodyScalarHalf<float, half, 128, 256, 128, 32, false, true, false, true,
                              true, true, true, true, true, false, false>(
      x, w, xs, ws, gl, y, staging, p);
}

inline void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                   const Plan& p, aclrtStream stream) {
  const uint32_t dims = PackedPlan<3, 6, 7, 5, 7, 7>::Encode(p);
  Scratch scratch(CubeFullKStagingBytes(p) / 2u);
  LaunchAndSync(stream, [&] {
    Kernel<float, half>
        <<<p.cores, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)scratch.p, dims);
  });
}

}  // namespace half_pair
