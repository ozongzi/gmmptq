namespace gmmptq {

// Weight-repacking family (rows/expert >= 256, n not a multiple of 32).
//
// An unaligned n makes every B load in the cube body a strided Nd2Nz, and with
// enough rows per expert the weights are read many times over. The AIVs copy
// the active experts' weights once into a 128-aligned pitch first, then the
// cube body reads that instead; SyncAll separates the two phases.
template <bool BF>
__global__ __aicore__ void PackedWeightsKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                               GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                               GM_ADDR st, GM_ADDR packed,
                                               uint32_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  Plan p = PackedPlan<10, 11, 4, 5>::Decode(dims);
  p.wstride = (p.n + 127u) & ~127u;
  p.vcores = 2u * p.cores;
  if ASCEND_IS_AIV {
    // bf16 double-buffers the copy; fp16 has half the staging to hide and does
    // better with the single-buffer path.
    PackActiveWeightRowsInline<true, BF>(w, packed, p.e * p.k, p.k, p.n, p.wstride,
                                         p.vcores, gl, p.listType);
  }
  AscendC::SyncAll<false>();
  if constexpr (BF)
    CubeFullKUnitBody<bfloat16_t, bfloat16_t, 192, 128, 128, 64, false, true, false,
                      true>(x, packed, xs, ws, gl, y, st, p);
  else
    CubeFullKBodyScalarHalf<float, half, 224, 128, 128, 64, false, true, false, true,
                            false, false, false, false, true>(x, packed, xs, ws, gl, y,
                                                              st, p);
}

template <bool BF>
inline void LaunchPackedWeights(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                GM_ADDR gl, GM_ADDR y, GM_ADDR packed, const Plan& p,
                                aclrtStream stream) {
  const uint32_t dims = PackedPlan<10, 11, 4, 5>::Encode(p);
  Scratch staging(CubeFullKStagingBytes(p) / (BF ? 1u : 2u));
  LaunchAndSync(stream, [&] {
    PackedWeightsKernel<BF><<<p.cores, nullptr, stream>>>(
        x, w, xs, ws, gl, y, (GM_ADDR)staging.p, packed, dims);
  });
}

}  // namespace gmmptq

// Tail variant of the repacking family for the two shapes whose last n-tile is
// a single channel wide (n = 1025 over 128-wide tiles).
//
// These bake their shape into the kernel rather than packing it into `dims`, so
// the body's K and N bounds are compile-time constants and the tail tile's
// tight-pitch dequantization folds away. That is also why there is one
// instantiation per shape instead of a runtime parameter.
namespace packed_tail {
using namespace gmmptq;

constexpr uint32_t PITCH = 1152;  // 1025 rounded up to a 128 multiple
constexpr uint32_t CORES = 20;

template <bool BF, uint32_t K, uint32_t N, uint32_t E, bool GT>
__global__ __aicore__ void Kernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                  GM_ADDR gl, GM_ADDR y, GM_ADDR st, GM_ADDR packed) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  Plan p{};
  p.k = K;
  p.n = N;
  p.e = E;
  p.cores = CORES;
  p.vcores = 2 * CORES;
  p.listType = GT;
  p.kl = (K + C0_I8 - 1u) & ~(C0_I8 - 1u);
  p.wstride = PITCH;
  if ASCEND_IS_AIV {
    PackActiveWeightRowsInline<true, BF>(w, packed, p.e * p.k, p.k, p.n, p.wstride,
                                         p.vcores, gl, p.listType);
  }
  AscendC::SyncAll<false>();
  if constexpr (BF)
    CubeFullKUnitBody<bfloat16_t, bfloat16_t, 192, 128, 128, 64, false, true, false,
                      true, true>(x, packed, xs, ws, gl, y, st, p);
  else
    CubeFullKBodyScalarHalf<float, half, 224, 128, 128, 64, false, true, false, true,
                            false, false, false, false, true, 3u, true, true>(
        x, packed, xs, ws, gl, y, st, p);
}

template <bool BF, uint32_t K, uint32_t N, uint32_t E>
void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl, GM_ADDR y, Plan p,
            aclrtStream stream) {
  p.wstride = PITCH;
  if constexpr (BF)
    ConfigureCubeFullK<192, 128, 128, 64, true, false>(p);
  else
    ConfigureCubeFullK<224, 128, 128, 64, true, false>(p);
  Scratch st(CubeFullKStagingBytes(p) / (BF ? 1u : 2u));
  Scratch pw(uint64_t(E) * K * PITCH);
  LaunchAndSync(stream, [&] {
    if (p.listType)
      Kernel<BF, K, N, E, true><<<CORES, nullptr, stream>>>(
          x, w, xs, ws, gl, y, (GM_ADDR)st.p, (GM_ADDR)pw.p);
    else
      Kernel<BF, K, N, E, false><<<CORES, nullptr, stream>>>(
          x, w, xs, ws, gl, y, (GM_ADDR)st.p, (GM_ADDR)pw.p);
  });
}

}  // namespace packed_tail
