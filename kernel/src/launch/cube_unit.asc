namespace gmmptq {

// Narrow-N family (n in [192, 320], k in (256, 384]): one 384-K Mmad per tile
// with a single L0 buffer, walked n-major so B stays resident while A rotates.
template <typename ScaleT, typename OutT>
__global__ __aicore__ void NarrowNKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                         GM_ADDR gl, GM_ADDR y, GM_ADDR staging,
                                         uint32_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  Plan p = PackedPlan<9, 9, 4, 5>::Decode(dims);
  CubeFullKUnitBody<ScaleT, OutT, 96, 128, 384, 48, true, false, true, false>(
      x, w, xs, ws, gl, y, staging, p);
}

inline void LaunchNarrowN(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl,
                          GM_ADDR y, const Plan& p, aclrtStream stream) {
  const uint32_t dims = PackedPlan<9, 9, 4, 5>::Encode(p);
  Scratch scratch(CubeFullKStagingBytes(p));
  LaunchAndSync(stream, [&] {
    NarrowNKernel<bfloat16_t, bfloat16_t>
        <<<p.cores, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)scratch.p, dims);
  });
}

}  // namespace gmmptq
