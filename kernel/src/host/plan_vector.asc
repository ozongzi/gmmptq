namespace gmmptq {

// Tiling for the k == 1 outer-product family (vector/outer.asc).
//
// A k == 1 matmul is x[m] (column) times w[n] (row), so one core owns a batch
// of `kc` token rows and writes them at a pitch of `nb`. Take the widest row
// batch whose working set still fits UB, then spread the batches plus one
// per-expert remainder over the AIVs.
inline void BuildOuterTiling(const Plan& p, VTiling& out) {
  const uint32_t pitch = UpH(p.n, 16);
  const uint32_t nUp = UpH(p.n, vec::GRAIN);
  // DataCopyPad's repeat stride is 8 bits, so a wide pitch forces one row.
  uint32_t rows = (pitch / 8 > 255) ? 1u : outer::MAX_ROWS;
  const auto ubBytes = [&](uint32_t r) -> uint32_t {
    const uint32_t rUp = UpH(r, vec::GRAIN);
    return r * pitch * 6 + 12 * nUp + 80 * rUp + (nUp + vec::GRAIN) +
           (rUp + vec::GRAIN);
  };
  while (rows > 1 && ubBytes(rows) > 188160) --rows;
  out.kc = rows;
  out.nb = pitch;
  out.m = p.m;
  out.k = p.k;
  out.n = p.n;
  out.e = p.e;
  out.listType = p.listType;
  const uint32_t items = (p.m + rows - 1) / rows + p.e;
  out.coreNum = items < p.vcores ? (items ? items : 1u) : p.vcores;
}

}  // namespace gmmptq
