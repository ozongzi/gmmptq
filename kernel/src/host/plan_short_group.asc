namespace gmmptq {

// UB footprint of ShortGroupMatmul for one (K chunk, N block).
inline uint32_t ShortGroupUbBytes(uint32_t maxK, uint32_t capacityN, uint32_t nPitch) {
  const uint32_t block = maxK * capacityN;
  const uint32_t kUp = UpH(maxK, 32);
  return 128 * 8 + 256 * 4 + (kUp + 32) + (block + 32) + 4 * block + 4 * kUp +
         10 * nPitch + 32 + 2 * block + 2 * kUp + 8192;
}

// Tiling for the many-experts / few-tokens family (vector/short_group.asc).
//
// With E >= 32 and m <= 2E most experts own one or two tokens, so there is no
// m-blocking to do: a core owns whole rows and the only choice is how much of
// K and N to hold at once. Halve the K chunk until the working set fits UB,
// then widen the N block so one chunk still covers at least 8 output blocks
// (below that the reduction tail dominates).
inline VTiling BuildShortGroupTiling(const Plan& p) {
  VTiling out{};
  out.m = p.m;
  out.k = p.k;
  out.n = p.n;
  out.e = p.e;
  out.listType = p.listType;
  out.coreNum = std::min(p.vcores, p.m);
  const uint32_t nPitch = UpH(p.n, 32);
  out.nb = std::min(nPitch, 192u);
  out.kc = 128;
  const uint32_t kUp = UpH(p.k, 8);
  while (out.kc > 8 &&
         (ShortGroupUbBytes(out.kc, out.nb, nPitch) > 188160 || out.kc / 2 >= kUp))
    out.kc /= 2;
  const uint32_t minWidth = UpH((8 * nPitch + out.kc - 1) / out.kc, 32);
  out.nb = std::max(out.nb, minWidth);
  return out;
}

}  // namespace gmmptq
