// Local measurement driver: feeds one gmmbench case through the submission's
// run_kernel on real silicon and writes the output back for verification.
//
// Timing is NOT taken here. Host wall time around a launch is tens of
// microseconds of ACL overhead, which swamps a kernel that is supposed to run
// in one or two. The kernel is launched many times inside one process and
// msprof reports each launch's device time; `sweep.sh` aggregates those. That
// is the same path that reproduced the official tuning guide's 218 us number
// to within 3%, so it is the one measurement here that can be trusted.
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
#include <stdexcept>

#include "acl/acl.h"
#include "judge_shim.h"
#include "kernel_operator.h"
#include "tiling/platform/platform_ascendc.h"

#include "kernel.asc"   // the submission, verbatim

namespace {

void must(aclError status, const char* what) {
    if (status != ACL_SUCCESS) {
        throw std::runtime_error(std::string(what) + " failed: " + std::to_string(status));
    }
}

std::vector<uint8_t> slurp(const std::string& path, size_t expect) {
    FILE* file = fopen(path.c_str(), "rb");
    if (!file) throw std::runtime_error("cannot open " + path);
    fseek(file, 0, SEEK_END);
    long size = ftell(file);
    fseek(file, 0, SEEK_SET);
    if (expect && size_t(size) != expect) {
        fclose(file);
        throw std::runtime_error(path + ": " + std::to_string(size) + " bytes, expected " +
                                 std::to_string(expect));
    }
    const size_t count = static_cast<size_t>(size);  // named, or this is a function declaration
    std::vector<uint8_t> bytes(count);
    if (fread(bytes.data(), 1, bytes.size(), file) != bytes.size()) {
        fclose(file);
        throw std::runtime_error("short read on " + path);
    }
    fclose(file);
    return bytes;
}

void* to_device(const std::vector<uint8_t>& host) {
    void* device = nullptr;
    must(aclrtMalloc(&device, host.size() ? host.size() : 32, ACL_MEM_MALLOC_HUGE_FIRST),
         "aclrtMalloc");
    if (host.size()) {
        must(aclrtMemcpy(device, host.size(), host.data(), host.size(),
                         ACL_MEMCPY_HOST_TO_DEVICE),
             "aclrtMemcpy H2D");
    }
    return device;
}

} // namespace

int main(int argc, char** argv) {
    std::string dir;
    int device_id = 0, iters = 20, cores = 0;
    std::string out_path;
    for (int i = 1; i < argc; i++) {
        std::string arg = argv[i];
        auto next = [&]() -> const char* {
            if (i + 1 >= argc) { fprintf(stderr, "%s needs a value\n", arg.c_str()); exit(2); }
            return argv[++i];
        };
        if (arg == "--dir") dir = next();
        else if (arg == "--out") out_path = next();
        else if (arg == "--device") device_id = atoi(next());
        else if (arg == "--iters") iters = atoi(next());
        else if (arg == "--cores") cores = atoi(next());
        else { fprintf(stderr, "unknown argument %s\n", arg.c_str()); return 2; }
    }
    if (dir.empty()) {
        fprintf(stderr,
                "usage: driver --dir <case dir> [--out y.bin] [--device 0] "
                "[--iters 20] [--cores N]\n");
        return 2;
    }
    if (out_path.empty()) out_path = dir + "/out.bin";

    long long e = 0, m = 0, k = 0, n = 0, gt = 0;
    char dtype[32] = {0};
    {
        FILE* file = fopen((dir + "/shape.txt").c_str(), "r");
        if (!file) { fprintf(stderr, "cannot read %s/shape.txt\n", dir.c_str()); return 1; }
        if (fscanf(file, "%lld %lld %lld %lld %lld %31s", &e, &m, &k, &n, &gt, dtype) != 6) {
            fclose(file);
            fprintf(stderr, "%s/shape.txt is malformed\n", dir.c_str());
            return 1;
        }
        fclose(file);
    }
    const bool bf = strcmp(dtype, "bfloat16") == 0;
    const size_t wscale_bytes = bf ? 2 : 4;

    try {
        must(aclInit(nullptr), "aclInit");
        must(aclrtSetDevice(device_id), "aclrtSetDevice");
        aclrtStream stream = nullptr;
        must(aclrtCreateStream(&stream), "aclrtCreateStream");

        auto x_host = slurp(dir + "/x.bin", size_t(m) * k);
        auto w_host = slurp(dir + "/weight.bin", size_t(e) * k * n);
        auto xs_host = slurp(dir + "/xscale.bin", size_t(m) * 4);
        auto ws_host = slurp(dir + "/wscale.bin", size_t(e) * n * wscale_bytes);
        auto gl_host = slurp(dir + "/grouplist.bin", size_t(e) * 8);

        void* x = to_device(x_host);
        void* weight = to_device(w_host);
        void* xscale = to_device(xs_host);
        void* wscale = to_device(ws_host);
        void* grouplist = to_device(gl_host);
        const size_t y_bytes = size_t(m) * n * 2;
        void* y = nullptr;
        must(aclrtMalloc(&y, y_bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc y");
        // Poison the output so a kernel that skips a tail leaves evidence
        // rather than inheriting a plausible zero.
        {
            std::vector<uint8_t> poison(y_bytes, 0xAB);
            must(aclrtMemcpy(y, y_bytes, poison.data(), y_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
                 "poison y");
        }

        const int64_t x_shape[2] = {m, k};
        const int64_t w_shape[3] = {e, k, n};
        const int64_t xs_shape[1] = {m};
        const int64_t ws_shape[2] = {e, n};
        const int64_t gl_shape[1] = {e};
        const int64_t y_shape[2] = {m, n};
        const TensorInfo x_info{2, x_shape, JUDGE_INT8};
        const TensorInfo w_info{3, w_shape, JUDGE_INT8};
        const TensorInfo xs_info{1, xs_shape, JUDGE_FLOAT32};
        const TensorInfo ws_info{2, ws_shape, bf ? JUDGE_BFLOAT16 : JUDGE_FLOAT32};
        const TensorInfo gl_info{1, gl_shape, JUDGE_INT64};
        const TensorInfo y_info{2, y_shape, bf ? JUDGE_BFLOAT16 : JUDGE_FLOAT16};
        const TensorGroupInfo gx{1, &x_info}, gw{1, &w_info}, gxs{1, &xs_info},
            gws{1, &ws_info}, ggl{1, &gl_info}, gy{1, &y_info};

        int64_t available = cores;
        if (available <= 0) {
            auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
            available = int64_t(platform->GetCoreNumAic());
        }

        for (int pass = 0; pass < iters; pass++) {
            run_kernel((GM_ADDR)x, gx, (GM_ADDR)weight, gw, (GM_ADDR)xscale, gxs,
                       (GM_ADDR)wscale, gws, (GM_ADDR)grouplist, ggl, (GM_ADDR)y, gy,
                       available, stream, gt, dtype);
            must(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }

        std::vector<uint8_t> y_host(y_bytes);
        must(aclrtMemcpy(y_host.data(), y_bytes, y, y_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
             "aclrtMemcpy D2H");
        FILE* out = fopen(out_path.c_str(), "wb");
        if (!out) throw std::runtime_error("cannot write " + out_path);
        fwrite(y_host.data(), 1, y_host.size(), out);
        fclose(out);

        printf("ran E=%lld M=%lld K=%lld N=%lld gt=%lld %s on %lld cores, %d passes -> %s\n",
               e, m, k, n, gt, dtype, (long long)available, iters, out_path.c_str());

        aclrtFree(x); aclrtFree(weight); aclrtFree(xscale);
        aclrtFree(wscale); aclrtFree(grouplist); aclrtFree(y);
        aclrtDestroyStream(stream);
        aclrtResetDevice(device_id);
        aclFinalize();
    } catch (const std::exception& error) {
        fprintf(stderr, "driver: %s\n", error.what());
        return 1;
    }
    return 0;
}
