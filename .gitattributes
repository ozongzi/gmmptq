# 容器里跑的东西必须是 LF。这台机器 core.autocrlf=true，重新 checkout 一次就会把
# kernel/ 下的脚本和源码换成 CRLF，shebang 里多一个 CR 就是 bash 语法错误，
# 而备份的全部意义就是拿回去逐字节相同。
kernel/** text eol=lf

# The verbatim fragments must stay byte-identical to the kernel.asc they were
# cut from, so they are never line-ending-normalized, whatever core.autocrlf says.
gen/chunks/** -text

# Body sources are alternative implementations of a slot; the default body must
# stay byte-identical to the fragment it replaces (body::tests::
# the_default_body_is_the_fragment_it_replaces), so they are not normalized
# either.
gen/bodies/** -text
