namespace tiny_capacity_contract {
template <bool BF, uint32_t RC, uint32_t KC, uint32_t NC, bool BFOnly = false>
inline bool TryCell(uint32_t m, uint32_t k, uint32_t n, GM_ADDR x, GM_ADDR w,
                    GM_ADDR xs, GM_ADDR ws, GM_ADDR gl, GM_ADDR y, uint32_t dims,
                    aclrtStream stream) {
  if constexpr (BFOnly && !BF) {
    return false;
  } else {
    if (m > RC || k > KC || n > NC) return false;
    if (((dims >> 7u) & 127u) == 0u) {
      TINY_CAPACITY_RUN(SearchTinyCapacityContract11850017, BF, RC, KC, NC, true);
    } else {
      TINY_CAPACITY_RUN(SearchTinyCapacityContract11850017, BF, RC, KC, NC, false);
    }
    return true;
  }
}
template <bool BF>
inline void Select(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                   uint32_t dims, aclrtStream stream) {
  const uint32_t m = (dims & 3u) + 1u, k = ((dims >> 2u) & 7u) + 1u,
                 n = ((dims >> 5u) & 3u) + 1u;
#define TINY_CAPACITY_TRY(RC, KC, NC, BFOnly)                                      \
  if (TryCell<BF, RC, KC, NC, BFOnly>(m, k, n, x, w, xs, ws, gl, y, dims, stream)) \
  return
  TINY_CAPACITY_TRY(1u, 1u, 1u, false);
  TINY_CAPACITY_TRY(1u, 1u, 2u, false);
  TINY_CAPACITY_TRY(1u, 1u, 4u, true);
  TINY_CAPACITY_TRY(1u, 2u, 1u, false);
  TINY_CAPACITY_TRY(1u, 2u, 2u, false);
  TINY_CAPACITY_TRY(1u, 2u, 4u, true);
  TINY_CAPACITY_TRY(1u, 4u, 1u, false);
  TINY_CAPACITY_TRY(1u, 4u, 2u, false);
  TINY_CAPACITY_TRY(1u, 8u, 1u, false);
  TINY_CAPACITY_TRY(2u, 1u, 1u, false);
  TINY_CAPACITY_TRY(2u, 1u, 2u, false);
  TINY_CAPACITY_TRY(2u, 1u, 4u, true);
  TINY_CAPACITY_TRY(2u, 2u, 1u, false);
  TINY_CAPACITY_TRY(2u, 2u, 2u, false);
  TINY_CAPACITY_TRY(2u, 2u, 4u, true);
  TINY_CAPACITY_TRY(2u, 4u, 1u, false);
  TINY_CAPACITY_TRY(2u, 4u, 2u, false);
  TINY_CAPACITY_TRY(4u, 1u, 1u, false);
  TINY_CAPACITY_TRY(4u, 1u, 2u, false);
  TINY_CAPACITY_TRY(4u, 2u, 1u, false);
  TINY_CAPACITY_TRY(4u, 2u, 2u, false);
#undef TINY_CAPACITY_TRY
  throw std::invalid_argument("outside registered M/K/N capacity family");
}
#undef TINY_CAPACITY_RUN
}
namespace gmmptq {
template <typename ScaleT, typename OutT, bool UnitFlagChain>
__global__ __aicore__ void ShortRowsKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                           GM_ADDR gl, GM_ADDR y, GM_ADDR st,
                                           uint32_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
  Plan p = PackedPlan<9, 10, 7, 5>::Decode(dims);
  CubeFullKBody<ScaleT, OutT, 96, 128, 256, 96, false, false, true, true, 1u, true,
                true, true, 0u, UnitFlagChain>(x, w, xs, ws, gl, y, st, p);
}
template <typename ScaleT, typename OutT>
__global__ __aicore__ void ShortRowsWideKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                               GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                               GM_ADDR st, uint32_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  Plan p = PackedPlan<9, 10, 7, 5>::Decode(dims);
  CubeFullKBody<ScaleT, OutT, 96, 128, 512, 48, false, false, true, true>(x, w, xs, ws,
                                                                          gl, y, st, p);
}
template <typename ScaleT, typename OutT>
__global__ __aicore__ void ShortRowsPlanKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                               GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                               GM_ADDR st, Plan p) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  CubeFullKBody<ScaleT, OutT, 96, 128, 512, 48, false, false, true, true>(x, w, xs, ws,
                                                                          gl, y, st, p);
}
inline void LaunchShortRowsWide(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                GM_ADDR gl, GM_ADDR y, const Plan& incoming, bool bf,
                                aclrtStream stream) {
  Plan p = incoming;
  p.cores = std::min(incoming.cores, PhysicalAicCores());
  p.vcores = p.cores * 2u;
  Scratch scratch(CubeFullKStagingBytes(p));
  LaunchAndSync(stream, [&] {
    if (p.cores <= 32u) {
      const uint32_t dims = PackedPlan<9, 10, 7, 5>::Encode(p);
      if (bf)
        ShortRowsWideKernel<bfloat16_t, bfloat16_t><<<p.cores, nullptr, stream>>>(
            x, w, xs, ws, gl, y, (GM_ADDR)scratch.p, dims);
      else
        ShortRowsWideKernel<float, half><<<p.cores, nullptr, stream>>>(
            x, w, xs, ws, gl, y, (GM_ADDR)scratch.p, dims);
    } else {
      if (bf)
        ShortRowsPlanKernel<bfloat16_t, bfloat16_t>
            <<<p.cores, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)scratch.p, p);
      else
        ShortRowsPlanKernel<float, half>
            <<<p.cores, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)scratch.p, p);
    }
  });
}
inline uint64_t ShortRowsTiles(const Plan& p) {
  return ((uint64_t(p.m) + 95u) / 96u + p.e - 1u) * ((uint64_t(p.n) + 127u) / 128u);
}
template <bool UnitFlagChain>
inline void LaunchShortRows(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl,
                            GM_ADDR y, const Plan& incoming, bool bf,
                            aclrtStream stream) {
  Plan p = incoming;
  p.cores = std::min(p.cores, PhysicalAicCores());
  if (p.cores > 32u || ShortRowsTiles(p) > 4ull * p.cores) {
    LaunchShortRowsWide(x, w, xs, ws, gl, y, incoming, bf, stream);
    return;
  }
  p.vcores = p.cores;
  Scratch scratch(CubeFullKStagingBytes(p));
  const uint32_t dims = PackedPlan<9, 10, 7, 5>::Encode(p);
  LaunchAndSync(stream, [&] {
    if (bf)
      ShortRowsKernel<bfloat16_t, bfloat16_t, UnitFlagChain>
          <<<p.cores, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)scratch.p, dims);
    else
      ShortRowsKernel<float, half, UnitFlagChain>
          <<<p.cores, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)scratch.p, dims);
  });
}
template <typename ScaleT, typename OutT>
__global__ __aicore__ void AlignedTilesKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                              GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                              GM_ADDR staging, uint32_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  Plan p = PackedPlan<2, 3, 4, 5, 7, 7>::Decode(dims);
  CubeFullKBody<ScaleT, OutT, 64, 128, 128, 64, false, true, false, false, 2u, true>(
      x, w, xs, ws, gl, y, staging, p);
}
inline void LaunchAlignedTiles(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl,
                               GM_ADDR y, const Plan& p, bool bf, aclrtStream stream) {
  const uint32_t dims = PackedPlan<2, 3, 4, 5, 7, 7>::Encode(p);
  Scratch stage(CubeFullKStagingBytes(p));
  LaunchAndSync(stream, [&] {
    if (bf)
      AlignedTilesKernel<bfloat16_t, bfloat16_t>
          <<<p.cores, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)stage.p, dims);
    else
      AlignedTilesKernel<float, half>
          <<<p.cores, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)stage.p, dims);
  });
}
}
namespace panel_tiles {
using namespace gmmptq;
template <uint32_t BM, uint32_t BK, uint32_t RV, uint32_t CORES, bool GT>
__global__ __aicore__ void Kernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                  GM_ADDR gl, GM_ADDR y, GM_ADDR st) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  Plan p{};
  p.k = 256;
  p.n = 512;
  p.e = 8;
  p.cores = CORES;
  p.vcores = 2 * CORES;
  p.listType = GT;
  p.kl = 256;
  p.wstride = 512;
  CubeFullKBody<bfloat16_t, bfloat16_t, BM, 128, BK, RV, false, false, false, true, 2u,
                true, false, false, 4u, true, true, true, true, true, true>(x, w, xs, ws, gl, y, st, p);
}
template <uint32_t BM, uint32_t BK, uint32_t RV, uint32_t CORES>
void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl, GM_ADDR y, Plan p,
            aclrtStream stream) {
  p.cores = CORES;
  ConfigureCubeFullK<BM, 128, BK, RV, false, false>(p);
  Scratch st(CubeFullKStagingBytes(p));
  LaunchAndSync(stream, [&] {
    if (p.listType)
      Kernel<BM, BK, RV, CORES, true>
          <<<CORES, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)st.p);
    else
      Kernel<BM, BK, RV, CORES, false>
          <<<CORES, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)st.p);
  });
}
}
