namespace gmmptq {
using AscendC::GlobalTensor;
using AscendC::LocalTensor;
using AscendC::TPosition;
__aicore__ inline uint32_t Ceil(uint32_t a, uint32_t b) {
  return b ? (a + b - 1) / b : 0;
}
__aicore__ inline uint32_t MinU(uint32_t a, uint32_t b) { return a < b ? a : b; }
struct VTiling {
  uint32_t m;
  uint32_t k;
  uint32_t n;
  uint32_t e;
  uint32_t listType;
  uint32_t coreNum;
  uint32_t kc;
  uint32_t nb;
};
struct Schedule {
  AscendC::GlobalTensor<int64_t> list;
  uint32_t listType;
  uint32_t experts;
  uint32_t m0;
  uint32_t nTiles;
  __aicore__ inline uint32_t Total() const {
    uint32_t total = 0, start = 0;
    for (uint32_t e = 0; e < experts; ++e) {
      uint32_t v = static_cast<uint32_t>(list.GetValue(e));
      uint32_t end = listType == 0 ? v : start + v;
      total += (end > start ? (end - start + m0 - 1) / m0 : 0u) * nTiles;
      start = end;
    }
    return total;
  }
};
struct Walk {
  GlobalTensor<int64_t> list;
  uint32_t listType;
  uint32_t experts;
  uint32_t baseM;
  uint32_t nTiles;
  uint32_t expert;
  uint32_t rowStart;
  uint32_t rows;
  uint32_t mIdx;
  uint32_t nIdx;
  uint32_t mTiles;
  uint32_t cursor;
  bool done;
  __aicore__ inline void Init(const GlobalTensor<int64_t>& glist, uint32_t type,
                              uint32_t experts_, uint32_t baseM_, uint32_t nTiles_) {
    list = glist;
    listType = type;
    experts = experts_;
    baseM = baseM_;
    nTiles = nTiles_;
    expert = 0;
    rowStart = 0;
    cursor = 0;
    mIdx = 0;
    nIdx = 0;
    rows = 0;
    mTiles = 0;
    done = false;
    Seek();
  }
  __aicore__ inline void Seek() {
    while (expert < experts) {
      uint32_t v = static_cast<uint32_t>(list.GetValue(expert));
      uint32_t end = (listType == 0) ? v : cursor + v;
      rows = (end > cursor) ? (end - cursor) : 0u;
      rowStart = cursor;
      cursor = end;
      if (rows > 0) {
        mTiles = Ceil(rows, baseM);
        mIdx = 0;
        nIdx = 0;
        return;
      }
      ++expert;
    }
    done = true;
  }
  __aicore__ inline void Next() {
    if (++nIdx < nTiles) return;
    nIdx = 0;
    if (++mIdx < mTiles) return;
    ++expert;
    Seek();
  }
};
namespace vec {
constexpr uint32_t GRAIN = 32;
}
namespace outer {
constexpr uint32_t MAX_ROWS = 32;
}
}
namespace gmmptq {
template <typename ScaleT>
__aicore__ inline void ToFloat(AscendC::LocalTensor<float> dst,
                               AscendC::LocalTensor<ScaleT> src, uint32_t count) {
  AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
}
template <>
__aicore__ inline void ToFloat<float>(AscendC::LocalTensor<float> dst,
                                      AscendC::LocalTensor<float> src, uint32_t count) {
  AscendC::Adds(dst, src, 0.0f, count);
}
__aicore__ inline void MulByRow(AscendC::LocalTensor<float> dst,
                                AscendC::LocalTensor<float> src,
                                AscendC::LocalTensor<float> col, uint32_t rows,
                                uint32_t cols, uint32_t pitch) {
  AscendC::BinaryRepeatParams rp;
  rp.dstBlkStride = 1;
  rp.src0BlkStride = 1;
  rp.src1BlkStride = 1;
  rp.dstRepStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src0RepStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src1RepStride = 0;
  for (uint32_t r = 0; r < rows; r += 255) {
    uint8_t rep = static_cast<uint8_t>(Min(255, rows - r));
    for (uint32_t c = 0; c < cols; c += F32_PER_REP) {
      uint64_t mask = Min(F32_PER_REP, cols - c);
      AscendC::Mul(dst[r * pitch + c], src[r * pitch + c], col[c], mask, rep, rp);
    }
  }
}
__aicore__ inline void MulByCol(AscendC::LocalTensor<float> value,
                                AscendC::LocalTensor<float> brcb, uint32_t rows,
                                uint32_t cols, uint32_t pitch) {
  AscendC::BinaryRepeatParams rp;
  rp.dstBlkStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src0BlkStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src1BlkStride = 1;
  rp.dstRepStride = 1;
  rp.src0RepStride = 1;
  rp.src1RepStride = 0;
  for (uint32_t r = 0; r < rows; r += F32_PER_BLK) {
    uint64_t mask = Min(F32_PER_BLK, rows - r) * F32_PER_BLK;
    for (uint32_t c = 0; c < cols; c += F32_PER_BLK * 255) {
      uint8_t rep =
          static_cast<uint8_t>(Min(F32_PER_BLK * 255, cols - c) / F32_PER_BLK);
      AscendC::Mul(value[r * pitch + c], value[r * pitch + c], brcb[r * F32_PER_BLK],
                   mask, rep, rp);
    }
  }
}
__aicore__ inline void MulByTokenScale(AscendC::LocalTensor<float> value,
                                       AscendC::LocalTensor<float> brcb, uint32_t rows,
                                       uint32_t cols, uint32_t pitch) {
  AscendC::BinaryRepeatParams rp;
  rp.dstBlkStride = 1;
  rp.src0BlkStride = 1;
  rp.src1BlkStride = 0;
  rp.dstRepStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src0RepStride = static_cast<uint16_t>(pitch / F32_PER_BLK);
  rp.src1RepStride = 1;
  for (uint32_t c = 0; c < cols; c += F32_PER_REP)
    AscendC::Mul(value[c], value[c], brcb, uint64_t(Min(F32_PER_REP, cols - c)),
                 uint8_t(rows), rp);
}
template <typename OutT>
__aicore__ inline void StoreRows(AscendC::GlobalTensor<OutT> dst,
                                 AscendC::LocalTensor<OutT> src, uint32_t rows,
                                 uint32_t cols, uint32_t pitch, uint32_t n) {
  AscendC::DataCopyPad(
      dst, src,
      AscendC::DataCopyExtParams{uint16_t(rows), cols * 2u,
                                 (pitch * 2u - Up(cols * 2u, BLK)) / BLK,
                                 (n - cols) * 2u, 0});
}
}
namespace gmmptq {
struct GeneralVectorDims {
  uint32_t m, k, n, e, listType;
};
constexpr uint32_t TINY_DIM_BITS_M = 2u;
constexpr uint32_t TINY_DIM_BITS_N = 5u;
constexpr uint32_t TINY_DIM_BITS_K = 3u;
constexpr uint32_t TINY_DIM_BITS_E = 7u;
inline uint32_t PackTinyDims(uint32_t m, uint32_t n, uint32_t k, uint32_t e,
                             uint32_t listType) {
  return (m - 1u) | ((n - 1u) << 2u) | ((k - 1u) << 7u) | ((e - 1u) << 10u) |
         (listType << 17u);
}
__aicore__ inline GeneralVectorDims UnpackTinyDims(uint32_t packed) {
  return GeneralVectorDims{(packed & 3u) + 1u, ((packed >> 7) & 7u) + 1u,
                           ((packed >> 2) & 31u) + 1u, ((packed >> 10) & 127u) + 1u,
                           (packed >> 17) & 1u};
}
__aicore__ inline uint32_t GvUp(uint32_t n, uint32_t a) { return (n + a - 1) / a * a; }
__aicore__ inline uint32_t GvMin(uint32_t a, uint32_t b) { return a < b ? a : b; }
template <AscendC::HardEvent Event>
__aicore__ inline void GvBarrier() {
  AscendC::SetFlag<Event>(0);
  AscendC::WaitFlag<Event>(0);
}
__aicore__ inline float GvFloat(uint32_t bits) {
  union {
    uint32_t u;
    float f;
  } value;
  value.u = bits;
  return value.f;
}
__aicore__ inline uint16_t GvRound16(float value, bool bf) {
  union {
    float f;
    uint32_t u;
  } v;
  v.f = value;
  if (bf) return uint16_t((v.u + 0x7fffu + ((v.u >> 16) & 1u)) >> 16);
  const uint32_t sign = (v.u >> 16) & 0x8000u, a = v.u & 0x7fffffffu;
  if (a >= 0x47800000u) return uint16_t(sign | 0x7c00u);
  if (a >= 0x38800000u)
    return uint16_t(sign | ((a + 0xfffu + ((a >> 13) & 1u) - 0x38000000u) >> 13));
  uint32_t e = a >> 23;
  if (e < 102u) return uint16_t(sign);
  uint32_t shift = 126u - e, mant = (a & 0x7fffffu) | 0x800000u;
  uint32_t base = mant >> shift, remainder = mant & ((1u << shift) - 1u),
           midpoint = 1u << (shift - 1u);
  return uint16_t(sign | (base + uint32_t(remainder > midpoint ||
                                          (remainder == midpoint && (base & 1u)))));
}
template <bool BF>
__aicore__ inline uint16_t GvEncode(float value) {
  if constexpr (BF) {
    return GvRound16(value, true);
  } else {
    union {
      half h;
      uint16_t u;
    } out;
    out.h = half(value);
    return out.u;
  }
}
__aicore__ inline void GvMulRows(AscendC::LocalTensor<float> dst,
                                 AscendC::LocalTensor<float> weights, uint32_t rows,
                                 uint32_t pitch) {
  AscendC::BinaryRepeatParams rp;
  rp.dstBlkStride = 1;
  rp.src0BlkStride = 1;
  rp.src1BlkStride = 1;
  rp.dstRepStride = uint16_t(pitch / 8);
  rp.src0RepStride = uint16_t(pitch / 8);
  rp.src1RepStride = 0;
  for (uint32_t c = 0; c < pitch; c += 64)
    AscendC::Mul(dst[c], dst[c], weights[c], uint64_t(GvMin(64, pitch - c)),
                 uint8_t(rows), rp);
}
__aicore__ inline void PreloadLine(GM_ADDR address) {
  AscendC::GlobalTensor<uint64_t> probe;
  probe.SetGlobalBuffer((__gm__ uint64_t*)address);
  AscendC::DataCachePreload(probe, int16_t(0));
}
template <bool WithGroups>
__aicore__ inline void PreloadOperands(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                       GM_ADDR groups) {
  PreloadLine(x);
  PreloadLine(w);
  PreloadLine(xs);
  PreloadLine(ws);
  if constexpr (WithGroups) PreloadLine(groups);
}
template <typename ScaleT, typename OutT>
struct TinyOperands {
  AscendC::GlobalTensor<int8_t> xg, wg;
  AscendC::GlobalTensor<float> xsg;
  AscendC::GlobalTensor<ScaleT> wsg;
  AscendC::GlobalTensor<OutT> yg;
  AscendC::GlobalTensor<int64_t> gg;
  __aicore__ inline void Bind(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                              GM_ADDR groups, GM_ADDR y) {
    xg.SetGlobalBuffer((__gm__ int8_t*)x);
    wg.SetGlobalBuffer((__gm__ int8_t*)w);
    xsg.SetGlobalBuffer((__gm__ float*)xs);
    wsg.SetGlobalBuffer((__gm__ ScaleT*)ws);
    yg.SetGlobalBuffer((__gm__ OutT*)y);
    gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  }
};
template <typename ScaleT>
__aicore__ inline float WeightScaleAt(GM_ADDR ws, uint64_t index) {
  if constexpr (sizeof(ScaleT) == 4) {
    return *(__gm__ float*)(ws + index * 4u);
  } else {
    return GvFloat(uint32_t(*(__gm__ uint16_t*)(ws + index * 2u)) << 16);
  }
}
__aicore__ inline int32_t TinyDot(const AscendC::GlobalTensor<int8_t>& xg,
                                  const AscendC::GlobalTensor<int8_t>& wg, uint32_t row,
                                  uint32_t owner, uint32_t col, uint32_t k,
                                  uint32_t n) {
  int32_t sum = 0;
  for (uint32_t i = 0; i < k; ++i)
    sum += int32_t(xg.GetValue(uint64_t(row) * k + i)) *
           int32_t(wg.GetValue((uint64_t(owner) * k + i) * n + col));
  return sum;
}
__aicore__ inline uint32_t OwnerOfRow(const AscendC::GlobalTensor<int64_t>& gg,
                                      uint32_t experts, uint32_t listType,
                                      uint32_t row) {
  uint32_t start = 0;
  for (uint32_t e = 0; e < experts; ++e) {
    const uint32_t v = uint32_t(gg.GetValue(e));
    const uint32_t end = listType == 0 ? v : start + v;
    if (row < end) return e;
    start = end;
  }
  return 0;
}
