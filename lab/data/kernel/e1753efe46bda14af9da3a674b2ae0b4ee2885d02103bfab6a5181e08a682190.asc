namespace gmmptq {
inline void Check(aclError status) {
  if (status != ACL_SUCCESS)
    throw std::runtime_error("GroupedMatmulPerTokenQuant ACL failure: " +
                             std::to_string(status));
}
struct Scratch {
  void* p = nullptr;
  explicit Scratch(size_t bytes) {
    if (bytes) Check(aclrtMalloc(&p, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
  }
  ~Scratch() {
    if (p) aclrtFree(p);
  }
  Scratch(const Scratch&) = delete;
  Scratch& operator=(const Scratch&) = delete;
};
inline uint32_t UpH(uint32_t v, uint32_t q) { return (v + q - 1) / q * q; }
template <class Issue>
inline void LaunchAndSync(aclrtStream stream, Issue issue) {
  try {
    issue();
    Check(aclrtSynchronizeStream(stream));
  } catch (...) {
    aclrtSynchronizeStream(stream);
    throw;
  }
}
inline uint32_t PhysicalAicCores() {
  auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (!platform) throw std::runtime_error("Cannot obtain physical AIC count");
  const uint32_t cores = platform->GetCoreNumAic();
  if (!cores) throw std::runtime_error("No physical AIC cores");
  return cores;
}
inline const TensorInfo& Tensor(const TensorGroupInfo& g, int rank, int dtype) {
  if (g.numTensors != 1 || !g.tensors || g.tensors[0].numDims != rank ||
      g.tensors[0].dtype != dtype || !g.tensors[0].shape)
    throw std::invalid_argument(
        "GroupedMatmulPerTokenQuant: tensor rank/dtype mismatch");
  return g.tensors[0];
}
}
namespace gmmptq {
template <uint32_t BM, uint32_t BN, uint32_t BK, uint32_t RV, bool Prefetch = false,
          bool SingleL0 = false>
inline bool ConfigureCubeFullK(Plan& p) {
  static_assert(BM > 0 && BM % 16 == 0, "BM alignment");
  static_assert(BN > 0 && BN % 32 == 0, "BN alignment");
  static_assert(BK > 0 && BK % 32 == 0, "BK alignment");
  static_assert(RV > 0 && RV <= BM && RV % 8 == 0, "RV alignment");
  static_assert(BM * BK * (SingleL0 ? 1u : 2u) <= L0A_BYTES, "L0A overflow");
  static_assert(BN * BK * (SingleL0 ? 1u : 2u) <= L0B_BYTES, "L0B overflow");
  static_assert(BM * BN * sizeof(int32_t) <= L0C_BYTES, "L0C overflow");
  constexpr uint32_t ub = RV * BN * 10u + BN * 8u + RV * 36u;
  static_assert(ub <= 192u * 1024u - 8192u - 256u, "UB overflow");
  if (!p.k || !p.n || !p.m || !p.e || !p.cores) return false;
  const uint32_t kp = UpH(p.k, C0_I8);
  const uint64_t l1 = uint64_t(BM + (Prefetch ? 2u : 1u) * BN) * kp;
  if (l1 > L1_BYTES) return false;
  p.kp = kp;
  p.m0 = BM;
  p.n0 = BN;
  p.m0r = BM;
  p.n0r = BN;
  p.n0c = BN;
  p.k0 = BK;
  p.kl = kp;
  p.nTiles = (p.n + BN - 1u) / BN;
  p.rv = RV;
  return true;
}
inline uint64_t CubeFullKStagingBytes(const Plan& p) {
  const uint64_t maxTiles = (uint64_t((p.m + p.m0 - 1u) / p.m0) + p.e) * p.nTiles;
  return maxTiles * p.m0 * p.n0 * sizeof(int32_t);
}
inline void LeanPlanCube(Plan& p) {
  uint32_t perExpert = p.e ? p.m / p.e : p.m;
  if (perExpert < 1) perExpert = 1;
  uint32_t m0 = 256;
  while (m0 > 16 && m0 / 2 >= UpH(perExpert, 16)) m0 /= 2;
  uint32_t n0 = 32768 / UpH(m0, 16);
  if (n0 > 512) n0 = 512;
  while (n0 > 32 && n0 / 2 >= UpH(p.n, 16)) n0 /= 2;
  if (n0 < 16) n0 = 16;
  uint32_t m0r = UpH(m0, 16);
  uint32_t n0r = UpH(n0, 16);
  uint32_t n0c = UpH(n0, 32);
  uint32_t k0 = 128;
  while (k0 > 32 && (m0r * k0 * 2 > L0A_BYTES || k0 * n0r * 2 > L0B_BYTES)) k0 /= 2;
  while (k0 > 32 && k0 / 2 >= p.kp) k0 /= 2;
  uint32_t kl = p.kp;
  while (kl > k0 && m0r * kl + 2 * kl * n0c > 524032u) kl -= k0;
  if (kl < k0) kl = k0;
  p.m0 = m0;
  p.n0 = n0;
  p.m0r = m0r;
  p.n0r = n0r;
  p.n0c = n0c;
  p.k0 = k0;
  p.kl = kl;
  p.nTiles = (p.n + n0 - 1) / n0;
  uint32_t pitch = UpH(n0, 8);
  uint32_t rv = 64;
  while (rv > 1 && rv * pitch * 4 * 2 + 16 * 1024 > UB_BYTES) rv /= 2;
  if (rv > m0) rv = m0 < 1 ? 1 : m0;
  p.rv = rv;
}
template <uint32_t KBits, uint32_t NBits, uint32_t EBits, uint32_t CoreBits,
          uint32_t KShift = 0u, uint32_t NShift = 0u>
struct PackedPlan {
  static constexpr uint32_t K_OFF = 0u;
  static constexpr uint32_t N_OFF = K_OFF + KBits;
  static constexpr uint32_t E_OFF = N_OFF + NBits;
  static constexpr uint32_t CORE_OFF = E_OFF + EBits;
  static constexpr uint32_t TYPE_OFF = CORE_OFF + CoreBits;
  static_assert(TYPE_OFF < 32u, "packed plan fields must fit one uint32");
  static inline uint32_t Encode(const Plan& p) {
    return ((p.k >> KShift) - 1u) << K_OFF | ((p.n >> NShift) - 1u) << N_OFF |
           (p.e - 1u) << E_OFF | (p.cores - 1u) << CORE_OFF | p.listType << TYPE_OFF;
  }
  __aicore__ static inline Plan Decode(uint32_t dims) {
    Plan p{};
    p.k = (((dims >> K_OFF) & ((1u << KBits) - 1u)) + 1u) << KShift;
    p.n = (((dims >> N_OFF) & ((1u << NBits) - 1u)) + 1u) << NShift;
    p.e = ((dims >> E_OFF) & ((1u << EBits) - 1u)) + 1u;
    p.cores = ((dims >> CORE_OFF) & ((1u << CoreBits) - 1u)) + 1u;
    p.listType = (dims >> TYPE_OFF) & 1u;
    p.kl = (p.k + C0_I8 - 1u) & ~(C0_I8 - 1u);
    p.wstride = p.n;
    return p;
  }
};
}
namespace gmmptq {
inline void BuildOuterTiling(const Plan& p, VTiling& out) {
  const uint32_t pitch = UpH(p.n, 16);
  const uint32_t nUp = UpH(p.n, vec::GRAIN);
  uint32_t rows = (pitch / 8 > 255) ? 1u : outer::MAX_ROWS;
  const auto ubBytes = [&](uint32_t r) -> uint32_t {
    const uint32_t rUp = UpH(r, vec::GRAIN);
    return r * pitch * 6 + 12 * nUp + 80 * rUp + (nUp + vec::GRAIN) +
           (rUp + vec::GRAIN);
  };
  while (rows > 1 && ubBytes(rows) > 188160) --rows;
  out.kc = rows;
  out.nb = pitch;
  out.m = p.m;
  out.k = p.k;
  out.n = p.n;
  out.e = p.e;
  out.listType = p.listType;
  const uint32_t items = (p.m + rows - 1) / rows + p.e;
  out.coreNum = items < p.vcores ? (items ? items : 1u) : p.vcores;
}
}
namespace gmmptq {
inline uint32_t ShortGroupUbBytes(uint32_t maxK, uint32_t capacityN, uint32_t nPitch) {
  const uint32_t block = maxK * capacityN;
  const uint32_t kUp = UpH(maxK, 32);
  return 128 * 8 + 256 * 4 + (kUp + 32) + (block + 32) + 4 * block + 4 * kUp +
         10 * nPitch + 32 + 2 * block + 2 * kUp + 8192;
}
inline VTiling BuildShortGroupTiling(const Plan& p) {
  VTiling out{};
  out.m = p.m;
  out.k = p.k;
  out.n = p.n;
  out.e = p.e;
  out.listType = p.listType;
  out.coreNum = std::min(p.vcores, p.m);
  const uint32_t nPitch = UpH(p.n, 32);
  out.nb = std::min(nPitch, 192u);
  out.kc = 128;
  const uint32_t kUp = UpH(p.k, 8);
  while (out.kc > 8 &&
         (ShortGroupUbBytes(out.kc, out.nb, nPitch) > 188160 || out.kc / 2 >= kUp))
    out.kc /= 2;
  const uint32_t minWidth = UpH((8 * nPitch + out.kc - 1) / out.kc, 32);
  out.nb = std::max(out.nb, minWidth);
  return out;
}
}
namespace gmmptq {
using AscendC::InitSocState;
using AscendC::PipeBarrier;
using AscendC::TBuf;
using AscendC::TPipe;
template <bool Static>
struct FullKPipeType {
  using Type = TPipe;
};
template <>
struct FullKPipeType<true> {
  struct Type {
    __aicore__ inline Type() { InitSocState(); }
    __aicore__ inline void Destroy() { PipeBarrier<PIPE_ALL>(); }
  };
};
template <bool Static, TPosition Pos>
struct FullKBufferType {
  using Type = TBuf<Pos>;
};
template <TPosition Pos>
struct FullKBufferType<true, Pos> {
  struct Type {
    uint32_t bytes;
    template <typename T>
    __aicore__ inline LocalTensor<T> Get() {
      return LocalTensor<T>(Pos, 0, bytes / sizeof(T));
    }
  };
};
template <bool Static, typename L1Buf, typename L0ABuf, typename L0BBuf,
          typename L0CBuf>
__aicore__ inline void InitCubeBuffers(L1Buf& l1, L0ABuf& l0a, L0BBuf& l0b,
                                       L0CBuf& l0c) {
  using namespace AscendC;
  if constexpr (Static) {
    l1.bytes = L1_BYTES;
    l0a.bytes = L0A_BYTES;
    l0b.bytes = L0B_BYTES;
    l0c.bytes = L0C_BYTES;
  } else {
    GetTPipePtr()->InitBuffer(l1, L1_BYTES);
    GetTPipePtr()->InitBuffer(l0a, L0A_BYTES);
    GetTPipePtr()->InitBuffer(l0b, L0B_BYTES);
    GetTPipePtr()->InitBuffer(l0c, L0C_BYTES);
  }
}
struct CubeTile {
  uint32_t mIdx, nIdx;
  uint32_t gRow;
  uint32_t mt;
  uint32_t nOff;
  uint32_t nt;
  template <uint32_t BM, uint32_t BN, bool NMajor>
  __aicore__ static inline CubeTile Of(uint32_t t, uint32_t mBlocks, uint32_t nTiles,
                                       uint32_t rowStart, uint32_t rows, uint32_t n) {
    CubeTile tile;
    if constexpr (NMajor) {
      tile.mIdx = t % mBlocks;
      tile.nIdx = t / mBlocks;
    } else {
      tile.mIdx = t / nTiles;
      tile.nIdx = t % nTiles;
    }
    tile.gRow = rowStart + tile.mIdx * BM;
    tile.mt = Min(BM, rows - tile.mIdx * BM);
    tile.nOff = tile.nIdx * BN;
    tile.nt = Min(BN, n - tile.nOff);
    return tile;
  }
};
template <uint32_t BM>
__aicore__ inline void LoadTileToL0(LocalTensor<int8_t> a, LocalTensor<int8_t> b,
                                    LocalTensor<int8_t> l1a, LocalTensor<int8_t> l1b,
                                    uint32_t ks, uint32_t mt, uint32_t nt,
                                    uint32_t kFrac, uint32_t kl) {
  using namespace AscendC;
  const uint32_t mFrac = Up(mt, ROW_FRAC) / ROW_FRAC;
  const uint32_t bRowStride = Up(nt, C0_I8) * C0_I8;
  LoadData2DParams la;
  la.startIndex = 0;
  la.repeatTimes = static_cast<uint8_t>(mFrac);
  la.srcStride = 1;
  la.dstGap = static_cast<uint16_t>(kFrac - 1u);
  la.ifTranspose = false;
  la.sid = 0;
  la.addrMode = 0;
  for (uint32_t j = 0; j < kFrac; ++j)
    LoadData(a[j * FRAC_I8], l1a[ks * BM + j * BM * C0_I8], la);
  LoadData2dTransposeParams lb;
  lb.startIndex = 0;
  lb.repeatTimes = static_cast<uint8_t>(Up(nt, C0_I8) / C0_I8);
  lb.srcStride = static_cast<uint16_t>(kl / C0_I8);
  lb.dstGap = 1;
  lb.dstFracGap = 0;
  lb.addrMode = 0;
  for (uint32_t i = 0; i < kFrac; ++i)
    LoadDataWithTranspose(b[i * bRowStride], l1b[ks * C0_I8 + i * 2u * FRAC_I8], lb);
}
template <uint32_t BM, bool SwapB = false>
__aicore__ inline void LoadTileToL0ResidentA(LocalTensor<int8_t> a, LocalTensor<int8_t> b,
                                    LocalTensor<int8_t> l1a, LocalTensor<int8_t> l1b,
                                    uint32_t ks, uint32_t mt, uint32_t nt,
                                    uint32_t kFrac, uint32_t kl, bool loadA) {
  using namespace AscendC;
  const uint32_t mFrac = Up(mt, ROW_FRAC) / ROW_FRAC;
  const uint32_t bRowStride = Up(nt, C0_I8) * C0_I8;
  LoadData2DParams la;
  la.startIndex = 0;
  la.repeatTimes = static_cast<uint8_t>(mFrac);
  la.srcStride = 1;
  la.dstGap = static_cast<uint16_t>(kFrac - 1u);
  la.ifTranspose = false;
  la.sid = 0;
  la.addrMode = 0;
  if (loadA) {
  for (uint32_t j = 0; j < kFrac; ++j)
    LoadData(a[j * FRAC_I8], l1a[ks * BM + j * BM * C0_I8], la);
  }
  if constexpr (SwapB) {
    const uint32_t nPairs = Up(nt, C0_I8) / C0_I8;
    if (kFrac > nPairs && kFrac <= 255u) {
      LoadData2dTransposeParams coalesced;
      coalesced.startIndex = 0;
      coalesced.repeatTimes = static_cast<uint8_t>(kFrac);
      coalesced.srcStride = 1;
      coalesced.dstGap = static_cast<uint16_t>(2u * nPairs - 1u);
      coalesced.dstFracGap = 0;
      coalesced.addrMode = 0;
      for (uint32_t j = 0; j < nPairs; ++j)
        LoadDataWithTranspose(b[j * 2u * FRAC_I8],
                             l1b[ks * C0_I8 + j * kl * C0_I8], coalesced);
      return;
    }
  }
  LoadData2dTransposeParams lb;
  lb.startIndex = 0;
  lb.repeatTimes = static_cast<uint8_t>(Up(nt, C0_I8) / C0_I8);
  lb.srcStride = static_cast<uint16_t>(kl / C0_I8);
  lb.dstGap = 1;
  lb.dstFracGap = 0;
  lb.addrMode = 0;
  for (uint32_t i = 0; i < kFrac; ++i)
    LoadDataWithTranspose(b[i * bRowStride], l1b[ks * C0_I8 + i * 2u * FRAC_I8], lb);
}
__aicore__ inline void LoadAPanel(LocalTensor<int8_t> l1a,
                                  const GlobalTensor<int8_t>& xg, uint32_t gRow,
                                  uint32_t mt, uint32_t k, uint32_t c0Stride) {
  AscendC::Nd2NzParams ap;
  ap.ndNum = 1;
  ap.nValue = uint16_t(mt);
  ap.dValue = uint16_t(k);
  ap.srcNdMatrixStride = 0;
  ap.srcDValue = uint16_t(k);
  ap.dstNzC0Stride = uint16_t(c0Stride);
  ap.dstNzNStride = 1;
  ap.dstNzMatrixStride = 0;
  AscendC::DataCopy(l1a, xg[uint64_t(gRow) * k], ap);
}
}
namespace gmmptq {
template <typename ScaleT, typename OutT>
__global__ __aicore__ void CubeMix(GM_ADDR xGm, GM_ADDR wGm, GM_ADDR xsGm, GM_ADDR wsGm,
                                   GM_ADDR glGm, GM_ADDR yGm, GM_ADDR stGm, Plan p) {
  using namespace AscendC;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  GlobalTensor<int64_t> list;
  list.SetGlobalBuffer((__gm__ int64_t*)glGm);
  Schedule sched{list, p.listType, p.e, p.m0, p.nTiles};
  uint32_t total = sched.Total();
  uint32_t aic, sub = 0, first, last;
  TPipe pipe;
  if ASCEND_IS_AIC {
    aic = GetBlockIdx();
    first = static_cast<uint32_t>(uint64_t(total) * aic / p.cores);
    last = static_cast<uint32_t>(uint64_t(total) * (aic + 1) / p.cores);
    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<int32_t> stg;
    xg.SetGlobalBuffer((__gm__ int8_t*)xGm);
    wg.SetGlobalBuffer((__gm__ int8_t*)wGm);
    stg.SetGlobalBuffer((__gm__ int32_t*)stGm);
    TBuf<TPosition::A1> l1Buf;
    TBuf<TPosition::A2> l0aBuf;
    TBuf<TPosition::B2> l0bBuf;
    TBuf<TPosition::CO1> l0cBuf;
    GetTPipePtr()->InitBuffer(l1Buf, L1_BYTES);
    GetTPipePtr()->InitBuffer(l0aBuf, L0A_BYTES);
    GetTPipePtr()->InitBuffer(l0bBuf, L0B_BYTES);
    GetTPipePtr()->InitBuffer(l0cBuf, L0C_BYTES);
    pipe.Destroy();
    LocalTensor<int8_t> l1 = l1Buf.Get<int8_t>();
    LocalTensor<int8_t> l0a = l0aBuf.Get<int8_t>();
    LocalTensor<int8_t> l0b = l0bBuf.Get<int8_t>();
    LocalTensor<int32_t> l0c = l0cBuf.Get<int32_t>();
    const uint32_t aBytes = p.m0r * p.kl;
    const uint32_t bBytes = p.kl * p.n0c;
    LocalTensor<int8_t> l1a = l1;
    LocalTensor<int8_t> l1b0 = l1[aBytes];
    LocalTensor<int8_t> l1b1 = l1[aBytes + bBytes];
    const uint32_t l0aHalf = p.m0r * p.k0;
    const uint32_t l0bHalf = p.k0 * p.n0r;
    uint32_t heldA = 0xffffffffu;
    uint32_t heldM = 0xffffffffu;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      uint32_t v = static_cast<uint32_t>(list.GetValue(e));
      uint32_t end = p.listType == 0 ? v : start + v;
      uint32_t rows = (end > start) ? (end - start) : 0u;
      uint32_t mBlocks = (rows + p.m0 - 1) / p.m0;
      uint32_t count = mBlocks * p.nTiles;
      if (acc + count > first) {
        uint32_t lo = first > acc ? first - acc : 0;
        uint32_t hi = Min(count, last - acc);
        for (uint32_t t = lo; t < hi; ++t) {
          const uint32_t relative = acc + t - first;
          const uint16_t tileId = uint16_t(relative & 3u);
          if (relative >= 4u) CrossCoreWaitFlag(uint16_t(4u + tileId));
          uint32_t mIdx = t / p.nTiles;
          uint32_t nIdx = t % p.nTiles;
          uint32_t gRow = start + mIdx * p.m0;
          uint32_t mt = Min(p.m0, rows - mIdx * p.m0);
          uint32_t nOff = nIdx * p.n0;
          uint32_t nt = Min(p.n0, p.n - nOff);
          bool reuseA = (e == heldA && mIdx == heldM && p.kl >= p.k);
          bool firstK = true;
          for (uint32_t kc = 0; kc < p.k; kc += p.kl) {
            uint32_t klc = Min(p.kl, p.k - kc);
            uint32_t klr = Up(klc, C0_I8);
            if (!reuseA) {
              Nd2NzParams ap;
              ap.ndNum = 1;
              ap.nValue = static_cast<uint16_t>(mt);
              ap.dValue = static_cast<uint16_t>(klc);
              ap.srcNdMatrixStride = 0;
              ap.srcDValue = static_cast<uint16_t>(p.k);
              ap.dstNzC0Stride = static_cast<uint16_t>(p.m0r);
              ap.dstNzNStride = 1;
              ap.dstNzMatrixStride = 0;
              DataCopy(l1a, xg[uint64_t(gRow) * p.k + kc], ap);
            }
            LocalTensor<int8_t> l1b = ((kc / p.kl) & 1) ? l1b1 : l1b0;
            Nd2NzParams bp;
            bp.ndNum = 1;
            bp.nValue = static_cast<uint16_t>(klc);
            bp.dValue = static_cast<uint16_t>(nt);
            bp.srcNdMatrixStride = 0;
            bp.srcDValue = static_cast<uint16_t>(p.n);
            bp.dstNzC0Stride = static_cast<uint16_t>(p.kl);
            bp.dstNzNStride = 1;
            bp.dstNzMatrixStride = 0;
            DataCopy(l1b, wg[(uint64_t(e) * p.k + kc) * p.n + nOff], bp);
            Barrier<HardEvent::MTE2_MTE1>();
            for (uint32_t ks = 0; ks < klr; ks += p.k0) {
              uint32_t kstep = Min(p.k0, klc - Min(klc, ks));
              if (kstep == 0) break;
              uint32_t half = ((ks / p.k0) & 1);
              LocalTensor<int8_t> a = l0a[half * l0aHalf];
              LocalTensor<int8_t> b = l0b[half * l0bHalf];
              const uint32_t kFrac = Up(kstep, C0_I8) / C0_I8;
              const uint32_t aRowStride = kFrac * C0_I8 * ROW_FRAC;
              const uint32_t bRowStride = Up(nt, C0_I8) * C0_I8;
              const uint32_t mFrac = Up(mt, ROW_FRAC) / ROW_FRAC;
              LoadData2DParams la;
              la.startIndex = 0;
              la.repeatTimes = static_cast<uint8_t>(mFrac);
              la.srcStride = 1;
              la.dstGap = static_cast<uint16_t>(kFrac - 1);
              la.ifTranspose = false;
              la.sid = 0;
              la.addrMode = 0;
              for (uint32_t j = 0; j < kFrac; ++j)
                LoadData(a[j * FRAC_I8], l1a[ks * p.m0r + j * p.m0r * C0_I8], la);
              LoadData2dTransposeParams lb;
              lb.startIndex = 0;
              lb.repeatTimes = static_cast<uint8_t>(Up(nt, C0_I8) / C0_I8);
              lb.srcStride = static_cast<uint16_t>(p.kl / C0_I8);
              lb.dstGap = 1;
              lb.dstFracGap = 0;
              lb.addrMode = 0;
              for (uint32_t i = 0; i < kFrac; ++i)
                LoadDataWithTranspose(b[i * bRowStride],
                                      l1b[ks * C0_I8 + i * 2 * FRAC_I8], lb);
              Barrier<HardEvent::MTE1_M>();
              MmadParams mp;
              mp.m = static_cast<uint16_t>(Up(mt, ROW_FRAC));
              mp.n = static_cast<uint16_t>(Up(nt, C0_I8));
              mp.k = static_cast<uint16_t>(kstep);
              mp.cmatrixInitVal = firstK;
              mp.unitFlag = 0;
              if (firstK) Barrier<HardEvent::FIX_M>();
              Mmad(l0c, a, b, mp);
              Barrier<HardEvent::M_MTE1>();
              firstK = false;
            }
            Barrier<HardEvent::MTE1_MTE2>();
          }
          heldA = e;
          heldM = mIdx;
          Barrier<HardEvent::M_FIX>();
          FixpipeParamsV220 fp;
          fp.nSize = static_cast<uint16_t>(nt);
          fp.mSize = static_cast<uint16_t>(mt);
          fp.srcStride = static_cast<uint16_t>(Up(mt, ROW_FRAC));
          fp.dstStride = p.n0;
          fp.quantPre = QuantMode_t::NoQuant;
          fp.reluEn = false;
          fp.unitFlag = 0;
          uint64_t base = uint64_t(acc + t) * p.m0 * p.n0;
          Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(stg[base], l0c, fp);
          CrossCoreSetFlag<2, PIPE_FIX>(tileId);
        }
      }
      acc += count;
      start = end;
    }
    const uint32_t owned = last - first;
    for (uint32_t q = owned > 4u ? owned - 4u : owned; q < owned; ++q)
      CrossCoreWaitFlag(uint16_t(4u + (q & 3u)));
  } else {
    aic = GetBlockIdx() / GetTaskRation();
    sub = GetSubBlockIdx();
    first = static_cast<uint32_t>(uint64_t(total) * aic / p.cores);
    last = static_cast<uint32_t>(uint64_t(total) * (aic + 1) / p.cores);
    GlobalTensor<int32_t> stg;
    GlobalTensor<float> xsg;
    GlobalTensor<ScaleT> wsg;
    GlobalTensor<OutT> yg;
    stg.SetGlobalBuffer((__gm__ int32_t*)stGm);
    xsg.SetGlobalBuffer((__gm__ float*)xsGm);
    wsg.SetGlobalBuffer((__gm__ ScaleT*)wsGm);
    yg.SetGlobalBuffer((__gm__ OutT*)yGm);
    TBuf<TPosition::VECCALC> ub;
    GetTPipePtr()->InitBuffer(ub, UB_BYTES);
    pipe.Destroy();
    LocalTensor<uint8_t> raw = ub.Get<uint8_t>();
    const uint32_t pitch = Up(p.n0, F32_PER_BLK);
    uint32_t off = 0;
    LocalTensor<int32_t> accI = raw[off].ReinterpretCast<int32_t>();
    off += p.rv * pitch * 4;
    LocalTensor<float> accF = raw[off].ReinterpretCast<float>();
    off += p.rv * pitch * 4;
    LocalTensor<OutT> out = raw[off].ReinterpretCast<OutT>();
    off += Up(p.rv * pitch * 2, BLK);
    LocalTensor<ScaleT> wsl = raw[off].ReinterpretCast<ScaleT>();
    off += Up(pitch * 4, BLK);
    LocalTensor<float> wsf = raw[off].ReinterpretCast<float>();
    off += pitch * 4;
    LocalTensor<float> xsl = raw[off].ReinterpretCast<float>();
    off += Up(p.rv * 4, BLK);
    LocalTensor<float> xsb = raw[off].ReinterpretCast<float>();
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      uint32_t v = static_cast<uint32_t>(list.GetValue(e));
      uint32_t end = p.listType == 0 ? v : start + v;
      uint32_t rows = (end > start) ? (end - start) : 0u;
      uint32_t mBlocks = (rows + p.m0 - 1) / p.m0;
      uint32_t count = mBlocks * p.nTiles;
      if (acc + count > first) {
        uint32_t lo = first > acc ? first - acc : 0;
        uint32_t hi = Min(count, last - acc);
        for (uint32_t t = lo; t < hi; ++t) {
          const uint32_t relative = acc + t - first;
          const uint16_t tileId = uint16_t(relative & 3u);
          uint32_t mIdx = t / p.nTiles;
          uint32_t nIdx = t % p.nTiles;
          uint32_t gRow = start + mIdx * p.m0;
          uint32_t mt = Min(p.m0, rows - mIdx * p.m0);
          uint32_t nOff = nIdx * p.n0;
          uint32_t nt = Min(p.n0, p.n - nOff);
          uint64_t base = uint64_t(acc + t) * p.m0 * p.n0;
          CrossCoreWaitFlag(tileId);
          if (last - first > 4u) CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
          uint32_t half = (mt + AIV_PER_AIC - 1) / AIV_PER_AIC;
          uint32_t r0 = Min(sub * half, mt);
          uint32_t r1 = Min((sub + 1) * half, mt);
          if (r0 < r1) {
            DataCopyPad(wsl, wsg[uint64_t(e) * p.n + nOff],
                        DataCopyExtParams{1, uint32_t(nt * sizeof(ScaleT)), 0, 0, 0},
                        DataCopyPadExtParams<ScaleT>{false, 0, 0, 0});
            Barrier<HardEvent::MTE2_V>();
            ToFloat<ScaleT>(wsf, wsl, nt);
            PipeBarrier<PIPE_V>();
          }
          const uint32_t ntr = Up(nt, F32_PER_BLK);
          for (uint32_t r = r0; r < r1; r += p.rv) {
            uint32_t nr = Min(p.rv, r1 - r);
            DataCopyPad(accI, stg[base + uint64_t(r) * p.n0],
                        DataCopyExtParams{uint16_t(nr), nt * 4, (p.n0 - nt) * 4,
                                          (pitch - ntr) / F32_PER_BLK, 0},
                        DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
            DataCopyPad(xsl, xsg[gRow + r], DataCopyExtParams{1, nr * 4, 0, 0, 0},
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
            Barrier<HardEvent::MTE2_V>();
            Cast(accF, accI, RoundMode::CAST_RINT, nr * pitch);
            BrcbRepeatParams br;
            br.dstBlkStride = 1;
            br.dstRepStride = 8;
            Brcb(xsb, xsl, static_cast<uint8_t>((nr + 7) / 8), br);
            PipeBarrier<PIPE_V>();
            MulByRow(accF, accF, wsf, nr, nt, pitch);
            PipeBarrier<PIPE_V>();
            MulByCol(accF, xsb, nr, ntr, pitch);
            PipeBarrier<PIPE_V>();
            Cast(out, accF, RoundMode::CAST_RINT, nr * pitch);
            Barrier<HardEvent::V_MTE3>();
            DataCopyPad(yg[uint64_t(gRow + r) * p.n + nOff], out,
                        DataCopyExtParams{uint16_t(nr), nt * 2,
                                          (pitch * 2 - Up(nt * 2, BLK)) / BLK,
                                          (p.n - nt) * 2, 0});
            Barrier<HardEvent::MTE3_MTE2>();
          }
        }
      }
      acc += count;
      start = end;
    }
    Barrier<HardEvent::MTE3_S>();
  }
}
}
namespace gmmptq {
template <typename ScaleT, typename OutT, uint32_t BM, uint32_t BN, uint32_t BK,
          uint32_t RV, bool NMajor = false, bool Prefetch = false,
          bool SingleL0 = false, bool PreXS = false, uint32_t Parts = 2u,
          bool StaticNoPipe = false, bool StreamB = false, bool P2TwoStripe = false,
          uint32_t Panel = 0u, bool UnitFlagChain = false, bool TilePipe = false,
          bool ResidentL0A = false, bool SwapB = false,
          bool StagePrefetch = false, bool MergeScaleBarrier = false>
__aicore__ inline void CubeFullKBody(GM_ADDR xGm, GM_ADDR wGm, GM_ADDR xsGm,
                                     GM_ADDR wsGm, GM_ADDR glGm, GM_ADDR yGm,
                                     GM_ADDR stGm, Plan p) {
  using namespace AscendC;
  static_assert(BM > 0 && BM % 16 == 0, "BM must align to the M fractile");
  static_assert(BN > 0 && BN % 32 == 0, "BN must align to int8 transpose pairs");
  static_assert(BK > 0 && BK % 32 == 0, "BK must align to int8 K fractiles");
  static_assert(RV > 0 && RV <= BM && RV % 8 == 0, "RV must align Brcb rows");
  static_assert(sizeof(OutT) == 2, "The output must be fp16 or bf16");
  static_assert(!(NMajor && Prefetch), "B prefetch is for M-major traversal");
  static_assert(!PreXS || (!NMajor && BM > 32u && BM != 208u && RV >= (BM + 1u) / 2u),
                "PreXS requires M-major early-scale placement and one AIV batch");
  static_assert(BM * BK * (SingleL0 ? 1u : 2u) <= L0A_BYTES, "L0A overflow");
  static_assert(BN * BK * (SingleL0 ? 1u : 2u) <= L0B_BYTES, "L0B overflow");
  static_assert(BM * BN * sizeof(int32_t) <= L0C_BYTES, "L0C overflow");
  static_assert(
      !P2TwoStripe || (BM == 96u && BN == 128u && BK == 256u && RV == 96u && !NMajor &&
                       !Prefetch && SingleL0 && PreXS && Parts == 1u && StreamB),
      "P2TwoStripe requires the original P2 resource policy");
  static_assert(!Panel || (!Prefetch && !StreamB),
                "panel residency replaces the per-tile B load policies");
  static_assert(!ResidentL0A || (!SingleL0 && TilePipe && !Prefetch && !StreamB),
                "resident A needs unchanged alternating L0 banks and full L1 staging");
  static_assert(!SwapB || ResidentL0A, "B descriptor swap requires the resident helper");
  constexpr uint32_t PITCH = BN;
  constexpr bool STAGE_PREFETCH = StagePrefetch && StaticNoPipe && PreXS &&
      Parts == 2u && BM > 32u && BM != 208u && RV <= 64u && BM <= Parts * RV &&
      !P2TwoStripe && !NMajor && !Prefetch && !StreamB && Panel && ResidentL0A;
  static_assert(!MergeScaleBarrier ||
                    (STAGE_PREFETCH && BM == 128u && BN == 128u && BK == 256u &&
                     RV == 64u && Panel == 4u && UnitFlagChain && TilePipe && SwapB),
                "merged scale wave requires the original P12 panel policy");
  constexpr uint32_t UB_USED = RV * PITCH * 10u + PITCH * 8u + RV * 36u;
  static_assert(UB_USED <= 192u * 1024u - 8192u - 256u, "UB overflow");
  const uint32_t nTiles = (p.n + BN - 1u) / BN;
  GlobalTensor<int64_t> list;
  list.SetGlobalBuffer((__gm__ int64_t*)glGm);
  Schedule sched{list, p.listType, p.e, BM, nTiles};
  const uint32_t total = sched.Total();
  typename FullKPipeType<StaticNoPipe>::Type pipe;
  if ASCEND_IS_AIC {
    const uint32_t physicalAic = GetBlockIdx();
    const uint32_t aic = (P2TwoStripe && p.cores % 7u != 0u)
                             ? (physicalAic * 7u) % p.cores
                             : physicalAic;
    const uint32_t first = uint32_t(uint64_t(total) * aic / p.cores);
    const uint32_t last = uint32_t(uint64_t(total) * (aic + 1u) / p.cores);
    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<int32_t> stg;
    xg.SetGlobalBuffer((__gm__ int8_t*)xGm);
    wg.SetGlobalBuffer((__gm__ int8_t*)wGm);
    stg.SetGlobalBuffer((__gm__ int32_t*)stGm);
    typename FullKBufferType<StaticNoPipe, TPosition::A1>::Type l1Buf;
    typename FullKBufferType<StaticNoPipe, TPosition::A2>::Type l0aBuf;
    typename FullKBufferType<StaticNoPipe, TPosition::B2>::Type l0bBuf;
    typename FullKBufferType<StaticNoPipe, TPosition::CO1>::Type l0cBuf;
    InitCubeBuffers<StaticNoPipe>(l1Buf, l0aBuf, l0bBuf, l0cBuf);
    pipe.Destroy();
    LocalTensor<int8_t> l1 = l1Buf.template Get<int8_t>();
    LocalTensor<int8_t> l0a = l0aBuf.template Get<int8_t>();
    LocalTensor<int8_t> l0b = l0bBuf.template Get<int8_t>();
    LocalTensor<int32_t> l0c = l0cBuf.template Get<int32_t>();
    if constexpr (UnitFlagChain) {
      SetFixPipeConfig<uint64_t>(l0c.ReinterpretCast<uint64_t>(), true);
      Barrier<HardEvent::FIX_M>();
      SetMMRowMajor();
    }
    const uint32_t aBytes = BM * p.kl;
    const uint32_t bBytes = p.kl * BN;
    LocalTensor<int8_t> l1a = l1;
    LocalTensor<int8_t> l1b0 = l1[aBytes];
    LocalTensor<int8_t> l1b1 = l1[aBytes + (Prefetch ? bBytes : 0u)];
    if constexpr (!SingleL0) {
      SetFlag<HardEvent::M_MTE1>(1);
      SetFlag<HardEvent::M_MTE1>(2);
    }
    uint32_t heldAExpert = 0xffffffffu, heldM = 0xffffffffu;
    uint32_t residentAMask = 0u;
    uint32_t heldBExpert = 0xffffffffu, heldN = 0xffffffffu;
    uint32_t kctr = 0;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      const uint32_t value = uint32_t(list.GetValue(e));
      const uint32_t end = p.listType == 0 ? value : start + value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t mBlocks = (rows + BM - 1u) / BM;
      const uint32_t count = mBlocks * nTiles;
      if (acc + count > first) {
        const uint32_t lo = first > acc ? first - acc : 0u;
        const uint32_t hi = Min(count, last - acc);
        for (uint32_t t = lo; t < hi; ++t) {
          const uint16_t tileId = uint16_t((acc + t - first) & 3u);
          if (acc + t - first >= 4u) CrossCoreWaitFlag(uint16_t(4u + tileId));
          const CubeTile tile =
              CubeTile::Of<BM, BN, NMajor>(t, mBlocks, nTiles, start, rows, p.n);
          const uint32_t gRow = tile.gRow, mt = tile.mt;
          const uint32_t nOff = tile.nOff, nt = tile.nt;
          const bool reuseA = e == heldAExpert && tile.mIdx == heldM;
          if constexpr (ResidentL0A) {
            if (!reuseA) residentAMask = 0u;
          }
          const bool reuseB =
              e == heldBExpert &&
              (Panel ? tile.nIdx / Panel == heldN / Panel : tile.nIdx == heldN);
          if constexpr (TilePipe && !Prefetch) {
            if (!reuseA || !reuseB) Barrier<HardEvent::MTE1_MTE2>();
          }
          if constexpr (!StreamB) {
            if (!reuseA) LoadAPanel(l1a, xg, gRow, mt, p.k, BM);
          }
          LocalTensor<int8_t> l1b = l1b0;
          Nd2NzParams bp;
          bp.ndNum = 1;
          bp.dstNzNStride = 1;
          bp.srcNdMatrixStride = 0;
          bp.dstNzMatrixStride = 0;
          bp.srcDValue = uint16_t(p.wstride);
          bp.dstNzC0Stride = uint16_t(p.kl);
          if constexpr (Panel) {
            const uint32_t panelOff = (tile.nIdx / Panel) * BN * Panel;
            l1b = l1b0[(tile.nIdx % Panel) * BN * p.kl];
            bp.nValue = uint16_t(p.k);
            bp.dValue = uint16_t(Min(BN * Panel, p.n - panelOff));
            if (!reuseB)
              DataCopy(l1b0, wg[uint64_t(e) * p.k * p.wstride + panelOff], bp);
          } else {
            if constexpr (Prefetch) l1b = ((t - lo) & 1u) ? l1b1 : l1b0;
            bp.nValue = uint16_t(StreamB ? Min(BK, p.k) : p.k);
            bp.dValue = uint16_t(nt);
            const bool wantB = Prefetch ? t == lo : !reuseB;
            if (wantB) DataCopy(l1b, wg[uint64_t(e) * p.k * p.wstride + nOff], bp);
          }
          if constexpr (StreamB) {
            if (!reuseA) LoadAPanel(l1a, xg, gRow, mt, p.k, BM);
          }
          Barrier<HardEvent::MTE2_MTE1>();
          if constexpr (Prefetch) {
            if (t + 1u < hi) {
              LocalTensor<int8_t> nextB = ((t - lo) & 1u) ? l1b0 : l1b1;
              const uint32_t nextNOff = ((t + 1u) % nTiles) * BN;
              Nd2NzParams nextBp = bp;
              nextBp.dValue = uint16_t(Min(BN, p.n - nextNOff));
              DataCopy(nextB, wg[uint64_t(e) * p.k * p.wstride + nextNOff], nextBp);
            }
          }
          bool firstK = true;
          for (uint32_t ks = 0; ks < p.k; ks += BK) {
            if constexpr (StreamB) {
              if (ks > 0u) Barrier<HardEvent::MTE2_MTE1>();
              if (!reuseB && ks + BK < p.k) {
                Nd2NzParams nextBp = bp;
                nextBp.nValue = uint16_t(Min(BK, p.k - ks - BK));
                DataCopy(l1b[(ks + BK) * C0_I8],
                         wg[uint64_t(e) * p.k * p.wstride +
                            uint64_t(ks + BK) * p.wstride + nOff],
                         nextBp);
              }
            }
            const uint32_t kstep = Min(BK, p.k - ks);
            const uint32_t half =
                SingleL0 ? 0u : ((TilePipe ? kctr : (ks / BK)) & 1u);
            if constexpr (!SingleL0) WaitFlag<HardEvent::M_MTE1>(half + 1u);
            LocalTensor<int8_t> a = l0a[half * BM * BK];
            LocalTensor<int8_t> b = l0b[half * BK * BN];
            const uint32_t kFrac = Up(kstep, C0_I8) / C0_I8;
            if constexpr (ResidentL0A) {
              if (p.k <= BK) {
                LoadTileToL0ResidentA<BM, SwapB>(a, b, l1a, l1b, ks, mt, nt, kFrac,
                                        p.kl, (residentAMask & (1u << half)) == 0u);
                residentAMask |= 1u << half;
              } else {
            LoadTileToL0<BM>(a, b, l1a, l1b, ks, mt, nt, kFrac, p.kl);
              }
            } else {
            LoadTileToL0<BM>(a, b, l1a, l1b, ks, mt, nt, kFrac, p.kl);
            }
            Barrier<HardEvent::MTE1_M>();
            MmadParams mp;
            mp.m = uint16_t(Up(mt, ROW_FRAC));
            mp.n = uint16_t(Up(nt, C0_I8));
            mp.k = uint16_t(kstep);
            mp.cmatrixInitVal = firstK;
            if constexpr (UnitFlagChain) {
              mp.unitFlag = (ks + BK >= p.k) ? 3u : 2u;
            } else {
              mp.unitFlag = 0;
              if (firstK) Barrier<HardEvent::FIX_M>();
            }
            Mmad(l0c, a, b, mp);
            if ((uint32_t(mp.m) / 16u) * (uint32_t(mp.n) / 16u) < 10u)
              PipeBarrier<PIPE_M>();
            if constexpr (SingleL0)
              Barrier<HardEvent::M_MTE1>();
            else
              SetFlag<HardEvent::M_MTE1>(half + 1u);
            firstK = false;
            ++kctr;
          }
          if constexpr (!TilePipe || Prefetch) Barrier<HardEvent::MTE1_MTE2>();
          heldAExpert = e;
          heldM = tile.mIdx;
          heldBExpert = e;
          heldN = tile.nIdx;
          if constexpr (!UnitFlagChain) Barrier<HardEvent::M_FIX>();
          FixpipeParamsV220 fp;
          fp.nSize = uint16_t(UnitFlagChain ? Up(nt, C0_I8) : nt);
          fp.mSize = uint16_t(UnitFlagChain ? Up(mt, ROW_FRAC) : mt);
          fp.srcStride = uint16_t(Up(mt, ROW_FRAC));
          fp.dstStride = BN;
          fp.quantPre = QuantMode_t::NoQuant;
          fp.reluEn = false;
          fp.unitFlag = UnitFlagChain ? 3u : 0u;
          const uint64_t base = uint64_t(acc + t) * BM * BN;
          Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(stg[base], l0c, fp);
          CrossCoreSetFlag<2, PIPE_FIX>(tileId);
        }
      }
      acc += count;
      start = end;
    }
    const uint32_t owned = last - first;
    for (uint32_t q = owned > 4u ? owned - 4u : owned; q < owned; ++q)
      CrossCoreWaitFlag(uint16_t(4u + (q & 3u)));
    if constexpr (!SingleL0) {
      WaitFlag<HardEvent::M_MTE1>(1);
      WaitFlag<HardEvent::M_MTE1>(2);
    }
    if constexpr (UnitFlagChain) {
      Barrier<HardEvent::FIX_M>();
      SetMMColumnMajor();
    }
  } else {
    const uint32_t physicalAic = GetBlockIdx() / GetTaskRation();
    const uint32_t aic = (P2TwoStripe && p.cores % 7u != 0u)
                             ? (physicalAic * 7u) % p.cores
                             : physicalAic;
    const uint32_t sub = GetSubBlockIdx();
    const uint32_t first = uint32_t(uint64_t(total) * aic / p.cores);
    const uint32_t last = uint32_t(uint64_t(total) * (aic + 1u) / p.cores);
    GlobalTensor<int32_t> stg;
    GlobalTensor<float> xsg;
    GlobalTensor<ScaleT> wsg;
    GlobalTensor<OutT> yg;
    stg.SetGlobalBuffer((__gm__ int32_t*)stGm);
    xsg.SetGlobalBuffer((__gm__ float*)xsGm);
    wsg.SetGlobalBuffer((__gm__ ScaleT*)wsGm);
    yg.SetGlobalBuffer((__gm__ OutT*)yGm);
    typename FullKBufferType<StaticNoPipe, TPosition::VECCALC>::Type ub;
    if constexpr (StaticNoPipe)
      ub.bytes = UB_USED;
    else
      GetTPipePtr()->InitBuffer(ub, UB_USED);
    pipe.Destroy();
    LocalTensor<uint8_t> raw = ub.template Get<uint8_t>();
    uint32_t off = 0;
    LocalTensor<int32_t> accI = raw[off].ReinterpretCast<int32_t>();
    off += RV * PITCH * 4u;
    LocalTensor<float> accF = raw[off].ReinterpretCast<float>();
    off += RV * PITCH * 4u;
    LocalTensor<OutT> out = raw[off].ReinterpretCast<OutT>();
    off += RV * PITCH * 2u;
    LocalTensor<ScaleT> wsl = raw[off].ReinterpretCast<ScaleT>();
    off += PITCH * 4u;
    LocalTensor<float> wsf = raw[off].ReinterpretCast<float>();
    off += PITCH * 4u;
    LocalTensor<float> xsl = raw[off].ReinterpretCast<float>();
    off += RV * 4u;
    LocalTensor<float> xsb = raw[off].ReinterpretCast<float>();
    if constexpr (P2TwoStripe) {
      SetFlag<HardEvent::MTE3_MTE2>(1);
      SetFlag<HardEvent::MTE3_MTE2>(2);
    }
    uint32_t heldScaleExpert = 0xffffffffu, heldScaleN = 0xffffffffu;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      const uint32_t value = uint32_t(list.GetValue(e));
      const uint32_t end = p.listType == 0 ? value : start + value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t mBlocks = (rows + BM - 1u) / BM;
      const uint32_t count = mBlocks * nTiles;
      if (acc + count > first) {
        const uint32_t lo = first > acc ? first - acc : 0u;
        const uint32_t hi = Min(count, last - acc);
        bool nextStageIssued = false;
        for (uint32_t t = lo; t < hi; ++t) {
          const bool stageIssued = nextStageIssued;
          nextStageIssued = false;
          const uint16_t tileId = uint16_t((acc + t - first) & 3u);
          const CubeTile tile =
              CubeTile::Of<BM, BN, NMajor>(t, mBlocks, nTiles, start, rows, p.n);
          const uint32_t gRow = tile.gRow, mt = tile.mt;
          const uint32_t nOff = tile.nOff, nt = tile.nt;
          const uint64_t base = uint64_t(acc + t) * BM * BN;
          if constexpr (BM <= 32 || BM == 208) {
            CrossCoreWaitFlag(tileId);
            if (last - first > 4u)
              CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
          }
          const uint32_t half = (mt + Parts - 1u) / Parts;
          const uint32_t r0 = Min(sub * half, mt);
          const uint32_t r1 = Min((sub + 1u) * half, mt);
          if (r0 < r1 && (!NMajor || heldScaleExpert != e || heldScaleN != tile.nIdx)) {
            heldScaleExpert = e;
            heldScaleN = tile.nIdx;
            DataCopyPad(wsl, wsg[uint64_t(e) * p.n + nOff],
                        DataCopyExtParams{1, uint32_t(nt * sizeof(ScaleT)), 0, 0, 0},
                        DataCopyPadExtParams<ScaleT>{false, 0, 0, 0});
            if constexpr (PreXS) {
              DataCopyPad(xsl, xsg[gRow + r0],
                          DataCopyExtParams{1, (r1 - r0) * 4u, 0, 0, 0},
                          DataCopyPadExtParams<float>{false, 0, 0, 0});
            }
            Barrier<HardEvent::MTE2_V>();
            ToFloat<ScaleT>(wsf, wsl, nt);
            if constexpr (PreXS) {
              BrcbRepeatParams br;
              br.dstBlkStride = 1;
              br.dstRepStride = 8;
              Brcb(xsb, xsl, uint8_t((r1 - r0 + 7u) / 8u), br);
            }
            if constexpr (!MergeScaleBarrier) PipeBarrier<PIPE_V>();
            if constexpr (P2TwoStripe) {
              LocalTensor<uint16_t> wmU16 = out.template ReinterpretCast<uint16_t>();
              LocalTensor<uint16_t> wsU16 = wsf.template ReinterpretCast<uint16_t>();
              BinaryRepeatParams copyScale;
              copyScale.dstBlkStride = 1;
              copyScale.src0BlkStride = 1;
              copyScale.src1BlkStride = 1;
              copyScale.dstRepStride = 16;
              copyScale.src0RepStride = 0;
              copyScale.src1RepStride = 0;
              for (uint32_t c = 0; c < nt; c += 64u)
                Or(wmU16[c * 2u], wsU16[c * 2u], wsU16[c * 2u],
                   uint64_t(Min(128u, 2u * (nt - c))), uint8_t((mt + 1u) / 2u),
                   copyScale);
            }
          }
          if constexpr (BM > 32 && BM != 208) {
            if (!stageIssued) {
              CrossCoreWaitFlag(tileId);
              if (last - first > 4u)
                CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
            }
          }
          if constexpr (P2TwoStripe) {
            constexpr uint32_t BANK_ROWS = 48u;
            LocalTensor<int32_t> accIBase = accI;
            LocalTensor<float> accFBase = accF;
            LocalTensor<float> wm = out.template ReinterpretCast<float>();
            LocalTensor<OutT> outBase = accI.template ReinterpretCast<OutT>();
            const uint32_t ntr = Up(nt, F32_PER_BLK);
            const uint32_t stripeRows = (mt + 1u) / 2u;
            const uint32_t activeBanks = mt > stripeRows ? 2u : 1u;
            for (uint32_t bank = 0; bank < activeBanks; ++bank) {
              const uint32_t row = bank * stripeRows;
              const uint32_t nr = Min(stripeRows, mt - row);
              const uint16_t event = uint16_t(bank + 1u);
              WaitFlag<HardEvent::MTE3_MTE2>(event);
              DataCopyPad(accIBase[bank * BANK_ROWS * PITCH],
                          stg[base + uint64_t(row) * BN],
                          DataCopyExtParams{uint16_t(nr), nt * 4u, (BN - nt) * 4u,
                                            (PITCH - ntr) / F32_PER_BLK, 0},
                          DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
              SetFlag<HardEvent::MTE2_V>(event);
            }
            for (uint32_t bank = 0; bank < activeBanks; ++bank) {
              const uint32_t row = bank * stripeRows;
              const uint32_t nr = Min(stripeRows, mt - row);
              const uint16_t event = uint16_t(bank + 1u);
              LocalTensor<int32_t> accI = accIBase[bank * BANK_ROWS * PITCH];
              LocalTensor<float> accF = accFBase[bank * BANK_ROWS * PITCH];
              LocalTensor<OutT> out = outBase[bank * BANK_ROWS * PITCH * 2u];
              WaitFlag<HardEvent::MTE2_V>(event);
              Cast(accF, accI, RoundMode::CAST_RINT, nr * PITCH);
              PipeBarrier<PIPE_V>();
              BinaryRepeatParams flatScale;
              flatScale.dstBlkStride = 1;
              flatScale.src0BlkStride = 1;
              flatScale.src1BlkStride = 1;
              flatScale.dstRepStride = 8;
              flatScale.src0RepStride = 8;
              flatScale.src1RepStride = 8;
              Mul(accF, accF, wm, uint64_t(64), uint8_t(nr * 2u), flatScale);
              PipeBarrier<PIPE_V>();
              MulByTokenScale(accF, xsb[row * 8u], nr, nt, PITCH);
              PipeBarrier<PIPE_V>();
              Cast(out, accF, RoundMode::CAST_RINT, nr * PITCH);
              SetFlag<HardEvent::V_MTE3>(event);
              WaitFlag<HardEvent::V_MTE3>(event);
              StoreRows(yg[uint64_t(gRow + row) * p.n + nOff], out, nr, nt, PITCH, p.n);
              SetFlag<HardEvent::MTE3_MTE2>(event);
            }
            Barrier<HardEvent::V_MTE2>();
          } else {
            const uint32_t ntr = Up(nt, F32_PER_BLK);
            for (uint32_t r = r0; r < r1; r += RV) {
              const uint32_t nr = Min(RV, r1 - r);
              if (!stageIssued)
                DataCopyPad(accI, stg[base + uint64_t(r) * BN],
                            DataCopyExtParams{uint16_t(nr), nt * 4u, (BN - nt) * 4u,
                                              (PITCH - ntr) / F32_PER_BLK, 0},
                            DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
              if constexpr (!PreXS) {
                DataCopyPad(xsl, xsg[gRow + r], DataCopyExtParams{1, nr * 4u, 0, 0, 0},
                            DataCopyPadExtParams<float>{false, 0, 0, 0});
              }
              Barrier<HardEvent::MTE2_V>();
              Cast(accF, accI, RoundMode::CAST_RINT, nr * PITCH);
              if constexpr (!PreXS) {
                BrcbRepeatParams br;
                br.dstBlkStride = 1;
                br.dstRepStride = 8;
                Brcb(xsb, xsl, uint8_t((nr + 7u) / 8u), br);
              }
              PipeBarrier<PIPE_V>();
              if constexpr (STAGE_PREFETCH) {
                Barrier<HardEvent::V_MTE2>();
                if (t + 1u < hi) {
                  const CubeTile next =
                      CubeTile::Of<BM, BN, NMajor>(t + 1u, mBlocks, nTiles,
                                                 start, rows, p.n);
                  const uint32_t nextHalf = (next.mt + Parts - 1u) / Parts;
                  const uint32_t nextR0 = Min(sub * nextHalf, next.mt);
                  const uint32_t nextR1 = Min((sub + 1u) * nextHalf, next.mt);
                  if (nextR0 < nextR1) {
                    const uint16_t nextId = uint16_t((acc + t + 1u - first) & 3u);
                    CrossCoreWaitFlag(nextId);
                    if (last - first > 4u)
                      CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + nextId));
                    const uint64_t nextBase = uint64_t(acc + t + 1u) * BM * BN;
                    const uint32_t nextNtr = Up(next.nt, F32_PER_BLK);
                    DataCopyPad(accI, stg[nextBase + uint64_t(nextR0) * BN],
                                DataCopyExtParams{uint16_t(nextR1 - nextR0),
                                    next.nt * 4u, (BN - next.nt) * 4u,
                                    (PITCH - nextNtr) / F32_PER_BLK, 0},
                                DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
                    nextStageIssued = true;
                  }
                }
              }
              MulByRow(accF, accF, wsf, nr, nt, PITCH);
              PipeBarrier<PIPE_V>();
              MulByTokenScale(accF, xsb, nr, nt, PITCH);
              PipeBarrier<PIPE_V>();
              Barrier<HardEvent::MTE3_V>();
              Cast(out, accF, RoundMode::CAST_RINT, nr * PITCH);
              Barrier<HardEvent::V_MTE3>();
              StoreRows(yg[uint64_t(gRow + r) * p.n + nOff], out, nr, nt, PITCH, p.n);
              if constexpr (!STAGE_PREFETCH) Barrier<HardEvent::V_MTE2>();
            }
          }
        }
      }
      acc += count;
      start = end;
    }
    if constexpr (P2TwoStripe) {
      WaitFlag<HardEvent::MTE3_MTE2>(1);
      WaitFlag<HardEvent::MTE3_MTE2>(2);
    }
    Barrier<HardEvent::MTE3_S>();
  }
}
}
namespace gmmptq {
template <typename ScaleT, typename OutT, uint32_t BM, uint32_t BN, uint32_t BK,
          uint32_t RV, bool NMajor = false, bool Prefetch = false,
          bool SingleL0 = false, bool StaticNoPipe = false, bool TightPitch = false,
          bool SingleBlockStage = false, uint32_t SplitB = 0u>
__aicore__ inline void CubeFullKUnitBody(GM_ADDR xGm, GM_ADDR wGm, GM_ADDR xsGm,
                                         GM_ADDR wsGm, GM_ADDR glGm, GM_ADDR yGm,
                                         GM_ADDR stGm, Plan p) {
  using namespace AscendC;
  static_assert(BM > 0 && BM % 16 == 0, "BM must align to the M fractile");
  static_assert(BN > 0 && BN % 32 == 0, "BN must align to int8 transpose pairs");
  static_assert(BK > 0 && BK % 32 == 0, "BK must align to int8 K fractiles");
  static_assert(RV > 0 && RV <= BM && RV % 8 == 0, "RV must align Brcb rows");
  static_assert(sizeof(OutT) == 2, "The output must be fp16 or bf16");
  static_assert(!(NMajor && Prefetch), "B prefetch is for M-major traversal");
  static_assert(!SplitB || Prefetch, "split B requires the prefetch buffers");
  static_assert(BM * BK * (SingleL0 ? 1u : 2u) <= L0A_BYTES, "L0A overflow");
  static_assert(BN * BK * (SingleL0 ? 1u : 2u) <= L0B_BYTES, "L0B overflow");
  static_assert(BM * BN * sizeof(int32_t) <= L0C_BYTES, "L0C overflow");
  constexpr uint32_t PITCH = BN;
  constexpr uint32_t UB_USED = RV * PITCH * 10u + PITCH * 8u + RV * 36u;
  static_assert(UB_USED <= 192u * 1024u - 8192u - 256u, "UB overflow");
  constexpr bool STRIDE7 = BM == 96u && BN == 128u && BK == 384u && RV == 48u;
  const uint32_t nTiles = (p.n + BN - 1u) / BN;
  GlobalTensor<int64_t> list;
  list.SetGlobalBuffer((__gm__ int64_t*)glGm);
  Schedule sched{list, p.listType, p.e, BM, nTiles};
  const uint32_t total = sched.Total();
  typename FullKPipeType<StaticNoPipe>::Type pipe;
  if ASCEND_IS_AIC {
    const uint32_t physicalAic = GetBlockIdx();
    const uint32_t aic =
        (STRIDE7 && p.cores % 7u != 0u) ? (physicalAic * 7u) % p.cores : physicalAic;
    const uint32_t first = uint32_t(uint64_t(total) * aic / p.cores);
    const uint32_t last = uint32_t(uint64_t(total) * (aic + 1u) / p.cores);
    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<int32_t> stg;
    xg.SetGlobalBuffer((__gm__ int8_t*)xGm);
    wg.SetGlobalBuffer((__gm__ int8_t*)wGm);
    stg.SetGlobalBuffer((__gm__ int32_t*)stGm);
    typename FullKBufferType<StaticNoPipe, TPosition::A1>::Type l1Buf;
    typename FullKBufferType<StaticNoPipe, TPosition::A2>::Type l0aBuf;
    typename FullKBufferType<StaticNoPipe, TPosition::B2>::Type l0bBuf;
    typename FullKBufferType<StaticNoPipe, TPosition::CO1>::Type l0cBuf;
    InitCubeBuffers<StaticNoPipe>(l1Buf, l0aBuf, l0bBuf, l0cBuf);
    pipe.Destroy();
    LocalTensor<int8_t> l1 = l1Buf.template Get<int8_t>();
    LocalTensor<int8_t> l0a = l0aBuf.template Get<int8_t>();
    LocalTensor<int8_t> l0b = l0bBuf.template Get<int8_t>();
    LocalTensor<int32_t> l0c = l0cBuf.template Get<int32_t>();
    SetFixPipeConfig<uint64_t>(l0c.ReinterpretCast<uint64_t>(), true);
    Barrier<HardEvent::FIX_M>();
    SetMMRowMajor();
    const uint32_t aBytes = BM * p.kl;
    const uint32_t bBytes = p.kl * BN;
    LocalTensor<int8_t> l1a = l1;
    LocalTensor<int8_t> l1b0 = l1[aBytes];
    LocalTensor<int8_t> l1b1 = l1[aBytes + (Prefetch ? bBytes : 0u)];
    if constexpr (!SingleL0) {
      SetFlag<HardEvent::M_MTE1>(1);
      SetFlag<HardEvent::M_MTE1>(2);
    }
    uint32_t heldAExpert = 0xffffffffu, heldM = 0xffffffffu;
    uint32_t heldBExpert = 0xffffffffu, heldN = 0xffffffffu;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      const uint32_t value = uint32_t(list.GetValue(e));
      const uint32_t end = p.listType == 0 ? value : start + value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t mBlocks = (rows + BM - 1u) / BM;
      const uint32_t count = mBlocks * nTiles;
      if (acc + count > first) {
        const uint32_t lo = first > acc ? first - acc : 0u;
        const uint32_t hi = Min(count, last - acc);
        for (uint32_t t = lo; t < hi; ++t) {
          const uint16_t tileId = uint16_t((acc + t - first) & 3u);
          if (acc + t - first >= 4u) CrossCoreWaitFlag(uint16_t(4u + tileId));
          const CubeTile tile =
              CubeTile::Of<BM, BN, NMajor>(t, mBlocks, nTiles, start, rows, p.n);
          const uint32_t gRow = tile.gRow, mt = tile.mt;
          const uint32_t nOff = tile.nOff, nt = tile.nt;
          const bool reuseA = e == heldAExpert && tile.mIdx == heldM;
          const bool reuseB = e == heldBExpert && tile.nIdx == heldN;
          if (!reuseA) LoadAPanel(l1a, xg, gRow, mt, p.k, BM);
          LocalTensor<int8_t> l1b = l1b0;
          if constexpr (Prefetch) l1b = ((t - lo) & 1u) ? l1b1 : l1b0;
          Nd2NzParams bp;
          bp.ndNum = 1;
          bp.nValue = uint16_t(p.k);
          bp.dValue = uint16_t(nt);
          bp.srcNdMatrixStride = 0;
          bp.srcDValue = uint16_t(p.wstride);
          bp.dstNzC0Stride = uint16_t(p.kl);
          bp.dstNzNStride = 1;
          bp.dstNzMatrixStride = 0;
          constexpr uint32_t prefix = SplitB * BK;
          const bool splitB = SplitB && t == lo && p.k > prefix;
          if (Prefetch ? t == lo : !reuseB) {
            Nd2NzParams early = bp;
            if (splitB) early.nValue = prefix;
            DataCopy(l1b, wg[uint64_t(e) * p.k * p.wstride + nOff], early);
          }
          Barrier<HardEvent::MTE2_MTE1>();
          if (splitB) {
            Nd2NzParams rest = bp;
            rest.nValue = p.k - prefix;
            DataCopy(l1b[prefix * C0_I8],
                     wg[(uint64_t(e) * p.k + prefix) * p.wstride + nOff], rest);
            SetFlag<HardEvent::MTE2_MTE1>(1);
          }
          if constexpr (Prefetch) {
            if (t + 1u < hi) {
              LocalTensor<int8_t> nextB = ((t - lo) & 1u) ? l1b0 : l1b1;
              const uint32_t nextNOff = ((t + 1u) % nTiles) * BN;
              Nd2NzParams nextBp = bp;
              nextBp.dValue = uint16_t(Min(BN, p.n - nextNOff));
              DataCopy(nextB, wg[uint64_t(e) * p.k * p.wstride + nextNOff], nextBp);
            }
          }
          bool firstK = true;
          for (uint32_t ks = 0; ks < p.k; ks += BK) {
            if (splitB && ks == prefix) WaitFlag<HardEvent::MTE2_MTE1>(1);
            const uint32_t kstep = Min(BK, p.k - ks);
            const uint32_t half = SingleL0 ? 0u : ((ks / BK) & 1u);
            if constexpr (!SingleL0) WaitFlag<HardEvent::M_MTE1>(half + 1u);
            LocalTensor<int8_t> a = l0a[half * BM * BK];
            LocalTensor<int8_t> b = l0b[half * BK * BN];
            const uint32_t kFrac = Up(kstep, C0_I8) / C0_I8;
            LoadTileToL0<BM>(a, b, l1a, l1b, ks, mt, nt, kFrac, p.kl);
            Barrier<HardEvent::MTE1_M>();
            MmadParams mp;
            mp.m = uint16_t(Up(mt, ROW_FRAC));
            mp.n = uint16_t(Up(nt, C0_I8));
            mp.k = uint16_t(kstep);
            mp.cmatrixInitVal = firstK;
            mp.unitFlag = (ks + BK >= p.k) ? 3u : 2u;
            Mmad(l0c, a, b, mp);
            if ((uint32_t(mp.m) / 16u) * (uint32_t(mp.n) / 16u) < 10u)
              PipeBarrier<PIPE_M>();
            if constexpr (SingleL0)
              Barrier<HardEvent::M_MTE1>();
            else
              SetFlag<HardEvent::M_MTE1>(half + 1u);
            firstK = false;
          }
          Barrier<HardEvent::MTE1_MTE2>();
          heldAExpert = e;
          heldM = tile.mIdx;
          heldBExpert = e;
          heldN = tile.nIdx;
          FixpipeParamsV220 fp;
          fp.nSize = uint16_t(Up(nt, C0_I8));
          fp.mSize = uint16_t(Up(mt, ROW_FRAC));
          fp.srcStride = uint16_t(Up(mt, ROW_FRAC));
          fp.dstStride = BN;
          fp.quantPre = QuantMode_t::NoQuant;
          fp.reluEn = false;
          fp.unitFlag = 3;
          const uint64_t base = uint64_t(acc + t) * BM * BN;
          Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(stg[base], l0c, fp);
          CrossCoreSetFlag<2, PIPE_FIX>(tileId);
        }
      }
      acc += count;
      start = end;
    }
    const uint32_t owned = last - first;
    for (uint32_t q = owned > 4u ? owned - 4u : owned; q < owned; ++q)
      CrossCoreWaitFlag(uint16_t(4u + (q & 3u)));
    if constexpr (!SingleL0) {
      WaitFlag<HardEvent::M_MTE1>(1);
      WaitFlag<HardEvent::M_MTE1>(2);
    }
    Barrier<HardEvent::FIX_M>();
    SetMMColumnMajor();
  } else {
    const uint32_t physicalAic = GetBlockIdx() / GetTaskRation();
    const uint32_t aic =
        (STRIDE7 && p.cores % 7u != 0u) ? (physicalAic * 7u) % p.cores : physicalAic;
    const uint32_t sub = GetSubBlockIdx();
    const uint32_t first = uint32_t(uint64_t(total) * aic / p.cores);
    const uint32_t last = uint32_t(uint64_t(total) * (aic + 1u) / p.cores);
    GlobalTensor<int32_t> stg;
    GlobalTensor<float> xsg;
    GlobalTensor<ScaleT> wsg;
    GlobalTensor<OutT> yg;
    stg.SetGlobalBuffer((__gm__ int32_t*)stGm);
    xsg.SetGlobalBuffer((__gm__ float*)xsGm);
    wsg.SetGlobalBuffer((__gm__ ScaleT*)wsGm);
    yg.SetGlobalBuffer((__gm__ OutT*)yGm);
    typename FullKBufferType<StaticNoPipe, TPosition::VECCALC>::Type ub;
    if constexpr (StaticNoPipe)
      ub.bytes = UB_USED;
    else
      GetTPipePtr()->InitBuffer(ub, UB_USED);
    pipe.Destroy();
    LocalTensor<uint8_t> raw = ub.template Get<uint8_t>();
    uint32_t off = 0;
    LocalTensor<int32_t> accI = raw[off].ReinterpretCast<int32_t>();
    off += RV * PITCH * 4u;
    LocalTensor<float> accF = raw[off].ReinterpretCast<float>();
    off += RV * PITCH * 4u;
    LocalTensor<OutT> out = raw[off].ReinterpretCast<OutT>();
    off += RV * PITCH * 2u;
    LocalTensor<ScaleT> wsl = raw[off].ReinterpretCast<ScaleT>();
    off += PITCH * 4u;
    LocalTensor<float> wsf = raw[off].ReinterpretCast<float>();
    off += PITCH * 4u;
    LocalTensor<float> xsl = raw[off].ReinterpretCast<float>();
    off += RV * 4u;
    LocalTensor<float> xsb = raw[off].ReinterpretCast<float>();
    uint32_t heldScaleExpert = 0xffffffffu, heldScaleN = 0xffffffffu;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      const uint32_t value = uint32_t(list.GetValue(e));
      const uint32_t end = p.listType == 0 ? value : start + value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t mBlocks = (rows + BM - 1u) / BM;
      const uint32_t count = mBlocks * nTiles;
      if (acc + count > first) {
        const uint32_t lo = first > acc ? first - acc : 0u;
        const uint32_t hi = Min(count, last - acc);
        for (uint32_t t = lo; t < hi; ++t) {
          const uint16_t tileId = uint16_t((acc + t - first) & 3u);
          const CubeTile tile =
              CubeTile::Of<BM, BN, NMajor>(t, mBlocks, nTiles, start, rows, p.n);
          const uint32_t gRow = tile.gRow, mt = tile.mt;
          const uint32_t nOff = tile.nOff, nt = tile.nt;
          const uint64_t base = uint64_t(acc + t) * BM * BN;
          if constexpr (BM <= 32 || BM == 208) {
            CrossCoreWaitFlag(tileId);
            if (last - first > 4u)
              CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
          }
          const uint32_t half = (mt + AIV_PER_AIC - 1u) / AIV_PER_AIC;
          const uint32_t r0 = Min(sub * half, mt);
          const uint32_t r1 = Min((sub + 1u) * half, mt);
          if (r0 < r1 && (!NMajor || heldScaleExpert != e || heldScaleN != tile.nIdx)) {
            heldScaleExpert = e;
            heldScaleN = tile.nIdx;
            DataCopyPad(wsl, wsg[uint64_t(e) * p.n + nOff],
                        DataCopyExtParams{1, uint32_t(nt * sizeof(ScaleT)), 0, 0, 0},
                        DataCopyPadExtParams<ScaleT>{false, 0, 0, 0});
            Barrier<HardEvent::MTE2_V>();
            ToFloat<ScaleT>(wsf, wsl, nt);
            PipeBarrier<PIPE_V>();
          }
          if constexpr (BM > 32 && BM != 208) {
            CrossCoreWaitFlag(tileId);
            if (last - first > 4u)
              CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
          }
          const uint32_t pitch = TightPitch ? Up(nt, ROW_FRAC) : PITCH;
          const uint32_t ntr = Up(nt, F32_PER_BLK);
          for (uint32_t r = r0; r < r1; r += RV) {
            const uint32_t nr = Min(RV, r1 - r);
            DataCopyExtParams stageCopy{uint16_t(nr), nt * 4u, (BN - nt) * 4u,
                                        (pitch - ntr) / F32_PER_BLK, 0};
            if constexpr (SingleBlockStage) {
              if (nt == BN) stageCopy = DataCopyExtParams{1, nr * BN * 4u, 0, 0, 0};
            }
            DataCopyPad(accI, stg[base + uint64_t(r) * BN], stageCopy,
                        DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
            DataCopyPad(xsl, xsg[gRow + r], DataCopyExtParams{1, nr * 4u, 0, 0, 0},
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
            Barrier<HardEvent::MTE2_V>();
            Cast(accF, accI, RoundMode::CAST_RINT, nr * pitch);
            BrcbRepeatParams br;
            br.dstBlkStride = 1;
            br.dstRepStride = 8;
            Brcb(xsb, xsl, uint8_t((nr + 7u) / 8u), br);
            PipeBarrier<PIPE_V>();
            MulByRow(accF, accF, wsf, nr, nt, pitch);
            PipeBarrier<PIPE_V>();
            MulByTokenScale(accF, xsb, nr, nt, pitch);
            PipeBarrier<PIPE_V>();
            Barrier<HardEvent::MTE3_V>();
            Cast(out, accF, RoundMode::CAST_RINT, nr * pitch);
            Barrier<HardEvent::V_MTE3>();
            StoreRows(yg[uint64_t(gRow + r) * p.n + nOff], out, nr, nt, pitch, p.n);
            Barrier<HardEvent::V_MTE2>();
          }
        }
      }
      acc += count;
      start = end;
    }
    Barrier<HardEvent::MTE3_S>();
  }
}
}
namespace gmmptq {
struct P4WeightedOwnership256 {
  __aicore__ static inline uint32_t ExpertWeight(uint32_t rows, uint32_t nt) {
    const uint32_t full = rows / 192u, tail = rows % 192u;
    return (full * 448u + (tail ? 256u + tail : 0u)) * nt;
  }
  __aicore__ static inline uint32_t Inverse(uint32_t rows, uint32_t nt,
                                            uint32_t target) {
    const uint32_t full = rows / 192u, tail = rows % 192u;
    const uint32_t strips = full + (tail != 0u), fullWeight = 448u * nt;
    const uint32_t strip = Min(target / fullWeight, full);
    if (strip == strips) return strips * nt;
    const uint32_t width = strip < full ? 448u : 256u + tail;
    const uint32_t local = target - strip * fullWeight;
    uint32_t tile = local / width;
    const uint32_t remainder = local - tile * width;
    if (tile < nt && remainder * 2u > width) ++tile;
    return strip * nt + tile;
  }
  template <class List>
  __aicore__ static inline void Own(List list, const Plan& p, uint32_t core,
                                    uint32_t& first, uint32_t& last) {
    const uint32_t nt = (p.n + 127u) / 128u;
    uint32_t start = 0, weight = 0;
    for (uint32_t e = 0; e < p.e; ++e) {
      const uint32_t value = uint32_t(list.GetValue(e));
      const uint32_t end = p.listType ? start + value : value;
      const uint32_t rows = end > start ? end - start : 0u;
      weight += ExpertWeight(rows, nt);
      start = end;
    }
    first = last = 0;
    if (weight == 0u) return;
    const uint32_t target0 = weight * core / p.cores;
    const uint32_t target1 = weight * (core + 1u) / p.cores;
    bool got0 = false, got1 = false;
    uint32_t prefix = 0, tiles = 0;
    start = 0;
    for (uint32_t e = 0; e < p.e && !(got0 && got1); ++e) {
      const uint32_t value = uint32_t(list.GetValue(e));
      const uint32_t end = p.listType ? start + value : value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t w = ExpertWeight(rows, nt);
      if (w) {
        if (!got0 && target0 <= prefix + w) {
          first = tiles + Inverse(rows, nt, target0 - prefix);
          got0 = true;
        }
        if (!got1 && target1 <= prefix + w) {
          last = tiles + Inverse(rows, nt, target1 - prefix);
          got1 = true;
        }
      }
      prefix += w;
      tiles += ((rows + 191u) / 192u) * nt;
      start = end;
    }
  }
};
template <typename ScaleT, typename OutT, uint32_t BM, uint32_t BN, uint32_t BK,
          uint32_t RV, bool NMajor = false, bool Prefetch = false,
          bool SingleL0 = false, bool StaticNoPipe = false, bool NativeM1 = false,
          bool CacheXS = false, bool WSSpan = false, bool Weighted = false,
          bool SingleBlockStage = false, uint32_t SplitB = 0u,
          bool UnitFlagChain = false, bool TightPitch = false,
          bool PairSnakeA = false>
__aicore__ inline void CubeFullKBodyScalarHalf(GM_ADDR xGm, GM_ADDR wGm, GM_ADDR xsGm,
                                               GM_ADDR wsGm, GM_ADDR glGm, GM_ADDR yGm,
                                               GM_ADDR stGm, Plan p) {
  using namespace AscendC;
  static_assert(BM > 0 && BM % 16 == 0, "BM must align to the M fractile");
  static_assert(BN > 0 && BN % 32 == 0, "BN must align to int8 transpose pairs");
  static_assert(BK > 0 && BK % 32 == 0, "BK must align to int8 K fractiles");
  static_assert(RV > 0 && RV <= BM && RV % 8 == 0, "RV must align Brcb rows");
  static_assert(sizeof(OutT) == 2, "The output must be fp16 or bf16");
  static_assert(!CacheXS || (!NMajor && RV >= (BM + 1u) / 2u),
                "one existing XS chunk per AV");
  static_assert(!(NMajor && Prefetch), "B prefetch is for M-major traversal");
  static_assert(BM * BK * (SingleL0 ? 1u : 2u) <= L0A_BYTES, "L0A overflow");
  static_assert(BN * BK * (SingleL0 ? 1u : 2u) <= L0B_BYTES, "L0B overflow");
  static_assert(BM * BN * sizeof(int32_t) <= L0C_BYTES, "L0C overflow");
  static_assert(!WSSpan || (BM == 192 && BN == 128 && RV == 128 && !NMajor && CacheXS &&
                            sizeof(ScaleT) == 4),
                "P4 WS span resource contract");
  static_assert(
      !Weighted || (BM == 192 && BN == 128 && BK == 96 && RV == 128 && !NMajor &&
                    Prefetch && StaticNoPipe && NativeM1 && CacheXS && WSSpan),
      "fixed P4 weighted ownership contract");
  static_assert(!SplitB || Prefetch, "the split B prefix extends the prefetch");
  static_assert(!PairSnakeA || (!SingleL0 && !NativeM1 && !NMajor),
                "pair snake retains the M-major double-L0 K parity");
  constexpr uint32_t PITCH = BN;
  constexpr uint32_t UB_USED = RV * PITCH * 10u + PITCH * 8u + RV * 36u;
  static_assert(UB_USED <= 192u * 1024u - 8192u - 256u, "UB overflow");
  constexpr bool STRIDE7 = (BM == 192u && BN == 128u && BK == 96u && RV == 128u) ||
                           (BM == 224u && BN == 128u && BK == 128u && (RV == 64u || RV == 112u));
  const uint32_t nTiles = (p.n + BN - 1u) / BN;
  GlobalTensor<int64_t> list;
  list.SetGlobalBuffer((__gm__ int64_t*)glGm);
  Schedule sched{list, p.listType, p.e, BM, nTiles};
  uint32_t total = 0;
  if constexpr (!Weighted) total = sched.Total();
  typename FullKPipeType<StaticNoPipe>::Type pipe;
  if ASCEND_IS_AIC {
    const uint32_t physicalAic = GetBlockIdx();
    const uint32_t aic =
        (STRIDE7 && p.cores % 7u != 0u) ? (physicalAic * 7u) % p.cores : physicalAic;
    uint32_t first, last;
    if constexpr (Weighted)
      P4WeightedOwnership256::Own(list, p, aic, first, last);
    else {
      first = uint32_t(uint64_t(total) * aic / p.cores);
      last = uint32_t(uint64_t(total) * (aic + 1u) / p.cores);
    }
    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<half> stg;
    xg.SetGlobalBuffer((__gm__ int8_t*)xGm);
    wg.SetGlobalBuffer((__gm__ int8_t*)wGm);
    stg.SetGlobalBuffer((__gm__ half*)stGm);
    typename FullKBufferType<StaticNoPipe, TPosition::A1>::Type l1Buf;
    typename FullKBufferType<StaticNoPipe, TPosition::A2>::Type l0aBuf;
    typename FullKBufferType<StaticNoPipe, TPosition::B2>::Type l0bBuf;
    typename FullKBufferType<StaticNoPipe, TPosition::CO1>::Type l0cBuf;
    InitCubeBuffers<StaticNoPipe>(l1Buf, l0aBuf, l0bBuf, l0cBuf);
    pipe.Destroy();
    LocalTensor<int8_t> l1 = l1Buf.template Get<int8_t>();
    LocalTensor<int8_t> l0a = l0aBuf.template Get<int8_t>();
    LocalTensor<int8_t> l0b = l0bBuf.template Get<int8_t>();
    LocalTensor<int32_t> l0c = l0cBuf.template Get<int32_t>();
    if constexpr (UnitFlagChain) {
      SetFixPipeConfig<uint64_t>(l0c.ReinterpretCast<uint64_t>(), true);
      Barrier<HardEvent::FIX_M>();
      SetMMRowMajor();
    }
    const uint32_t aBytes = BM * p.kl;
    const uint32_t bBytes = p.kl * BN;
    LocalTensor<int8_t> l1a = l1;
    LocalTensor<int8_t> l1b0 = l1[aBytes];
    LocalTensor<int8_t> l1b1 = l1[aBytes + (Prefetch ? bBytes : 0u)];
    if constexpr (!SingleL0) {
      SetFlag<HardEvent::M_MTE1>(1);
      SetFlag<HardEvent::M_MTE1>(2);
    }
    uint32_t heldAExpert = 0xffffffffu, heldM = 0xffffffffu;
    bool reverseAPairs = false;
    uint32_t heldBExpert = 0xffffffffu, heldN = 0xffffffffu;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      const uint32_t value = uint32_t(list.GetValue(e));
      const uint32_t end = p.listType == 0 ? value : start + value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t mBlocks = (rows + BM - 1u) / BM;
      const uint32_t count = mBlocks * nTiles;
      if (acc + count > first) {
        const uint32_t lo = first > acc ? first - acc : 0u;
        const uint32_t hi = Min(count, last - acc);
        for (uint32_t t = lo; t < hi; ++t) {
          const uint16_t tileId = uint16_t((acc + t - first) & 3u);
          if (acc + t - first >= 4u) CrossCoreWaitFlag(uint16_t(4u + tileId));
          const CubeTile tile =
              CubeTile::Of<BM, BN, NMajor>(t, mBlocks, nTiles, start, rows, p.n);
          const uint32_t gRow = tile.gRow, mt = tile.mt;
          const uint32_t nOff = tile.nOff, nt = tile.nt;
          const bool reuseA = e == heldAExpert && tile.mIdx == heldM;
          if constexpr (PairSnakeA) reverseAPairs = reuseA ? !reverseAPairs : false;
          const bool reuseB = e == heldBExpert && tile.nIdx == heldN;
          const bool nativeM1 = NativeM1 && mt == 1u &&
                                uint64_t(p.kl) * Up(nt, C0_I8) <= L0B_BYTES;
          if (!reuseA) LoadAPanel(l1a, xg, gRow, mt, p.k, nativeM1 ? 1u : BM);
          LocalTensor<int8_t> l1b = l1b0;
          if constexpr (Prefetch) l1b = ((t - lo) & 1u) ? l1b1 : l1b0;
          Nd2NzParams bp;
          bp.ndNum = 1;
          bp.nValue = uint16_t(p.k);
          bp.dValue = uint16_t(nt);
          bp.srcNdMatrixStride = 0;
          bp.srcDValue = uint16_t(p.wstride);
          bp.dstNzC0Stride = uint16_t(p.kl);
          bp.dstNzNStride = 1;
          bp.dstNzMatrixStride = 0;
          constexpr uint32_t prefix = SplitB * BK;
          const bool splitB = SplitB && t == lo && p.k > prefix && !nativeM1;
          if constexpr (Prefetch) {
            if (t == lo) {
              Nd2NzParams early = bp;
              if (splitB) early.nValue = prefix;
              DataCopy(l1b, wg[uint64_t(e) * p.k * p.wstride + nOff], early);
            }
          } else {
            if (!reuseB) DataCopy(l1b, wg[uint64_t(e) * p.k * p.wstride + nOff], bp);
          }
          Barrier<HardEvent::MTE2_MTE1>();
          if (splitB) {
            Nd2NzParams rest = bp;
            rest.nValue = p.k - prefix;
            DataCopy(l1b[prefix * C0_I8],
                     wg[(uint64_t(e) * p.k + prefix) * p.wstride + nOff], rest);
            SetFlag<HardEvent::MTE2_MTE1>(1);
          }
          if constexpr (Prefetch) {
            if (t + 1u < hi) {
              LocalTensor<int8_t> nextB = ((t - lo) & 1u) ? l1b0 : l1b1;
              const uint32_t nextNOff = ((t + 1u) % nTiles) * BN;
              Nd2NzParams nextBp = bp;
              nextBp.dValue = uint16_t(Min(BN, p.n - nextNOff));
              DataCopy(nextB, wg[uint64_t(e) * p.k * p.wstride + nextNOff], nextBp);
            }
          }
          if (nativeM1) {
            WaitFlag<HardEvent::M_MTE1>(1);
            WaitFlag<HardEvent::M_MTE1>(2);
            LoadData2DParams na;
            na.startIndex = 0;
            na.repeatTimes = 1;
            na.srcStride = 1;
            na.dstGap = 0;
            na.ifTranspose = false;
            na.sid = 0;
            na.addrMode = 0;
            LoadData(l0a, l1a, na);
            LoadData2dTransposeParams nb;
            nb.startIndex = 0;
            nb.repeatTimes = uint8_t(Up(nt, C0_I8) / C0_I8);
            nb.srcStride = uint16_t(p.kl / C0_I8);
            nb.dstGap = 1;
            nb.dstFracGap = 0;
            nb.addrMode = 0;
            const uint32_t nativeStride = Up(nt, C0_I8) * C0_I8;
            for (uint32_t k32 = 0; k32 < p.kl / C0_I8; ++k32)
              LoadDataWithTranspose(l0b[k32 * nativeStride], l1b[k32 * 2u * FRAC_I8],
                                    nb);
            Barrier<HardEvent::MTE1_M>();
            if constexpr (!UnitFlagChain) Barrier<HardEvent::FIX_M>();
            MmadParams nm;
            nm.m = 1;
            nm.n = uint16_t(Up(nt, C0_I8));
            nm.k = uint16_t(p.k);
            nm.cmatrixInitVal = true;
            nm.unitFlag = UnitFlagChain ? 3u : 0u;
            Mmad(l0c, l0a, l0b, nm);
            PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(1);
            SetFlag<HardEvent::M_MTE1>(2);
          } else {
            if constexpr (PairSnakeA) {
              bool firstK = true;
              const uint32_t kBlocks = (p.k + BK - 1u) / BK;
              for (uint32_t q = 0; q < kBlocks; ++q) {
                const uint32_t slab = reverseAPairs
                    ? kBlocks - 2u - (q & ~1u) + (q & 1u) : q;
                const uint32_t ks = slab * BK;
                if (splitB && ks == prefix) WaitFlag<HardEvent::MTE2_MTE1>(1);
                const uint32_t kstep = Min(BK, p.k - ks);
                const uint32_t half = q & 1u;
                if constexpr (!SingleL0) WaitFlag<HardEvent::M_MTE1>(half + 1u);
                LocalTensor<int8_t> a = l0a[half * BM * BK];
                LocalTensor<int8_t> b = l0b[half * BK * BN];
                const uint32_t kFrac = Up(kstep, C0_I8) / C0_I8;
                LoadTileToL0ResidentA<BM, true>(a, b, l1a, l1b, ks, mt, nt, kFrac,
                                         p.kl, !reuseA || q >= 2u);
                Barrier<HardEvent::MTE1_M>();
                MmadParams mp;
                mp.m = uint16_t(Up(mt, ROW_FRAC));
                mp.n = uint16_t(Up(nt, C0_I8));
                mp.k = uint16_t(kstep);
                mp.cmatrixInitVal = firstK;
                if constexpr (UnitFlagChain) {
                  mp.unitFlag = (q + 1u == kBlocks) ? 3u : 2u;
                } else {
                  mp.unitFlag = 0;
                  if (firstK) Barrier<HardEvent::FIX_M>();
                }
                Mmad(l0c, a, b, mp);
                if ((uint32_t(mp.m) / 16u) * (uint32_t(mp.n) / 16u) < 10u)
                  PipeBarrier<PIPE_M>();
                if constexpr (SingleL0)
                  Barrier<HardEvent::M_MTE1>();
                else
                  SetFlag<HardEvent::M_MTE1>(half + 1u);
                firstK = false;
              }
            } else {
              bool firstK = true;
              for (uint32_t ks = 0; ks < p.k; ks += BK) {
                if (splitB && ks == prefix) WaitFlag<HardEvent::MTE2_MTE1>(1);
                const uint32_t kstep = Min(BK, p.k - ks);
                const uint32_t half = SingleL0 ? 0u : ((ks / BK) & 1u);
                if constexpr (!SingleL0) WaitFlag<HardEvent::M_MTE1>(half + 1u);
                LocalTensor<int8_t> a = l0a[half * BM * BK];
                LocalTensor<int8_t> b = l0b[half * BK * BN];
                const uint32_t kFrac = Up(kstep, C0_I8) / C0_I8;
                LoadTileToL0<BM>(a, b, l1a, l1b, ks, mt, nt, kFrac, p.kl);
                Barrier<HardEvent::MTE1_M>();
                MmadParams mp;
                mp.m = uint16_t(Up(mt, ROW_FRAC));
                mp.n = uint16_t(Up(nt, C0_I8));
                mp.k = uint16_t(kstep);
                mp.cmatrixInitVal = firstK;
                if constexpr (UnitFlagChain) {
                  mp.unitFlag = (ks + BK >= p.k) ? 3u : 2u;
                } else {
                  mp.unitFlag = 0;
                  if (firstK) Barrier<HardEvent::FIX_M>();
                }
                Mmad(l0c, a, b, mp);
                if ((uint32_t(mp.m) / 16u) * (uint32_t(mp.n) / 16u) < 10u)
                  PipeBarrier<PIPE_M>();
                if constexpr (SingleL0)
                  Barrier<HardEvent::M_MTE1>();
                else
                  SetFlag<HardEvent::M_MTE1>(half + 1u);
                firstK = false;
              }
            }
          }
          Barrier<HardEvent::MTE1_MTE2>();
          heldAExpert = e;
          heldM = tile.mIdx;
          heldBExpert = e;
          heldN = tile.nIdx;
          if constexpr (!UnitFlagChain) Barrier<HardEvent::M_FIX>();
          FixpipeParamsV220 fp;
          fp.nSize = uint16_t(UnitFlagChain ? Up(nt, C0_I8) : nt);
          fp.mSize = uint16_t(UnitFlagChain ? (nativeM1 ? 1u : Up(mt, ROW_FRAC)) : mt);
          fp.srcStride = uint16_t(Up(mt, ROW_FRAC));
          fp.dstStride = BN;
          fp.quantPre = QuantMode_t::DEQF16;
          fp.deqScalar = 0x39800000ull;
          fp.reluEn = false;
          fp.unitFlag = UnitFlagChain ? 3u : 0u;
          const uint64_t base = uint64_t(acc + t) * BM * BN;
          Fixpipe<half, int32_t, CFG_ROW_MAJOR>(stg[base], l0c, fp);
          CrossCoreSetFlag<2, PIPE_FIX>(tileId);
        }
      }
      acc += count;
      start = end;
    }
    const uint32_t owned = last - first;
    for (uint32_t q = owned > 4u ? owned - 4u : owned; q < owned; ++q)
      CrossCoreWaitFlag(uint16_t(4u + (q & 3u)));
    if constexpr (!SingleL0) {
      WaitFlag<HardEvent::M_MTE1>(1);
      WaitFlag<HardEvent::M_MTE1>(2);
    }
    if constexpr (UnitFlagChain) {
      Barrier<HardEvent::FIX_M>();
      SetMMColumnMajor();
    }
  } else {
    const uint32_t physicalAic = GetBlockIdx() / GetTaskRation();
    const uint32_t aic =
        (STRIDE7 && p.cores % 7u != 0u) ? (physicalAic * 7u) % p.cores : physicalAic;
    const uint32_t sub = GetSubBlockIdx();
    uint32_t first, last;
    if constexpr (Weighted)
      P4WeightedOwnership256::Own(list, p, aic, first, last);
    else {
      first = uint32_t(uint64_t(total) * aic / p.cores);
      last = uint32_t(uint64_t(total) * (aic + 1u) / p.cores);
    }
    GlobalTensor<half> stg;
    GlobalTensor<float> xsg;
    GlobalTensor<ScaleT> wsg;
    GlobalTensor<OutT> yg;
    stg.SetGlobalBuffer((__gm__ half*)stGm);
    xsg.SetGlobalBuffer((__gm__ float*)xsGm);
    wsg.SetGlobalBuffer((__gm__ ScaleT*)wsGm);
    yg.SetGlobalBuffer((__gm__ OutT*)yGm);
    typename FullKBufferType<StaticNoPipe, TPosition::VECCALC>::Type ub;
    if constexpr (StaticNoPipe)
      ub.bytes = UB_USED;
    else
      GetTPipePtr()->InitBuffer(ub, UB_USED);
    pipe.Destroy();
    LocalTensor<uint8_t> raw = ub.template Get<uint8_t>();
    uint32_t off = 0;
    LocalTensor<half> accI = raw[off].ReinterpretCast<half>();
    off += RV * PITCH * 4u;
    LocalTensor<float> accF = raw[off].ReinterpretCast<float>();
    off += RV * PITCH * 4u;
    LocalTensor<OutT> out = raw[off].ReinterpretCast<OutT>();
    off += RV * PITCH * 2u;
    LocalTensor<ScaleT> wsl = raw[off].ReinterpretCast<ScaleT>();
    off += PITCH * 4u;
    LocalTensor<float> wsf = raw[off].ReinterpretCast<float>();
    off += PITCH * 4u;
    LocalTensor<float> xsl = raw[off].ReinterpretCast<float>();
    off += RV * 4u;
    LocalTensor<float> xsb = raw[off].ReinterpretCast<float>();
    uint32_t heldScaleExpert = 0xffffffffu, heldScaleN = 0xffffffffu;
    uint32_t heldXSRow = 0xffffffffu, heldXSRows = 0xffffffffu;
    LocalTensor<ScaleT> spanWSRaw = raw[RV * PITCH * 2u].ReinterpretCast<ScaleT>();
    LocalTensor<float> spanWSScaled =
        raw[RV * PITCH * 2u + 4096u].ReinterpretCast<float>();
    uint32_t spanExpert = 0xffffffffu, spanM = 0xffffffffu;
    uint32_t spanFirstN = 0u, spanEndN = 0u;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      const uint32_t value = uint32_t(list.GetValue(e));
      const uint32_t end = p.listType == 0 ? value : start + value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t mBlocks = (rows + BM - 1u) / BM;
      const uint32_t count = mBlocks * nTiles;
      if (acc + count > first) {
        const uint32_t lo = first > acc ? first - acc : 0u;
        const uint32_t hi = Min(count, last - acc);
        for (uint32_t t = lo; t < hi; ++t) {
          const uint16_t tileId = uint16_t((acc + t - first) & 3u);
          const CubeTile tile =
              CubeTile::Of<BM, BN, NMajor>(t, mBlocks, nTiles, start, rows, p.n);
          const uint32_t gRow = tile.gRow, mt = tile.mt;
          const uint32_t nOff = tile.nOff, nt = tile.nt;
          const uint64_t base = uint64_t(acc + t) * BM * BN;
          if constexpr (BM <= 32 || BM == 208) {
            CrossCoreWaitFlag(tileId);
            if (last - first > 4u)
              CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
          }
          const uint32_t half = (mt + AIV_PER_AIC - 1u) / AIV_PER_AIC;
          const uint32_t r0 = Min(sub * half, mt);
          const uint32_t r1 = Min((sub + 1u) * half, mt);
          LocalTensor<float> tileWS = wsf;
          if constexpr (WSSpan) {
            if (r0 < r1) {
              if (spanExpert != e || spanM != tile.mIdx || tile.nIdx < spanFirstN ||
                  tile.nIdx >= spanEndN) {
                const uint32_t runEnd = Min(hi, (tile.mIdx + 1u) * nTiles);
                spanFirstN = tile.nIdx;
                spanEndN = runEnd - tile.mIdx * nTiles;
                const uint32_t spanNt = Min(p.n, spanEndN * BN) - nOff;
                DataCopyPad(
                    spanWSRaw, wsg[uint64_t(e) * p.n + nOff],
                    DataCopyExtParams{1, spanNt * uint32_t(sizeof(ScaleT)), 0, 0, 0},
                    DataCopyPadExtParams<ScaleT>{false, 0, 0, 0});
                Barrier<HardEvent::MTE2_V>();
                Muls(spanWSScaled, spanWSRaw, 4096.0f, spanNt);
                PipeBarrier<PIPE_V>();
                spanExpert = e;
                spanM = tile.mIdx;
              }
              tileWS = spanWSScaled[(tile.nIdx - spanFirstN) * BN];
            }
          } else {
            if (r0 < r1 &&
                (!NMajor || heldScaleExpert != e || heldScaleN != tile.nIdx)) {
              heldScaleExpert = e;
              heldScaleN = tile.nIdx;
              DataCopyPad(wsl, wsg[uint64_t(e) * p.n + nOff],
                          DataCopyExtParams{1, uint32_t(nt * sizeof(ScaleT)), 0, 0, 0},
                          DataCopyPadExtParams<ScaleT>{false, 0, 0, 0});
              Barrier<HardEvent::MTE2_V>();
              Muls(wsf, wsl, 4096.0f, nt);
              PipeBarrier<PIPE_V>();
            }
          }
          if constexpr (BM > 32 && BM != 208) {
            CrossCoreWaitFlag(tileId);
            if (last - first > 4u)
              CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
          }
          const uint32_t pitch = TightPitch ? Up(nt, ROW_FRAC) : PITCH;
          const uint32_t ntr = Up(nt, ROW_FRAC);
          for (uint32_t r = r0; r < r1; r += RV) {
            const uint32_t nr = Min(RV, r1 - r);
            DataCopyExtParams stageCopy{uint16_t(nr), nt * 2u, (BN - nt) * 2u,
                                        (pitch - ntr) / ROW_FRAC, 0};
            if constexpr (SingleBlockStage) {
              if (nt == BN) stageCopy = DataCopyExtParams{1, nr * BN * 2u, 0, 0, 0};
            }
            DataCopyPad(accI, stg[base + uint64_t(r) * BN], stageCopy,
                        DataCopyPadExtParams<OutT>{false, 0, 0, 0});
            const bool loadXS = !CacheXS || heldXSRow != gRow + r || heldXSRows != nr;
            if (loadXS) {
              DataCopyPad(xsl, xsg[gRow + r], DataCopyExtParams{1, nr * 4u, 0, 0, 0},
                          DataCopyPadExtParams<float>{false, 0, 0, 0});
            }
            Barrier<HardEvent::MTE2_V>();
            Cast(accF, accI, RoundMode::CAST_NONE, nr * pitch);
            if (loadXS) {
              BrcbRepeatParams br;
              br.dstBlkStride = 1;
              br.dstRepStride = 8;
              Brcb(xsb, xsl, uint8_t((nr + 7u) / 8u), br);
              heldXSRow = gRow + r;
              heldXSRows = nr;
            }
            PipeBarrier<PIPE_V>();
            MulByRow(accF, accF, tileWS, nr, nt, pitch);
            PipeBarrier<PIPE_V>();
            MulByTokenScale(accF, xsb, nr, nt, pitch);
            PipeBarrier<PIPE_V>();
            Barrier<HardEvent::MTE3_V>();
            Cast(out, accF, RoundMode::CAST_RINT, nr * pitch);
            Barrier<HardEvent::V_MTE3>();
            StoreRows(yg[uint64_t(gRow + r) * p.n + nOff], out, nr, nt, pitch, p.n);
            Barrier<HardEvent::V_MTE2>();
          }
        }
      }
      acc += count;
      start = end;
    }
    Barrier<HardEvent::MTE3_S>();
  }
}
}
namespace gmmptq {
template <typename ScaleT, typename OutT, uint32_t BM, uint32_t BN, uint32_t BK,
          uint32_t RV, bool NMajor = false, bool Prefetch = false,
          bool SingleL0 = false, bool StaticNoPipe = false, bool ChunkPrefetch = false,
          bool ColdBPrefix = false, bool SingleBlockStage = false,
          bool ContinuousTiles = false, bool PlainAlignedStage = false,
          bool StridedPair = false, bool HalfPairOutput = false>
__aicore__ inline void CubeFullKUnitBodyScalarHalf(GM_ADDR xGm, GM_ADDR wGm,
                                                   GM_ADDR xsGm, GM_ADDR wsGm,
                                                   GM_ADDR glGm, GM_ADDR yGm,
                                                   GM_ADDR stGm, Plan p) {
  using namespace AscendC;
  static_assert(BM > 0 && BM % 16 == 0, "BM must align to the M fractile");
  static_assert(BN > 0 && BN % 32 == 0, "BN must align to int8 transpose pairs");
  static_assert(BK > 0 && BK % 32 == 0, "BK must align to int8 K fractiles");
  static_assert(RV > 0 && RV <= BM && RV % 8 == 0, "RV must align Brcb rows");
  static_assert(sizeof(OutT) == 2, "The output must be fp16 or bf16");
  static_assert(!(NMajor && Prefetch), "B prefetch is for M-major traversal");
  static_assert(BM * BK * (SingleL0 ? 1u : 2u) <= L0A_BYTES, "L0A overflow");
  static_assert(BN * BK * (SingleL0 ? 1u : 2u) <= L0B_BYTES, "L0B overflow");
  static_assert(BM * BN * sizeof(int32_t) <= L0C_BYTES, "L0C overflow");
  static_assert(!SingleBlockStage ||
                    (BM == 128 && BN == 256 && BK == 128 && RV == 32 && StaticNoPipe &&
                     ChunkPrefetch && ColdBPrefix && !NMajor && Prefetch),
                "fixed P1 aligned fullN singleblock-stage contract");
  static_assert(
      !PlainAlignedStage || SingleBlockStage,
      "PlainAlignedStage requires the original P1 aligned single-block stage contract");
  constexpr uint32_t PITCH = BN;
  static_assert(!HalfPairOutput || (StridedPair && ChunkPrefetch && SingleBlockStage &&
                                    BN == 128u && RV == 64u),
                "half pairing requires existing aligned panel family");
  static_assert(
      BM == 128u && BN == 256u && BK == 128u && RV == 32u && !NMajor && Prefetch &&
          StaticNoPipe && ChunkPrefetch && ColdBPrefix && SingleBlockStage &&
          ContinuousTiles && PlainAlignedStage && !StridedPair && !HalfPairOutput &&
          sizeof(ScaleT) == 4u && sizeof(OutT) == 2u,
      "precombined FP16 scales require the original P1 complete resource policy");
  constexpr uint32_t UB_USED =
      (StridedPair ? 98304u : 0u) - (HalfPairOutput ? 49152u : 0u) + RV * PITCH * 10u +
      PITCH * 8u + RV * 36u + (ChunkPrefetch ? RV * 4u : 0u) + RV * PITCH * 8u;
  static_assert(UB_USED <= 192u * 1024u - 8192u - 256u, "UB overflow");
  const uint32_t nTiles = (p.n + BN - 1u) / BN;
  GlobalTensor<int64_t> list;
  list.SetGlobalBuffer((__gm__ int64_t*)glGm);
  Schedule sched{list, p.listType, p.e, BM, nTiles};
  const uint32_t total = sched.Total();
  typename FullKPipeType<StaticNoPipe>::Type pipe;
  if ASCEND_IS_AIC {
    const uint32_t physical = GetBlockIdx();
    const uint32_t aic = p.cores == 20u
                             ? (physical * 7u + 1u) % p.cores
                             : (physical + 1u == p.cores ? 0u : physical + 1u);
    const uint32_t first = static_cast<uint32_t>(uint64_t(total) * aic / p.cores);
    const uint32_t last = static_cast<uint32_t>(uint64_t(total) * (aic + 1u) / p.cores);
    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<half> stg;
    xg.SetGlobalBuffer((__gm__ int8_t*)xGm);
    wg.SetGlobalBuffer((__gm__ int8_t*)wGm);
    stg.SetGlobalBuffer((__gm__ half*)stGm);
    typename FullKBufferType<StaticNoPipe, TPosition::A1>::Type l1Buf;
    typename FullKBufferType<StaticNoPipe, TPosition::A2>::Type l0aBuf;
    typename FullKBufferType<StaticNoPipe, TPosition::B2>::Type l0bBuf;
    typename FullKBufferType<StaticNoPipe, TPosition::CO1>::Type l0cBuf;
    if constexpr (StaticNoPipe)
      l1Buf.bytes = L1_BYTES;
    else
      GetTPipePtr()->InitBuffer(l1Buf, L1_BYTES);
    if constexpr (StaticNoPipe)
      l0aBuf.bytes = L0A_BYTES;
    else
      GetTPipePtr()->InitBuffer(l0aBuf, L0A_BYTES);
    if constexpr (StaticNoPipe)
      l0bBuf.bytes = L0B_BYTES;
    else
      GetTPipePtr()->InitBuffer(l0bBuf, L0B_BYTES);
    if constexpr (StaticNoPipe)
      l0cBuf.bytes = L0C_BYTES;
    else
      GetTPipePtr()->InitBuffer(l0cBuf, L0C_BYTES);
    pipe.Destroy();
    LocalTensor<int8_t> l1 = l1Buf.template Get<int8_t>();
    LocalTensor<int8_t> l0a = l0aBuf.template Get<int8_t>();
    LocalTensor<int8_t> l0b = l0bBuf.template Get<int8_t>();
    LocalTensor<int32_t> l0c = l0cBuf.template Get<int32_t>();
    SetFixPipeConfig<uint64_t>(l0c.ReinterpretCast<uint64_t>(), true);
    Barrier<HardEvent::FIX_M>();
    SetMMRowMajor();
    const uint32_t aBytes = BM * p.kl;
    const uint32_t bBytes = p.kl * BN;
    LocalTensor<int8_t> l1a = l1;
    LocalTensor<int8_t> l1b0 = l1[aBytes];
    LocalTensor<int8_t> l1b1 = l1[aBytes + (Prefetch ? bBytes : 0u)];
    if constexpr (!SingleL0) {
      SetFlag<HardEvent::M_MTE1>(1);
      SetFlag<HardEvent::M_MTE1>(2);
    }
    uint32_t heldAExpert = 0xffffffffu, heldM = 0xffffffffu;
    uint32_t heldBExpert = 0xffffffffu, heldN = 0xffffffffu;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      const uint32_t value = static_cast<uint32_t>(list.GetValue(e));
      const uint32_t end = p.listType == 0 ? value : start + value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t mBlocks = (rows + BM - 1u) / BM;
      const uint32_t count = mBlocks * nTiles;
      if (acc + count > first) {
        const uint32_t lo = first > acc ? first - acc : 0u;
        const uint32_t hi = Min(count, last - acc);
        uint32_t carriedM = 0u, carriedN = 0u;
        if constexpr (ContinuousTiles && !NMajor) {
          carriedM = lo / nTiles;
          carriedN = lo - carriedM * nTiles;
        }
        for (uint32_t t = lo; t < hi; ++t) {
          const uint16_t tileId =
              uint16_t((acc + t - first) & ((last - first <= 8u) ? 7u : 3u));
          if (last - first > 8u && acc + t - first >= 4u) {
            CrossCoreWaitFlag(uint16_t(4u + tileId));
          }
          uint32_t mIdx, nIdx;
          if constexpr (NMajor) {
            mIdx = t % mBlocks;
            nIdx = t / mBlocks;
          } else {
            if constexpr (ContinuousTiles) {
              mIdx = carriedM;
              nIdx = carriedN;
            } else {
              mIdx = t / nTiles;
              nIdx = t % nTiles;
            }
          }
          const uint32_t gRow = start + mIdx * BM;
          const uint32_t mt = Min(BM, rows - mIdx * BM);
          const uint32_t nOff = nIdx * BN;
          const uint32_t nt = Min(BN, p.n - nOff);
          const bool reuseA = e == heldAExpert && mIdx == heldM;
          const bool reuseB = e == heldBExpert && nIdx == heldN;
          if (!reuseA) {
            Nd2NzParams ap;
            ap.ndNum = 1;
            ap.nValue = static_cast<uint16_t>(mt);
            ap.dValue = static_cast<uint16_t>(p.k);
            ap.srcNdMatrixStride = 0;
            ap.srcDValue = static_cast<uint16_t>(p.k);
            ap.dstNzC0Stride = static_cast<uint16_t>(BM);
            ap.dstNzNStride = 1;
            ap.dstNzMatrixStride = 0;
            DataCopy(l1a, xg[uint64_t(gRow) * p.k], ap);
          }
          LocalTensor<int8_t> l1b = l1b0;
          if constexpr (Prefetch) l1b = ((t - lo) & 1u) ? l1b1 : l1b0;
          Nd2NzParams bp;
          bp.ndNum = 1;
          bp.nValue = static_cast<uint16_t>(p.k);
          bp.dValue = static_cast<uint16_t>(nt);
          bp.srcNdMatrixStride = 0;
          bp.srcDValue = static_cast<uint16_t>(p.wstride);
          bp.dstNzC0Stride = static_cast<uint16_t>(p.kl);
          bp.dstNzNStride = 1;
          bp.dstNzMatrixStride = 0;
          bool splitCurrentB = false;
          if constexpr (Prefetch) {
            if (t == lo) {
              if constexpr (ColdBPrefix) {
                splitCurrentB = p.k > BK;
                Nd2NzParams firstBp = bp;
                if (splitCurrentB) firstBp.nValue = static_cast<uint16_t>(BK);
                DataCopy(l1b, wg[uint64_t(e) * p.k * p.wstride + nOff], firstBp);
              } else {
                DataCopy(l1b, wg[uint64_t(e) * p.k * p.wstride + nOff], bp);
              }
            }
          } else {
            if (!reuseB) DataCopy(l1b, wg[uint64_t(e) * p.k * p.wstride + nOff], bp);
          }
          Barrier<HardEvent::MTE2_MTE1>();
          if constexpr (ColdBPrefix) {
            if (splitCurrentB) {
              Nd2NzParams restBp = bp;
              restBp.nValue = static_cast<uint16_t>(p.k - BK);
              DataCopy(l1b[BK * C0_I8], wg[(uint64_t(e) * p.k + BK) * p.wstride + nOff],
                       restBp);
              SetFlag<HardEvent::MTE2_MTE1>(1);
            }
          }
          if constexpr (Prefetch) {
            if (t + 1u < hi) {
              LocalTensor<int8_t> nextB = ((t - lo) & 1u) ? l1b0 : l1b1;
              uint32_t nextNIdx;
              if constexpr (ContinuousTiles && !NMajor)
                nextNIdx = (carriedN + 1u == nTiles) ? 0u : carriedN + 1u;
              else
                nextNIdx = (t + 1u) % nTiles;
              const uint32_t nextNOff = nextNIdx * BN;
              Nd2NzParams nextBp = bp;
              nextBp.dValue = static_cast<uint16_t>(Min(BN, p.n - nextNOff));
              DataCopy(nextB, wg[uint64_t(e) * p.k * p.wstride + nextNOff], nextBp);
            }
          }
          bool firstK = true;
          for (uint32_t ks = 0; ks < p.k; ks += BK) {
            if constexpr (ColdBPrefix) {
              if (splitCurrentB && ks == BK) WaitFlag<HardEvent::MTE2_MTE1>(1);
            }
            const uint32_t kstep = Min(BK, p.k - ks);
            const uint32_t half = SingleL0 ? 0u : ((ks / BK) & 1u);
            if constexpr (!SingleL0) WaitFlag<HardEvent::M_MTE1>(half + 1u);
            LocalTensor<int8_t> a = l0a[half * BM * BK];
            LocalTensor<int8_t> b = l0b[half * BK * BN];
            const uint32_t kFrac = Up(kstep, C0_I8) / C0_I8;
            const uint32_t mFrac = Up(mt, ROW_FRAC) / ROW_FRAC;
            const uint32_t bRowStride = Up(nt, C0_I8) * C0_I8;
            LoadData2DParams la;
            la.startIndex = 0;
            la.repeatTimes = static_cast<uint8_t>(mFrac);
            la.srcStride = 1;
            la.dstGap = static_cast<uint16_t>(kFrac - 1u);
            la.ifTranspose = false;
            la.sid = 0;
            la.addrMode = 0;
            for (uint32_t j = 0; j < kFrac; ++j)
              LoadData(a[j * FRAC_I8], l1a[ks * BM + j * BM * C0_I8], la);
            LoadData2dTransposeParams lb;
            lb.startIndex = 0;
            lb.repeatTimes = static_cast<uint8_t>(Up(nt, C0_I8) / C0_I8);
            lb.srcStride = static_cast<uint16_t>(p.kl / C0_I8);
            lb.dstGap = 1;
            lb.dstFracGap = 0;
            lb.addrMode = 0;
            for (uint32_t i = 0; i < kFrac; ++i)
              LoadDataWithTranspose(b[i * bRowStride],
                                    l1b[ks * C0_I8 + i * 2u * FRAC_I8], lb);
            Barrier<HardEvent::MTE1_M>();
            MmadParams mp;
            mp.m = static_cast<uint16_t>(Up(mt, ROW_FRAC));
            mp.n = static_cast<uint16_t>(Up(nt, C0_I8));
            mp.k = static_cast<uint16_t>(kstep);
            mp.cmatrixInitVal = firstK;
            mp.unitFlag = (ks + BK >= p.k) ? 3u : 2u;
            Mmad(l0c, a, b, mp);
            if ((uint32_t(mp.m) / 16u) * (uint32_t(mp.n) / 16u) < 10u)
              PipeBarrier<PIPE_M>();
            if constexpr (SingleL0)
              Barrier<HardEvent::M_MTE1>();
            else
              SetFlag<HardEvent::M_MTE1>(half + 1u);
            firstK = false;
          }
          Barrier<HardEvent::MTE1_MTE2>();
          heldAExpert = e;
          heldM = mIdx;
          heldBExpert = e;
          heldN = nIdx;
          FixpipeParamsV220 fp;
          fp.nSize = static_cast<uint16_t>(Up(nt, C0_I8));
          fp.mSize = static_cast<uint16_t>(Up(mt, ROW_FRAC));
          fp.srcStride = static_cast<uint16_t>(Up(mt, ROW_FRAC));
          fp.dstStride = BN;
          fp.quantPre = QuantMode_t::DEQF16;
          fp.deqScalar = 0x39800000ull;
          fp.reluEn = false;
          fp.unitFlag = 3;
          const uint64_t base = uint64_t(acc + t) * BM * BN;
          Fixpipe<half, int32_t, CFG_ROW_MAJOR>(stg[base], l0c, fp);
          CrossCoreSetFlag<2, PIPE_FIX>(tileId);
          if constexpr (ContinuousTiles && !NMajor) {
            if (++carriedN == nTiles) {
              carriedN = 0u;
              ++carriedM;
            }
          }
        }
      }
      acc += count;
      start = end;
    }
    const uint32_t owned = last - first;
    for (uint32_t q = owned > 8u ? owned - 4u : owned; q < owned; ++q) {
      CrossCoreWaitFlag(uint16_t(4u + (q & 3u)));
    }
    if constexpr (!SingleL0) {
      WaitFlag<HardEvent::M_MTE1>(1);
      WaitFlag<HardEvent::M_MTE1>(2);
    }
    Barrier<HardEvent::FIX_M>();
    SetMMColumnMajor();
  } else {
    const uint32_t physical = GetBlockIdx() / GetTaskRation();
    const uint32_t aic = p.cores == 20u
                             ? (physical * 7u + 1u) % p.cores
                             : (physical + 1u == p.cores ? 0u : physical + 1u);
    const uint32_t sub = GetSubBlockIdx();
    const uint32_t first = static_cast<uint32_t>(uint64_t(total) * aic / p.cores);
    const uint32_t last = static_cast<uint32_t>(uint64_t(total) * (aic + 1u) / p.cores);
    GlobalTensor<half> stg;
    GlobalTensor<float> xsg;
    GlobalTensor<ScaleT> wsg;
    GlobalTensor<OutT> yg;
    stg.SetGlobalBuffer((__gm__ half*)stGm);
    xsg.SetGlobalBuffer((__gm__ float*)xsGm);
    wsg.SetGlobalBuffer((__gm__ ScaleT*)wsGm);
    yg.SetGlobalBuffer((__gm__ OutT*)yGm);
    typename FullKBufferType<StaticNoPipe, TPosition::VECCALC>::Type ub;
    if constexpr (StaticNoPipe)
      ub.bytes = UB_USED;
    else
      GetTPipePtr()->InitBuffer(ub, UB_USED);
    pipe.Destroy();
    LocalTensor<uint8_t> raw = ub.template Get<uint8_t>();
    uint32_t off = 0;
    LocalTensor<half> accI = raw[off].ReinterpretCast<half>();
    off += RV * PITCH * 4u;
    LocalTensor<float> accF = raw[off].ReinterpretCast<float>();
    off += StridedPair && !HalfPairOutput ? 128u * 256u * 4u : RV * PITCH * 4u;
    LocalTensor<OutT> out = raw[off].ReinterpretCast<OutT>();
    off += HalfPairOutput ? 128u * 256u * 2u : RV * PITCH * 2u;
    LocalTensor<ScaleT> wsl = raw[off].ReinterpretCast<ScaleT>();
    off += PITCH * 4u;
    LocalTensor<float> wsf = raw[off].ReinterpretCast<float>();
    off += PITCH * 4u;
    LocalTensor<float> xsl = raw[off].ReinterpretCast<float>();
    off += RV * 4u;
    LocalTensor<float> xsb = raw[off].ReinterpretCast<float>();
    if constexpr (ChunkPrefetch) off += RV * 32u;
    LocalTensor<float> xsl1 = raw[off].ReinterpretCast<float>();
    LocalTensor<float> scaleProduct =
        raw[UB_USED - RV * PITCH * 8u].ReinterpretCast<float>();
    uint32_t heldScaleExpert = 0xffffffffu, heldScaleN = 0xffffffffu;
    uint32_t heldRowScaleExpert = 0xffffffffu, heldRowScaleM = 0xffffffffu;
    uint32_t acc = 0, start = 0;
    for (uint32_t e = 0; e < p.e && acc < last; ++e) {
      const uint32_t value = static_cast<uint32_t>(list.GetValue(e));
      const uint32_t end = p.listType == 0 ? value : start + value;
      const uint32_t rows = end > start ? end - start : 0u;
      const uint32_t mBlocks = (rows + BM - 1u) / BM;
      const uint32_t count = mBlocks * nTiles;
      if (acc + count > first) {
        const uint32_t lo = first > acc ? first - acc : 0u;
        const uint32_t hi = Min(count, last - acc);
        for (uint32_t t = lo; t < hi; ++t) {
          const uint16_t tileId =
              uint16_t((acc + t - first) & ((last - first <= 8u) ? 7u : 3u));
          uint32_t mIdx, nIdx;
          if constexpr (NMajor) {
            mIdx = t % mBlocks;
            nIdx = t / mBlocks;
          } else {
            mIdx = t / nTiles;
            nIdx = t % nTiles;
          }
          const uint32_t gRow = start + mIdx * BM;
          const uint32_t mt = Min(BM, rows - mIdx * BM);
          const uint32_t nOff = nIdx * BN;
          const uint32_t nt = Min(BN, p.n - nOff);
          const uint32_t runLo = (lo > mIdx * nTiles ? lo : mIdx * nTiles);
          const uint32_t pairSide = (t - runLo) & 1u;
          const bool paired = StridedPair && !NMajor && BN == 128u && RV == 64u &&
                              nt == 128u &&
                              (pairSide != 0u || (t + 1u < hi && nIdx + 1u < nTiles));
          const uint32_t workPitch = paired && !HalfPairOutput ? 256u : PITCH;
          const uint64_t base = uint64_t(acc + t) * BM * BN;
          if constexpr (BM <= 32 || BM == 208) {
            CrossCoreWaitFlag(tileId);
            if (last - first > 8u)
              CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
          }
          const uint32_t half = (mt + AIV_PER_AIC - 1u) / AIV_PER_AIC;
          const uint32_t r0 = Min(sub * half, mt);
          const uint32_t r1 = Min((sub + 1u) * half, mt);
          const uint32_t prepRows = Min(RV, r1 - r0);
          const uint32_t extraRows = r1 - r0 - prepRows;
          if (r0 < r1) {
            const bool reuseRowScale = heldRowScaleExpert == e && heldRowScaleM == mIdx;
            DataCopyPad(wsl, wsg[uint64_t(e) * p.n + nOff],
                        DataCopyExtParams{1, uint32_t(nt * sizeof(ScaleT)), 0, 0, 0},
                        DataCopyPadExtParams<ScaleT>{false, 0, 0, 0});
            if (!reuseRowScale) {
              DataCopyPad(xsl, xsg[gRow + r0],
                          DataCopyExtParams{1, prepRows * 4u, 0, 0, 0},
                          DataCopyPadExtParams<float>{false, 0, 0, 0});
              if (extraRows)
                DataCopyPad(xsl1, xsg[gRow + r0 + RV],
                            DataCopyExtParams{1, extraRows * 4u, 0, 0, 0},
                            DataCopyPadExtParams<float>{false, 0, 0, 0});
              heldRowScaleExpert = e;
              heldRowScaleM = mIdx;
            }
            SetFlag<HardEvent::MTE2_V>(2);
            WaitFlag<HardEvent::MTE2_V>(2);
            Muls(wsf, wsl, 4096.0f, nt);
            BrcbRepeatParams prepBr;
            prepBr.dstBlkStride = 1;
            prepBr.dstRepStride = 8;
            Brcb(xsb, xsl, uint8_t((prepRows + 7u) / 8u), prepBr);
            PipeBarrier<PIPE_V>();
            BinaryRepeatParams outer;
            outer.dstBlkStride = 1;
            outer.src0BlkStride = 1;
            outer.src1BlkStride = 0;
            outer.dstRepStride = PITCH / 8u;
            outer.src0RepStride = 0;
            outer.src1RepStride = 1;
            for (uint32_t c = 0; c < nt; c += 64u)
              Mul(scaleProduct[c], wsf[c], xsb, uint64_t(Min(64u, nt - c)),
                  uint8_t(prepRows), outer);
            if (extraRows) {
              PipeBarrier<PIPE_V>();
              Brcb(xsb, xsl1, uint8_t((extraRows + 7u) / 8u), prepBr);
              PipeBarrier<PIPE_V>();
              for (uint32_t c = 0; c < nt; c += 64u)
                Mul(scaleProduct[RV * PITCH + c], wsf[c], xsb,
                    uint64_t(Min(64u, nt - c)), uint8_t(extraRows), outer);
            }
          }
          if constexpr (BM > 32 && BM != 208) {
            CrossCoreWaitFlag(tileId);
            if (last - first > 8u)
              CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4u + tileId));
          }
          if constexpr (ChunkPrefetch) {
            const uint32_t ntr = Up(nt, 16u);
            const bool twoChunks = r1 - r0 > RV;
            if (twoChunks) {
              if constexpr (PlainAlignedStage)
                DataCopy(accI, stg[base + uint64_t(r0) * BN], RV * BN);
              else
                DataCopyPad(
                    accI, stg[base + uint64_t(r0) * BN],
                    (SingleBlockStage
                         ? DataCopyExtParams{1, RV * BN * 2u, 0, 0, 0}
                         : DataCopyExtParams{uint16_t(RV), nt * 2u, (BN - nt) * 2u,
                                             (PITCH - ntr) / 16u, 0}),
                    DataCopyPadExtParams<OutT>{false, 0, 0, 0});
              SetFlag<HardEvent::MTE2_V>(0);
              const uint32_t nr1 = r1 - r0 - RV;
              if constexpr (PlainAlignedStage)
                DataCopy(accI[RV * PITCH], stg[base + uint64_t(r0 + RV) * BN],
                         nr1 * BN);
              else
                DataCopyPad(
                    accI[RV * PITCH], stg[base + uint64_t(r0 + RV) * BN],
                    (SingleBlockStage
                         ? DataCopyExtParams{1, nr1 * BN * 2u, 0, 0, 0}
                         : DataCopyExtParams{uint16_t(nr1), nt * 2u, (BN - nt) * 2u,
                                             (PITCH - ntr) / 16u, 0}),
                    DataCopyPadExtParams<OutT>{false, 0, 0, 0});
              SetFlag<HardEvent::MTE2_V>(1);
            }
            for (uint32_t r = r0; r < r1; r += RV) {
              const uint32_t nr = Min(RV, r1 - r);
              const uint32_t bank = twoChunks ? (r - r0) / RV : 0u;
              if (twoChunks) {
                WaitFlag<HardEvent::MTE2_V>(bank);
              } else {
                if constexpr (PlainAlignedStage)
                  DataCopy(accI, stg[base + uint64_t(r) * BN], nr * BN);
                else
                  DataCopyPad(
                      accI, stg[base + uint64_t(r) * BN],
                      (SingleBlockStage
                           ? DataCopyExtParams{1, nr * BN * 2u, 0, 0, 0}
                           : DataCopyExtParams{uint16_t(nr), nt * 2u, (BN - nt) * 2u,
                                               (PITCH - ntr) / 16u, 0}),
                      DataCopyPadExtParams<OutT>{false, 0, 0, 0});
                Barrier<HardEvent::MTE2_V>();
              }
              LocalTensor<float> work = paired && !HalfPairOutput
                                            ? accF[(r - r0) * 256u + pairSide * 128u]
                                            : accF;
              if (paired && !HalfPairOutput) {
                UnaryRepeatParams wide{1, 1, 32, 8};
                Cast(work, accI[bank * RV * PITCH], RoundMode::CAST_NONE, uint64_t(64),
                     uint8_t(nr), wide);
                Cast(work[64], accI[bank * RV * PITCH][64], RoundMode::CAST_NONE,
                     uint64_t(64), uint8_t(nr), wide);
              } else
                Cast(work, accI[bank * RV * PITCH], RoundMode::CAST_NONE, nr * PITCH);
              PipeBarrier<PIPE_V>();
              BinaryRepeatParams apply;
              apply.dstBlkStride = 1;
              apply.src0BlkStride = 1;
              apply.src1BlkStride = 1;
              apply.dstRepStride = 8;
              apply.src0RepStride = 8;
              apply.src1RepStride = 8;
              Mul(work, work, scaleProduct[bank * RV * PITCH], uint64_t(64),
                  uint8_t(nr * (PITCH / 64u)), apply);
              PipeBarrier<PIPE_V>();
              if (paired) {
                if constexpr (HalfPairOutput) {
                  if (pairSide == 0u && r == r0) Barrier<HardEvent::MTE3_V>();
                  LocalTensor<OutT> halfPanel = out[(r - r0) * 256u + pairSide * 128u];
                  UnaryRepeatParams narrow{1, 1, 16, 16};
                  Cast(halfPanel, work, RoundMode::CAST_RINT, uint64_t(64), uint8_t(nr),
                       narrow);
                  Cast(halfPanel[64], work[64], RoundMode::CAST_RINT, uint64_t(64),
                       uint8_t(nr), narrow);
                  if (pairSide != 0u && r + nr == r1) {
                    Barrier<HardEvent::V_MTE3>();
                    DataCopyPad(yg[uint64_t(gRow + r0) * p.n + nOff - 128u], out,
                                DataCopyExtParams{uint16_t(r1 - r0), 512u, 0,
                                                  (p.n - 256u) * 2u, 0});
                  }
                } else if (pairSide != 0u) {
                  for (uint32_t rr = 0; rr < nr; rr += 32u) {
                    const uint32_t outRows = Min(32u, nr - rr);
                    Barrier<HardEvent::MTE3_V>();
                    Cast(out, accF[(r - r0 + rr) * 256u], RoundMode::CAST_RINT,
                         outRows * 256u);
                    Barrier<HardEvent::V_MTE3>();
                    DataCopyPad(yg[uint64_t(gRow + r + rr) * p.n + nOff - 128u], out,
                                DataCopyExtParams{uint16_t(outRows), 512u, 0,
                                                  (p.n - 256u) * 2u, 0});
                  }
                }
              } else {
                Barrier<HardEvent::MTE3_V>();
                Cast(out, work, RoundMode::CAST_RINT, nr * PITCH);
                Barrier<HardEvent::V_MTE3>();
                DataCopyPad(yg[uint64_t(gRow + r) * p.n + nOff], out,
                            DataCopyExtParams{uint16_t(nr), nt * 2u,
                                              (PITCH * 2u - Up(nt * 2u, BLK)) / BLK,
                                              (p.n - nt) * 2u, 0});
              }
              Barrier<HardEvent::V_MTE2>();
            }
          } else {
            const uint32_t ntr = Up(nt, 16u);
            for (uint32_t r = r0; r < r1; r += RV) {
              const uint32_t nr = Min(RV, r1 - r);
              if constexpr (PlainAlignedStage)
                DataCopy(accI, stg[base + uint64_t(r) * BN], nr * BN);
              else
                DataCopyPad(
                    accI, stg[base + uint64_t(r) * BN],
                    (SingleBlockStage
                         ? DataCopyExtParams{1, nr * BN * 2u, 0, 0, 0}
                         : DataCopyExtParams{uint16_t(nr), nt * 2u, (BN - nt) * 2u,
                                             (PITCH - ntr) / 16u, 0}),
                    DataCopyPadExtParams<OutT>{false, 0, 0, 0});
              DataCopyPad(xsl, xsg[gRow + r], DataCopyExtParams{1, nr * 4u, 0, 0, 0},
                          DataCopyPadExtParams<float>{false, 0, 0, 0});
              Barrier<HardEvent::MTE2_V>();
              LocalTensor<float> work = paired && !HalfPairOutput
                                            ? accF[(r - r0) * 256u + pairSide * 128u]
                                            : accF;
              if (paired && !HalfPairOutput) {
                UnaryRepeatParams wide{1, 1, 32, 8};
                Cast(work, accI, RoundMode::CAST_NONE, uint64_t(64), uint8_t(nr), wide);
                Cast(work[64], accI[64], RoundMode::CAST_NONE, uint64_t(64),
                     uint8_t(nr), wide);
              } else
                Cast(work, accI, RoundMode::CAST_NONE, nr * PITCH);
              BrcbRepeatParams br;
              br.dstBlkStride = 1;
              br.dstRepStride = 8;
              Brcb(xsb, xsl, static_cast<uint8_t>((nr + 7u) / 8u), br);
              PipeBarrier<PIPE_V>();
              MulByRow(work, work, wsf, nr, nt, workPitch);
              PipeBarrier<PIPE_V>();
              BinaryRepeatParams rowScale;
              rowScale.dstBlkStride = 1;
              rowScale.src0BlkStride = 1;
              rowScale.src1BlkStride = 0;
              rowScale.dstRepStride = workPitch / 8;
              rowScale.src0RepStride = workPitch / 8;
              rowScale.src1RepStride = 1;
              for (uint32_t c = 0; c < nt; c += 64)
                Mul(work[c], work[c], xsb, uint64_t(Min(64u, nt - c)), uint8_t(nr),
                    rowScale);
              PipeBarrier<PIPE_V>();
              if (paired) {
                if constexpr (HalfPairOutput) {
                  if (pairSide == 0u && r == r0) Barrier<HardEvent::MTE3_V>();
                  LocalTensor<OutT> halfPanel = out[(r - r0) * 256u + pairSide * 128u];
                  UnaryRepeatParams narrow{1, 1, 16, 16};
                  Cast(halfPanel, work, RoundMode::CAST_RINT, uint64_t(64), uint8_t(nr),
                       narrow);
                  Cast(halfPanel[64], work[64], RoundMode::CAST_RINT, uint64_t(64),
                       uint8_t(nr), narrow);
                  if (pairSide != 0u && r + nr == r1) {
                    Barrier<HardEvent::V_MTE3>();
                    DataCopyPad(yg[uint64_t(gRow + r0) * p.n + nOff - 128u], out,
                                DataCopyExtParams{uint16_t(r1 - r0), 512u, 0,
                                                  (p.n - 256u) * 2u, 0});
                  }
                } else if (pairSide != 0u) {
                  for (uint32_t rr = 0; rr < nr; rr += 32u) {
                    const uint32_t outRows = Min(32u, nr - rr);
                    Barrier<HardEvent::MTE3_V>();
                    Cast(out, accF[(r - r0 + rr) * 256u], RoundMode::CAST_RINT,
                         outRows * 256u);
                    Barrier<HardEvent::V_MTE3>();
                    DataCopyPad(yg[uint64_t(gRow + r + rr) * p.n + nOff - 128u], out,
                                DataCopyExtParams{uint16_t(outRows), 512u, 0,
                                                  (p.n - 256u) * 2u, 0});
                  }
                }
              } else {
                Barrier<HardEvent::MTE3_V>();
                Cast(out, work, RoundMode::CAST_RINT, nr * PITCH);
                Barrier<HardEvent::V_MTE3>();
                DataCopyPad(yg[uint64_t(gRow + r) * p.n + nOff], out,
                            DataCopyExtParams{uint16_t(nr), nt * 2u,
                                              (PITCH * 2u - Up(nt * 2u, BLK)) / BLK,
                                              (p.n - nt) * 2u, 0});
              }
              Barrier<HardEvent::V_MTE2>();
            }
          }
        }
      }
      acc += count;
      start = end;
    }
    Barrier<HardEvent::MTE3_S>();
  }
}
}
namespace gmmptq {
__aicore__ inline uint32_t ActivePackCount(const AscendC::GlobalTensor<int64_t>& groups,
                                           uint32_t e, uint32_t listType) {
  const uint32_t v = uint32_t(groups.GetValue(e));
  return listType == 1u ? v : v - (e ? uint32_t(groups.GetValue(e - 1u)) : 0u);
}
template <bool StaticNoPipe = false, bool Double64 = false>
__aicore__ inline void PackActiveWeightRowsInline(GM_ADDR source, GM_ADDR dest,
                                                  uint32_t rows, uint32_t k, uint32_t n,
                                                  uint32_t pitch, uint32_t cores,
                                                  GM_ADDR gl, uint32_t listType) {
  using namespace AscendC;
  GlobalTensor<int64_t> groups;
  groups.SetGlobalBuffer((__gm__ int64_t*)gl);
  const uint32_t experts = rows / k;
  uint32_t active = 0;
  for (uint32_t e = 0; e < experts; ++e)
    if (ActivePackCount(groups, e, listType) > 0u) ++active;
  const uint32_t core = GetBlockIdx(), virtualRows = active * k;
  const uint32_t begin = uint32_t(uint64_t(virtualRows) * core / cores);
  const uint32_t end = uint32_t(uint64_t(virtualRows) * (core + 1u) / cores);
  typename FullKPipeType<StaticNoPipe>::Type pipe;
  typename FullKBufferType<StaticNoPipe, TPosition::VECCALC>::Type buf;
  if constexpr (StaticNoPipe)
    buf.bytes = 131072;
  else
    pipe.InitBuffer(buf, 131072);
  auto data = buf.template Get<int8_t>();
  GlobalTensor<int8_t> src, dst;
  src.SetGlobalBuffer((__gm__ int8_t*)source);
  dst.SetGlobalBuffer((__gm__ int8_t*)dest);
  const uint32_t batch = (Double64 ? 65536u : 131072u) / pitch;
  uint32_t issued = 0;
  uint32_t e = 0, ordinal = 0;
  if (begin < end) {
    const uint32_t target = begin / k;
    for (; e < experts; ++e)
      if (ActivePackCount(groups, e, listType) > 0u) {
        if (ordinal == target) break;
        ++ordinal;
      }
  }
  if constexpr (Double64) {
    for (uint32_t row = begin; row < end;) {
      const uint32_t have = Min(Min(batch, end - row), k - row % k);
      const uint32_t realRow = e * k + row % k;
      const uint32_t slot = issued & 1u;
      if (issued >= 2u) WaitFlag<HardEvent::MTE3_MTE2>(slot + 1u);
      LocalTensor<int8_t> chunk = data[slot * 65536u];
      DataCopyPad(
          chunk, src[uint64_t(realRow) * n],
          DataCopyExtParams{uint16_t(have), n, 0, (pitch - Up(n, 32u)) / 32u, 0},
          DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
      SetFlag<HardEvent::MTE2_MTE3>(slot + 1u);
      WaitFlag<HardEvent::MTE2_MTE3>(slot + 1u);
      DataCopyPad(dst[uint64_t(realRow) * pitch], chunk,
                  DataCopyExtParams{1, have * pitch, 0, 0, 0});
      SetFlag<HardEvent::MTE3_MTE2>(slot + 1u);
      ++issued;
      row += have;
      if (row < end && row % k == 0u) {
        do {
          ++e;
        } while (e < experts && ActivePackCount(groups, e, listType) == 0u);
      }
    }
    if (issued > 0u) WaitFlag<HardEvent::MTE3_MTE2>(1u);
    if (issued > 1u) WaitFlag<HardEvent::MTE3_MTE2>(2u);
  } else {
    for (uint32_t row = begin; row < end;) {
      const uint32_t have = Min(Min(batch, end - row), k - row % k);
      const uint32_t realRow = e * k + row % k;
      DataCopyPad(
          data, src[uint64_t(realRow) * n],
          DataCopyExtParams{uint16_t(have), n, 0, (pitch - Up(n, 32u)) / 32u, 0},
          DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
      Barrier<HardEvent::MTE2_MTE3>();
      DataCopyPad(dst[uint64_t(realRow) * pitch], data,
                  DataCopyExtParams{1, have * pitch, 0, 0, 0});
      Barrier<HardEvent::MTE3_MTE2>();
      row += have;
      if (row < end && row % k == 0u) {
        do {
          ++e;
        } while (e < experts && ActivePackCount(groups, e, listType) == 0u);
      }
    }
  }
  Barrier<HardEvent::MTE3_S>();
  if constexpr (StaticNoPipe) pipe.Destroy();
}
}
namespace gmmptq {
template <typename WScaleT, typename OutT, int Mode, uint32_t Rows, bool EarlyInput,
          uint32_t Outputs, bool NextOwnedInput = false>
class OuterStaticUb {
 public:
  __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR xScale, GM_ADDR wScale,
                              GM_ADDR groupList, GM_ADDR y, const VTiling* t) {
    static_assert(Mode == 1 && Rows == 32 && EarlyInput && Outputs == 1,
                  "one fixed RR32 family");
    static_assert(sizeof(WScaleT) == 4 && sizeof(OutT) == 2,
                  "selected FP16 family only");
    t_ = t;
    xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
    wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
    xsGm_.SetGlobalBuffer((__gm__ float*)xScale);
    wsGm_.SetGlobalBuffer((__gm__ WScaleT*)wScale);
    glGm_.SetGlobalBuffer((__gm__ int64_t*)groupList);
    yGm_.SetGlobalBuffer((__gm__ OutT*)y);
    core_ = AscendC::GetBlockIdx();
    blocks_ = t_->coreNum;
    n_ = t_->n;
    rows_ = Rows;
    pitch_ = t_->nb;
    held_ = 0xFFFFFFFFu;
    const uint32_t block = rows_ * pitch_;
    const uint32_t nUp = Up(n_, vec::GRAIN);
    const uint32_t rUp = Up(rows_, vec::GRAIN);
    const uint32_t wBytes = nUp + vec::GRAIN, xBytes = rUp + vec::GRAIN;
    const uint32_t workBase = wBytes + xBytes;
    rawW_ = LocalTensor<int8_t>(AscendC::TPosition::VECCALC, 0, wBytes);
    rawX_ = LocalTensor<int8_t>(AscendC::TPosition::VECCALC, wBytes, xBytes);
    for (uint16_t i = 0; i < Outputs; ++i)
      AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(i);
    uint32_t at = 0;
    outF_ = LocalTensor<float>(AscendC::TPosition::VECCALC, workBase + at, block);
    at += block * sizeof(float);
    outH_ = LocalTensor<OutT>(AscendC::TPosition::VECCALC, workBase + at, block);
    at += block * sizeof(OutT) * Outputs;
    wf_ = LocalTensor<float>(AscendC::TPosition::VECCALC, workBase + at, nUp);
    at += nUp * sizeof(float);
    wsf_ = LocalTensor<float>(AscendC::TPosition::VECCALC, workBase + at, nUp);
    at += nUp * sizeof(float);
    wsRaw_ = LocalTensor<WScaleT>(AscendC::TPosition::VECCALC, workBase + at, nUp);
    at += nUp * sizeof(float);
    xf_ = LocalTensor<float>(AscendC::TPosition::VECCALC, workBase + at, rUp);
    at += rUp * sizeof(float);
    xsf_ = LocalTensor<float>(AscendC::TPosition::VECCALC, workBase + at, rUp);
    at += rUp * sizeof(float);
    xh_ = LocalTensor<half>(AscendC::TPosition::VECCALC, workBase + at, rUp);
    at += rUp * sizeof(half);
    xbr_ = LocalTensor<float>(AscendC::TPosition::VECCALC, workBase + at, rUp * 8);
    at += rUp * 8 * sizeof(float);
    xsbr_ = LocalTensor<float>(AscendC::TPosition::VECCALC, workBase + at, rUp * 8);
  }
  __aicore__ inline void Process() {
    Walk walk;
    walk.Init(glGm_, t_->listType, t_->e, rows_, 1u);
    uint32_t item = 0;
    while (!walk.done) {
      if (item % blocks_ == core_) {
        const uint32_t taken = walk.mIdx * rows_;
        if constexpr (NextOwnedInput) {
          const uint64_t nextM = uint64_t(walk.mIdx) + blocks_;
          const bool next = nextM < walk.mTiles;
          const uint32_t nextTaken = next ? uint32_t(nextM) * rows_ : 0u;
          Block(walk.expert, walk.rowStart + taken, MinU(rows_, walk.rows - taken),
                next, next ? walk.rowStart + nextTaken : 0u,
                next ? MinU(rows_, walk.rows - nextTaken) : 0u);
        } else {
          Block(walk.expert, walk.rowStart + taken, MinU(rows_, walk.rows - taken));
        }
      }
      ++item;
      walk.Next();
    }
    for (uint16_t i = 0; i < Outputs; ++i)
      AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(i);
  }
 private:
  __aicore__ inline void LoadExpert(uint32_t expert) {
    if (expert == held_) return;
    held_ = expert;
    const uint32_t nUp = Up(n_, vec::GRAIN);
    LocalTensor<int8_t> wr = rawW_;
    AscendC::DataCopyPad(wr, wGm_[uint64_t(expert) * n_],
                         AscendC::DataCopyExtParams{1, n_, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
    AscendC::DataCopyPad(
        wsRaw_, wsGm_[uint64_t(expert) * n_],
        AscendC::DataCopyExtParams{1, uint32_t(n_ * sizeof(WScaleT)), 0, 0, 0},
        AscendC::DataCopyPadExtParams<WScaleT>{true, 0, 0, 0});
  }
  __aicore__ inline void CastExpert() {
    const uint32_t nUp = Up(n_, vec::GRAIN);
    LocalTensor<int8_t> wr = rawW_;
    AscendC::Cast(whBuf(), wr, AscendC::RoundMode::CAST_NONE, nUp);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Cast(wf_, whBuf(), AscendC::RoundMode::CAST_NONE, nUp);
    AscendC::PipeBarrier<PIPE_V>();
    if constexpr (Mode != 0) {
      AscendC::Mul(wf_, wf_, wsRaw_.template ReinterpretCast<float>(), nUp);
      AscendC::PipeBarrier<PIPE_V>();
    }
  }
  __aicore__ inline LocalTensor<half> whBuf() {
    return wsf_.template ReinterpretCast<half>();
  }
  __aicore__ inline void CastScale(const LocalTensor<float>& dst, uint32_t count) {
    if constexpr (AscendC::IsSameType<WScaleT, float>::value) {
      AscendC::DataCopy(dst, wsRaw_.template ReinterpretCast<float>(), count);
    } else {
      AscendC::Cast(dst, wsRaw_, AscendC::RoundMode::CAST_NONE, count);
    }
  }
  __aicore__ inline void CopyRows(LocalTensor<int8_t> xr, uint32_t row0,
                                  uint32_t have) {
    AscendC::DataCopyPad(xr, xGm_[row0], AscendC::DataCopyExtParams{1, have, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
    AscendC::DataCopyPad(xsf_, xsGm_[row0],
                         AscendC::DataCopyExtParams{1, have * 4u, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<float>{true, 0, 0, 0});
  }
  __aicore__ inline void Block(uint32_t expert, uint32_t row0, uint32_t have,
                                 bool hasNext = false, uint32_t nextRow = 0u,
                                 uint32_t nextHave = 0u) {
    bool inputHit = false;
    if constexpr (NextOwnedInput) {
      inputHit = nextInputValid_;
      nextInputValid_ = false;
      if (!inputHit) {
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
      }
    } else {
      AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
    }
    const uint32_t rUp = Up(have, vec::GRAIN);
    LocalTensor<int8_t> xr = rawX_;
    const bool reload = expert != held_;
    if constexpr (EarlyInput) {
      if constexpr (NextOwnedInput) {
        if (!inputHit) CopyRows(xr, row0, have);
      } else {
        CopyRows(xr, row0, have);
      }
    }
    LoadExpert(expert);
    if constexpr (!EarlyInput) CopyRows(xr, row0, have);
    Barrier<AscendC::HardEvent::MTE2_V>();
    if (reload) CastExpert();
    AscendC::Cast(xh_, xr, AscendC::RoundMode::CAST_NONE, rUp);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Cast(xf_, xh_, AscendC::RoundMode::CAST_NONE, rUp);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::BrcbRepeatParams br;
    br.dstBlkStride = 1;
    br.dstRepStride = 8;
    if constexpr (Mode == 1) {
      AscendC::Mul(xf_, xf_, xsf_, rUp);
      AscendC::PipeBarrier<PIPE_V>();
      if constexpr (NextOwnedInput) {
        if (hasNext) {
          AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
          AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
          CopyRows(rawX_, nextRow, nextHave);
          nextInputValid_ = true;
        }
      }
    }
    AscendC::Brcb(xbr_, xf_, uint8_t((have + 7) / 8), br);
    if constexpr (Mode != 1) AscendC::Brcb(xsbr_, xsf_, uint8_t((have + 7) / 8), br);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
    AscendC::BinaryRepeatParams rp;
    rp.dstBlkStride = 1;
    rp.src0BlkStride = 1;
    rp.src1BlkStride = 0;
    rp.dstRepStride = uint16_t(pitch_ / 8);
    rp.src0RepStride = 0;
    rp.src1RepStride = 1;
    for (uint32_t c = 0; c < n_; c += 64)
      AscendC::Mul(outF_[c], wf_[c], xbr_, uint64_t(MinU(64, n_ - c)), uint8_t(have),
                   rp);
    AscendC::PipeBarrier<PIPE_V>();
    if constexpr (Mode == 0) {
      rp.src0RepStride = uint16_t(pitch_ / 8);
      rp.src1BlkStride = 1;
      rp.src1RepStride = 0;
      for (uint32_t c = 0; c < n_; c += 64)
        AscendC::Mul(outF_[c], outF_[c], wsf_[c], uint64_t(MinU(64, n_ - c)),
                     uint8_t(have), rp);
      AscendC::PipeBarrier<PIPE_V>();
    }
    if constexpr (Mode != 1) {
      rp.src0RepStride = uint16_t(pitch_ / 8);
      rp.src1BlkStride = 0;
      rp.src1RepStride = 1;
      for (uint32_t c = 0; c < n_; c += 64)
        AscendC::Mul(outF_[c], outF_[c], xsbr_, uint64_t(MinU(64, n_ - c)),
                     uint8_t(have), rp);
      AscendC::PipeBarrier<PIPE_V>();
    }
    const uint16_t slot = outputIndex_++ % Outputs;
    auto target = outH_[slot * rows_ * pitch_];
    AscendC::Cast(target, outF_, AscendC::RoundMode::CAST_RINT, have * pitch_);
    AscendC::PipeBarrier<PIPE_V>();
    auto packed = outF_.template ReinterpretCast<OutT>();
    AscendC::GatherMaskParams gp;
    gp.repeatTimes = have;
    gp.src0RepeatStride = pitch_ * sizeof(OutT) / 32u;
    uint64_t valid = 0;
    AscendC::GatherMask(packed, target, uint8_t(7), true, n_, gp, valid);
    AscendC::ResetMask();
    Barrier<AscendC::HardEvent::V_MTE3>();
    AscendC::DataCopyPad(
        yGm_[uint64_t(row0) * n_], packed,
        AscendC::DataCopyExtParams{1, uint32_t(have * n_ * sizeof(OutT)), 0, 0, 0});
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(slot);
  }
  GlobalTensor<int8_t> xGm_, wGm_;
  GlobalTensor<float> xsGm_;
  GlobalTensor<WScaleT> wsGm_;
  GlobalTensor<int64_t> glGm_;
  GlobalTensor<OutT> yGm_;
  LocalTensor<int8_t> rawW_, rawX_;
  LocalTensor<float> outF_, wf_, wsf_, xf_, xsf_;
  LocalTensor<float> xbr_, xsbr_;
  LocalTensor<WScaleT> wsRaw_;
  LocalTensor<half> xh_;
  LocalTensor<OutT> outH_;
  const VTiling* t_;
  bool nextInputValid_ = false;
  uint32_t outputIndex_ = 0;
  uint32_t core_, blocks_, n_, rows_, pitch_, held_;
};
__global__ __aicore__ void OuterStaticUbKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                               GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                               VTiling t) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  AscendC::InitSocState();
  OuterStaticUb<float, half, 1, 32, true, 1, true> op;
  op.Init(x, w, xs, ws, gl, y, &t);
  op.Process();
  AscendC::PipeBarrier<PIPE_ALL>();
}
template <typename WScaleT, typename OutT, int Mode, uint32_t Rows, bool EarlyInput,
          uint32_t Outputs>
class OuterQueued {
 public:
  __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR xScale, GM_ADDR wScale,
                              GM_ADDR groupList, GM_ADDR y, const VTiling* t,
                              AscendC::TPipe* pipe) {
    t_ = t;
    xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
    wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
    xsGm_.SetGlobalBuffer((__gm__ float*)xScale);
    wsGm_.SetGlobalBuffer((__gm__ WScaleT*)wScale);
    glGm_.SetGlobalBuffer((__gm__ int64_t*)groupList);
    yGm_.SetGlobalBuffer((__gm__ OutT*)y);
    core_ = AscendC::GetBlockIdx();
    blocks_ = t_->coreNum;
    n_ = t_->n;
    rows_ = Rows;
    pitch_ = t_->nb;
    held_ = 0xFFFFFFFFu;
    const uint32_t block = rows_ * pitch_;
    const uint32_t nUp = Up(n_, vec::GRAIN);
    const uint32_t rUp = Up(rows_, vec::GRAIN);
    pipe->InitBuffer(wq_, 1, nUp + vec::GRAIN);
    pipe->InitBuffer(xq_, 1, rUp + vec::GRAIN);
    pipe->InitBuffer(work_, block * sizeof(float) + block * sizeof(OutT) * Outputs +
                                3 * nUp * sizeof(float) + 4 * rUp * sizeof(float) +
                                16 * rUp * sizeof(float));
    for (uint16_t i = 0; i < Outputs; ++i)
      AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(i);
    uint32_t at = 0;
    outF_ = work_.GetWithOffset<float>(block, at);
    at += block * sizeof(float);
    outH_ = work_.GetWithOffset<OutT>(block, at);
    at += block * sizeof(OutT) * Outputs;
    wf_ = work_.GetWithOffset<float>(nUp, at);
    at += nUp * sizeof(float);
    wsf_ = work_.GetWithOffset<float>(nUp, at);
    at += nUp * sizeof(float);
    wsRaw_ = work_.GetWithOffset<WScaleT>(nUp, at);
    at += nUp * sizeof(float);
    xf_ = work_.GetWithOffset<float>(rUp, at);
    at += rUp * sizeof(float);
    xsf_ = work_.GetWithOffset<float>(rUp, at);
    at += rUp * sizeof(float);
    xh_ = work_.GetWithOffset<half>(rUp, at);
    at += rUp * sizeof(half);
    xbr_ = work_.GetWithOffset<float>(rUp * 8, at);
    at += rUp * 8 * sizeof(float);
    xsbr_ = work_.GetWithOffset<float>(rUp * 8, at);
  }
  __aicore__ inline void Process() {
    Walk walk;
    walk.Init(glGm_, t_->listType, t_->e, rows_, 1u);
    uint32_t item = 0;
    while (!walk.done) {
      if (item % blocks_ == core_) {
        const uint32_t taken = walk.mIdx * rows_;
        Block(walk.expert, walk.rowStart + taken, MinU(rows_, walk.rows - taken));
      }
      ++item;
      walk.Next();
    }
    for (uint16_t i = 0; i < Outputs; ++i)
      AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(i);
  }
 private:
  __aicore__ inline void LoadExpert(uint32_t expert) {
    if (expert == held_) return;
    held_ = expert;
    const uint32_t nUp = Up(n_, vec::GRAIN);
    LocalTensor<int8_t> wr = wq_.template AllocTensor<int8_t>();
    AscendC::DataCopyPad(wr, wGm_[uint64_t(expert) * n_],
                         AscendC::DataCopyExtParams{1, n_, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
    AscendC::DataCopyPad(
        wsRaw_, wsGm_[uint64_t(expert) * n_],
        AscendC::DataCopyExtParams{1, uint32_t(n_ * sizeof(WScaleT)), 0, 0, 0},
        AscendC::DataCopyPadExtParams<WScaleT>{true, 0, 0, 0});
    wq_.EnQue(wr);
    wr = wq_.template DeQue<int8_t>();
    AscendC::Cast(whBuf(), wr, AscendC::RoundMode::CAST_NONE, nUp);
    AscendC::PipeBarrier<PIPE_V>();
    wq_.FreeTensor(wr);
    AscendC::Cast(wf_, whBuf(), AscendC::RoundMode::CAST_NONE, nUp);
    CastScale(wsf_, nUp);
    AscendC::PipeBarrier<PIPE_V>();
    if constexpr (Mode != 0) {
      AscendC::Mul(wf_, wf_, wsf_, nUp);
      AscendC::PipeBarrier<PIPE_V>();
    }
  }
  __aicore__ inline LocalTensor<half> whBuf() {
    return outF_.template ReinterpretCast<half>();
  }
  __aicore__ inline void CastScale(const LocalTensor<float>& dst, uint32_t count) {
    if constexpr (AscendC::IsSameType<WScaleT, float>::value) {
      AscendC::DataCopy(dst, wsRaw_.template ReinterpretCast<float>(), count);
    } else {
      AscendC::Cast(dst, wsRaw_, AscendC::RoundMode::CAST_NONE, count);
    }
  }
  __aicore__ inline void CopyRows(LocalTensor<int8_t> xr, uint32_t row0,
                                  uint32_t have) {
    AscendC::DataCopyPad(xr, xGm_[row0], AscendC::DataCopyExtParams{1, have, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
    AscendC::DataCopyPad(xsf_, xsGm_[row0],
                         AscendC::DataCopyExtParams{1, have * 4u, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<float>{true, 0, 0, 0});
  }
  __aicore__ inline void Block(uint32_t expert, uint32_t row0, uint32_t have) {
    const auto inputReuse = GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_MTE2);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputReuse);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputReuse);
    const uint32_t rUp = Up(have, vec::GRAIN);
    LocalTensor<int8_t> xr = xq_.template AllocTensor<int8_t>();
    if constexpr (EarlyInput) {
      CopyRows(xr, row0, have);
      xq_.EnQue(xr);
    }
    LoadExpert(expert);
    if constexpr (!EarlyInput) {
      CopyRows(xr, row0, have);
      xq_.EnQue(xr);
    }
    xr = xq_.template DeQue<int8_t>();
    AscendC::Cast(xh_, xr, AscendC::RoundMode::CAST_NONE, rUp);
    AscendC::PipeBarrier<PIPE_V>();
    xq_.FreeTensor(xr);
    AscendC::Cast(xf_, xh_, AscendC::RoundMode::CAST_NONE, rUp);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::BrcbRepeatParams br;
    br.dstBlkStride = 1;
    br.dstRepStride = 8;
    if constexpr (Mode == 1) {
      AscendC::Mul(xf_, xf_, xsf_, rUp);
      AscendC::PipeBarrier<PIPE_V>();
    }
    AscendC::Brcb(xbr_, xf_, uint8_t((have + 7) / 8), br);
    if constexpr (Mode != 1) AscendC::Brcb(xsbr_, xsf_, uint8_t((have + 7) / 8), br);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::BinaryRepeatParams rp;
    rp.dstBlkStride = 1;
    rp.src0BlkStride = 1;
    rp.src1BlkStride = 0;
    rp.dstRepStride = uint16_t(pitch_ / 8);
    rp.src0RepStride = 0;
    rp.src1RepStride = 1;
    for (uint32_t c = 0; c < n_; c += 64)
      AscendC::Mul(outF_[c], wf_[c], xbr_, uint64_t(MinU(64, n_ - c)), uint8_t(have),
                   rp);
    AscendC::PipeBarrier<PIPE_V>();
    if constexpr (Mode == 0) {
      rp.src0RepStride = uint16_t(pitch_ / 8);
      rp.src1BlkStride = 1;
      rp.src1RepStride = 0;
      for (uint32_t c = 0; c < n_; c += 64)
        AscendC::Mul(outF_[c], outF_[c], wsf_[c], uint64_t(MinU(64, n_ - c)),
                     uint8_t(have), rp);
      AscendC::PipeBarrier<PIPE_V>();
    }
    if constexpr (Mode != 1) {
      rp.src0RepStride = uint16_t(pitch_ / 8);
      rp.src1BlkStride = 0;
      rp.src1RepStride = 1;
      for (uint32_t c = 0; c < n_; c += 64)
        AscendC::Mul(outF_[c], outF_[c], xsbr_, uint64_t(MinU(64, n_ - c)),
                     uint8_t(have), rp);
      AscendC::PipeBarrier<PIPE_V>();
    }
    const uint16_t slot = outputIndex_++ % Outputs;
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(slot);
    auto target = outH_[slot * rows_ * pitch_];
    AscendC::Cast(target, outF_, AscendC::RoundMode::CAST_RINT, have * pitch_);
    Barrier<AscendC::HardEvent::V_MTE3>();
    AscendC::DataCopyPad(yGm_[uint64_t(row0) * n_], target,
                         AscendC::DataCopyExtParams{
                             uint16_t(have), uint32_t(n_ * sizeof(OutT)), 0, 0, 0});
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(slot);
  }
  GlobalTensor<int8_t> xGm_, wGm_;
  GlobalTensor<float> xsGm_;
  GlobalTensor<WScaleT> wsGm_;
  GlobalTensor<int64_t> glGm_;
  GlobalTensor<OutT> yGm_;
  AscendC::TQue<AscendC::TPosition::VECIN, 1> wq_, xq_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> work_;
  LocalTensor<float> outF_, wf_, wsf_, xf_, xsf_;
  LocalTensor<float> xbr_, xsbr_;
  LocalTensor<WScaleT> wsRaw_;
  LocalTensor<half> xh_;
  LocalTensor<OutT> outH_;
  const VTiling* t_;
  uint32_t outputIndex_ = 0;
  uint32_t core_, blocks_, n_, rows_, pitch_, held_;
};
__global__ __aicore__ void OuterQueuedKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                             GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                             VTiling t) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  AscendC::TPipe pipe;
  OuterQueued<float, half, 1, 20, true, 2> op;
  op.Init(x, w, xs, ws, gl, y, &t, &pipe);
  op.Process();
}
template <typename WScaleT, typename OutT>
class OuterGeneric {
 public:
  __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR xScale, GM_ADDR wScale,
                              GM_ADDR groupList, GM_ADDR y, const VTiling* t,
                              AscendC::TPipe* pipe) {
    t_ = t;
    xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
    wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
    xsGm_.SetGlobalBuffer((__gm__ float*)xScale);
    wsGm_.SetGlobalBuffer((__gm__ WScaleT*)wScale);
    glGm_.SetGlobalBuffer((__gm__ int64_t*)groupList);
    yGm_.SetGlobalBuffer((__gm__ OutT*)y);
    core_ = AscendC::GetBlockIdx();
    blocks_ = t_->coreNum;
    n_ = t_->n;
    rows_ = t_->kc;
    pitch_ = t_->nb;
    held_ = 0xFFFFFFFFu;
    const uint32_t block = rows_ * pitch_;
    const uint32_t nUp = Up(n_, vec::GRAIN);
    const uint32_t rUp = Up(rows_, vec::GRAIN);
    pipe->InitBuffer(wq_, 1, nUp + vec::GRAIN);
    pipe->InitBuffer(xq_, 1, rUp + vec::GRAIN);
    pipe->InitBuffer(work_, block * sizeof(float) + block * sizeof(OutT) +
                                3 * nUp * sizeof(float) + 4 * rUp * sizeof(float) +
                                16 * rUp * sizeof(float));
    uint32_t at = 0;
    outF_ = work_.GetWithOffset<float>(block, at);
    at += block * sizeof(float);
    outH_ = work_.GetWithOffset<OutT>(block, at);
    at += block * sizeof(OutT);
    wf_ = work_.GetWithOffset<float>(nUp, at);
    at += nUp * sizeof(float);
    wsf_ = work_.GetWithOffset<float>(nUp, at);
    at += nUp * sizeof(float);
    wsRaw_ = work_.GetWithOffset<WScaleT>(nUp, at);
    at += nUp * sizeof(float);
    xf_ = work_.GetWithOffset<float>(rUp, at);
    at += rUp * sizeof(float);
    xsf_ = work_.GetWithOffset<float>(rUp, at);
    at += rUp * sizeof(float);
    xh_ = work_.GetWithOffset<half>(rUp, at);
    at += rUp * sizeof(half);
    xbr_ = work_.GetWithOffset<float>(rUp * 8, at);
    at += rUp * 8 * sizeof(float);
    xsbr_ = work_.GetWithOffset<float>(rUp * 8, at);
  }
  __aicore__ inline void Process() {
    Walk walk;
    walk.Init(glGm_, t_->listType, t_->e, rows_, 1u);
    uint32_t item = 0;
    while (!walk.done) {
      if (item % blocks_ == core_) {
        const uint32_t taken = walk.mIdx * rows_;
        Block(walk.expert, walk.rowStart + taken, MinU(rows_, walk.rows - taken));
      }
      ++item;
      walk.Next();
    }
  }
 private:
  __aicore__ inline void LoadExpert(uint32_t expert) {
    if (expert == held_) return;
    held_ = expert;
    const uint32_t nUp = Up(n_, vec::GRAIN);
    LocalTensor<int8_t> wr = wq_.template AllocTensor<int8_t>();
    AscendC::DataCopyPad(wr, wGm_[uint64_t(expert) * n_],
                         AscendC::DataCopyExtParams{1, n_, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
    AscendC::DataCopyPad(
        wsRaw_, wsGm_[uint64_t(expert) * n_],
        AscendC::DataCopyExtParams{1, uint32_t(n_ * sizeof(WScaleT)), 0, 0, 0},
        AscendC::DataCopyPadExtParams<WScaleT>{true, 0, 0, 0});
    wq_.EnQue(wr);
    wr = wq_.template DeQue<int8_t>();
    AscendC::Cast(whBuf(), wr, AscendC::RoundMode::CAST_NONE, nUp);
    AscendC::PipeBarrier<PIPE_V>();
    wq_.FreeTensor(wr);
    AscendC::Cast(wf_, whBuf(), AscendC::RoundMode::CAST_NONE, nUp);
    CastScale(wsf_, nUp);
    AscendC::PipeBarrier<PIPE_V>();
  }
  __aicore__ inline LocalTensor<half> whBuf() {
    return outF_.template ReinterpretCast<half>();
  }
  __aicore__ inline void CastScale(const LocalTensor<float>& dst, uint32_t count) {
    if constexpr (AscendC::IsSameType<WScaleT, float>::value) {
      AscendC::DataCopy(dst, wsRaw_.template ReinterpretCast<float>(), count);
    } else {
      AscendC::Cast(dst, wsRaw_, AscendC::RoundMode::CAST_NONE, count);
    }
  }
  __aicore__ inline void Block(uint32_t expert, uint32_t row0, uint32_t have) {
    LoadExpert(expert);
    const uint32_t rUp = Up(have, vec::GRAIN);
    LocalTensor<int8_t> xr = xq_.template AllocTensor<int8_t>();
    AscendC::DataCopyPad(xr, xGm_[row0], AscendC::DataCopyExtParams{1, have, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
    AscendC::DataCopyPad(xsf_, xsGm_[row0],
                         AscendC::DataCopyExtParams{1, have * 4u, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<float>{true, 0, 0, 0});
    xq_.EnQue(xr);
    xr = xq_.template DeQue<int8_t>();
    AscendC::Cast(xh_, xr, AscendC::RoundMode::CAST_NONE, rUp);
    AscendC::PipeBarrier<PIPE_V>();
    xq_.FreeTensor(xr);
    AscendC::Cast(xf_, xh_, AscendC::RoundMode::CAST_NONE, rUp);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::BrcbRepeatParams br;
    br.dstBlkStride = 1;
    br.dstRepStride = 8;
    AscendC::Brcb(xbr_, xf_, uint8_t((have + 7) / 8), br);
    AscendC::Brcb(xsbr_, xsf_, uint8_t((have + 7) / 8), br);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::BinaryRepeatParams rp;
    rp.dstBlkStride = 1;
    rp.src0BlkStride = 1;
    rp.src1BlkStride = 0;
    rp.dstRepStride = uint16_t(pitch_ / 8);
    rp.src0RepStride = 0;
    rp.src1RepStride = 1;
    for (uint32_t c = 0; c < n_; c += 64)
      AscendC::Mul(outF_[c], wf_[c], xbr_, uint64_t(MinU(64, n_ - c)), uint8_t(have),
                   rp);
    AscendC::PipeBarrier<PIPE_V>();
    rp.src0RepStride = uint16_t(pitch_ / 8);
    rp.src1BlkStride = 1;
    rp.src1RepStride = 0;
    for (uint32_t c = 0; c < n_; c += 64)
      AscendC::Mul(outF_[c], outF_[c], wsf_[c], uint64_t(MinU(64, n_ - c)),
                   uint8_t(have), rp);
    AscendC::PipeBarrier<PIPE_V>();
    rp.src1BlkStride = 0;
    rp.src1RepStride = 1;
    for (uint32_t c = 0; c < n_; c += 64)
      AscendC::Mul(outF_[c], outF_[c], xsbr_, uint64_t(MinU(64, n_ - c)), uint8_t(have),
                   rp);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Cast(outH_, outF_, AscendC::RoundMode::CAST_RINT, have * pitch_);
    Barrier<AscendC::HardEvent::V_MTE3>();
    AscendC::DataCopyPad(yGm_[uint64_t(row0) * n_], outH_,
                         AscendC::DataCopyExtParams{
                             uint16_t(have), uint32_t(n_ * sizeof(OutT)), 0, 0, 0});
    Barrier<AscendC::HardEvent::MTE3_V>();
  }
  GlobalTensor<int8_t> xGm_, wGm_;
  GlobalTensor<float> xsGm_;
  GlobalTensor<WScaleT> wsGm_;
  GlobalTensor<int64_t> glGm_;
  GlobalTensor<OutT> yGm_;
  AscendC::TQue<AscendC::TPosition::VECIN, 1> wq_, xq_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> work_;
  LocalTensor<float> outF_, wf_, wsf_, xf_, xsf_;
  LocalTensor<float> xbr_, xsbr_;
  LocalTensor<WScaleT> wsRaw_;
  LocalTensor<half> xh_;
  LocalTensor<OutT> outH_;
  const VTiling* t_;
  uint32_t core_, blocks_, n_, rows_, pitch_, held_;
};
template <typename WScaleT, typename OutT>
__global__ __aicore__ void OuterGenericKernel(GM_ADDR x, GM_ADDR weight, GM_ADDR xScale,
                                              GM_ADDR wScale, GM_ADDR groupList,
                                              GM_ADDR y, VTiling tiling) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  AscendC::TPipe pipe;
  OuterGeneric<WScaleT, OutT> op;
  op.Init(x, weight, xScale, wScale, groupList, y, &tiling, &pipe);
  op.Process();
}
}
namespace gmmptq {
struct EmptyResource {};
static_assert(std::is_trivially_default_constructible<EmptyResource>::value &&
                  std::is_trivially_destructible<EmptyResource>::value,
              "static resources must have no queue constructor/destructor");
template <bool Static>
using P13Buf =
    std::conditional_t<Static, EmptyResource, AscendC::TBuf<TPosition::VECCALC>>;
template <bool Static>
using P13Que = std::conditional_t<Static, EmptyResource,
                                  AscendC::TQue<AscendC::QuePosition::VECIN, 1>>;
template <bool Static>
using P13Pipe = std::conditional_t<Static, EmptyResource, AscendC::TPipe>;
namespace balanced_short_group {
constexpr uint32_t GRAIN = 32;
constexpr uint32_t LANES = 8;
constexpr uint32_t SCRATCH_BYTES = 8192;
}
template <typename WScaleT, typename OutT, bool Static = false>
class ShortGroupMatmul {
 public:
  __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR xScale, GM_ADDR wScale,
                              GM_ADDR groupList, GM_ADDR y, const VTiling* t,
                              P13Pipe<Static>* pipe) {
    t_ = t;
    if constexpr (Static) {
      xsAll_ = LocalTensor<float>(TPosition::VECIN, 0, 256);
      groupList_ = LocalTensor<int64_t>(TPosition::VECIN, 1024, 128);
      rawIssued_ = false;
    } else {
      pipe->InitBuffer(xsAllBuf_, 256 * sizeof(float));
      xsAll_ = xsAllBuf_.template Get<float>();
      pipe->InitBuffer(groupBuf_, 128 * 8);
      groupList_ = groupBuf_.template Get<int64_t>();
    }
    xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
    wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
    xsGm_.SetGlobalBuffer((__gm__ float*)xScale);
    wsGm_.SetGlobalBuffer((__gm__ WScaleT*)wScale);
    glGm_.SetGlobalBuffer((__gm__ int64_t*)groupList);
    yGm_.SetGlobalBuffer((__gm__ OutT*)y);
    core_ = t_->coreNum % 7u ? AscendC::GetBlockIdx() * 7u % t_->coreNum
                             : AscendC::GetBlockIdx();
    blocks_ = t_->coreNum;
    kc_ = t_->kc;
    nb_ = t_->nb;
    nBlocks_ = Ceil(t_->n, nb_);
    if constexpr (Static)
      out_ = LocalTensor<OutT>(TPosition::VECOUT, 2048, Up(t_->n, 32));
    else
      pipe->InitBuffer(outBuf_, Up(t_->n, 32) * sizeof(OutT));
    outputIssued_ = false;
    const uint32_t block = kc_ * nb_;
    capacity_ = block;
    const uint32_t nbAligned = Up(t_->n, balanced_short_group::GRAIN);
    if constexpr (Static) {
      const uint32_t xb = 2048 + Up(t_->n, 32) * sizeof(OutT);
      const uint32_t wb = xb + Up(kc_, BLK) + BLK;
      xraw_ = LocalTensor<int8_t>(TPosition::VECIN, xb, Up(kc_, BLK) + BLK);
      wraw_ = LocalTensor<int8_t>(TPosition::VECIN, wb, Up(block, BLK) + BLK);
      workBase_ = wb + Up(block, BLK) + BLK;
    } else {
      pipe->InitBuffer(xq_, 1, Up(kc_, BLK) + BLK);
      pipe->InitBuffer(wq_, 1, Up(block, BLK) + BLK);
    }
    const uint32_t blockUp = Up(block, balanced_short_group::GRAIN);
    const uint32_t fprod = blockUp * sizeof(float);
    const uint32_t fx = Up(kc_, balanced_short_group::GRAIN) * sizeof(float);
    const uint32_t fn = nbAligned * sizeof(float);
    const uint32_t fscratch = balanced_short_group::SCRATCH_BYTES;
    const uint32_t hw = blockUp * sizeof(half);
    const uint32_t hx = Up(kc_, balanced_short_group::GRAIN) * sizeof(half);
    if constexpr (!Static)
      pipe->InitBuffer(work_, fprod + fx + 2 * fn + balanced_short_group::LANES * 4 +
                                  hw + hx + fscratch);
    uint32_t at = 0;
    wf_ = WorkView<float>(blockUp, at);
    at += fprod;
    prod_ = wf_;
    xf_ = WorkView<float>(Up(kc_, balanced_short_group::GRAIN), at);
    at += fx;
    acc_ = WorkView<float>(nbAligned, at);
    at += fn;
    wsf_ = WorkView<float>(nbAligned, at);
    at += fn;
    xsUb_ = WorkView<float>(balanced_short_group::LANES, at);
    at += balanced_short_group::LANES * 4;
    wh_ = WorkView<half>(blockUp, at);
    at += hw;
    xh_ = WorkView<half>(Up(kc_, balanced_short_group::GRAIN), at);
    at += hx;
    scratch_ = WorkView<uint8_t>(fscratch, at);
  }
  __aicore__ inline void Process() {
    AscendC::DataCopyPad(xsAll_, xsGm_,
                         AscendC::DataCopyExtParams{1, t_->m * 4, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<float>{false, 0, 0, 0});
    AscendC::DataCopyPad(groupList_, glGm_,
                         AscendC::DataCopyExtParams{1, t_->e * 8, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
    Barrier<AscendC::HardEvent::MTE2_S>();
    uint32_t expert = 0;
    uint32_t end = uint32_t(groupList_.GetValue(0));
    const uint32_t nBlocks = Ceil(t_->n, 32);
    const uint32_t total = t_->m * nBlocks;
    uint32_t first = uint32_t(uint64_t(total) * core_ / blocks_);
    const uint32_t last = uint32_t(uint64_t(total) * (core_ + 1) / blocks_);
    const uint32_t firstRow = first / nBlocks;
    const uint32_t lastBegin =
        t_->e > 1u
            ? (t_->listType == 0 ? uint32_t(groupList_.GetValue(t_->e - 2u))
                                 : t_->m - uint32_t(groupList_.GetValue(t_->e - 1u)))
            : 0u;
    if (first < last && firstRow >= lastBegin) {
      expert = t_->e - 1u;
      end = t_->m;
    } else if (first < last && firstRow >= end && firstRow >= t_->m / 2u) {
      expert = t_->e - 1u;
      end = t_->m;
      while (expert > 0u) {
        const uint32_t begin = t_->listType == 0
                                   ? uint32_t(groupList_.GetValue(expert - 1u))
                                   : end - uint32_t(groupList_.GetValue(expert));
        if (firstRow >= begin) break;
        end = begin;
        --expert;
      }
    }
    while (first < last) {
      const uint32_t row = first / nBlocks;
      const uint32_t col = (first % nBlocks) * 32;
      const uint32_t take = MinU(last - first, nBlocks - first % nBlocks);
      while (row >= end && expert + 1 < t_->e) {
        ++expert;
        const uint32_t value = uint32_t(groupList_.GetValue(expert));
        end = t_->listType == 0 ? value : end + value;
      }
      Row(expert, row, col, MinU(t_->n - col, take * 32));
      first += take;
    }
    if (outputIssued_) Sync<AscendC::HardEvent::MTE3_S>();
    if constexpr (Static)
      if (rawIssued_) {
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
      }
  }
 private:
  template <AscendC::HardEvent E>
  __aicore__ inline void Sync() {
    if constexpr (Static) {
      constexpr uint8_t id =
          (E == AscendC::HardEvent::MTE2_V || E == AscendC::HardEvent::V_MTE2) ? 2u
                                                                               : 0u;
      AscendC::SetFlag<E>(id);
      AscendC::WaitFlag<E>(id);
    } else {
      const auto id = GetTPipePtr()->FetchEventID(E);
      AscendC::SetFlag<E>(id);
      AscendC::WaitFlag<E>(id);
    }
  }
  template <typename T>
  __aicore__ inline LocalTensor<T> WorkView(uint32_t count, uint32_t offset) {
    if constexpr (Static)
      return LocalTensor<T>(TPosition::VECCALC, workBase_ + offset, count);
    else
      return work_.template GetWithOffset<T>(count, offset);
  }
  __aicore__ inline LocalTensor<OutT> Output() {
    if constexpr (Static)
      return out_;
    else
      return outBuf_.template Get<OutT>();
  }
  __aicore__ inline void Row(uint32_t expert, uint32_t row, uint32_t col,
                             uint32_t cols) {
    const bool flat = false;
    const uint32_t pitch = flat ? cols : Up(cols, BLK);
    kc_ = t_->kc;
    while (kc_ * pitch > capacity_) kc_ /= 2;
    const uint32_t accLen = Up(pitch, balanced_short_group::GRAIN);
    AscendC::Duplicate(acc_, 0.0f, accLen);
    AscendC::PipeBarrier<PIPE_V>();
    IssueInputs(expert, row, col, cols, flat, 0, MinU(kc_, t_->k));
    for (uint32_t k0 = 0; k0 < t_->k; k0 += kc_) {
      const uint32_t klen = MinU(kc_, t_->k - k0);
      LoadChunk(expert, row, col, cols, pitch, flat, k0, klen);
    }
    LoadWeightScale(expert, col, cols, accLen);
    AscendC::Mul(acc_, acc_, wsf_, accLen);
    AscendC::PipeBarrier<PIPE_V>();
    const float xs = xsAll_.GetValue(row);
    Sync<AscendC::HardEvent::S_V>();
    AscendC::Muls(acc_, acc_, xs, accLen);
    AscendC::PipeBarrier<PIPE_V>();
    LocalTensor<OutT> out = Output();
    if (outputIssued_) Sync<AscendC::HardEvent::MTE3_V>();
    AscendC::Cast(out, acc_, AscendC::RoundMode::CAST_RINT, accLen);
    Sync<AscendC::HardEvent::V_MTE3>();
    AscendC::DataCopyExtParams p{1, cols * uint32_t(sizeof(OutT)), 0, 0, 0};
    AscendC::DataCopyPad(yGm_[uint64_t(row) * t_->n + col], out, p);
    outputIssued_ = true;
  }
  __aicore__ inline void IssueInputs(uint32_t expert, uint32_t row, uint32_t col,
                                     uint32_t cols, bool flat, uint32_t k0,
                                     uint32_t klen) {
    LocalTensor<int8_t> xi8;
    if constexpr (Static) {
      if (rawIssued_) AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
      xi8 = xraw_;
    } else
      xi8 = xq_.template AllocTensor<int8_t>();
    {
      AscendC::DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
      AscendC::DataCopyExtParams p{1, klen, 0, 0, 0};
      AscendC::DataCopyPad(xi8, xGm_[uint64_t(row) * t_->k + k0], p, pad);
    }
    if constexpr (Static)
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
    else
      xq_.EnQue(xi8);
    LocalTensor<int8_t> wi8;
    if constexpr (Static) {
      if (rawIssued_) AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
      wi8 = wraw_;
    } else
      wi8 = wq_.template AllocTensor<int8_t>();
    {
      AscendC::DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
      AscendC::DataCopyExtParams p =
          flat ? AscendC::DataCopyExtParams{1, klen * cols, 0, 0, 0}
               : AscendC::DataCopyExtParams{static_cast<uint16_t>(klen), cols,
                                            t_->n - cols, 0, 0};
      AscendC::DataCopyPad(wi8, wGm_[(uint64_t(expert) * t_->k + k0) * t_->n + col], p,
                           pad);
    }
    if constexpr (Static) {
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(1);
      rawIssued_ = true;
    } else
      wq_.EnQue(wi8);
  }
  __aicore__ inline void LoadChunk(uint32_t expert, uint32_t row, uint32_t col,
                                   uint32_t cols, uint32_t pitch, bool flat,
                                   uint32_t k0, uint32_t klen) {
    if (klen < kc_) {
      AscendC::Duplicate(xf_, 0.0f, Up(kc_, balanced_short_group::GRAIN));
      AscendC::Duplicate(wf_[klen * pitch], 0.0f, (kc_ - klen) * pitch);
      AscendC::PipeBarrier<PIPE_V>();
    }
    LocalTensor<int8_t> xr, wr;
    if constexpr (Static) {
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
      xr = xraw_;
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(1);
      wr = wraw_;
    } else {
      xr = xq_.template DeQue<int8_t>();
      wr = wq_.template DeQue<int8_t>();
    }
    const uint32_t welems = Up(klen * pitch, balanced_short_group::GRAIN);
    const uint32_t xelems = Up(klen, balanced_short_group::GRAIN);
    AscendC::Cast(xh_, xr, AscendC::RoundMode::CAST_NONE, xelems);
    AscendC::Cast(wh_, wr, AscendC::RoundMode::CAST_NONE, welems);
    AscendC::PipeBarrier<PIPE_V>();
    if constexpr (Static) {
      AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(1);
    } else {
      xq_.FreeTensor(xr);
      wq_.FreeTensor(wr);
    }
    if (k0 + kc_ < t_->k)
      IssueInputs(expert, row, col, cols, flat, k0 + kc_, MinU(kc_, t_->k - k0 - kc_));
    AscendC::Cast(xf_, xh_, AscendC::RoundMode::CAST_NONE, xelems);
    AscendC::Cast(wf_, wh_, AscendC::RoundMode::CAST_NONE, welems);
    AscendC::PipeBarrier<PIPE_V>();
    if (k0 + klen == t_->k) IssueWeightScale(expert, col, cols);
    LocalTensor<float> xbr = scratch_.template ReinterpretCast<float>();
    AscendC::Brcb(xbr, xf_, uint8_t(kc_ / 8), AscendC::BrcbRepeatParams{1, 8});
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::BinaryRepeatParams repeat;
    repeat.dstBlkStride = 1;
    repeat.src0BlkStride = 1;
    repeat.src1BlkStride = 0;
    repeat.dstRepStride = uint8_t(pitch / 8);
    repeat.src0RepStride = uint8_t(pitch / 8);
    repeat.src1RepStride = 1;
    for (uint32_t r0 = 0; r0 < kc_; r0 += 128) {
      const uint8_t repeats = uint8_t(MinU(128, kc_ - r0));
      for (uint32_t c = 0; c < pitch; c += 64) {
        const uint64_t mask = MinU(64, pitch - c);
        AscendC::Mul(prod_[r0 * pitch + c], wf_[r0 * pitch + c], xbr[r0 * 8], mask,
                     repeats, repeat);
      }
    }
    AscendC::PipeBarrier<PIPE_V>();
    uint32_t rows = kc_;
    while (rows > 1 && (((rows / 2) * pitch) % balanced_short_group::LANES) == 0) {
      const uint32_t half = rows / 2;
      AscendC::Add(prod_, prod_, prod_[half * pitch], half * pitch);
      AscendC::PipeBarrier<PIPE_V>();
      rows = half;
    }
    if (rows == 1 && pitch >= balanced_short_group::LANES) {
      AscendC::Add(acc_, acc_, prod_, pitch);
      AscendC::PipeBarrier<PIPE_V>();
      return;
    }
    AscendC::PipeBarrier<PIPE_ALL>();
    for (uint32_t c = 0; c < pitch; ++c) {
      float sum = acc_.GetValue(c);
      for (uint32_t r = 0; r < rows; ++r) {
        sum += prod_.GetValue(r * pitch + c);
      }
      acc_.SetValue(c, sum);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
  }
  __aicore__ inline void IssueWeightScale(uint32_t expert, uint32_t col,
                                          uint32_t cols) {
    Sync<AscendC::HardEvent::V_MTE2>();
    const uint64_t base = uint64_t(expert) * t_->n + col;
    AscendC::DataCopyPadExtParams<WScaleT> pad{true, 0, 0, 0};
    AscendC::DataCopyExtParams p{1, cols * uint32_t(sizeof(WScaleT)), 0, 0, 0};
    if constexpr (sizeof(WScaleT) == 4) {
      AscendC::DataCopyPad(wsf_, wsGm_[base], p, pad);
    } else {
      auto raw = wh_.template ReinterpretCast<WScaleT>();
      AscendC::DataCopyPad(raw, wsGm_[base], p, pad);
    }
  }
  __aicore__ inline void LoadWeightScale(uint32_t, uint32_t, uint32_t,
                                         uint32_t nbAligned) {
    Sync<AscendC::HardEvent::MTE2_V>();
    if constexpr (sizeof(WScaleT) != 4) {
      auto raw = wh_.template ReinterpretCast<WScaleT>();
      AscendC::Cast(wsf_, raw, AscendC::RoundMode::CAST_NONE, nbAligned);
      AscendC::PipeBarrier<PIPE_V>();
    }
  }
  P13Buf<Static> xsAllBuf_;
  LocalTensor<float> xsAll_;
  P13Buf<Static> outBuf_;
  bool outputIssued_;
  P13Buf<Static> groupBuf_;
  LocalTensor<int64_t> groupList_;
  const VTiling* t_;
  GlobalTensor<int8_t> xGm_, wGm_;
  GlobalTensor<float> xsGm_;
  GlobalTensor<WScaleT> wsGm_;
  GlobalTensor<int64_t> glGm_;
  GlobalTensor<OutT> yGm_;
  P13Que<Static> xq_, wq_;
  P13Buf<Static> work_;
  LocalTensor<float> prod_, wf_, xf_, acc_, wsf_, xsUb_;
  LocalTensor<half> wh_, xh_;
  LocalTensor<uint8_t> scratch_;
  uint32_t core_, blocks_, kc_, nb_, nBlocks_, capacity_;
  uint32_t workBase_;
  bool rawIssued_;
  LocalTensor<int8_t> xraw_, wraw_;
  LocalTensor<OutT> out_;
};
template <typename WScaleT, typename OutT>
__global__ __aicore__ void ShortGroupKernel(GM_ADDR x, GM_ADDR weight, GM_ADDR xScale,
                                            GM_ADDR wScale, GM_ADDR groupList,
                                            GM_ADDR y, VTiling tiling) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  AscendC::InitSocState();
  ShortGroupMatmul<WScaleT, OutT, true> op;
  op.Init(x, weight, xScale, wScale, groupList, y, &tiling, nullptr);
  op.Process();
  AscendC::PipeBarrier<PIPE_ALL>();
}
__global__ __aicore__ void ShortGroupCompactKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                                   GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                                   uint64_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  AscendC::InitSocState();
  VTiling t{};
  t.m = (dims & 255u) + 1;
  t.k = ((dims >> 8) & 255u) + 1;
  t.n = ((dims >> 16) & 511u) + 1;
  t.e = ((dims >> 25) & 127u) + 1;
  t.coreNum = ((dims >> 32) & 63u) + 1;
  t.listType = (dims >> 38) & 1;
  t.kc = 128;
  t.nb = 192;
  ShortGroupMatmul<bfloat16_t, bfloat16_t, true> op;
  op.Init(x, w, xs, ws, gl, y, &t, nullptr);
  op.Process();
  AscendC::PipeBarrier<PIPE_ALL>();
}
}
namespace gmmptq {
template <typename ScaleT, typename OutT, uint32_t Rows = 16>
__global__ __aicore__ void RowDot(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                  GM_ADDR gl, GM_ADDR y, GeneralVectorDims p) {
  using namespace AscendC;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  static_assert(Rows >= 1 && Rows <= 16, "row batch must fit vector UB at maximum K");
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<float> xsg;
  GlobalTensor<ScaleT> wsg;
  GlobalTensor<OutT> yg;
  GlobalTensor<int64_t> glg;
  xg.SetGlobalBuffer((__gm__ int8_t*)x);
  wg.SetGlobalBuffer((__gm__ int8_t*)w);
  xsg.SetGlobalBuffer((__gm__ float*)xs);
  wsg.SetGlobalBuffer((__gm__ ScaleT*)ws);
  yg.SetGlobalBuffer((__gm__ OutT*)y);
  glg.SetGlobalBuffer((__gm__ int64_t*)gl);
  const uint32_t block = GetBlockIdx(), cores = GetBlockNum();
  const uint32_t lo = p.m * block / cores, hi = p.m * (block + 1) / cores;
  if (lo >= hi) return;
  const uint32_t cap = GvMin(p.k, 1024), cap32 = GvUp(cap, 32), cap64 = GvUp(cap, 64);
  const uint32_t wk32 = GvUp(p.k, 32), wk64 = GvUp(p.k, 64), rr = GvUp(Rows, 16);
  uint32_t bytes = Rows * (cap32 * 3 + cap64 * 4) + wk32 * 3 + wk64 * 4 + Rows * 64 +
                   rr * 18 + 128 + GvUp(p.e * 8, 32);
  TPipe pipe;
  TBuf<TPosition::VECCALC> ub;
  pipe.InitBuffer(ub, GvUp(bytes, 32));
  auto raw = ub.Get<uint8_t>();
  uint32_t at = 0;
  auto xi = raw[at].ReinterpretCast<int8_t>();
  at += Rows * cap32;
  auto xh = raw[at].ReinterpretCast<half>();
  at += Rows * cap32 * 2;
  auto xf = raw[at].ReinterpretCast<float>();
  at += Rows * cap64 * 4;
  auto wi = raw[at].ReinterpretCast<int8_t>();
  at += wk32;
  auto wh = raw[at].ReinterpretCast<half>();
  at += wk32 * 2;
  auto wf = raw[at].ReinterpretCast<float>();
  at += wk64 * 4;
  auto red1 = raw[at].ReinterpretCast<float>();
  at += Rows * 64;
  auto red2 = raw[at].ReinterpretCast<float>();
  at += rr * 4;
  auto acc = raw[at].ReinterpretCast<int32_t>();
  at += rr * 4;
  auto partial = raw[at].ReinterpretCast<int32_t>();
  at += rr * 4;
  auto xsl = raw[at].ReinterpretCast<float>();
  at += rr * 4;
  auto out = raw[at].ReinterpretCast<OutT>();
  at += rr * 2;
  auto wsl = raw[at].ReinterpretCast<ScaleT>();
  at += 64;
  auto wsf = raw[at].ReinterpretCast<float>();
  at += 64;
  auto gll = raw[at].ReinterpretCast<int64_t>();
  DataCopyPad(gll, glg, DataCopyExtParams{1, p.e * 8, 0, 0, 0},
              DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
  GvBarrier<HardEvent::MTE2_S>();
  uint32_t start = 0;
  for (uint32_t e = 0; e < p.e; ++e) {
    const uint32_t value = uint32_t(gll.GetValue(e));
    const uint32_t end = p.listType == 0 ? value : start + value;
    uint32_t row = start > lo ? start : lo, stop = end < hi ? end : hi;
    start = end;
    if (row >= stop) continue;
    GvBarrier<HardEvent::V_MTE2>();
    DataCopyPad(wi, wg[uint64_t(e) * p.k], DataCopyExtParams{1, p.k, 0, 0, 0},
                DataCopyPadExtParams<int8_t>{true, 0, uint8_t(wk32 - p.k), 0});
    DataCopyPad(wsl, wsg[e], DataCopyExtParams{1, uint32_t(sizeof(ScaleT)), 0, 0, 0},
                DataCopyPadExtParams<ScaleT>{false, 0, 0, 0});
    GvBarrier<HardEvent::MTE2_V>();
    Cast(wh, wi, RoundMode::CAST_NONE, wk32);
    if constexpr (sizeof(ScaleT) == 2) Cast(wsf, wsl, RoundMode::CAST_NONE, 16);
    Duplicate(wf, 0.0f, wk64);
    PipeBarrier<PIPE_V>();
    Cast(wf, wh, RoundMode::CAST_NONE, wk32);
    GvBarrier<HardEvent::V_S>();
    float scale;
    if constexpr (sizeof(ScaleT) == 4)
      scale = wsl.GetValue(0);
    else
      scale = wsf.GetValue(0);
    GvBarrier<HardEvent::S_V>();
    for (; row < stop; row += Rows) {
      const uint32_t have = GvMin(Rows, stop - row);
      GvBarrier<HardEvent::V_MTE2>();
      DataCopyPad(xsl, xsg[row], DataCopyExtParams{1, have * 4, 0, 0, 0},
                  DataCopyPadExtParams<float>{false, 0, 0, 0});
      if (p.k > 1024) Duplicate(acc, int32_t(0), GvUp(have, 8));
      for (uint32_t k0 = 0; k0 < p.k; k0 += cap) {
        uint32_t len = GvMin(cap, p.k - k0), kp = GvUp(len, 32), fp = GvUp(len, 64);
        GvBarrier<HardEvent::V_MTE2>();
        DataCopyPad(xi, xg[uint64_t(row) * p.k + k0],
                    DataCopyExtParams{uint16_t(have), len, p.k - len, 0, 0},
                    DataCopyPadExtParams<int8_t>{true, 0, uint8_t(kp - len), 0});
        GvBarrier<HardEvent::MTE2_V>();
        Cast(xh, xi, RoundMode::CAST_NONE, have * kp);
        Duplicate(xf, 0.0f, have * fp);
        Duplicate(red1, 0.0f, have * 16);
        PipeBarrier<PIPE_V>();
        for (uint32_t r = 0; r < have; ++r)
          Cast(xf[r * fp], xh[r * kp], RoundMode::CAST_NONE, kp);
        PipeBarrier<PIPE_V>();
        GvMulRows(xf, wf[k0], have, fp);
        PipeBarrier<PIPE_V>();
        for (uint32_t r = 0; r < have; ++r)
          WholeReduceSum(red1[r * 16], xf[r * fp], 64, fp / 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(red2, red1, 16, have, 1, 1, 2);
        PipeBarrier<PIPE_V>();
        if (p.k > 1024) {
          Cast(partial, red2, RoundMode::CAST_RINT, GvUp(have, 8));
          PipeBarrier<PIPE_V>();
          Add(acc, acc, partial, GvUp(have, 8));
          PipeBarrier<PIPE_V>();
        }
      }
      if (p.k > 1024) {
        Cast(red2, acc, RoundMode::CAST_RINT, GvUp(have, 8));
        PipeBarrier<PIPE_V>();
      }
      Muls(red2, red2, scale, GvUp(have, 8));
      PipeBarrier<PIPE_V>();
      Mul(red2, red2, xsl, GvUp(have, 8));
      PipeBarrier<PIPE_V>();
      Cast(out, red2, RoundMode::CAST_RINT, GvUp(have, 16));
      GvBarrier<HardEvent::V_MTE3>();
      DataCopyPad(yg[row], out, DataCopyExtParams{1, have * 2, 0, 0, 0});
      GvBarrier<HardEvent::MTE3_V>();
    }
  }
}
template <typename ScaleT, typename OutT>
__global__ __aicore__ void NarrowDotPerColumn(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                              GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                              GeneralVectorDims p) {
  using namespace AscendC;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<float> xsg;
  GlobalTensor<ScaleT> wsg;
  GlobalTensor<OutT> yg;
  GlobalTensor<int64_t> glg;
  xg.SetGlobalBuffer((__gm__ int8_t*)x);
  wg.SetGlobalBuffer((__gm__ int8_t*)w);
  xsg.SetGlobalBuffer((__gm__ float*)xs);
  wsg.SetGlobalBuffer((__gm__ ScaleT*)ws);
  yg.SetGlobalBuffer((__gm__ OutT*)y);
  glg.SetGlobalBuffer((__gm__ int64_t*)gl);
  const uint32_t k32 = GvUp(p.k, 32), k64 = GvUp(p.k, 64);
  const uint32_t w32 = GvUp(p.k * p.n, 32), whCount = GvUp(p.k * p.n, 128);
  const uint32_t partialCount = k64 / 64, partialPad = GvUp(partialCount, 16);
  const uint32_t groups = partialPad / 16;
  TPipe pipe;
  TBuf<TPosition::VECCALC> ub;
  pipe.InitBuffer(ub, 108320);
  auto raw = ub.Get<uint8_t>();
  auto xi = raw[0].ReinterpretCast<int8_t>();
  auto wi = raw[8192].ReinterpretCast<int8_t>();
  auto xh = raw[24576].ReinterpretCast<half>();
  auto x16 = raw[40960].ReinterpretCast<int16_t>();
  auto w16 = raw[57344].ReinterpretCast<int16_t>();
  auto wf = raw[73728].ReinterpretCast<float>();
  auto red1 = raw[106496].ReinterpretCast<float>();
  auto red2 = raw[107008].ReinterpretCast<float>();
  auto xsl = raw[107040].ReinterpretCast<float>();
  auto wsl = raw[107072].ReinterpretCast<ScaleT>();
  auto wsf = raw[107136].ReinterpretCast<float>();
  auto result = raw[107200].ReinterpretCast<float>();
  auto out = raw[107264].ReinterpretCast<OutT>();
  auto gll = raw[107296].ReinterpretCast<int64_t>();
  const uint32_t c = GetBlockIdx();
  if (c >= p.n) return;
  uint32_t expert = 0;
  if (p.e > 1) {
    DataCopyPad(gll, glg, DataCopyExtParams{1, p.e * 8, 0, 0, 0},
                DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
    GvBarrier<HardEvent::MTE2_S>();
    while (expert + 1 < p.e && gll.GetValue(expert) == 0) ++expert;
  }
  auto selectedScale = wsg[expert * p.n + c];
  DataCacheCleanAndInvalid<float, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(
      xsg);
  DataCacheCleanAndInvalid<ScaleT, CacheLine::SINGLE_CACHE_LINE,
                           DcciDst::CACHELINE_OUT>(selectedScale);
  GlobalTensor<uint64_t> scalePreload;
  scalePreload.SetGlobalBuffer((__gm__ uint64_t*)xs);
  DataCachePreload(scalePreload, int16_t(0));
  scalePreload.SetGlobalBuffer(
      (__gm__ uint64_t*)(ws + uint64_t(expert * p.n + c) * sizeof(ScaleT)));
  DataCachePreload(scalePreload, int16_t(0));
  DataCopyPad(xi, xg, DataCopyExtParams{1, p.k, 0, 0, 0},
              DataCopyPadExtParams<int8_t>{true, 0, uint8_t(k32 - p.k), 0});
  DataCopyPad(wi, wg[uint64_t(expert) * p.k * p.n],
              DataCopyExtParams{1, p.k * p.n, 0, 0, 0},
              DataCopyPadExtParams<int8_t>{true, 0, uint8_t(w32 - p.k * p.n), 0});
  GvBarrier<HardEvent::MTE2_V>();
  if (k64 > k32) Duplicate(x16, int16_t(0), k64);
  const uint32_t weightWords = p.n == 2 ? w32 / 2 : k32;
  if (k64 > weightWords) Duplicate(w16, int16_t(0), k64);
  Cast(xh, xi, RoundMode::CAST_NONE, k32);
  PipeBarrier<PIPE_V>();
  Cast(x16, xh, RoundMode::CAST_RINT, k32);
  PipeBarrier<PIPE_V>();
  if (p.n == 2) {
    auto packed = wi.ReinterpretCast<int16_t>();
    if (c == 0) {
      ShiftLeft(w16, packed, int16_t(8), int32_t(weightWords));
      PipeBarrier<PIPE_V>();
      ShiftRight(w16, w16, int16_t(8), int32_t(weightWords));
    } else
      ShiftRight(w16, packed, int16_t(8), int32_t(weightWords));
  } else {
    Cast(xh, wi, RoundMode::CAST_NONE, k32);
    PipeBarrier<PIPE_V>();
    Cast(w16, xh, RoundMode::CAST_RINT, k32);
  }
  PipeBarrier<PIPE_V>();
  Mul(w16, w16, x16, k64);
  PipeBarrier<PIPE_V>();
  Cast(wf, w16, RoundMode::CAST_NONE, k64);
  PipeBarrier<PIPE_V>();
  {
    if (partialPad > partialCount) Duplicate(red1, 0.0f, partialPad);
    PipeBarrier<PIPE_V>();
    WholeReduceSum(red1, wf, 64, partialCount, 1, 1, 8);
    PipeBarrier<PIPE_V>();
    WholeReduceSum(red2, red1, 16, groups, 1, 1, 2);
    GvBarrier<HardEvent::V_S>();
    int32_t sum = 0;
    for (uint32_t i = 0; i < groups; ++i) sum += int32_t(red2.GetValue(i));
    float scale;
    if constexpr (sizeof(ScaleT) == 4)
      scale = wsg.GetValue(expert * p.n + c);
    else {
      GlobalTensor<uint16_t> bits;
      bits.SetGlobalBuffer((__gm__ uint16_t*)ws);
      scale = GvFloat(uint32_t(bits.GetValue(expert * p.n + c)) << 16);
    }
    float weighted = float(sum) * scale;
    result.SetValue(0, weighted * xsg.GetValue(0));
    GvBarrier<HardEvent::S_V>();
  }
  Cast(out, result, RoundMode::CAST_RINT, 16);
  GvBarrier<HardEvent::V_MTE3>();
  DataCopyPad(yg[c], out, DataCopyExtParams{1, 2, 0, 0, 0});
}
}
namespace gmmptq {
template <typename ScaleT, typename OutT, uint32_t R = 32, uint32_t C = 800>
__global__ __aicore__ void N1PairDot(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                     GM_ADDR groups, GM_ADDR y, GeneralVectorDims s,
                                     uint32_t cores) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  using namespace AscendC;
  static_assert(C % 32u == 0 && R == 32u, "aligned pair rows");
  constexpr uint32_t ROW4 = (R * 4u + 31u) / 32u * 32u,
                     ROW2 = (R * 2u + 31u) / 32u * 32u;
  constexpr uint32_t UB_BYTES = R * C + C + 2u * R * C + 4u * R * C + 2u * C + ROW4 +
                                C * 2u + ROW4 + ROW2 + R * 32u + ROW4;
  static_assert(UB_BYTES == 184672u && UB_BYTES <= 188160u, "pair UB bound");
  TPipe pipe;
  uint32_t at = 0;
  LocalTensor<int8_t> xl(TPosition::VECCALC, at, (R * C) / 1u);
  at += (R * C);
  LocalTensor<int8_t> wl(TPosition::VECCALC, at, (C) / 1u);
  at += (C);
  LocalTensor<int16_t> even(TPosition::VECCALC, at, (R * C) / 2u);
  at += (R * C);
  LocalTensor<int16_t> odd(TPosition::VECCALC, at, (R * C) / 2u);
  at += (R * C);
  LocalTensor<float> f(TPosition::VECCALC, at, (R * C * 2u) / 4u);
  at += (R * C * 2u);
  LocalTensor<float> other(TPosition::VECCALC, at, (R * C * 2u) / 4u);
  at += (R * C * 2u);
  LocalTensor<int16_t> weven(TPosition::VECCALC, at, (C) / 2u);
  at += (C);
  LocalTensor<int16_t> wodd(TPosition::VECCALC, at, (C) / 2u);
  at += (C);
  LocalTensor<float> sums(TPosition::VECCALC, at, (ROW4) / 4u);
  at += (ROW4);
  LocalTensor<float> scratch(TPosition::VECCALC, at, (C * 2u) / 4u);
  at += (C * 2u);
  LocalTensor<float> scales(TPosition::VECCALC, at, (ROW4) / 4u);
  at += (ROW4);
  LocalTensor<OutT> out(TPosition::VECCALC, at, (ROW2) / 2u);
  at += (ROW2);
  LocalTensor<float> spaced(TPosition::VECCALC, at, (R * 32u) / 4u);
  at += (R * 32u);
  LocalTensor<int32_t> index(TPosition::VECCALC, at, (ROW4) / 4u);
  at += (ROW4);
  CreateVecIndex(index, int32_t(0), R);
  PipeBarrier<PIPE_V>();
  Muls(index, index, int32_t(32), R);
  PipeBarrier<PIPE_V>();
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<float> xsg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<OutT> yg;
  xg.SetGlobalBuffer((__gm__ int8_t*)x);
  wg.SetGlobalBuffer((__gm__ int8_t*)w);
  xsg.SetGlobalBuffer((__gm__ float*)xs);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  yg.SetGlobalBuffer((__gm__ OutT*)y);
  LocalTensor<int64_t> groupsUb(TPosition::VECCALC, 184672, 128);
  LocalTensor<ScaleT> weightScaleUb(TPosition::VECCALC, 185696, 128);
  GlobalTensor<ScaleT> weightScaleGm;
  weightScaleGm.SetGlobalBuffer((__gm__ ScaleT*)ws);
  DataCopyPad(groupsUb, gg, DataCopyExtParams{1, s.e * 8u, 0, 0, 0},
              DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
  DataCopyPad(weightScaleUb, weightScaleGm,
              DataCopyExtParams{1, s.e * uint32_t(sizeof(ScaleT)), 0, 0, 0},
              DataCopyPadExtParams<ScaleT>{false, 0, 0, 0});
  GvBarrier<HardEvent::MTE2_S>();
  uint32_t begin = uint64_t(s.m) * GetBlockIdx() / cores,
           finish = uint64_t(s.m) * (GetBlockIdx() + 1) / cores;
  uint32_t width = (s.k + 31) / 32 * 32, start = 0;
  const uint32_t pairs = width / 2u, realPairs = (s.k + 1u) / 2u;
  for (uint32_t e = 0; e < s.e; ++e) {
    uint32_t entry = groupsUb.GetValue(e),
             end = s.listType == 0 ? entry : start + entry;
    uint32_t first = begin > start ? begin : start, last = finish < end ? finish : end;
    if (first < last) {
      DataCopyPad(wl, wg[uint64_t(e) * s.k], DataCopyExtParams{1, s.k, 0, 0, 0},
                  DataCopyPadExtParams<int8_t>{true, 0, uint8_t(width - s.k), 0});
      GvBarrier<HardEvent::MTE2_V>();
      auto wp = wl.ReinterpretCast<int16_t>();
      ShiftLeft(weven, wp, int16_t(8), pairs);
      ShiftRight(wodd, wp, int16_t(8), pairs);
      PipeBarrier<PIPE_V>();
      ShiftRight(weven, weven, int16_t(8), pairs);
      GvBarrier<HardEvent::V_MTE2>();
      float weightScale;
      if constexpr (sizeof(ScaleT) == 4)
        weightScale = weightScaleUb.GetValue(e);
      else {
        union {
          uint32_t u;
          float f;
        } v;
        v.u = uint32_t(weightScaleUb.template ReinterpretCast<uint16_t>().GetValue(e))
              << 16;
        weightScale = v.f;
      }
      for (uint32_t m = first; m < last; m += R) {
        uint32_t nr = last - m < R ? last - m : R;
        DataCopyPad(xl, xg[uint64_t(m) * s.k],
                    DataCopyExtParams{uint16_t(nr), s.k, 0, 0, 0},
                    DataCopyPadExtParams<int8_t>{true, 0, uint8_t(width - s.k), 0});
        DataCopyPad(scales, xsg[m], DataCopyExtParams{1, nr * 4, 0, 0, 0},
                    DataCopyPadExtParams<float>{false, 0, 0, 0});
        GvBarrier<HardEvent::MTE2_V>();
        auto xp = xl.ReinterpretCast<int16_t>();
        ShiftLeft(even, xp, int16_t(8), nr * pairs);
        ShiftRight(odd, xp, int16_t(8), nr * pairs);
        PipeBarrier<PIPE_V>();
        ShiftRight(even, even, int16_t(8), nr * pairs);
        PipeBarrier<PIPE_V>();
        for (uint32_t col = 0; col < pairs; col += 128u) {
          const uint64_t mask = pairs - col < 128u ? pairs - col : 128u;
          const BinaryRepeatParams row{
              1, 1, 1, uint8_t(width / 32u), uint8_t(width / 32u), 0};
          Mul(even[col], even[col], weven[col], mask, uint8_t(nr), row);
          Mul(odd[col], odd[col], wodd[col], mask, uint8_t(nr), row);
        }
        PipeBarrier<PIPE_V>();
        Cast(f, even, RoundMode::CAST_NONE, nr * pairs);
        Cast(other, odd, RoundMode::CAST_NONE, nr * pairs);
        PipeBarrier<PIPE_V>();
        Add(f, f, other, nr * pairs);
        PipeBarrier<PIPE_V>();
        for (uint32_t col = 64u; col < realPairs; col += 64u) {
          BinaryRepeatParams ar{
              1, 1, 1, uint8_t(pairs / 8u), uint8_t(pairs / 8u), uint8_t(pairs / 8u)};
          Add(f, f, f[col], uint64_t(Min(64u, realPairs - col)), uint8_t(nr), ar);
          PipeBarrier<PIPE_V>();
        }
        WholeReduceSum(spaced, f, uint64_t(Min(64u, realPairs)), uint8_t(nr), 8, 1,
                       uint8_t(pairs / 8u));
        PipeBarrier<PIPE_V>();
        Gather(sums, spaced, index.ReinterpretCast<uint32_t>(), 0, nr);
        PipeBarrier<PIPE_V>();
        Muls(sums, sums, weightScale, nr);
        PipeBarrier<PIPE_V>();
        Mul(sums, sums, scales, nr);
        PipeBarrier<PIPE_V>();
        Cast(out, sums, RoundMode::CAST_RINT, nr);
        GvBarrier<HardEvent::V_MTE3>();
        DataCopyPad(yg[m], out, DataCopyExtParams{1, nr * 2, 0, 0, 0});
        GvBarrier<HardEvent::MTE3_V>();
        GvBarrier<HardEvent::V_MTE2>();
      }
    }
    start = end;
  }
}
}
namespace narrow_n1 {
using namespace gmmptq;
using namespace AscendC;
template <uint32_t R, uint32_t BK, bool Native = false, bool Acknowledge = false,
          bool ScalarWScale = false, bool Combine = false>
__global__ __aicore__ void Kernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                  GM_ADDR gl, GM_ADDR y, GM_ADDR st, uint64_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
  Plan p{};
  p.m = (dims & 65535u) + 1u;
  p.k = ((dims >> 16) & 1023u) + 1u;
  p.e = ((dims >> 26) & 127u) + 1u;
  p.cores = ((dims >> 33) & 31u) + 1u;
  p.listType = (dims >> 38) & 1u;
  InitSocState();
  constexpr uint32_t BN = R;
  GlobalTensor<int64_t> gg;
  gg.SetGlobalBuffer((__gm__ int64_t*)gl);
  GlobalTensor<int8_t> xg, wg;
  xg.SetGlobalBuffer((__gm__ int8_t*)x);
  wg.SetGlobalBuffer((__gm__ int8_t*)w);
  GlobalTensor<int32_t> sg;
  sg.SetGlobalBuffer((__gm__ int32_t*)st);
  const uint32_t core = GetBlockIdx();
  uint32_t start = 0, ordinal = 0, issued = 0;
  if ASCEND_IS_AIC {
    LocalTensor<int8_t> a1(TPosition::A1, 0, 16 * 1024),
        b1(TPosition::A1, 16 * 1024, BN * 1024);
    LocalTensor<int8_t> a2(TPosition::A2, 0, 16 * BK), b2(TPosition::B2, 0, BN * BK);
    LocalTensor<int32_t> c(TPosition::CO1, 0, 16 * BN);
    for (uint32_t e = 0; e < p.e; ++e) {
      uint32_t v = gg.GetValue(e), end = p.listType ? start + v : v, rows = end - start,
               tiles = (rows + R - 1) / R;
      for (uint32_t t = (core + p.cores - ordinal % p.cores) % p.cores; t < tiles;
           t += p.cores) {
        const uint32_t row = start + t * R, nr = Min(R, end - row), task = ordinal + t;
        if constexpr (Acknowledge) {
          if (issued >= 4) CrossCoreWaitFlag(uint16_t(4 + (issued & 3)));
        }
        Nd2NzParams ap{};
        ap.ndNum = 1;
        ap.nValue = 1;
        ap.dValue = p.k;
        ap.srcDValue = p.k;
        ap.dstNzC0Stride = Native ? 1 : 16;
        ap.dstNzNStride = 1;
        Nd2NzParams bp = ap;
        bp.nValue = nr;
        bp.dstNzC0Stride = BN;
        DataCopy(a1, wg[uint64_t(e) * p.k], ap);
        DataCopy(b1, xg[uint64_t(row) * p.k], bp);
        Barrier<HardEvent::MTE2_MTE1>();
        for (uint32_t ks = 0; ks < p.k; ks += BK) {
          uint32_t step = Min(BK, p.k - ks), kf = Up(step, 32u) / 32u;
          LoadData2DParams la{};
          la.repeatTimes = 1;
          la.srcStride = 1;
          la.dstGap = kf - 1;
          la.ifTranspose = false;
          if constexpr (Native) {
            la.dstGap = 0;
            la.repeatTimes = 2;
            LoadData(a2, a1, la);
          } else {
            for (uint32_t j = 0; j < kf; ++j)
              LoadData(a2[j * 512], a1[ks * 16 + j * 16 * 32], la);
          }
          LoadData2DParams lb{};
          lb.repeatTimes = Up(nr, 32u) / 16u;
          lb.srcStride = 1;
          lb.dstGap = 0;
          lb.ifTranspose = false;
          for (uint32_t j = 0; j < kf; ++j)
            LoadData(b2[j * Up(nr, 32u) * 32], b1[ks * BN + j * BN * 32], lb);
          Barrier<HardEvent::MTE1_M>();
          if (ks == 0) Barrier<HardEvent::FIX_M>();
          MmadParams mp{};
          mp.m = Native ? 1 : 16;
          mp.n = Up(nr, 32u);
          mp.k = step;
          mp.cmatrixInitVal = ks == 0;
          Mmad(c, a2, b2, mp);
          PipeBarrier<PIPE_M>();
          Barrier<HardEvent::M_MTE1>();
        }
        Barrier<HardEvent::MTE1_MTE2>();
        Barrier<HardEvent::M_FIX>();
        FixpipeParamsV220 fp{};
        fp.nSize = nr;
        fp.mSize = 1;
        fp.srcStride = 16;
        fp.dstStride = R;
        fp.quantPre = QuantMode_t::NoQuant;
        fp.reluEn = false;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(sg[uint64_t(task) * R], c, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(uint16_t(issued & 3));
        ++issued;
      }
      ordinal += tiles;
      start = end;
    }
    if constexpr (Acknowledge) {
      for (uint32_t q = issued > 4 ? issued - 4 : 0; q < issued; ++q)
        CrossCoreWaitFlag(uint16_t(4 + (q & 3)));
    }
  } else {
    LocalTensor<int32_t> acc(TPosition::VECCALC, 0, R);
    LocalTensor<float> f(TPosition::VECCALC, R * 4, R),
        scale(TPosition::VECCALC, R * 8, R);
    LocalTensor<bfloat16_t> wscale(TPosition::VECCALC, R * 12, 16),
        out(TPosition::VECCALC, R * 12 + 32, R);
    LocalTensor<float> wsf(TPosition::VECCALC, R * 14 + 32, 8);
    GlobalTensor<uint16_t> wsbits;
    if constexpr (ScalarWScale) {
      wsbits.SetGlobalBuffer((__gm__ uint16_t*)ws);
      GlobalTensor<uint64_t> pre;
      pre.SetGlobalBuffer((__gm__ uint64_t*)ws);
      DataCachePreload(pre, int16_t(0));
    }
    GlobalTensor<float> xsg;
    xsg.SetGlobalBuffer((__gm__ float*)xs);
    GlobalTensor<bfloat16_t> wsg, yg;
    wsg.SetGlobalBuffer((__gm__ bfloat16_t*)ws);
    yg.SetGlobalBuffer((__gm__ bfloat16_t*)y);
    for (uint32_t e = 0; e < p.e; ++e) {
      uint32_t v = gg.GetValue(e), end = p.listType ? start + v : v, rows = end - start,
               tiles = (rows + R - 1) / R;
      for (uint32_t t = (core + p.cores - ordinal % p.cores) % p.cores; t < tiles;
           t += p.cores) {
        const uint32_t row = start + t * R, nr = Min(R, end - row), task = ordinal + t;
        DataCopyPad(scale, xsg[row], DataCopyExtParams{1, nr * 4, 0, 0, 0},
                    DataCopyPadExtParams<float>{false, 0, 0, 0});
        float weightScale = 0.0f;
        if constexpr (ScalarWScale) {
          weightScale = GvFloat(uint32_t(wsbits.GetValue(e)) << 16);
          if constexpr (Combine) {
            Barrier<HardEvent::MTE2_V>();
            Muls(scale, scale, weightScale, nr);
            PipeBarrier<PIPE_V>();
          }
        } else {
          DataCopyPad(wscale, wsg[e], DataCopyExtParams{1, 2, 0, 0, 0},
                      DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
        }
        CrossCoreWaitFlag(uint16_t(issued & 3));
        DataCopyPad(acc, sg[uint64_t(task) * R], DataCopyExtParams{1, nr * 4, 0, 0, 0},
                    DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
        Barrier<HardEvent::MTE2_V>();
        Cast(f, acc, RoundMode::CAST_RINT, nr);
        if constexpr (ScalarWScale) {
          PipeBarrier<PIPE_V>();
        } else {
          Cast(wsf, wscale, RoundMode::CAST_NONE, 1);
          Barrier<HardEvent::V_S>();
          weightScale = wsf.GetValue(0);
          Barrier<HardEvent::S_V>();
        }
        if constexpr (!Combine) {
          Muls(f, f, weightScale, nr);
          PipeBarrier<PIPE_V>();
        }
        Mul(f, f, scale, nr);
        PipeBarrier<PIPE_V>();
        Cast(out, f, RoundMode::CAST_RINT, nr);
        Barrier<HardEvent::V_MTE3>();
        DataCopyPad(yg[row], out, DataCopyExtParams{1, nr * 2, 0, 0, 0});
        Barrier<HardEvent::MTE3_V>();
        Barrier<HardEvent::V_MTE2>();
        if constexpr (Acknowledge)
          CrossCoreSetFlag<2, PIPE_MTE3>(uint16_t(4 + (issued & 3)));
        ++issued;
      }
      ordinal += tiles;
      start = end;
    }
    Barrier<HardEvent::MTE3_S>();
  }
  PipeBarrier<PIPE_ALL>();
}
template <uint32_t R, uint32_t BK, bool Native = false, bool Acknowledge = false,
          bool ScalarWScale = false, bool Combine = false>
void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl, GM_ADDR y, Plan p,
            aclrtStream stream) {
  Scratch st(uint64_t((p.m + R - 1) / R + p.e) * R * 4);
  const uint64_t dims = uint64_t(p.m - 1) | (uint64_t(p.k - 1) << 16) |
                        (uint64_t(p.e - 1) << 26) | (uint64_t(p.cores - 1) << 33) |
                        (uint64_t(p.listType) << 38);
  LaunchAndSync(stream, [&] {
    Kernel<R, BK, Native, Acknowledge, ScalarWScale, Combine>
        <<<p.cores, nullptr, stream>>>(x, w, xs, ws, gl, y, (GM_ADDR)st.p, dims);
  });
}
}
namespace longdot_capacity {
using namespace AscendC;
struct Pointers {
  uint64_t x, w, xs, ws, y;
};
static_assert(sizeof(Pointers) == 40, "five pointer launch ABI");
template <HardEvent E>
__aicore__ inline void Fence() {
  SetFlag<E>(0);
  WaitFlag<E>(0);
}
__aicore__ inline float FloatBits(uint32_t bits) {
  union {
    uint32_t u;
    float f;
  } v;
  v.u = bits;
  return v.f;
}
template <uint32_t Capacity, bool Merged, uint32_t ScalePath, bool WFirst,
          bool Balanced, bool BF, bool ScalarOutput = false,
          bool ZipInputStages = false>
class Dot {
  static_assert(!Merged && !Balanced,
                "one channel per core; exact original integer reduction");
  static_assert(Capacity == 1024u || Capacity == 2048u || Capacity == 4096u ||
                    Capacity == 8192u,
                "power-of-two reduction capacity");
  static constexpr uint32_t CH = Merged ? 2u : 1u;
  static constexpr uint32_t BYTES =
      13u * Capacity + (CH - 1u) * 6u * Capacity + CH * 544u + 160u;
  static_assert(BYTES <= 188160u, "UB overflow");
  using Scale = typename std::conditional<BF, bfloat16_t, float>::type;
  using Out = typename std::conditional<BF, bfloat16_t, half>::type;
 public:
  __aicore__ inline void Run(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR y,
                             uint32_t k) {
    k_ = k;
    InitSocState();
    LocalTensor<uint8_t> raw(TPosition::VECCALC, 0, BYTES);
    uint32_t at = 0;
    xi_ = raw[at].template ReinterpretCast<int8_t>();
    at += Capacity;
    wi_ = raw[at].template ReinterpretCast<int8_t>();
    at += (2u * Capacity);
    xh_ = raw[at].template ReinterpretCast<half>();
    at += (2u * Capacity);
    x16_ = raw[at].template ReinterpretCast<int16_t>();
    at += (2u * Capacity);
    w16_ = raw[at].template ReinterpretCast<int16_t>();
    at += CH * (2u * Capacity);
    wf_ = raw[at].template ReinterpretCast<float>();
    at += CH * (4u * Capacity);
    red1_ = raw[at].template ReinterpretCast<float>();
    at += CH * 512;
    red2_ = raw[at].template ReinterpretCast<float>();
    at += CH * 32;
    xsUb_ = raw[at].template ReinterpretCast<float>();
    at += 32;
    wsUb_ = raw[at].template ReinterpretCast<Scale>();
    at += 32;
    result_ = raw[at].template ReinterpretCast<float>();
    at += 64;
    out_ = raw[at].template ReinterpretCast<Out>();
    xg_.SetGlobalBuffer((__gm__ int8_t*)x);
    wg_.SetGlobalBuffer((__gm__ int8_t*)w);
    xsg_.SetGlobalBuffer((__gm__ float*)xs);
    wsg_.SetGlobalBuffer((__gm__ Scale*)ws);
    wsBits_.SetGlobalBuffer((__gm__ uint16_t*)ws);
    yg_.SetGlobalBuffer((__gm__ Out*)y);
    channel_ = Merged ? 0u : GetBlockIdx();
    if (channel_ >= 2u) {
      PipeBarrier<PIPE_ALL>();
      return;
    }
    if constexpr (ScalePath == 0u || ScalePath == 2u) PrepareScales(xs, ws);
    if (k_ < Capacity) {
      Duplicate(xi_.template ReinterpretCast<int16_t>(), int16_t(0), Capacity / 2u);
      Duplicate(wi_.template ReinterpretCast<int16_t>(), int16_t(0), Capacity);
      Fence<HardEvent::V_MTE2>();
    }
    if constexpr (WFirst) {
      LoadW();
      LoadX();
    } else {
      LoadX();
      LoadW();
    }
    if constexpr (ScalePath == 1u || ScalePath == 3u) PrepareScales(xs, ws);
    Fence<HardEvent::MTE2_V>();
    if constexpr (ZipInputStages) {
      auto packed = wi_.template ReinterpretCast<int16_t>();
      Cast(xh_, xi_, RoundMode::CAST_NONE, Capacity);
      if (channel_ == 0u)
        ShiftLeft(w16_, packed, int16_t(8), Capacity);
      else
        ShiftRight(w16_, packed, int16_t(8), Capacity);
      PipeBarrier<PIPE_V>();
      Cast(x16_, xh_, RoundMode::CAST_RINT, Capacity);
      if (channel_ == 0u)
        ShiftRight(w16_, w16_, int16_t(8), Capacity);
      PipeBarrier<PIPE_V>();
    } else {
    Cast(xh_, xi_, RoundMode::CAST_NONE, Capacity);
    PipeBarrier<PIPE_V>();
    Cast(x16_, xh_, RoundMode::CAST_RINT, Capacity);
    PipeBarrier<PIPE_V>();
    auto packed = wi_.template ReinterpretCast<int16_t>();
    if constexpr (Merged) {
      ShiftLeft(w16_, packed, int16_t(8), Capacity);
      ShiftRight(w16_[Capacity], packed, int16_t(8), Capacity);
      PipeBarrier<PIPE_V>();
      ShiftRight(w16_, w16_, int16_t(8), Capacity);
    } else {
      if (channel_ == 0u) {
        ShiftLeft(w16_, packed, int16_t(8), Capacity);
        PipeBarrier<PIPE_V>();
        ShiftRight(w16_, w16_, int16_t(8), Capacity);
      } else
        ShiftRight(w16_, packed, int16_t(8), Capacity);
    }
    PipeBarrier<PIPE_V>();
    }
    Mul(w16_, w16_, x16_, Capacity);
    if constexpr (Merged) Mul(w16_[Capacity], w16_[Capacity], x16_, Capacity);
    PipeBarrier<PIPE_V>();
    auto packedProducts = w16_.template ReinterpretCast<int32_t>();
    auto integerSums = wf_.template ReinterpretCast<int32_t>();
    auto highProducts = integerSums[Capacity / 2u];
    ShiftLeft(integerSums, packedProducts, int32_t(16), Capacity / 2u);
    PipeBarrier<PIPE_V>();
    ShiftRight(integerSums, integerSums, int32_t(16), Capacity / 2u);
    ShiftRight(highProducts, packedProducts, int32_t(16), Capacity / 2u);
    PipeBarrier<PIPE_V>();
    Add(integerSums, integerSums, highProducts, Capacity / 2u);
    PipeBarrier<PIPE_V>();
    if constexpr (Capacity == 8192u) {
      if constexpr (Capacity / 4u >= 2048u && 2048u >= 512u) {
        Add(integerSums, integerSums, integerSums[2048u], 2048u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 1024u && 1024u >= 512u) {
        Add(integerSums, integerSums, integerSums[1024u], 1024u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 512u && 512u >= 512u) {
        Add(integerSums, integerSums, integerSums[512u], 512u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 256u && 256u >= 512u) {
        Add(integerSums, integerSums, integerSums[256u], 256u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 128u && 128u >= 512u) {
        Add(integerSums, integerSums, integerSums[128u], 128u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 64u && 64u >= 512u) {
        Add(integerSums, integerSums, integerSums[64u], 64u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 32u && 32u >= 512u) {
        Add(integerSums, integerSums, integerSums[32u], 32u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 16u && 16u >= 512u) {
        Add(integerSums, integerSums, integerSums[16u], 16u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 8u && 8u >= 512u) {
        Add(integerSums, integerSums, integerSums[8u], 8u);
        PipeBarrier<PIPE_V>();
      }
      Cast(wf_, integerSums, RoundMode::CAST_RINT, 512u);
      PipeBarrier<PIPE_V>();
      WholeReduceSum(red2_, wf_, uint64_t(512u / 8u), uint8_t(8), 1, 1,
                     uint8_t(512u / 64u));
      PipeBarrier<PIPE_V>();
      if constexpr (!true) {
        Cast(integerSums, red2_, RoundMode::CAST_RINT, 8);
        PipeBarrier<PIPE_V>();
      }
    } else {
      if constexpr (Capacity / 4u >= 2048u) {
        Add(integerSums, integerSums, integerSums[2048u], 2048u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 1024u) {
        Add(integerSums, integerSums, integerSums[1024u], 1024u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 512u) {
        Add(integerSums, integerSums, integerSums[512u], 512u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 256u) {
        Add(integerSums, integerSums, integerSums[256u], 256u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 128u) {
        Add(integerSums, integerSums, integerSums[128u], 128u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 64u) {
        Add(integerSums, integerSums, integerSums[64u], 64u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 32u) {
        Add(integerSums, integerSums, integerSums[32u], 32u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 16u) {
        Add(integerSums, integerSums, integerSums[16u], 16u);
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Capacity / 4u >= 8u) {
        Add(integerSums, integerSums, integerSums[8u], 8u);
        PipeBarrier<PIPE_V>();
      }
    }
    Fence<HardEvent::V_S>();
    if constexpr (ScalePath >= 2u) Fence<HardEvent::MTE2_S>();
    const float xsValue = ScalePath >= 2u ? xsUb_.GetValue(0) : xsg_.GetValue(0);
    const int32_t sum0 = Sum<0>();
    const float ws0 = WeightScale(channel_);
    const float weighted0 = float(sum0) * ws0;
    if constexpr (ScalarOutput) {
      const uint16_t encoded0 = gmmptq::GvEncode<BF>(weighted0 * xsValue);
      WriteGmByPassDCache(reinterpret_cast<__gm__ uint16_t*>(y) + channel_, encoded0);
      if constexpr (Merged) {
        const int32_t sum1 = Sum<8>();
        const float weighted1 = float(sum1) * WeightScale(1);
        const uint16_t encoded1 = gmmptq::GvEncode<BF>(weighted1 * xsValue);
        WriteGmByPassDCache(reinterpret_cast<__gm__ uint16_t*>(y) + 1u, encoded1);
      }
      DataSyncBarrier<MemDsbT::DDR>();
    } else {
      result_.SetValue(0, weighted0 * xsValue);
      if constexpr (Merged) {
        const int32_t sum1 = Sum<8>();
        const float weighted1 = float(sum1) * WeightScale(1);
        result_.SetValue(1, weighted1 * xsValue);
      }
      Fence<HardEvent::S_V>();
      Cast(out_, result_, RoundMode::CAST_RINT, 16);
      Fence<HardEvent::V_MTE3>();
      DataCopyPad(yg_[channel_], out_, DataCopyExtParams{1, CH * 2u, 0, 0, 0});
    }
    PipeBarrier<PIPE_ALL>();
  }
 private:
  __aicore__ inline void LoadX() {
    DataCopyPad(
        xi_, xg_, DataCopyExtParams{1, k_, 0, 0, 0},
        DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32u - k_ % 32u) % 32u), 0});
  }
  __aicore__ inline void LoadW() {
    DataCopyPad(wi_, wg_, DataCopyExtParams{1, 2u * k_, 0, 0, 0},
                DataCopyPadExtParams<int8_t>{
                    true, 0, uint8_t((32u - (2u * k_) % 32u) % 32u), 0});
  }
  __aicore__ inline void PrepareScales(GM_ADDR xs, GM_ADDR ws) {
    if constexpr (ScalePath < 2u) {
      DataCacheCleanAndInvalid<float, CacheLine::SINGLE_CACHE_LINE,
                               DcciDst::CACHELINE_OUT>(xsg_);
      auto selected = wsg_[channel_];
      DataCacheCleanAndInvalid<Scale, CacheLine::SINGLE_CACHE_LINE,
                               DcciDst::CACHELINE_OUT>(selected);
      const bool crosses = (uint64_t(ws) & 63u) + 2u * sizeof(Scale) > 64u;
      if constexpr (Merged)
        if (crosses) {
          auto tail = wsg_[1];
          DataCacheCleanAndInvalid<Scale, CacheLine::SINGLE_CACHE_LINE,
                                   DcciDst::CACHELINE_OUT>(tail);
        }
      GlobalTensor<uint64_t> prefetch;
      prefetch.SetGlobalBuffer((__gm__ uint64_t*)xs);
      DataCachePreload(prefetch, int16_t(0));
      prefetch.SetGlobalBuffer((__gm__ uint64_t*)(ws + channel_ * sizeof(Scale)));
      DataCachePreload(prefetch, int16_t(0));
      if constexpr (Merged)
        if (crosses) {
          prefetch.SetGlobalBuffer((__gm__ uint64_t*)(ws + sizeof(Scale)));
          DataCachePreload(prefetch, int16_t(0));
        }
    } else {
      DataCopyPad(xsUb_, xsg_, DataCopyExtParams{1, 4, 0, 0, 0},
                  DataCopyPadExtParams<float>{false, 0, 0, 0});
      DataCopyPad(wsUb_, wsg_, DataCopyExtParams{1, 2u * sizeof(Scale), 0, 0, 0},
                  DataCopyPadExtParams<Scale>{false, 0, 0, 0});
    }
  }
  __aicore__ inline float WeightScale(uint32_t channel) {
    if constexpr (BF) {
      const uint32_t bits =
          ScalePath >= 2u ? wsUb_.template ReinterpretCast<uint16_t>().GetValue(channel)
                          : wsBits_.GetValue(channel);
      return FloatBits(bits << 16);
    } else
      return ScalePath >= 2u ? wsUb_.GetValue(channel) : wsg_.GetValue(channel);
  }
  template <uint32_t Base>
  __aicore__ inline int32_t Sum() {
    static_assert(Base == 0u, "one channel per core");
    auto values = wf_.template ReinterpretCast<int32_t>();
    int32_t total = 0;
    for (uint32_t i = 0; i < 8u; ++i)
      total += Capacity == 8192u ? int32_t(red2_.GetValue(i)) : values.GetValue(i);
    return total;
  }
  uint32_t channel_, k_;
  GlobalTensor<int8_t> xg_, wg_;
  GlobalTensor<float> xsg_;
  GlobalTensor<Scale> wsg_;
  GlobalTensor<uint16_t> wsBits_;
  GlobalTensor<Out> yg_;
  LocalTensor<int8_t> xi_, wi_;
  LocalTensor<half> xh_;
  LocalTensor<int16_t> x16_, w16_;
  LocalTensor<float> wf_, red1_, red2_, xsUb_, result_;
  LocalTensor<Scale> wsUb_;
  LocalTensor<Out> out_;
};
}
template <uint32_t Capacity, bool BF, bool ScalarOutput>
__global__ __aicore__ void SearchLongDotCapacityBFCacheActual(GM_ADDR x, GM_ADDR w,
                                                              GM_ADDR xs, GM_ADDR ws,
                                                              GM_ADDR y, uint32_t k) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  longdot_capacity::Dot<Capacity, false, 1u, !BF, false, BF, ScalarOutput, true> op;
  op.Run(x, w, xs, ws, y, k);
}
template <uint32_t Capacity, bool ScalarOutput>
__global__ __aicore__ void SearchLongDotCapacityDMAScales(GM_ADDR x, GM_ADDR w,
                                                          GM_ADDR xs, GM_ADDR ws,
                                                          GM_ADDR y, uint32_t k) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  longdot_capacity::Dot<Capacity, false, 3u, true, false, false, ScalarOutput, true> op;
  op.Run(x, w, xs, ws, y, k);
}
namespace longdot_capacity {
template <uint32_t Capacity, bool BF>
inline void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR y, uint32_t k,
                   bool scalar, aclrtStream stream) {
  if constexpr (!BF) {
    if (((reinterpret_cast<uintptr_t>(xs) | reinterpret_cast<uintptr_t>(ws)) & 3u) !=
        0u) {
      if (scalar)
        SearchLongDotCapacityDMAScales<Capacity, true>
            <<<2, nullptr, stream>>>(x, w, xs, ws, y, k);
      else
        SearchLongDotCapacityDMAScales<Capacity, false>
            <<<2, nullptr, stream>>>(x, w, xs, ws, y, k);
      return;
    }
  }
  if (scalar)
    SearchLongDotCapacityBFCacheActual<Capacity, BF, true>
        <<<2, nullptr, stream>>>(x, w, xs, ws, y, k);
  else
    SearchLongDotCapacityBFCacheActual<Capacity, BF, false>
        <<<2, nullptr, stream>>>(x, w, xs, ws, y, k);
}
}
namespace longdot_capacity {
template <bool BF>
inline void LaunchForK(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR y,
                       uint32_t k, bool scalar, aclrtStream stream) {
  if (k <= 1024u)
    Launch<1024u, BF>(x, w, xs, ws, y, k, scalar, stream);
  else if (k <= 2048u)
    Launch<2048u, BF>(x, w, xs, ws, y, k, scalar, stream);
  else if (k <= 4096u)
    Launch<4096u, BF>(x, w, xs, ws, y, k, scalar, stream);
  else
    Launch<8192u, BF>(x, w, xs, ws, y, k, scalar, stream);
}
}
namespace gmmptq {
template <typename ScaleT, typename OutT, bool SingleExpert, bool Direct>
__global__ __aicore__ void TinyRowKernel(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                         GM_ADDR groups, GM_ADDR y, uint32_t packed) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const GeneralVectorDims s = UnpackTinyDims(packed);
  using namespace AscendC;
  PreloadOperands<!SingleExpert>(x, w, xs, ws, groups);
  const uint32_t m = GetBlockIdx();
  uint32_t owner = 0;
  if constexpr (!SingleExpert) {
    GlobalTensor<int64_t> gg;
    gg.SetGlobalBuffer((__gm__ int64_t*)groups);
    owner = OwnerOfRow(gg, s.e, s.listType, m);
  }
  TinyOperands<ScaleT, OutT> t;
  t.Bind(x, w, xs, ws, groups, y);
  if constexpr (!Direct) InitSocState();
  LocalTensor<float> f(TPosition::VECCALC, 0, 32);
  LocalTensor<OutT> out(TPosition::VECCALC, 128, 32);
  uint32_t encodedRow = 0;
  const float row = t.xsg.GetValue(m);
  for (uint32_t n = 0; n < s.n; ++n) {
    const int32_t sum = TinyDot(t.xg, t.wg, m, owner, n, s.k, s.n);
    const float scale = WeightScaleAt<ScaleT>(ws, uint64_t(owner) * s.n + n);
    const float value = float(sum) * scale * row;
    if constexpr (Direct)
      encodedRow |= uint32_t(GvEncode<sizeof(ScaleT) == 2>(value)) << (16 * n);
    else
      f.SetValue(n, value);
  }
  if constexpr (Direct) {
    if (s.n == 1)
      WriteGmByPassDCache(reinterpret_cast<__gm__ uint16_t*>(y) + m,
                          uint16_t(encodedRow));
    else
      WriteGmByPassDCache(reinterpret_cast<__gm__ uint32_t*>(y) + m, encodedRow);
    DataSyncBarrier<MemDsbT::DDR>();
  } else {
    GvBarrier<HardEvent::S_V>();
    Cast(out, f, RoundMode::CAST_RINT, s.n);
    GvBarrier<HardEvent::V_MTE3>();
    DataCopyPad(t.yg[uint64_t(m) * s.n], out,
                DataCopyExtParams{1, s.n * sizeof(OutT), 0, 0, 0});
    PipeBarrier<PIPE_ALL>();
  }
}
template <typename ScaleT, typename OutT>
__global__ __aicore__ void TinyRowStrided(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                          GM_ADDR groups, GM_ADDR y, uint32_t packed) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const GeneralVectorDims s = UnpackTinyDims(packed);
  using namespace AscendC;
  PreloadOperands<true>(x, w, xs, ws, groups);
  InitSocState();
  const uint32_t first = GetBlockIdx(), blocks = GetBlockNum();
  for (uint32_t m = first, slot = 0; m < s.m; m += blocks, ++slot) {
    GlobalTensor<int64_t> gg;
    gg.SetGlobalBuffer((__gm__ int64_t*)groups);
    const uint32_t owner = OwnerOfRow(gg, s.e, s.listType, m);
    TinyOperands<ScaleT, OutT> t;
    t.Bind(x, w, xs, ws, groups, y);
    LocalTensor<float> f(TPosition::VECCALC, slot * 192, 32);
    LocalTensor<OutT> out(TPosition::VECCALC, slot * 192 + 128, 32);
    const float row = t.xsg.GetValue(m);
    for (uint32_t n = 0; n < s.n; ++n) {
      const int32_t sum = TinyDot(t.xg, t.wg, m, owner, n, s.k, s.n);
      const float scale = WeightScaleAt<ScaleT>(ws, uint64_t(owner) * s.n + n);
      f.SetValue(n, float(sum) * scale * row);
    }
    SetFlag<HardEvent::S_V>(static_cast<event_t>(slot));
    WaitFlag<HardEvent::S_V>(static_cast<event_t>(slot));
    Cast(out, f, RoundMode::CAST_RINT, s.n);
    SetFlag<HardEvent::V_MTE3>(static_cast<event_t>(slot));
    WaitFlag<HardEvent::V_MTE3>(static_cast<event_t>(slot));
    DataCopyPad(t.yg[uint64_t(m) * s.n], out,
                DataCopyExtParams{1, s.n * sizeof(OutT), 0, 0, 0});
  }
  PipeBarrier<PIPE_ALL>();
}
template <typename ScaleT, typename OutT>
__global__ __aicore__ void TinyRowBisectDirect(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                               GM_ADDR ws, GM_ADDR groups, GM_ADDR y,
                                               uint32_t packed) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  GeneralVectorDims s = UnpackTinyDims(packed);
  s.n = 1u;
  using namespace AscendC;
  PreloadOperands<true>(x, w, xs, ws, groups);
  const uint32_t m = GetBlockIdx();
  uint32_t owner = 0, start = 0;
  GlobalTensor<float> earlyXs;
  earlyXs.SetGlobalBuffer((__gm__ float*)xs);
  const float row = earlyXs.GetValue(m);
  GlobalTensor<int64_t> gg;
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  if (m * 2u >= s.m) {
    uint32_t end = s.m;
    owner = 0u;
    for (uint32_t e = s.e - 1u; e > 0u; --e) {
      const uint32_t begin = s.listType == 0 ? uint32_t(gg.GetValue(e - 1u))
                                             : end - uint32_t(gg.GetValue(e));
      if (m >= begin) {
        owner = e;
        break;
      }
      end = begin;
    }
  } else {
    owner = s.e - 1u;
    for (uint32_t e = 0; e + 1u < s.e; ++e) {
      const uint32_t v = uint32_t(gg.GetValue(e));
      const uint32_t end = s.listType == 0 ? v : start + v;
      if (m < end) {
        owner = e;
        break;
      }
      start = end;
    }
  }
  TinyOperands<ScaleT, OutT> t;
  t.Bind(x, w, xs, ws, groups, y);
  uint32_t encodedRow = 0;
  for (uint32_t n = 0; n < s.n; ++n) {
    const float scale = WeightScaleAt<ScaleT>(ws, uint64_t(owner) * s.n + n);
    const int32_t sum = TinyDot(t.xg, t.wg, m, owner, n, s.k, s.n);
    encodedRow |= uint32_t(GvEncode<sizeof(ScaleT) == 2>(float(sum) * scale * row))
                  << (16 * n);
  }
  if (s.n == 1)
    WriteGmByPassDCache(reinterpret_cast<__gm__ uint16_t*>(y) + m,
                        uint16_t(encodedRow));
  else
    WriteGmByPassDCache(reinterpret_cast<__gm__ uint32_t*>(y) + m, encodedRow);
  DataSyncBarrier<MemDsbT::DDR>();
}
}
namespace gmmptq {
template <typename ScaleT, typename OutT>
__global__ __aicore__ void TinyExpertRows(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                          GM_ADDR groups, GM_ADDR y, uint32_t packed) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const GeneralVectorDims s = UnpackTinyDims(packed);
  using namespace AscendC;
  PreloadOperands<true>(x, w, xs, ws, groups);
  const uint32_t owner = GetBlockIdx();
  GlobalTensor<int64_t> gg;
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  const uint32_t begin = owner ? uint32_t(gg.GetValue(owner - 1)) : 0u;
  const uint32_t end = owner + 1 < s.e ? uint32_t(gg.GetValue(owner)) : s.m;
  if (begin == end) return;
  TinyOperands<ScaleT, OutT> t;
  t.Bind(x, w, xs, ws, groups, y);
  InitSocState();
  LocalTensor<float> f(TPosition::VECCALC, 0, 32);
  LocalTensor<OutT> out(TPosition::VECCALC, 128, 32);
  for (uint32_t m = begin; m < end; ++m) {
    const float row = t.xsg.GetValue(m);
    for (uint32_t n = 0; n < s.n; ++n) {
      const int32_t sum = TinyDot(t.xg, t.wg, m, owner, n, s.k, s.n);
      const float scale = WeightScaleAt<ScaleT>(ws, uint64_t(owner) * s.n + n);
      f.SetValue((m - begin) * s.n + n, float(sum) * scale * row);
    }
  }
  const uint32_t count = (end - begin) * s.n;
  GvBarrier<HardEvent::S_V>();
  Cast(out, f, RoundMode::CAST_RINT, count);
  GvBarrier<HardEvent::V_MTE3>();
  DataCopyPad(t.yg[uint64_t(begin) * s.n], out,
              DataCopyExtParams{1, count * sizeof(OutT), 0, 0, 0});
  PipeBarrier<PIPE_ALL>();
}
template <typename ScaleT, typename OutT, bool Direct>
__global__ __aicore__ void TinyExpert2x2(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws,
                                         GM_ADDR groups, GM_ADDR y, uint32_t packed) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const GeneralVectorDims s = UnpackTinyDims(packed);
  using namespace AscendC;
  PreloadOperands<true>(x, w, xs, ws, groups);
  const uint32_t owner = GetBlockIdx();
  GlobalTensor<int64_t> gg;
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  const uint32_t begin = owner ? uint32_t(gg.GetValue(owner - 1)) : 0u;
  const uint32_t end = owner + 1 < s.e ? uint32_t(gg.GetValue(owner)) : s.m;
  if (begin == end) return;
  TinyOperands<ScaleT, OutT> t;
  t.Bind(x, w, xs, ws, groups, y);
  if constexpr (!Direct) InitSocState();
  LocalTensor<float> f(TPosition::VECCALC, 0, 32);
  LocalTensor<OutT> out(TPosition::VECCALC, 128, 32);
  const uint64_t wb = uint64_t(owner) * 4u;
  const int32_t w00 = int32_t(t.wg.GetValue(wb)), w01 = int32_t(t.wg.GetValue(wb + 1u));
  const int32_t w10 = int32_t(t.wg.GetValue(wb + 2u)),
                w11 = int32_t(t.wg.GetValue(wb + 3u));
  const float scale0 = WeightScaleAt<ScaleT>(ws, uint64_t(owner) * 2u);
  const float scale1 = WeightScaleAt<ScaleT>(ws, uint64_t(owner) * 2u + 1u);
  uint64_t word0 = 0, word1 = 0;
  for (uint32_t m = begin; m < end; ++m) {
    const float row = t.xsg.GetValue(m);
    const int32_t x0 = int32_t(t.xg.GetValue(uint64_t(m) * 2u));
    const int32_t x1 = int32_t(t.xg.GetValue(uint64_t(m) * 2u + 1u));
    const int32_t sum0 = x0 * w00 + x1 * w10, sum1 = x0 * w01 + x1 * w11;
    if constexpr (Direct) {
      const uint32_t encoded =
          uint32_t(GvEncode<sizeof(ScaleT) == 2>(float(sum0) * scale0 * row)) |
          (uint32_t(GvEncode<sizeof(ScaleT) == 2>(float(sum1) * scale1 * row)) << 16u);
      const uint32_t index = m - begin;
      if (index < 2u)
        word0 |= uint64_t(encoded) << (index * 32u);
      else
        word1 |= uint64_t(encoded) << ((index - 2u) * 32u);
    } else {
      f.SetValue((m - begin) * s.n, float(sum0) * scale0 * row);
      f.SetValue((m - begin) * s.n + 1u, float(sum1) * scale1 * row);
    }
  }
  const uint32_t rows = end - begin;
  if constexpr (Direct) {
    auto* dst = reinterpret_cast<__gm__ uint32_t*>(y) + begin;
    if (begin & 1u) {
      WriteGmByPassDCache(dst, uint32_t(word0));
      if (rows == 3u)
        WriteGmByPassDCache(reinterpret_cast<__gm__ uint64_t*>(dst + 1u),
                            (word0 >> 32u) | (word1 << 32u));
      else if (rows == 2u)
        WriteGmByPassDCache(dst + 1u, uint32_t(word0 >> 32u));
    } else {
      if (rows >= 2u)
        WriteGmByPassDCache(reinterpret_cast<__gm__ uint64_t*>(dst), word0);
      else
        WriteGmByPassDCache(dst, uint32_t(word0));
      if (rows == 4u)
        WriteGmByPassDCache(reinterpret_cast<__gm__ uint64_t*>(dst + 2u), word1);
      else if (rows == 3u)
        WriteGmByPassDCache(dst + 2u, uint32_t(word1));
    }
    DataSyncBarrier<MemDsbT::DDR>();
  } else {
    const uint32_t count = rows * s.n;
    GvBarrier<HardEvent::S_V>();
    Cast(out, f, RoundMode::CAST_RINT, count);
    GvBarrier<HardEvent::V_MTE3>();
    DataCopyPad(t.yg[uint64_t(begin) * s.n], out,
                DataCopyExtParams{1, count * sizeof(OutT), 0, 0, 0});
    PipeBarrier<PIPE_ALL>();
  }
}
}
namespace gmmptq {
template <bool BF>
__global__ __aicore__ void TinySingleCoreDirect(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                                GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                                uint32_t packed) {
  using namespace AscendC;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const uint32_t mCount = (packed & 15u) + 1u;
  const uint32_t nCount = ((packed >> 4) & 31u) + 1u;
  const uint32_t kCount = ((packed >> 9) & 7u) + 1u;
  const uint32_t eCount = ((packed >> 12) & 7u) + 1u;
  const uint32_t listType = (packed >> 15) & 1u;
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<uint32_t> xsg, wsg32, y32;
  GlobalTensor<uint16_t> wsg16, y16;
  GlobalTensor<int64_t> glg;
  xg.SetGlobalBuffer((__gm__ int8_t*)x);
  wg.SetGlobalBuffer((__gm__ int8_t*)w);
  xsg.SetGlobalBuffer((__gm__ uint32_t*)xs);
  wsg32.SetGlobalBuffer((__gm__ uint32_t*)ws);
  wsg16.SetGlobalBuffer((__gm__ uint16_t*)ws);
  glg.SetGlobalBuffer((__gm__ int64_t*)gl);
  y32.SetGlobalBuffer((__gm__ uint32_t*)y);
  y16.SetGlobalBuffer((__gm__ uint16_t*)y);
  DataCacheCleanAndInvalid<int8_t, CacheLine::SINGLE_CACHE_LINE,
                           DcciDst::CACHELINE_OUT>(xg);
  DataCacheCleanAndInvalid<int8_t, CacheLine::SINGLE_CACHE_LINE,
                           DcciDst::CACHELINE_OUT>(wg);
  DataCacheCleanAndInvalid<uint32_t, CacheLine::SINGLE_CACHE_LINE,
                           DcciDst::CACHELINE_OUT>(xsg);
  if constexpr (BF)
    DataCacheCleanAndInvalid<uint16_t, CacheLine::SINGLE_CACHE_LINE,
                             DcciDst::CACHELINE_OUT>(wsg16);
  else
    DataCacheCleanAndInvalid<uint32_t, CacheLine::SINGLE_CACHE_LINE,
                             DcciDst::CACHELINE_OUT>(wsg32);
  if (eCount > 1)
    DataCacheCleanAndInvalid<int64_t, CacheLine::SINGLE_CACHE_LINE,
                             DcciDst::CACHELINE_OUT>(glg);
  GlobalTensor<uint64_t> preloadTensor;
  preloadTensor.SetGlobalBuffer((__gm__ uint64_t*)x);
  DataCachePreload(preloadTensor, int16_t(0));
  preloadTensor.SetGlobalBuffer((__gm__ uint64_t*)w);
  DataCachePreload(preloadTensor, int16_t(0));
  preloadTensor.SetGlobalBuffer((__gm__ uint64_t*)xs);
  DataCachePreload(preloadTensor, int16_t(0));
  preloadTensor.SetGlobalBuffer((__gm__ uint64_t*)ws);
  DataCachePreload(preloadTensor, int16_t(0));
  uint32_t expert = 0;
  uint32_t end = mCount;
  if (eCount > 1) end = uint32_t(glg.GetValue(0));
  uint32_t packedOutput = 0;
  uint32_t linear = 0;
  for (uint32_t row = 0; row < mCount; ++row) {
    while (expert + 1 < eCount && row >= end) {
      ++expert;
      if (expert + 1 < eCount) {
        const uint32_t value = uint32_t(glg.GetValue(expert));
        end = listType == 0 ? value : end + value;
      } else
        end = mCount;
    }
    const float rowScale = GvFloat(xsg.GetValue(row));
    for (uint32_t column = 0; column < nCount; ++column, ++linear) {
      int32_t sum = 0;
#pragma unroll
      for (uint32_t k = 0; k < 8; ++k)
        if (k < kCount)
          sum += int32_t(xg.GetValue(row * kCount + k)) *
                 int32_t(wg.GetValue((expert * kCount + k) * nCount + column));
      uint32_t scaleBits;
      if constexpr (BF)
        scaleBits = uint32_t(wsg16.GetValue(expert * nCount + column)) << 16;
      else
        scaleBits = wsg32.GetValue(expert * nCount + column);
      const float weighted = float(sum) * GvFloat(scaleBits);
      const uint32_t encoded = GvEncode<BF>(weighted * rowScale);
      if ((linear & 1u) == 0)
        packedOutput = encoded;
      else
        y32.SetValue(linear >> 1, packedOutput | (encoded << 16));
    }
  }
  if (linear & 1u) y16.SetValue(linear - 1, uint16_t(packedOutput));
  DataCacheCleanAndInvalid<uint32_t, CacheLine::SINGLE_CACHE_LINE,
                           DcciDst::CACHELINE_OUT>(y32);
}
template <bool BF>
__global__ __aicore__ void TinySingleCoreStaged(GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                                                GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                                                uint32_t packed) {
  using namespace AscendC;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const GeneralVectorDims p{(packed & 63u) + 1u, ((packed >> 12) & 7u) + 1u,
                            ((packed >> 6) & 63u) + 1u, ((packed >> 15) & 15u) + 1u,
                            (packed >> 19) & 1u};
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<uint32_t> xsg, wsg32;
  GlobalTensor<uint16_t> wsg16, yg;
  GlobalTensor<int64_t> glg;
  xg.SetGlobalBuffer((__gm__ int8_t*)x);
  wg.SetGlobalBuffer((__gm__ int8_t*)w);
  xsg.SetGlobalBuffer((__gm__ uint32_t*)xs);
  wsg32.SetGlobalBuffer((__gm__ uint32_t*)ws);
  wsg16.SetGlobalBuffer((__gm__ uint16_t*)ws);
  glg.SetGlobalBuffer((__gm__ int64_t*)gl);
  yg.SetGlobalBuffer((__gm__ uint16_t*)y);
  TPipe pipe;
  TBuf<TPosition::VECCALC> ub;
  pipe.InitBuffer(ub, 13312);
  auto raw = ub.Get<uint8_t>();
  auto xl = raw[0].ReinterpretCast<int8_t>();
  auto wl = raw[512].ReinterpretCast<int8_t>();
  auto xsl = raw[8704].ReinterpretCast<uint32_t>();
  auto ws32 = raw[8960].ReinterpretCast<uint32_t>();
  auto ws16 = raw[8960].ReinterpretCast<uint16_t>();
  auto gll = raw[13056].ReinterpretCast<int64_t>();
  auto out = raw[13184].ReinterpretCast<uint16_t>();
  DataCopyPad(xl, xg, DataCopyExtParams{1, p.m * p.k, 0, 0, 0},
              DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
  DataCopyPad(wl, wg, DataCopyExtParams{1, p.e * p.k * p.n, 0, 0, 0},
              DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
  DataCopyPad(xsl, xsg, DataCopyExtParams{1, p.m * 4, 0, 0, 0},
              DataCopyPadExtParams<uint32_t>{false, 0, 0, 0});
  if constexpr (BF)
    DataCopyPad(ws16, wsg16, DataCopyExtParams{1, p.e * p.n * 2, 0, 0, 0},
                DataCopyPadExtParams<uint16_t>{false, 0, 0, 0});
  else
    DataCopyPad(ws32, wsg32, DataCopyExtParams{1, p.e * p.n * 4, 0, 0, 0},
                DataCopyPadExtParams<uint32_t>{false, 0, 0, 0});
  if (p.e > 1)
    DataCopyPad(gll, glg, DataCopyExtParams{1, (p.e - 1) * 8, 0, 0, 0},
                DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
  GvBarrier<HardEvent::MTE2_S>();
  uint32_t ends[16] = {}, previous = 0;
  for (uint32_t e = 0; e + 1 < p.e; ++e) {
    uint32_t value = uint32_t(gll.GetValue(e));
    ends[e] = p.listType == 0 ? value : previous + value;
    previous = ends[e];
  }
  uint32_t expert = 0;
  for (uint32_t m = 0; m < p.m; ++m) {
    while (expert + 1 < p.e && m >= ends[expert]) ++expert;
    const float scale = GvFloat(xsl.GetValue(m));
    for (uint32_t n = 0; n < p.n; ++n) {
      int32_t sum = 0;
#pragma unroll
      for (uint32_t k = 0; k < 8; ++k)
        if (k < p.k)
          sum += int32_t(xl.GetValue(m * p.k + k)) *
                 int32_t(wl.GetValue((expert * p.k + k) * p.n + n));
      uint32_t bits;
      if constexpr (BF)
        bits = uint32_t(ws16.GetValue(expert * p.n + n)) << 16;
      else
        bits = ws32.GetValue(expert * p.n + n);
      float weighted = float(sum) * GvFloat(bits);
      out.SetValue(m * p.n + n, GvEncode<BF>(weighted * scale));
    }
  }
  GvBarrier<HardEvent::S_MTE3>();
  DataCopyPad(yg, out, DataCopyExtParams{1, p.m * p.n * 2, 0, 0, 0});
}
}
namespace tiny_capacity_unrolled {
using namespace gmmptq;
using namespace AscendC;
template <uint32_t Cap>
__aicore__ inline uint64_t Load(GM_ADDR p, uint32_t bytes) {
  if (bytes == 0u) return 0u;
  if constexpr (Cap == 1u)
    return uint64_t(*(__gm__ uint8_t*)p);
  else {
    if (bytes == Cap && (reinterpret_cast<uintptr_t>(p) & (Cap - 1u)) == 0u) {
      if constexpr (Cap == 8u)
        return *(__gm__ uint64_t*)p;
      else if constexpr (Cap == 4u)
        return *(__gm__ uint32_t*)p;
      else
        return *(__gm__ uint16_t*)p;
    }
    constexpr uint32_t Half = Cap / 2u;
    uint64_t lo = Load<Half>(p, Min(bytes, Half));
    if (bytes > Half) lo |= Load<Half>(p + Half, bytes - Half) << (Half * 8u);
    return lo;
  }
}
template <uint32_t Cap>
__aicore__ inline void Store(GM_ADDR p, uint64_t bits, uint32_t bytes) {
  if (bytes == 0u) return;
  if constexpr (Cap == 2u)
    WriteGmByPassDCache((__gm__ uint16_t*)p, uint16_t(bits));
  else {
    if (bytes == Cap && (reinterpret_cast<uintptr_t>(p) & (Cap - 1u)) == 0u) {
      if constexpr (Cap == 8u)
        WriteGmByPassDCache((__gm__ uint64_t*)p, bits);
      else
        WriteGmByPassDCache((__gm__ uint32_t*)p, uint32_t(bits));
    } else {
      constexpr uint32_t Half = Cap / 2u;
      Store<Half>(p, bits, Min(bytes, Half));
      if (bytes > Half) Store<Half>(p + Half, bits >> (Half * 8u), bytes - Half);
    }
  }
}
__aicore__ inline float F(uint32_t u) {
  union {
    uint32_t u;
    float f;
  } v;
  v.u = u;
  return v.f;
}
__aicore__ inline int32_t S(uint64_t u, uint32_t i) {
  return int32_t(int8_t((u >> (i * 8u)) & 255u));
}
template <bool BF, uint32_t KC, uint32_t NC, bool Full, bool Single>
__aicore__ inline void Rows(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR y,
                            uint32_t m, uint32_t actualK, uint32_t actualN,
                            uint32_t owners) {
  constexpr uint32_t MC =
      (4u < 8u / KC ? 4u : 8u / KC) < 8u / NC ? (4u < 8u / KC ? 4u : 8u / KC) : 8u / NC;
  constexpr uint32_t XCap = MC * KC, WCap = KC * NC, SCap = NC * (BF ? 2u : 4u);
  static_assert(XCap <= 8u && WCap <= 8u && SCap <= 8u && MC * NC <= 8u,
                "capacity family");
  const uint32_t k = Full ? KC : actualK, n = Full ? NC : actualN;
  const uint64_t xx = Load<XCap>(x, m * k), sx0 = Load<8>(xs, Min(8u, m * 4u));
  const uint64_t sx1 = m > 2u ? Load<8>(xs + 8u, m * 4u - 8u) : 0u;
  uint64_t ww = 0, sw = 0, out0 = 0, out1 = 0;
  uint32_t held = 0xffffffffu;
  if constexpr (Single) {
    ww = Load<WCap>(w, k * n);
    sw = Load<SCap>(ws, n * (BF ? 2u : 4u));
  }
#pragma unroll
  for (uint32_t row = 0; row < MC; ++row)
    if (row < m) {
      if constexpr (!Single) {
        const uint32_t owner = (owners >> (8u * row)) & 255u;
        if (owner != held) {
          ww = Load<WCap>(w + uint64_t(owner) * k * n, k * n);
          sw =
              Load<SCap>(ws + uint64_t(owner) * n * (BF ? 2u : 4u), n * (BF ? 2u : 4u));
          held = owner;
        }
      }
      const float scale = F(uint32_t((row < 2u ? sx0 : sx1) >> (32u * (row & 1u))));
#pragma unroll
      for (uint32_t col = 0; col < NC; ++col)
        if (Full || col < n) {
          int32_t dot = 0;
#pragma unroll
          for (uint32_t t = 0; t < KC; ++t)
            if (Full || t < k) dot += S(xx, row * k + t) * S(ww, t * n + col);
          const uint32_t sb = BF ? uint32_t(uint16_t(sw >> (16u * col))) << 16u
                                 : uint32_t(sw >> (32u * col));
          const float weighted = float(dot) * F(sb);
          const uint16_t v = GvEncode<BF>(weighted * scale);
          const uint32_t q = row * n + col;
          if (q < 4u)
            out0 |= uint64_t(v) << (q * 16u);
          else
            out1 |= uint64_t(v) << ((q - 4u) * 16u);
        }
    }
  const uint32_t bytes = m * n * 2u;
  Store<8>(y, out0, Min(bytes, 8u));
  if (bytes > 8u) Store<8>(y + 8u, out1, bytes - 8u);
}
template <bool BF, uint32_t KC, uint32_t NC>
__global__ __aicore__ void SearchTinyCapacityUnrolled11850012(GM_ADDR x, GM_ADDR w,
                                                              GM_ADDR xs, GM_ADDR ws,
                                                              GM_ADDR gl, GM_ADDR y,
                                                              uint32_t dims) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  const uint32_t m = (dims & 3u) + 1u, k = ((dims >> 2u) & 7u) + 1u,
                 n = ((dims >> 5u) & 3u) + 1u, e = ((dims >> 7u) & 127u) + 1u,
                 gt = (dims >> 14u) & 1u;
  GlobalTensor<uint64_t> preload;
  if (e > 1u) {
    preload.SetGlobalBuffer((__gm__ uint64_t*)gl);
    DataCachePreload(preload, int16_t(0));
  }
  preload.SetGlobalBuffer((__gm__ uint64_t*)x);
  DataCachePreload(preload, int16_t(0));
  preload.SetGlobalBuffer((__gm__ uint64_t*)xs);
  DataCachePreload(preload, int16_t(0));
  preload.SetGlobalBuffer((__gm__ uint64_t*)w);
  DataCachePreload(preload, int16_t(0));
  preload.SetGlobalBuffer((__gm__ uint64_t*)ws);
  DataCachePreload(preload, int16_t(0));
  uint32_t owners = 0;
  if (e > 1u) {
    uint32_t done = 0;
    uint64_t end = 0;
    for (uint32_t expert = 0; expert + 1u < e && done < m; ++expert) {
      const uint64_t v = Load<8>(gl + uint64_t(expert) * 8u, 8u);
      end = gt ? end + v : v;
      while (done < m && uint64_t(done) < end) {
        owners |= expert << (8u * done);
        ++done;
      }
    }
    while (done < m) {
      owners |= (e - 1u) << (8u * done);
      ++done;
    }
  }
  if (e == 1u) {
    if (k == KC && n == NC)
      Rows<BF, KC, NC, true, true>(x, w, xs, ws, y, m, k, n, 0u);
    else
      Rows<BF, KC, NC, false, true>(x, w, xs, ws, y, m, k, n, 0u);
  } else {
    if (k == KC && n == NC)
      Rows<BF, KC, NC, true, false>(x, w, xs, ws, y, m, k, n, owners);
    else
      Rows<BF, KC, NC, false, false>(x, w, xs, ws, y, m, k, n, owners);
  }
  DataSyncBarrier<MemDsbT::DDR>();
}
}
namespace tiny_capacity_unrolled {
#ifdef TINY_CAPACITY_CPU
#define TINY_CAPACITY_RUN(Kernel, ...) Kernel<__VA_ARGS__>(x, w, xs, ws, gl, y, dims)
#else
#define TINY_CAPACITY_RUN(Kernel, ...) \
  Kernel<__VA_ARGS__><<<1, nullptr, stream>>>(x, w, xs, ws, gl, y, dims)
#endif
template <bool BF, uint32_t KC, uint32_t NC, bool BFOnly = false>
inline bool TryCell(uint32_t k, uint32_t n, GM_ADDR x, GM_ADDR w, GM_ADDR xs,
                    GM_ADDR ws, GM_ADDR gl, GM_ADDR y, uint32_t dims,
                    aclrtStream stream) {
  if constexpr (BFOnly && !BF) {
    return false;
  } else {
    if (k > KC || n > NC) return false;
    TINY_CAPACITY_RUN(SearchTinyCapacityUnrolled11850012, BF, KC, NC);
    return true;
  }
}
template <bool BF>
inline void Select(GM_ADDR x, GM_ADDR w, GM_ADDR xs, GM_ADDR ws, GM_ADDR gl, GM_ADDR y,
                   uint32_t dims, aclrtStream stream) {
  const uint32_t k = ((dims >> 2u) & 7u) + 1u, n = ((dims >> 5u) & 3u) + 1u;
#define TINY_CAPACITY_TRY(KC, NC, BFOnly) \
  if (TryCell<BF, KC, NC, BFOnly>(k, n, x, w, xs, ws, gl, y, dims, stream)) return
  TINY_CAPACITY_TRY(1u, 1u, false);
  TINY_CAPACITY_TRY(1u, 2u, false);
  TINY_CAPACITY_TRY(1u, 4u, true);
  TINY_CAPACITY_TRY(2u, 1u, false);
  TINY_CAPACITY_TRY(2u, 2u, false);
  TINY_CAPACITY_TRY(2u, 4u, true);
  TINY_CAPACITY_TRY(4u, 1u, false);
  TINY_CAPACITY_TRY(4u, 2u, false);
  TINY_CAPACITY_TRY(8u, 1u, false);
#undef TINY_CAPACITY_TRY
  throw std::invalid_argument("outside registered power-of-two capacity family");
}
